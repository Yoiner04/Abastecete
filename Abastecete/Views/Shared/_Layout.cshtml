@using BusinessLogic.Utilidades
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abastecete</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png">
    <script src="https://unpkg.com/boxicons@2.1.4/dist/boxicons.js"></script>
</head>

@Html.Partial("_SupportBubble")
@Html.Partial("_ContactModal")
@Html.Partial("_AddonBubble")


<body class="bg-gray-100" style="color: black;">

    @{
        string permisos = HttpContextAccessor.HttpContext.Session.GetString("permisos");
        string membresia = HttpContextAccessor.HttpContext.Session.GetString("membresia") ?? "0";
        bool ocultarPublicarOferta = (membresia == "11" || membresia == "12" || membresia == "13");
    }
    <header id="header" class="fixed top-0 left-0 w-full z-40 shadow-md" style="background-color: #F4F1E9;">
        <nav class="flex flex-col lg:flex-row items-start lg:items-center px-6 py-2 gap-2 lg:gap-0">
            <div class="flex items-center gap-4 md:gap-x-6 lg:gap-x-2 w-full lg:w-auto justify-between">
                <a href="@Url.Action("Principal", "Home")" class="flex items-center min-w-max">
                    <img src="~/css/Images/LOGO FINAL.png" alt="Abastecete Logo" class="h-14 w-auto">
                </a>

                <button id="menu-toggle" class="text-black focus:outline-none lg:hidden">
                    <i class="fas fa-bars text-2xl"></i>
                </button>
            </div>

            <div id="menu-container"
                class="hidden lg:flex w-full justify-center items-center gap-4 bg-gray-100 px-4 md:px-2 py-2 lg:flex-row lg:flex-nowrap lg:justify-between lg:gap-2 lg:px-2 bg-transparent">
                <ul id="menu"
                    class="flex flex-col items-center gap-x-2 text-base font-bold text-black lg:flex-row lg:gap-x-2 lg:justify-start">
                    <li>
                        <form id="search-form-md" action="@Url.Action("Index", "Buscador")" method="get"
                            class="flex w-fit">
                            <div class="relative w-64 sm:w-80">
                                <div class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-2">
                                    <i class="fa fa-search text-sm text-gray-500 dark:text-gray-400"></i>
                                </div>

                                <input type="text" id="search-input-md" name="query"
                                    value="@Context.Request.Query["query"]"
                                    class="block w-full rounded-md border border-gray-300 bg-gray-50 py-2 ps-8 pe-24 text-sm text-gray-900 focus:border-blue-500 focus:ring-blue-500"
                                    placeholder="Buscar producto..." required />

                                <button type="submit"
                                    class="absolute end-1 top-1 bottom-1 my-auto rounded-md bg-[#F66623] px-3 py-1.5 text-sm font-semibold text-white hover:bg-[#e75b1f] focus:outline-none focus:ring-2 focus:ring-blue-300">
                                    Buscar
                                </button>
                            </div>
                        </form>
                    </li>

                    <li class="flex-1 md:flex-none text-center">
                        <a href="@Url.Action("Listar", "Categorias")"
                            class="block px-4 sm:px-1 lg:px-0 xl:px-2 py-2 whitespace-nowrap text-black hover:text-green-600">Proveedores</a>
                    </li>

                    <li class="flex-1 md:flex-none text-center">
                        <a href="/#ofertas-container"
                            class="block px-4 md:px-1 lg:px-0 xl:px-2 py-2 whitespace-nowrap text-black hover:text-green-600">Ofertas
                            flash</a>
                    </li>

                    <li class="flex-1 md:flex-none text-center">
                        <a href="/" id="open-contact-modal"
                            class="block px-4 py-2 text-black hover:text-green-600 md:px-0 lg:px-0 xl:px-2 md:py-0">Contacto</a>
                    </li>
                </ul>

                <div class="flex items-center justify-center lg:justify-end flex-1">
                    @if (permisos != null)
                    {
                        <div class="relative flex items-center">
                            <button id="user-btn" title="Ver opciones de usuario"
                                class="flex items-center gap-2 min-w-max rounded-full p-1 transition hover:bg-gray-100 focus:outline-none">
                                <img src="~/css/Images/avatar.png" alt="Usuario"
                                    class="h-10 w-10 rounded-full border border-gray-300 shadow-sm">
                            </button>

                            <ul id="user-menu"
                                class="absolute top-2 right-0 z-50 mt-2 hidden min-w-[180px] overflow-hidden rounded-lg border border-gray-200 bg-white text-sm shadow-xl md:min-w-[220px]">
                                <li class="border-b px-5 py-3 transition duration-200 hover:bg-gray-100">
                                    <a href="@Url.Action("Actualizar", "Usuarios")"
                                        class="block w-full text-left font-medium text-black">
                                        ✏️ Editar perfil
                                    </a>

                                </li>
                                <li class="px-5 py-3 transition duration-200 hover:bg-gray-100">
                                    <a href="@Url.Action("Logout", "Login")" class="block font-semibold text-black">🚪
                                        Cerrar Sesión</a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Login")"
                            class="rounded-lg bg-green-600 px-4 lg:px-0 xl:px-4 py-2 text-sm font-medium text-white hover:bg-green-700 text-center md:py-3 md:text-base xl:text-lg">Únete
                            a nosotros</a>
                    }
                </div>
            </div>
        </nav>

        <button id="admin-menu-toggle" class="block w-full bg-gray-300 py-2 text-center font-bold text-black md:hidden">
            Menú de Administración ⬇
        </button>

        <div id="admin-menu" class="hidden justify-center bg-gray-200 py-2 md:flex">
            <ul class="flex flex-col text-center text-sm md:flex-row md:space-x-6 md:text-left">

                @if (permisos != null)
                {
                    @if (RolPermisos.TienePermiso("Publica tu negocio", permisos))
                    {
                        <li class="group">
                            <a href="@Url.Action("Crear", "Negocios")" class="text-black group-hover:text-green-600">
                                Publica tu negocio
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("Mi negocio", permisos))
                    {
                        <li class="group">
                            <a href="@Url.Action("ProductosNegocio", "Productos")"
                                class="text-black group-hover:text-green-600">
                                Mi negocio
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("Mi negocio", permisos) && !ocultarPublicarOferta)
                    {
                        <li class="group">
                            <a href="@Url.Action("Crear", "OfertasFlash")" class="text-black group-hover:text-green-600">
                                Publicar oferta flash
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("Dejanos tu reseña", permisos))
                    {
                        <li class="group">
                            <a href="/#dejanos-tu-resenia" class="text-black group-hover:text-green-600">
                                Dejanos tu reseña
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("Administrar Categorias", permisos))
                    {
                        <li class="group">
                            <a href="@Url.Action("Consultar", "Categorias")" class="text-black group-hover:text-green-600">
                                Gestionar Categorías
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("Administrar Usuarios", permisos))
                    {
                        <li class="group">
                            <a href="@Url.Action("Consultar", "Usuarios")" class="text-black group-hover:text-green-600">
                                Gestionar Usuarios
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("Administrar Membresias", permisos))
                    {
                        <li class="group">
                            <a href="@Url.Action("Consultar", "Membresias")" class="text-black group-hover:text-green-600">
                                Gestionar Membresias
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("Administrar Roles", permisos))
                    {
                        <li class="group">
                            <a href="@Url.Action("Consultar", "Roles")" class="text-black group-hover:text-green-600">
                                Gestionar Roles y permisos
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("Administrar Banners", permisos))
                    {
                        <li class="group">
                            <a href="@Url.Action("Editar", "Banners")" class="text-black group-hover:text-green-600">
                                Gestionar Banners
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("Administrar Banners", permisos))
                    {
                        <li class="group">
                            <a href="@Url.Action("Gestionar", "OfertasFlash")" class="text-black group-hover:text-green-600">
                                Gestionar Ofertas
                            </a>
                        </li>
                    }
                }
                else
                {
                    <li class="group">
                        <a href="@Url.Action("Login", "Login")" class="text-black group-hover:text-green-600">
                            ¡Publica tu negocio o dejanos tu reseña!
                        </a>
                    </li>
                }
            </ul>
        </div>

    </header>

    <main role="main" class="pt-28">
        @RenderBody()
    </main>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Menú de navegación principal
            const menuToggle = document.getElementById('menu-toggle');
            const menuContainer = document.getElementById('menu-container');

            function resetMenuOnResize() {
                if (window.innerWidth >= 1024) {
                    menuContainer.classList.remove('hidden');
                } else {
                    menuContainer.classList.add('hidden');
                }
            }

            if (menuToggle && menuContainer) {
                menuToggle.addEventListener('click', () => {
                    menuContainer.classList.toggle('hidden');
                });
                window.addEventListener('resize', resetMenuOnResize);
                resetMenuOnResize();
            }

            // Menú de administración
            const adminMenuToggle = document.getElementById('admin-menu-toggle');
            const adminMenu = document.getElementById('admin-menu');

            function resetAdminMenuOnResize() {
                if (window.innerWidth >= 1024) {
                    adminMenu.classList.remove('hidden');
                } else {
                    adminMenu.classList.add('hidden');
                }
            }

            if (adminMenuToggle && adminMenu) {
                adminMenuToggle.addEventListener('click', () => {
                    adminMenu.classList.toggle('hidden');
                });
                window.addEventListener('resize', resetAdminMenuOnResize);
                resetAdminMenuOnResize();
            }
        });


        document.addEventListener("DOMContentLoaded", function () {
            const adminMenu = document.getElementById('admin-menu');
            const adminMenuToggle = document.getElementById('admin-menu-toggle');

            function resetAdminMenuOnResize() {
                if (window.innerWidth >= 1024) {
                    adminMenu.classList.remove('hidden');
                    adminMenu.style.position = '';
                    adminMenu.style.top = '';
                    adminMenu.style.left = '';
                    adminMenu.style.width = '';
                } else {
                    adminMenu.classList.add('hidden');
                }
            }

            window.addEventListener('resize', resetAdminMenuOnResize);
            resetAdminMenuOnResize();
        });

        document.addEventListener("DOMContentLoaded", function () {
            const userBtn = document.getElementById("user-btn");
            const userMenu = document.getElementById("user-menu");

            if (userBtn && userMenu) {
                userBtn.addEventListener("click", function (e) {
                    e.stopPropagation();
                    userMenu.classList.toggle("hidden");
                });

                // Cierra el menú si se hace clic fuera
                document.addEventListener("click", function (e) {
                    if (!userMenu.classList.contains("hidden")) {
                        if (!userMenu.contains(e.target) && e.target !== userBtn) {
                            userMenu.classList.add("hidden");
                        }
                    }
                });
            }
        });
    </script>
    @await Html.PartialAsync("_Footer")

</body>

</html>

<style>
    html,
    body {
        height: 100%;
        margin: 0;
    }

    body {
        display: flex;
        flex-direction: column;
    }

    main {
        flex: 1;
    }

    footer {
        margin-top: auto;
    }
</style>