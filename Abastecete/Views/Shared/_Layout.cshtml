@using BusinessLogic.Utilidades
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abastecete</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" type="image/x-icon" href="~/images/Logo A naranja.png">
    <script src="https://unpkg.com/boxicons@2.1.4/dist/boxicons.js"></script>
</head>

@Html.Partial("_SupportBubble")
@Html.Partial("_ContactModal")


<body class="bg-gray-100" style="color: black;">

    @{
        // Nuevo sistema de permisos (códigos como ADMIN_USUARIOS)
        string permisosSistema = HttpContextAccessor.HttpContext.Session.GetString("permisosSistema");
        // Sistema antiguo de permisos (nombres como "Administrar Usuarios") - fallback
        string permisosLegacy = HttpContextAccessor.HttpContext.Session.GetString("permisos");
        // Usar nuevo sistema si existe, sino fallback al antiguo
        string permisos = !string.IsNullOrEmpty(permisosSistema) ? permisosSistema : permisosLegacy;
        string membresia = HttpContextAccessor.HttpContext.Session.GetString("membresia") ?? "0";
        bool estaLogueado = permisos != null || permisosSistema != null;
        int? idLocal = HttpContextAccessor.HttpContext.Session.GetInt32("idLocal");
        bool tieneLocal = idLocal.HasValue && idLocal.Value > 0;
        string userPicture = HttpContextAccessor.HttpContext.Session.GetString("userPicture") ?? "";
    }
    <!-- Header Principal Modernizado -->
    <header id="header" class="fixed top-0 left-0 w-full z-40 shadow-lg transition-shadow duration-300" style="background-color: #F4F1E9;">
        <nav class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center px-4 lg:px-6 py-3 gap-3 lg:gap-6">
            <!-- Logo y botón móvil -->
            <div class="flex items-center gap-4 w-full lg:w-auto justify-between">
                <a href="@Url.Action("Principal", "Home")" class="flex items-center group">
                    <img src="~/images/LOGO FINAL.png" alt="Abastecete Logo"
                         class="h-12 lg:h-14 w-auto transition-transform duration-300 group-hover:scale-105">
                </a>
                <button id="menu-toggle" class="lg:hidden flex items-center justify-center w-10 h-10 rounded-lg hover:bg-[#23916A]/10 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#23916A]">
                    <i class="fas fa-bars text-xl text-gray-700"></i>
                </button>
            </div>

            <!-- Contenedor del menú -->
            <div id="menu-container" class="hidden lg:flex w-full flex-col lg:flex-row items-center gap-4 lg:gap-6">
                <!-- Barra de búsqueda con autocompletado -->
                <form id="search-form-md" action="@Url.Action("Index", "Buscador")" method="get" class="w-full lg:w-auto lg:flex-1 lg:max-w-md order-1">
                    <div class="relative group">
                        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
                            <i class="fa fa-search text-gray-400 group-focus-within:text-[#23916A] transition-colors duration-200"></i>
                        </div>
                        <input type="text" id="search-input-md" name="query"
                            value="@Context.Request.Query["query"]"
                            autocomplete="off"
                            class="w-full pl-11 pr-24 py-2.5 rounded-full border border-gray-300 bg-white text-sm text-gray-900 placeholder-gray-400 transition-all duration-200 focus:border-[#23916A] focus:ring-2 focus:ring-[#23916A]/20 focus:outline-none"
                            placeholder="¿Qué estás buscando?" />
                        <button type="submit"
                            class="absolute right-1.5 top-1/2 -translate-y-1/2 px-4 py-1.5 rounded-full bg-[#F66623] text-white text-sm font-semibold shadow-sm hover:bg-[#e55a1a] hover:shadow-md transition-all duration-200">
                            Buscar
                        </button>
                        <!-- Dropdown de sugerencias -->
                        <div id="search-suggestions" class="hidden absolute top-full left-0 right-0 mt-2 bg-white rounded-xl shadow-2xl border border-gray-200 overflow-hidden z-50 max-h-96 overflow-y-auto">
                            <!-- Loader -->
                            <div id="suggestions-loader" class="hidden p-4 text-center text-gray-500">
                                <i class="fas fa-spinner fa-spin mr-2"></i>Buscando...
                            </div>
                            <!-- Contenido de sugerencias -->
                            <div id="suggestions-content"></div>
                        </div>
                    </div>
                </form>

                <!-- Links de navegación - En móvil horizontal con scroll, en desktop normal -->
                <ul id="menu" class="flex flex-row lg:flex-row items-center gap-1 w-full lg:w-auto order-2 justify-center flex-wrap">
                    <li>
                        <a href="@Url.Action("Listar", "Categorias")"
                            class="flex items-center gap-2 px-3 py-2 rounded-lg font-semibold text-sm no-underline hover:bg-[#23916A]/10 hover:text-[#23916A] transition-all duration-200 whitespace-nowrap" style="color: #374151;">
                            <i class="fas fa-store text-xs opacity-70"></i>
                            Proveedores
                        </a>
                    </li>
                    <li>
                        <a href="/#ofertas-container"
                            class="flex items-center gap-2 px-3 py-2 rounded-lg font-semibold text-sm no-underline hover:bg-[#F66623]/10 hover:text-[#F66623] transition-all duration-200 whitespace-nowrap" style="color: #374151;">
                            <i class="fas fa-bolt text-xs opacity-70"></i>
                            Ofertas
                        </a>
                    </li>
                    <li>
                        <a href="/" id="open-contact-modal"
                            class="flex items-center gap-2 px-3 py-2 rounded-lg font-semibold text-sm no-underline hover:bg-gray-200 transition-all duration-200 whitespace-nowrap" style="color: #374151;">
                            <i class="fas fa-envelope text-xs opacity-70"></i>
                            Contacto
                        </a>
                    </li>
                </ul>

                <!-- Área de usuario -->
                <div class="flex items-center gap-3 order-3 w-full lg:w-auto justify-center lg:justify-end mt-2 lg:mt-0">
                    @if (estaLogueado)
                    {
                        <div class="relative">
                            <button id="user-btn" title="Ver opciones de usuario"
                                class="flex items-center gap-2 px-3 py-2 rounded-full bg-white border border-gray-200 hover:border-[#23916A] hover:shadow-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-[#23916A]">
                                <img src="@(string.IsNullOrEmpty(userPicture) ? "/images/avatar.png" : userPicture)" alt="Usuario"
                                    class="h-8 w-8 rounded-full border-2 border-[#23916A]/20 object-cover">
                                <i class="fas fa-chevron-down text-xs text-gray-500"></i>
                            </button>
                            <ul id="user-menu"
                                class="absolute top-full right-0 z-50 mt-2 hidden min-w-[200px] overflow-hidden rounded-xl border border-gray-200 bg-white text-sm shadow-xl">
                                <li class="border-b border-gray-100">
                                    <a href="@Url.Action("Actualizar", "Usuarios")"
                                        class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-[#23916A]/10 hover:text-[#23916A] transition-colors duration-150 no-underline">
                                        <i class="fas fa-user-edit text-[#23916A]"></i>
                                        <span class="font-medium">Editar perfil</span>
                                    </a>
                                </li>
                                @if (tieneLocal && !RolPermisos.TienePermiso("ADMIN_DASHBOARD", permisos))
                                {
                                    <li class="border-b border-gray-100">
                                        <a href="@Url.Action("Index", "Analiticas")"
                                            class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-[#23916A]/10 hover:text-[#23916A] transition-colors duration-150 no-underline">
                                            <i class="fas fa-chart-line text-[#23916A]"></i>
                                            <span class="font-medium">Analíticas</span>
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a href="@Url.Action("Logout", "Login")"
                                        class="flex items-center gap-3 px-4 py-3 text-gray-700 hover:bg-red-50 hover:text-red-600 transition-colors duration-150 no-underline">
                                        <i class="fas fa-sign-out-alt"></i>
                                        <span class="font-medium">Cerrar Sesión</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "Login")"
                            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#23916A] text-white font-semibold text-sm shadow-md hover:bg-[#1d7a59] hover:shadow-lg transition-all duration-200 no-underline">
                            <i class="fas fa-user-plus text-xs"></i>
                            Únete gratis
                        </a>
                    }
                </div>
            </div>
        </nav>

        <!-- Menú de administración móvil toggle -->
        <button id="admin-menu-toggle" class="flex w-full items-center justify-center gap-2 py-2.5 text-center font-semibold text-gray-700 md:hidden hover:bg-[#e8e4db] transition-colors duration-200" style="background-color: #ebe7de;">
            <i class="fas fa-cog text-sm"></i>
            Menú de Administración
            <i class="fas fa-chevron-down text-xs"></i>
        </button>

        <!-- Menú de administración -->
        <div id="admin-menu" class="hidden justify-center py-2.5 md:flex border-t border-[#d9d5cc]" style="background-color: #ebe7de;">
            <ul class="flex flex-col text-center text-sm md:flex-row md:gap-1 lg:gap-2 md:text-left px-4 flex-wrap justify-center">
                @{
                    var esAdmin = RolPermisos.TienePermiso("ADMIN_DASHBOARD", permisos);
                }
                @if (estaLogueado)
                {
                    @* Opciones para usuarios sin negocio y sin permisos de admin *@
                    @if (!tieneLocal && !esAdmin)
                    {
                        <li>
                            <a href="@Url.Action("Crear", "Negocios")" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium hover:bg-[#23916A]/10 hover:text-[#23916A] transition-all duration-200" style="color: #374151;">
                                <i class="fas fa-plus-circle text-xs" style="color: #23916A;"></i>
                                Publica tu negocio
                            </a>
                        </li>
                        <li>
                            <a href="/#dejanos-tu-resenia" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium hover:bg-[#23916A]/10 hover:text-[#23916A] transition-all duration-200" style="color: #374151;">
                                <i class="fas fa-star text-xs" style="color: #F66623;"></i>
                                Tu reseña
                            </a>
                        </li>
                    }
                    @* Opciones para usuarios con negocio (permisos de negocio) *@
                    @if (RolPermisos.TienePermiso("Mi negocio,PRODUCTOS_BASICO,PRODUCTOS_ILIMITADOS", permisos))
                    {
                        <li>
                            <a href="@Url.Action("ProductosNegocio", "Productos")" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium hover:bg-[#23916A]/10 hover:text-[#23916A] transition-all duration-200" style="color: #374151;">
                                <i class="fas fa-building text-xs" style="color: #23916A;"></i>
                                Mi negocio
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("Mi negocio,OFERTAS_FLASH", permisos))
                    {
                        <li>
                            <a href="@Url.Action("Crear", "OfertasFlash")" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium hover:bg-[#F66623]/10 hover:text-[#F66623] transition-all duration-200" style="color: #374151;">
                                <i class="fas fa-bolt text-xs" style="color: #F66623;"></i>
                                Publicar oferta
                            </a>
                        </li>
                    }
                    @* Opciones de administración *@
                    @if (RolPermisos.TienePermiso("ADMIN_CATEGORIAS", permisos))
                    {
                        <li>
                            <a href="@Url.Action("Consultar", "Categorias")" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium hover:bg-[#23916A]/10 hover:text-[#23916A] transition-all duration-200" style="color: #374151;">
                                <i class="fas fa-tags text-xs" style="color: #23916A;"></i>
                                Categorías
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("Index", "Unidad")" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium hover:bg-[#23916A]/10 hover:text-[#23916A] transition-all duration-200" style="color: #374151;">
                                <i class="fas fa-balance-scale text-xs" style="color: #23916A;"></i>
                                Unidades
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("ADMIN_USUARIOS", permisos))
                    {
                        <li>
                            <a href="@Url.Action("Consultar", "Usuarios")" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium hover:bg-[#23916A]/10 hover:text-[#23916A] transition-all duration-200" style="color: #374151;">
                                <i class="fas fa-users text-xs" style="color: #23916A;"></i>
                                Usuarios
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("ADMIN_MEMBRESIAS", permisos))
                    {
                        <li>
                            <a href="@Url.Action("Consultar", "Membresias")" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium hover:bg-[#23916A]/10 hover:text-[#23916A] transition-all duration-200" style="color: #374151;">
                                <i class="fas fa-id-card text-xs" style="color: #23916A;"></i>
                                Membresías
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("ADMIN_BANNERS", permisos))
                    {
                        <li>
                            <a href="@Url.Action("Editar", "Banners")" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium hover:bg-[#23916A]/10 hover:text-[#23916A] transition-all duration-200" style="color: #374151;">
                                <i class="fas fa-images text-xs" style="color: #23916A;"></i>
                                Banners
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("ADMIN_OFERTAS", permisos))
                    {
                        <li>
                            <a href="@Url.Action("Gestionar", "OfertasFlash")" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium hover:bg-[#F66623]/10 hover:text-[#F66623] transition-all duration-200" style="color: #374151;">
                                <i class="fas fa-percentage text-xs" style="color: #F66623;"></i>
                                Ofertas
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("ADMIN_PRODUCTOS", permisos))
                    {
                        <li>
                            <a href="@Url.Action("AdminProductos", "Productos")" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium hover:bg-[#23916A]/10 hover:text-[#23916A] transition-all duration-200" style="color: #374151;">
                                <i class="fas fa-box text-xs" style="color: #23916A;"></i>
                                Productos
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("ADMIN_MARCAS", permisos))
                    {
                        <li>
                            <a href="@Url.Action("Index", "Marcas")" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium hover:bg-[#23916A]/10 hover:text-[#23916A] transition-all duration-200" style="color: #374151;">
                                <i class="fas fa-trademark text-xs" style="color: #23916A;"></i>
                                Marcas
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("ADMIN_GALERIA", permisos))
                    {
                        <li>
                            <a href="@Url.Action("Index", "GaleriaAdmin")" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium hover:bg-[#23916A]/10 hover:text-[#23916A] transition-all duration-200" style="color: #374151;">
                                <i class="fas fa-images text-xs" style="color: #23916A;"></i>
                                Galeria
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("ADMIN_LOGS", permisos))
                    {
                        <li>
                            <a href="@Url.Action("Index", "Logs")" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium hover:bg-[#23916A]/10 hover:text-[#23916A] transition-all duration-200" style="color: #374151;">
                                <i class="fas fa-clipboard-list text-xs" style="color: #23916A;"></i>
                                Logs
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("ADMIN_DASHBOARD", permisos))
                    {
                        <li>
                            <a href="@Url.Action("DashboardAdmin", "Analiticas")" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium hover:bg-[#23916A]/10 hover:text-[#23916A] transition-all duration-200" style="color: #374151;">
                                <i class="fas fa-chart-pie text-xs" style="color: #23916A;"></i>
                                Dashboard
                            </a>
                        </li>
                    }
                    @if (RolPermisos.TienePermiso("ADMIN_REFERIDOS", permisos))
                    {
                        <li>
                            <a href="@Url.Action("Configuracion", "Referidos")" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg font-medium hover:bg-[#23916A]/10 hover:text-[#23916A] transition-all duration-200" style="color: #374151;">
                                <i class="fas fa-user-group text-xs" style="color: #23916A;"></i>
                                Referidos
                            </a>
                        </li>
                    }
                }
                else
                {
                    <li>
                        <a href="@Url.Action("Index", "Login")" class="btn-publicar inline-flex items-center gap-2 px-4 py-2 rounded-lg font-semibold no-underline transition-all duration-200">
                            <i class="fas fa-rocket text-sm"></i>
                            ¡Publica tu negocio o déjanos tu reseña!
                        </a>
                    </li>
                    <style>
                        .btn-publicar {
                            background-color: #23916A !important;
                            color: #ffffff !important;
                        }
                        .btn-publicar:hover {
                            background-color: #1d7a59 !important;
                            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
                        }
                        .btn-publicar i {
                            color: #ffffff !important;
                        }
                    </style>
                }
            </ul>
        </div>
    </header>

    <main role="main" class="pt-36 md:pt-40">
        @RenderBody()
    </main>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Menú de navegación principal
            const menuToggle = document.getElementById('menu-toggle');
            const menuContainer = document.getElementById('menu-container');

            function resetMenuOnResize() {
                if (window.innerWidth >= 1024) {
                    menuContainer.classList.remove('hidden');
                } else {
                    menuContainer.classList.add('hidden');
                }
            }

            if (menuToggle && menuContainer) {
                menuToggle.addEventListener('click', () => {
                    menuContainer.classList.toggle('hidden');
                });
                window.addEventListener('resize', resetMenuOnResize);
                resetMenuOnResize();
            }

            // Menú de administración
            const adminMenuToggle = document.getElementById('admin-menu-toggle');
            const adminMenu = document.getElementById('admin-menu');

            function resetAdminMenuOnResize() {
                if (window.innerWidth >= 1024) {
                    adminMenu.classList.remove('hidden');
                } else {
                    adminMenu.classList.add('hidden');
                }
            }

            if (adminMenuToggle && adminMenu) {
                adminMenuToggle.addEventListener('click', () => {
                    adminMenu.classList.toggle('hidden');
                });
                window.addEventListener('resize', resetAdminMenuOnResize);
                resetAdminMenuOnResize();
            }
        });


        document.addEventListener("DOMContentLoaded", function () {
            const adminMenu = document.getElementById('admin-menu');
            const adminMenuToggle = document.getElementById('admin-menu-toggle');

            function resetAdminMenuOnResize() {
                if (window.innerWidth >= 1024) {
                    adminMenu.classList.remove('hidden');
                    adminMenu.style.position = '';
                    adminMenu.style.top = '';
                    adminMenu.style.left = '';
                    adminMenu.style.width = '';
                } else {
                    adminMenu.classList.add('hidden');
                }
            }

            window.addEventListener('resize', resetAdminMenuOnResize);
            resetAdminMenuOnResize();
        });

        document.addEventListener("DOMContentLoaded", function () {
            const userBtn = document.getElementById("user-btn");
            const userMenu = document.getElementById("user-menu");

            if (userBtn && userMenu) {
                userBtn.addEventListener("click", function (e) {
                    e.stopPropagation();
                    userMenu.classList.toggle("hidden");
                });

                // Cierra el menú si se hace clic fuera
                document.addEventListener("click", function (e) {
                    if (!userMenu.classList.contains("hidden")) {
                        if (!userMenu.contains(e.target) && e.target !== userBtn) {
                            userMenu.classList.add("hidden");
                        }
                    }
                });
            }
        });

        // =============================================
        // AUTOCOMPLETADO DEL BUSCADOR
        // =============================================
        (function() {
            const searchInput = document.getElementById('search-input-md');
            const suggestionsContainer = document.getElementById('search-suggestions');
            const suggestionsContent = document.getElementById('suggestions-content');
            const suggestionsLoader = document.getElementById('suggestions-loader');
            const searchForm = document.getElementById('search-form-md');

            if (!searchInput || !suggestionsContainer) return;

            let debounceTimer;
            let currentQuery = '';
            let selectedIndex = -1;

            // Debounce de 300ms
            function debounce(func, wait) {
                return function(...args) {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => func.apply(this, args), wait);
                };
            }

            // Buscar sugerencias
            async function fetchSugerencias(query) {
                if (query.length < 2) {
                    hideSugerencias();
                    return;
                }

                currentQuery = query;
                suggestionsLoader.classList.remove('hidden');
                suggestionsContent.innerHTML = '';
                suggestionsContainer.classList.remove('hidden');

                try {
                    const response = await fetch(`/Buscador/Sugerencias?query=${encodeURIComponent(query)}`);
                    const data = await response.json();

                    // Verificar que la query no haya cambiado mientras se cargaba
                    if (query !== currentQuery) return;

                    suggestionsLoader.classList.add('hidden');
                    renderSugerencias(data, query);
                } catch (error) {
                    console.error('Error fetching sugerencias:', error);
                    suggestionsLoader.classList.add('hidden');
                    hideSugerencias();
                }
            }

            // Renderizar sugerencias
            function renderSugerencias(data, query) {
                const { locales, productos, ofertas, totalResultados } = data;

                if (totalResultados === 0) {
                    suggestionsContent.innerHTML = `
                        <div class="p-4 text-center text-gray-500">
                            <i class="fas fa-search text-2xl mb-2 opacity-50"></i>
                            <p class="text-sm">No se encontraron resultados para "<strong>${escapeHtml(query)}</strong>"</p>
                        </div>
                    `;
                    return;
                }

                let html = '';

                // Locales
                if (locales && locales.length > 0) {
                    html += `
                        <div class="px-3 py-2 bg-gray-50 border-b border-gray-100">
                            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                <i class="fas fa-store mr-1 text-[#23916A]"></i>Locales
                            </span>
                        </div>
                    `;
                    locales.forEach(local => {
                        html += `
                            <a href="/Negocios/ConsultarProductos?idLocal=${local.id}"
                               class="suggestion-item flex items-center gap-3 px-4 py-3 hover:bg-[#23916A]/5 transition-colors cursor-pointer border-b border-gray-50"
                               data-track-local="${local.id}">
                                <img src="${local.imagen}" alt="${escapeHtml(local.nombre)}"
                                     class="w-10 h-10 rounded-lg object-cover bg-gray-100 flex-shrink-0"
                                     onerror="this.src='/images/default-local.png'">
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-900 truncate">${highlightMatch(local.nombre, query)}</p>
                                    <p class="text-xs text-gray-500 truncate">${escapeHtml(local.direccion || '')}</p>
                                </div>
                                <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                            </a>
                        `;
                    });
                }

                // Productos
                if (productos && productos.length > 0) {
                    html += `
                        <div class="px-3 py-2 bg-gray-50 border-b border-gray-100">
                            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                <i class="fas fa-box mr-1 text-[#F66623]"></i>Productos
                            </span>
                        </div>
                    `;
                    productos.forEach(producto => {
                        html += `
                            <a href="/Negocios/ConsultarProductos?idLocal=${producto.idLocal}"
                               class="suggestion-item flex items-center gap-3 px-4 py-3 hover:bg-[#F66623]/5 transition-colors cursor-pointer border-b border-gray-50"
                               data-track-local="${producto.idLocal}">
                                <img src="${producto.imagen || producto.imagenLocal}" alt="${escapeHtml(producto.nombre)}"
                                     class="w-10 h-10 rounded-lg object-cover bg-gray-100 flex-shrink-0"
                                     onerror="this.src='/images/default-product.png'">
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-900 truncate">${highlightMatch(producto.nombre, query)}</p>
                                    <p class="text-xs text-gray-500 truncate">
                                        <span class="font-semibold text-[#23916A]">$${formatPrice(producto.precio)}</span>
                                        <span class="mx-1">•</span>
                                        ${escapeHtml(producto.nombreLocal)}
                                    </p>
                                </div>
                                <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                            </a>
                        `;
                    });
                }

                // Ofertas Flash
                if (ofertas && ofertas.length > 0) {
                    html += `
                        <div class="px-3 py-2 bg-gray-50 border-b border-gray-100">
                            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                <i class="fas fa-bolt mr-1 text-yellow-500"></i>Ofertas Flash
                            </span>
                        </div>
                    `;
                    ofertas.forEach(oferta => {
                        html += `
                            <a href="/Negocios/ConsultarProductos?idLocal=${oferta.idLocal}"
                               class="suggestion-item flex items-center gap-3 px-4 py-3 hover:bg-yellow-50 transition-colors cursor-pointer border-b border-gray-50"
                               data-track-local="${oferta.idLocal}">
                                <img src="${oferta.imagen || oferta.imagenLocal}" alt="${escapeHtml(oferta.titulo)}"
                                     class="w-10 h-10 rounded-lg object-cover bg-gray-100 flex-shrink-0"
                                     onerror="this.src='/images/default-offer.png'">
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-900 truncate">${highlightMatch(oferta.titulo || oferta.producto, query)}</p>
                                    <p class="text-xs text-gray-500 truncate">
                                        <span class="text-yellow-600 font-medium"><i class="fas fa-clock mr-1"></i>Oferta</span>
                                        <span class="mx-1">•</span>
                                        ${escapeHtml(oferta.nombreLocal)}
                                    </p>
                                </div>
                                <i class="fas fa-chevron-right text-gray-300 text-xs"></i>
                            </a>
                        `;
                    });
                }

                // Ver todos los resultados
                html += `
                    <a href="/Buscador?query=${encodeURIComponent(query)}"
                       class="suggestion-item flex items-center justify-center gap-2 px-4 py-3 bg-[#23916A]/5 hover:bg-[#23916A]/10 transition-colors cursor-pointer text-[#23916A] font-medium">
                        <i class="fas fa-search"></i>
                        Ver todos los resultados para "${escapeHtml(query)}"
                    </a>
                `;

                suggestionsContent.innerHTML = html;
                selectedIndex = -1;
            }

            // Ocultar sugerencias
            function hideSugerencias() {
                suggestionsContainer.classList.add('hidden');
                selectedIndex = -1;
            }

            // Escapar HTML
            function escapeHtml(text) {
                if (!text) return '';
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            // Resaltar coincidencias
            function highlightMatch(text, query) {
                if (!text || !query) return escapeHtml(text);
                const escaped = escapeHtml(text);
                const regex = new RegExp(`(${escapeHtml(query)})`, 'gi');
                return escaped.replace(regex, '<mark class="bg-yellow-200 rounded px-0.5">$1</mark>');
            }

            // Formatear precio
            function formatPrice(price) {
                if (!price) return '0';
                return parseInt(price).toLocaleString('es-CO');
            }

            // Event: Input con debounce
            searchInput.addEventListener('input', debounce(function(e) {
                fetchSugerencias(e.target.value.trim());
            }, 300));

            // Event: Focus - mostrar sugerencias si hay texto
            searchInput.addEventListener('focus', function() {
                if (this.value.trim().length >= 2 && suggestionsContent.innerHTML) {
                    suggestionsContainer.classList.remove('hidden');
                }
            });

            // Event: Click fuera - ocultar sugerencias
            document.addEventListener('click', function(e) {
                if (!suggestionsContainer.contains(e.target) && e.target !== searchInput) {
                    hideSugerencias();
                }
            });

            // Event: Teclado - navegación
            searchInput.addEventListener('keydown', function(e) {
                const items = suggestionsContent.querySelectorAll('.suggestion-item');

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
                    updateSelection(items);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    selectedIndex = Math.max(selectedIndex - 1, -1);
                    updateSelection(items);
                } else if (e.key === 'Enter' && selectedIndex >= 0) {
                    e.preventDefault();
                    items[selectedIndex].click();
                } else if (e.key === 'Escape') {
                    hideSugerencias();
                }
            });

            // Actualizar selección visual
            function updateSelection(items) {
                items.forEach((item, index) => {
                    if (index === selectedIndex) {
                        item.classList.add('bg-gray-100');
                        item.scrollIntoView({ block: 'nearest' });
                    } else {
                        item.classList.remove('bg-gray-100');
                    }
                });
            }

            // Trackear clic en sugerencia para analíticas
            function trackSugerenciaClic(idLocal) {
                if (!idLocal) return;
                fetch('/Buscador/RegistrarClicSugerencia', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ idLocal: parseInt(idLocal) })
                }).catch(err => console.error('Error tracking sugerencia:', err));
            }

            // Event: Clic en sugerencia - trackear analítica
            suggestionsContent.addEventListener('click', function(e) {
                const item = e.target.closest('[data-track-local]');
                if (item) {
                    trackSugerenciaClic(item.dataset.trackLocal);
                }
            });
        })();
    </script>
    @await Html.PartialAsync("_Footer")

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>

<style>
    html,
    body {
        height: 100%;
        margin: 0;
    }

    body {
        display: flex;
        flex-direction: column;
    }

    main {
        flex: 1;
    }

    footer {
        margin-top: auto;
    }
</style>