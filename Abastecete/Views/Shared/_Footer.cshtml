        </div>

        <div class="flex flex-col space-y-2 md:gap-y-6 md:col-start-2 md:row-start-2 h-full">
            <h2 class="text-lg font-semibold">No te pierdas ninguna <span class="text-green-400">Oferta</span>
            </h2>

            <div class="flex w-full">
                <input type="email" class="flex-grow rounded-l-lg bg-gray-800 p-3 text-white" placeholder="Tu correo">
                <a class="rounded-r-lg bg-orange-500 px-4 pt-3" href="@Url.Action("Login", "Login")">Suscribete</a>
