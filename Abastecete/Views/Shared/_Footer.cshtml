</footer>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("dejanos-tu-resenia");
        const successMsg = document.getElementById("footer-opinion-success");
        const submitBtn = form.querySelector("button[type='submit']");
        const originalBtnText = submitBtn.innerText;

        form.addEventListener("submit", async function (e) {
            e.preventDefault();

            const formData = new FormData(form);

            // 🔒 Bloquear botón y mostrar "Enviando..."
            submitBtn.disabled = true;
            submitBtn.innerText = "Enviando...";

            try {
                const response = await fetch("/api/contact/opinion", {
                    method: "POST",
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    successMsg.classList.remove("hidden");
                    form.reset();
                } else {
                    alert("Error al enviar tu opinión.");
                }
            } catch (err) {
                alert("Hubo un error al procesar tu solicitud.");
            } finally {
                // ✅ Rehabilitar el botón y restaurar texto
                submitBtn.disabled = false;
                submitBtn.innerText = originalBtnText;
            }
        });
    });
</script>
