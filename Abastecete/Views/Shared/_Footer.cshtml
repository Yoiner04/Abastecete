                </li>
                <li>
                    <a href="#promociones-container" class="flex items-center text-green-400 hover:underline">
                        <span class="mr-2">➤</span> Promociones
                    </a>
                </li>
                <li>
                    <a href="#categorias-container"
                        class="flex items-center text-green-400 hover:underline scroll-smooth">
                        <span class="mr-2">➤</span> Categorías
                    </a>
                </li>
            </ul>

            <div class="grid grid-rows-3 gap-3">
                <a href="https://web.facebook.com/people/Websen/61571549591292/" target="_blank"
                    rel="noopener noreferrer" class="rounded-lg bg-green-600 px-4 py-2 text-center">FACEBOOK</a>
                <a href="https://www.instagram.com/websencol/#" target="_blank" rel="noopener noreferrer"
                    class="rounded-lg bg-orange-500 px-4 py-2 text-center">INSTAGRAM</a>
                <a href="https://www.linkedin.com/in/websen-col-99459733b/" target="_blank" rel="noopener noreferrer"
                    class="rounded-lg bg-gray-700 px-4 py-2 text-center">LINKEDIN</a>
