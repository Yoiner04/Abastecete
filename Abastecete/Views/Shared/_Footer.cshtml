                <input type="text" name="nombre" placeholder="Tu nombre completo"
                    class="col-span-2 rounded-lg bg-gray-800 py-2 px-3 text-white placeholder-gray-400" required />
                <input type="email" name="correo" placeholder="Tu correo electrónico"
                    class="rounded-lg bg-gray-800 py-2 px-3 text-white placeholder-gray-400" required />
                <input type="tel" name="telefono" placeholder="Tu número de teléfono"
                    class="rounded-lg bg-gray-800 py-2 px-3 text-white placeholder-gray-400" required />
                <textarea name="mensaje" placeholder="Tu opinión aquí" rows="2"
                    class="col-span-2 rounded-lg bg-gray-800 p-3 text-white placeholder-gray-400" required></textarea>
                <button type="submit"
                    class="col-span-2 w-full rounded-lg bg-green-600 py-2 font-semibold text-white hover:bg-green-700 transition">
