<div id="bannerProveedoresModal" class="fixed inset-0 z-50 flex hidden items-center justify-center bg-black bg-opacity-50">
    <div id="bannerProveedoresModalContent" class="w-full max-w-3xl max-h-[90vh] overflow-y-auto rounded-lg bg-white p-4 md:p-6">
        <h2 class="mb-4 text-center text-xl font-bold">Editar Banner de Proveedores</h2>

        <form id="uploadBannerProveedoresForm" enctype="multipart/form-data" class="space-y-4">
            <div class="flex flex-col gap-3">
                <img src="/images/banner_proveedores.webp?t=@DateTime.Now.Ticks"
                     alt="Banner Proveedores"
                     class="w-full h-auto rounded-lg object-cover shadow">
                <input type="file" id="proveedoresImage" name="proveedoresImage" accept="image/*" class="w-full text-sm">
            </div>

            <div class="mt-4 flex flex-col sm:flex-row justify-center gap-4">
                <button type="submit"
                        class="rounded bg-blue-500 px-4 py-2 text-white hover:bg-blue-600 transition">
                    Subir Imagen
                </button>
                <button type="button" onclick="cerrarBannerProveedoresModal()"
                        class="rounded bg-gray-500 px-4 py-2 text-white hover:bg-gray-600 transition">
                    Cerrar
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function abrirBannerProveedoresModal() {
        document.getElementById("bannerProveedoresModal").classList.remove("hidden");
        document.body.classList.add("overflow-hidden");
    }

    function cerrarBannerProveedoresModal() {
        document.getElementById("bannerProveedoresModal").classList.add("hidden");
        document.body.classList.remove("overflow-hidden");
    }

    document.getElementById("bannerProveedoresModal").addEventListener("click", function (event) {
        if (!document.getElementById("bannerProveedoresModalContent").contains(event.target)) {
            cerrarBannerProveedoresModal();
        }
    });

    document.getElementById("uploadBannerProveedoresForm").addEventListener("submit", function (event) {
        event.preventDefault();
        let formData = new FormData();
        let file = document.getElementById("proveedoresImage").files[0];

        if (!file) {
            alert("Selecciona una imagen antes de subir.");
            return;
        }

        formData.append("proveedoresImage", file);

        fetch("/Banners/SubirImagenProveedor", {
            method: "POST",
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                alert(data.mensaje);
                cerrarBannerProveedoresModal();
                location.reload();
            })
            .catch(error => console.error("Error:", error));
    });
</script>
