<!-- CategoryBannerModal.cshtml -->
<div id="categoryBannerModal" class="hidden fixed inset-0 z-50 bg-black bg-opacity-50 flex justify-center items-center px-4 py-8">
    <div class="bg-white p-6 rounded-lg w-full max-w-5xl shadow-lg max-h-[90vh] overflow-y-auto md:overflow-visible md:max-h-full">
        <h2 class="text-xl font-bold mb-4 text-center text-gray-800">Actualizar Banners de Categoría</h2>
        <form id="uploadCategoryBannerForm" enctype="multipart/form-data" class="flex flex-col gap-4">
            <!-- Selector de categoría -->
            <label for="categorySelect" class="text-sm font-medium">Seleccionar Categoría</label>
            <select id="categorySelect" name="nombreCategoria" class="border p-2 rounded w-full">
                @foreach (var categoria in Model)
                {
                    <option value="@categoria.Nombre">@categoria.Nombre</option>
                }
            </select>

            <!-- Previsualización de imágenes -->
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                @for (int i = 1; i <= 6; i++)
                {
                    var tipo = i <= 2 ? "Ancha" : "Cuadrada";
                    var rutaBase = "/images/default.webp";

                    <div class="flex flex-col items-center border p-3 rounded-lg shadow-md">
                        <label class="text-sm font-medium mb-2">Imagen @tipo @((i <= 2) ? i : i - 2)</label>
                        <img id="previewBanner@(i)" src="@rutaBase" alt="Banner @i" class="w-full h-28 object-cover rounded-lg mb-2">
                        <input type="file" id="bannerImage@(i)" name="imagen@(i)" accept="image/*" class="text-xs w-full">
                    </div>
                }
            </div>

            <!-- Botones -->
            <div class="mt-4 flex flex-col sm:flex-row justify-center gap-4">
                <button type="submit"
                        class="bg-green-600 text-white font-medium rounded-lg shadow-md transition-all duration-300 ease-in-out
                        hover:bg-green-700 focus:ring focus:ring-green-300
                        px-6 py-3">
                    Subir Imágenes
                </button>

                <button type="button" onclick="cerrarCategoryBannerModal()" class="bg-gray-500 text-white px-6 py-3 rounded-lg shadow-md hover:bg-gray-600">
                    Cerrar
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function abrirCategoryBannerModal() {
        document.getElementById("categoryBannerModal").classList.remove("hidden");
        document.body.classList.add("overflow-hidden");
        actualizarPrevisualizaciones();
    }

    function cerrarCategoryBannerModal() {
        document.getElementById("categoryBannerModal").classList.add("hidden");
        document.body.classList.remove("overflow-hidden");
    }

    document.getElementById("categoryBannerModal").addEventListener("click", function (event) {
        if (event.target === this) {
            cerrarCategoryBannerModal();
        }
    });

    document.getElementById("categorySelect").addEventListener("change", actualizarPrevisualizaciones);

    function actualizarPrevisualizaciones() {
        let categoria = document.getElementById("categorySelect").value;
        for (let i = 1; i <= 6; i++) {
            let imgElement = document.getElementById("previewBanner" + i);
            imgElement.src = `/images/${categoria}/banner${i}.webp`;
            imgElement.onerror = function () {
                this.src = "/images/default.webp";
            };
        }
    }

    document.getElementById("uploadCategoryBannerForm").addEventListener("submit", function (event) {
        event.preventDefault();
        let formData = new FormData(this);

        let nombreCategoria = document.getElementById("categorySelect").value;
        formData.set("nombreCategoria", nombreCategoria);

        fetch("/Banners/SubirImagenesCategoria", {
            method: "POST",
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                alert(data.mensaje);
                cerrarCategoryBannerModal();
                location.reload();
            })
            .catch(error => console.error("Error:", error));
    });
</script>
