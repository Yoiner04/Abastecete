<div id="bannerModal" class="fixed inset-0 z-50 flex hidden items-center justify-center bg-black bg-opacity-50">
    <div id="bannerModalContent" class="w-full max-w-2xl max-h-[90vh] overflow-y-auto rounded-lg bg-white p-4 md:p-6">
        <h2 class="mb-4 text-center text-xl font-bold">Editar Banners</h2>

        <form id="uploadBannerForm" enctype="multipart/form-data" class="space-y-6">
            <!-- Carrusel -->
            <div>
                <h3 class="mb-2 text-lg font-semibold">Carrusel</h3>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
                    <div class="flex flex-col gap-2">
                        <img src="/images/carrusel1.webp?t=@DateTime.Now.Ticks" alt="Carrusel 1"
                             class="h-32 w-full rounded-lg object-cover shadow">
                        <input type="file" id="carouselImage1" name="carouselImage1" accept="image/*" class="text-xs">
                    </div>
                    <div class="flex flex-col gap-2">
                        <img src="/images/carrusel2.webp?t=@DateTime.Now.Ticks" alt="Carrusel 2"
                             class="h-32 w-full rounded-lg object-cover shadow">
                        <input type="file" id="carouselImage2" name="carouselImage2" accept="image/*" class="text-xs">
                    </div>
                    <div class="flex flex-col gap-2">
                        <img src="/images/carrusel3.webp?t=@DateTime.Now.Ticks" alt="Carrusel 3"
                             class="h-32 w-full rounded-lg object-cover shadow">
                        <input type="file" id="carouselImage3" name="carouselImage3" accept="image/*" class="text-xs">
                    </div>
                </div>
            </div>

            <!-- Laterales -->
            <div>
                <h3 class="mb-2 text-lg font-semibold">Laterales</h3>
                <div class="grid grid-cols-2 gap-4">
                    <div class="flex flex-col gap-2">
                        <img src="/images/lateral1.webp?t=@DateTime.Now.Ticks" alt="Lateral 1"
                             class="h-32 w-full rounded-lg object-cover shadow">
                        <input type="file" id="sideImage1" name="sideImage1" accept="image/*" class="text-xs">
                    </div>
                    <div class="flex flex-col gap-2">
                        <img src="/images/lateral2.webp?t=@DateTime.Now.Ticks" alt="Lateral 2"
                             class="h-32 w-full rounded-lg object-cover shadow">
                        <input type="file" id="sideImage2" name="sideImage2" accept="image/*" class="text-xs">
                    </div>
                </div>
            </div>

            <!-- Botones -->
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <button type="submit"
                        class="rounded bg-blue-500 px-4 py-2 text-white hover:bg-blue-600 transition">
                    Subir Imágenes
                </button>
                <button type="button" onclick="cerrarBannerModal()"
                        class="rounded bg-gray-500 px-4 py-2 text-white hover:bg-gray-600 transition">
                    Cerrar
                </button>
            </div>
        </form>
    </div>
</div>


<script>
    function abrirBannerModal() {
        document.body.classList.add("overflow-hidden");
        document.getElementById("bannerModal").classList.remove("hidden");
    }

    function cerrarBannerModal() {
        document.body.classList.remove("overflow-hidden");
        document.getElementById("bannerModal").classList.add("hidden");
    }

    document.getElementById("bannerModal").addEventListener("click", function (event) {
        if (!document.getElementById("bannerModalContent").contains(event.target)) {
            cerrarBannerModal();
        }
    });

    document.getElementById("uploadBannerForm").addEventListener("submit", function (event) {
        event.preventDefault();
        let formData = new FormData();
        let inputs = ["carouselImage1", "carouselImage2", "carouselImage3", "sideImage1", "sideImage2"];
        let hasFile = false;

        inputs.forEach(id => {
            let file = document.getElementById(id).files[0];
            if (file) {
                formData.append(id, file);
                hasFile = true;
            }
        });

        if (!hasFile) {
            alert("Selecciona al menos una imagen antes de subir.");
            return;
        }

        fetch("/Banners/SubirImagenes", {
            method: "POST",
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                alert(data.mensaje);
                cerrarBannerModal();
                location.reload();
            })
            .catch(error => console.error("Error:", error));
    });
</script>
