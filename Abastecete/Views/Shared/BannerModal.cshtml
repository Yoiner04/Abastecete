
<div id="bannerModal" class="bg-opacity-50 fixed inset-0 z-50 flex hidden items-center justify-center bg-black px-4 py-8">
    <div id="bannerModalContent" class="max-h-[90vh] w-full max-w-6xl overflow-y-auto rounded-2xl border border-gray-200 bg-white p-6 shadow-xl">
        <h2 class="mb-6 text-center text-2xl font-bold text-gray-800">Gestionar Banners de Inicio</h2>

        <!-- Galería dinámica -->
        <div class="mb-10 grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3" id="galeriaInicio">
            <!-- Render dinámico aquí -->
        </div>

        <!-- Subida de nuevo banner -->
        <form id="formNuevoBannerInicio" class="flex flex-col gap-4 border-t pt-6">
            <label class="text-lg font-semibold text-gray-700">Agregar nuevo banner</label>

            <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
                <select id="formatoBanner" class="w-full rounded border border-gray-300 px-4 py-2 text-sm text-gray-700 sm:w-1/3">
                    <option value="16:9">📺 Formato Horizontal (16:9)</option>
                    <option value="1:1">🔲 Formato Cuadrado (1:1)</option>
                </select>

                <input type="file" id="nuevoBannerInicio" accept="image/*"
                       class="w-full text-sm text-gray-700 file:mr-4 file:rounded-lg file:border-0 file:bg-green-50 file:px-4 file:py-2 file:text-green-700 hover:file:bg-green-100" />
            </div>

            <div class="flex flex-col justify-center gap-4 pt-4 sm:flex-row">
                <button type="submit"
                        class="w-full rounded-lg bg-green-600 px-6 py-2 font-semibold text-white transition hover:bg-green-700 sm:w-auto">
                    Subir Imagen
                </button>
                <button type="button" onclick="cerrarBannerModal()"
                        class="w-full rounded-lg bg-gray-500 px-6 py-2 font-semibold text-white transition hover:bg-gray-600 sm:w-auto">
                    Cerrar
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    let bannersInicio = [];

    function abrirBannerModal() {
        document.getElementById("bannerModal").classList.remove("hidden");
        document.body.classList.add("overflow-hidden");
        cargarBannersInicio();
    }

    function cerrarBannerModal() {
        document.getElementById("bannerModal").classList.add("hidden");
        document.body.classList.remove("overflow-hidden");
    }

    document.getElementById("bannerModal").addEventListener("click", function (event) {
        if (!document.getElementById("bannerModalContent").contains(event.target)) {
            cerrarBannerModal();
        }
    });

    document.getElementById("formNuevoBannerInicio").addEventListener("submit", function (e) {
        e.preventDefault();
        const file = document.getElementById("nuevoBannerInicio").files[0];
        const formato = document.getElementById("formatoBanner").value;

        if (!file) {
            alert("⚠️ Selecciona una imagen antes de subir.");
            return;
        }

        if (formato === "1:1") {
            const cuadradas = document.querySelectorAll(`#galeriaInicio img[data-formato='1:1']`).length;
            console.log(cuadradas);
            if (cuadradas == 2) {
                alert("⚠️ Solo puedes subir hasta 2 banners cuadrados (1:1).");
                return;
            }
        }

        const formData = new FormData();
        formData.append("imagen", file);
        formData.append("formato", formato);

        fetch("/Banners/AgregarBannerInicio", {
            method: "POST",
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            alert(data.mensaje);
            document.getElementById("nuevoBannerInicio").value = "";
            cargarBannersInicio();
        })
        .catch(() => alert("❌ Error al subir imagen."));
    });

    // Cargar y mostrar banners existentes
    function cargarBannersInicio() {
        fetch("/Banners/ListarBannersInicio")
            .then(res => res.json())
            .then(banners => {
                bannersInicio = banners;
                const galeria = document.getElementById("galeriaInicio");
                galeria.innerHTML = "";

                if (!banners.length) {
                    galeria.innerHTML = '<p class="col-span-full text-center text-gray-600">No hay banners aún.</p>';
                    return;
                }
                console.log(banners);   

                banners.forEach(b => {
                    galeria.innerHTML += `
                        <div class="flex flex-col items-center gap-2 rounded-lg border p-4 shadow">
                            <img src="${b.base64}" alt="${b.nombre}"  data-formato="${b.tipo}" class="h-32 w-full rounded bg-gray-100 object-contain" />
                            <div class="text-xs text-gray-500">${b.tipo === "1:1" ? "Formato: Cuadrado" : "Formato: Horizontal"}</div>
                            <div class="mt-2 flex gap-2">
                                <button onclick="reemplazarBannerInicio('${b.id}')" class="rounded bg-blue-500 px-3 py-1 text-sm text-white hover:bg-blue-600">Reemplazar</button>
                                <button onclick="eliminarBannerInicio('${b.id}')" class="rounded bg-red-500 px-3 py-1 text-sm text-white hover:bg-red-600">Eliminar</button>
                            </div>
                        </div>`;
                });
            })
            .catch(() => alert("❌ Error al cargar los banners."));
    }

    // Reemplazar imagen
    function reemplazarBannerInicio(id) {
        const input = document.createElement("input");
        input.type = "file";
        input.accept = "image/*";
        input.onchange = () => {
            const file = input.files[0];
            if (file) {
                const formData = new FormData();
                formData.append("id", id);
                formData.append("imagen", file);

                fetch("/Banners/ReemplazarBannerInicio", {
                    method: "POST",
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    alert(data.mensaje);
                    cargarBannersInicio();
                })
                .catch(() => alert("❌ Error al reemplazar banner."));
            }
        };
        input.click();
    }

    // Eliminar imagen
    function eliminarBannerInicio(id) {
        if (confirm("¿Estás seguro de eliminar este banner?")) {
            fetch(`/Banners/EliminarBannerInicio?id=${id}`, {
                method: "DELETE"
            })
            .then(res => res.json())
            .then(data => {
                alert(data.mensaje);
                cargarBannersInicio();
            })
            .catch(() => alert("❌ Error al eliminar banner."));
        }
    }
</script>
