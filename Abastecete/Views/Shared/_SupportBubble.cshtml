@{
    // Ocultar burbuja de soporte en la página del local (tiene su propio botón de WhatsApp)
    var ocultarEnLocal = Context.Request.Path.ToString().Contains("/Negocios/ConsultarProductos");
}
@if (!ocultarEnLocal)
{
<!-- Burbuja de soporte -->
<div id="support-bubble" class="fixed right-4 bottom-4 z-50 flex flex-col items-center space-y-2">
    <!-- Redes Sociales (ocultas por defecto) -->
    <div id="social-links" class="mb-2 flex hidden flex-col items-end space-y-3">
        <a href="https://wa.me/573204276025" target="_blank"
           class="group social-btn relative flex h-11 w-11 items-center justify-center rounded-full bg-green-500 text-white shadow-lg transition-all duration-300 hover:scale-110">
            <span class="tooltip">WhatsApp</span>
            <box-icon type='logo' name='whatsapp' color="white" size="md"></box-icon>
        </a>
        <a href="https://www.facebook.com/profile.php?id=61571549591292" target="_blank"
           class="group social-btn relative flex h-11 w-11 items-center justify-center rounded-full bg-blue-600 text-white shadow-lg transition-all duration-300 hover:scale-110">
            <span class="tooltip">Facebook</span>
            <box-icon type='logo' name='facebook' color="white" size="md"></box-icon>
        </a>
        <a href="https://www.instagram.com/websencol" target="_blank"
           class="group social-btn relative flex h-11 w-11 items-center justify-center rounded-full bg-pink-500 text-white shadow-lg transition-all duration-300 hover:scale-110">
            <span class="tooltip">Instagram</span>
            <box-icon type='logo' name='instagram' color="white" size="md"></box-icon>
        </a>
        <a href="https://www.tiktok.com/@@websencol" target="_blank"
           class="group social-btn relative flex h-11 w-11 items-center justify-center rounded-full bg-black text-white shadow-lg transition-all duration-300 hover:scale-110">
            <span class="tooltip">TikTok</span>
            <box-icon type='logo' name='tiktok' color="white" size="md"></box-icon>
        </a>
        <a href="https://www.youtube.com/@@WEBSENCOL" target="_blank"
           class="group social-btn relative flex h-11 w-11 items-center justify-center rounded-full bg-red-600 text-white shadow-lg transition-all duration-300 hover:scale-110">
            <span class="tooltip">YouTube</span>
            <box-icon type='logo' name='youtube' color="white" size="md"></box-icon>
        </a>
        <a href="https://www.linkedin.com/in/websen-col-99459733b/" target="_blank"
           class="group social-btn relative flex h-11 w-11 items-center justify-center rounded-full bg-blue-700 text-white shadow-lg transition-all duration-300 hover:scale-110">
            <span class="tooltip">LinkedIn</span>
            <box-icon type='logo' name='linkedin' color="white" size="md"></box-icon>
        </a>
    </div>

    <!-- Botón de Soporte con Tooltip a la Izquierda -->
    <button id="open-support-chat"
            class="group relative flex h-16 w-16 items-center justify-center rounded-full bg-black text-white shadow-lg transition-transform duration-200 hover:scale-110">
        <span class="support-tooltip">Contáctanos a través de nuestras redes</span>
        <box-icon name='support' flip='horizontal' color="white" size="lg"></box-icon>
    </button>

</div>

<!-- Estilos con Tailwind -->
<style>
    .tooltip {
        position: absolute;
        right: 100%;
        margin-right: 10px;
        background-color: rgba(0, 0, 0, 0.8);
        color: white;
        font-size: 14px;
        padding: 6px 10px;
        border-radius: 5px;
        white-space: nowrap;
        opacity: 0;
        transform: translateX(10px);
        transition: opacity 0.3s ease, transform 0.3s ease;
        visibility: hidden;
    }

    .group:hover .tooltip {
        opacity: 1;
        transform: translateX(0);
        visibility: visible;
    }

    .social-btn {
        box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.7);
        transition: box-shadow 0.3s ease-in-out;
    }

        .social-btn:hover {
            box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.5);
        }

    #open-support-chat {
        background: linear-gradient(135deg, #ff7e5f, #feb47b);
        box-shadow: 0 0 15px rgba(255, 126, 95, 0.7);
        animation: glow-animation 1.5s infinite alternate;
    }

    @@keyframes glow-animation {
        0% {
            box-shadow: 0 0 10px rgba(255, 126, 95, 0.7);
        }

        100% {
            box-shadow: 0 0 20px rgba(255, 126, 95, 1);
        }
    }

    .support-tooltip {
        position: absolute;
        right: 100%;
        margin-right: 10px;
        background-color: rgba(0, 0, 0, 0.8);
        color: white;
        font-size: 14px;
        padding: 6px 12px;
        border-radius: 5px;
        white-space: nowrap;
        opacity: 0;
        transform: translateX(10px);
        transition: opacity 0.3s ease, transform 0.3s ease;
        visibility: hidden;
        z-index: 10;
    }

    .group:hover .support-tooltip {
        opacity: 1;
        transform: translateX(0);
        visibility: visible;
    }
</style>

<!-- Script para desplegar redes sociales -->
<script>
    document.getElementById("open-support-chat")?.addEventListener("click", function () {
        document.getElementById("social-links").classList.toggle("hidden");
    });
</script>
}