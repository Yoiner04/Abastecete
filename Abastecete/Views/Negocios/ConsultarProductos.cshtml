@model List<BusinessLogic.Models.Producto>
@{
    var negocio = ViewBag.negocio as BusinessLogic.Models.Negocio;
    var productCount = Model?.Count ?? 0;
    var categoryCount = ViewBag.categorias?.Count ?? 0;

    ViewData["Title"] = $"{negocio?.Nombre} - Productos en Abastécete";
    ViewData["Description"] = $"Descubre {productCount} productos de {negocio?.Nombre}. {negocio?.Descripcion ?? "Tu proveedor de confianza en Abastécete"}";
}
@Html.Partial("_ContactModal")
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["Description"]">
    <meta name="keywords" content="@negocio?.Nombre, productos, @(categoryCount) categorías, proveedor, Abastécete">
    <meta property="og:title" content="@ViewData["Title"]">
    <meta property="og:description" content="@ViewData["Description"]">
    <meta property="og:type" content="website">
    @if (!string.IsNullOrWhiteSpace(negocio?.imagen?.Base64))
    {
        <meta property="og:image" content="@negocio.imagen.Base64">
    }
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@ViewData["Title"]">
    <meta name="twitter:description" content="@ViewData["Description"]">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        /* Animaciones personalizadas */
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes pulse-soft {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.02); }
        }

        @@keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        /* Skeleton loader animation */
        @@keyframes skeleton-pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .animate-pulse {
            animation: skeleton-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        .animate-fadeInUp {
            animation: fadeInUp 0.5s ease-out forwards;
        }

        .animation-delay-100 { animation-delay: 0.1s; }
        .animation-delay-200 { animation-delay: 0.2s; }
        .animation-delay-300 { animation-delay: 0.3s; }

        /* Glassmorphism */
        .glass {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .glass-dark {
            background: rgba(0, 0, 0, 0.3);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

        /* Producto card efectos */
        .producto-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .producto-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
        }

        .producto-card:hover .producto-image {
            transform: scale(1.05);
        }

        .producto-card:hover .producto-overlay {
            opacity: 1;
        }

        .producto-image {
            transition: transform 0.4s ease;
        }

        .producto-overlay {
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        /* Range slider mejorado */
        .range-slider {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 0.5rem;
            -webkit-appearance: none;
            background: transparent;
            pointer-events: auto;
        }

        .range-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 1.25rem;
            width: 1.25rem;
            border-radius: 50%;
            background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
            cursor: pointer;
            z-index: 3;
            position: relative;
            box-shadow: 0 2px 8px rgba(34, 197, 94, 0.4);
            transition: transform 0.2s ease;
        }

        .range-slider::-webkit-slider-thumb:hover {
            transform: scale(1.1);
        }

        .range-slider::-moz-range-thumb {
            height: 1.25rem;
            width: 1.25rem;
            border-radius: 50%;
            background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
            cursor: pointer;
            z-index: 3;
            position: relative;
            border: none;
            box-shadow: 0 2px 8px rgba(34, 197, 94, 0.4);
        }

        #rangeBar {
            top: 0;
            height: 0.5rem;
            z-index: 1;
            border-radius: 0.25rem;
        }

        /* Input de búsqueda */
        .search-input:focus {
            box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
        }

        /* Badge animado */
        .badge-new {
            background: linear-gradient(90deg, #f97316, #fb923c, #f97316);
            background-size: 200% auto;
            animation: shimmer 2s linear infinite;
        }

        /* Filtro activo */
        .filter-active {
            border-color: #22c55e !important;
            background: linear-gradient(to right, rgba(34, 197, 94, 0.05), rgba(34, 197, 94, 0.1));
        }

        /* Scrollbar personalizado */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #22c55e, #16a34a);
            border-radius: 4px;
        }

        /* Floating action */
        .fab {
            transition: all 0.3s ease;
        }

        .fab:hover {
            transform: scale(1.1) rotate(5deg);
        }

        /* Vista Lista */
        #productosContainer.list-view {
            display: flex !important;
            flex-direction: column;
            gap: 1rem;
        }

        #productosContainer.list-view .producto-card {
            flex-direction: row !important;
            max-height: 140px;
        }

        #productosContainer.list-view .producto-imagen {
            width: 140px;
            min-width: 140px;
            aspect-ratio: 1;
        }

        #productosContainer.list-view .producto-imagen img {
            padding: 0.5rem;
        }

        #productosContainer.list-view .producto-info {
            padding: 1rem 1.5rem;
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 1.5rem;
        }

        #productosContainer.list-view .producto-nombre {
            flex: 1;
            margin-bottom: 0;
            font-size: 1rem;
        }

        #productosContainer.list-view .producto-acciones {
            flex-direction: row;
            align-items: center;
            gap: 1.5rem;
            margin-top: 0;
        }

        #productosContainer.list-view .producto-precio {
            font-size: 1.25rem;
            white-space: nowrap;
        }

        #productosContainer.list-view .producto-overlay {
            opacity: 0;
        }

        #productosContainer.list-view .producto-card:hover .producto-overlay {
            opacity: 1;
        }

        @@media (max-width: 640px) {
            #productosContainer.list-view .producto-card {
                max-height: none;
                flex-direction: column !important;
            }
            #productosContainer.list-view .producto-imagen {
                width: 100%;
                height: 120px;
            }
            #productosContainer.list-view .producto-info {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }
        }

        /* Panel expandible */
        .info-panel {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s ease-out, padding 0.3s ease;
        }
        .info-panel.expanded {
            max-height: 800px;
            padding-top: 1.5rem;
            padding-bottom: 1.5rem;
        }
    </style>
</head>

<body class="bg-gradient-to-br from-gray-50 via-white to-gray-100 min-h-screen">
    <!-- SKELETON LOADER -->
    <div id="skeleton-productos" class="animate-pulse">
        <!-- Header Skeleton -->
        <div class="relative w-full overflow-hidden">
            <!-- Banner skeleton -->
            <div class="relative h-64 sm:h-80 lg:h-96 w-full bg-gray-200"></div>

            <!-- Info card skeleton -->
            <div class="relative z-20 -mt-16 container mx-auto px-4 sm:px-6 lg:px-8">
                <div class="bg-white rounded-2xl shadow-xl p-6 sm:p-8 border border-gray-100">
                    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
                        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 flex-1">
                            <!-- Logo skeleton -->
                            <div class="size-32 sm:size-40 lg:size-48 rounded-2xl bg-gray-200"></div>

                            <!-- Text skeleton -->
                            <div class="flex-1 space-y-3 text-center sm:text-left">
                                <div class="h-8 bg-gray-200 rounded w-64 mx-auto sm:mx-0"></div>
                                <div class="h-4 bg-gray-200 rounded w-96 mx-auto sm:mx-0"></div>
                                <div class="flex gap-4 justify-center sm:justify-start mt-4">
                                    <div class="h-4 bg-gray-200 rounded w-24"></div>
                                    <div class="h-4 bg-gray-200 rounded w-24"></div>
                                    <div class="h-4 bg-gray-200 rounded w-24"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Buttons skeleton -->
                        <div class="flex gap-3">
                            <div class="h-12 w-36 bg-gray-200 rounded-xl"></div>
                            <div class="h-12 w-40 bg-gray-200 rounded-xl"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main content skeleton -->
        <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <!-- Search bar skeleton -->
            <div class="mb-8">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 sm:p-6">
                    <div class="flex flex-col sm:flex-row gap-4">
                        <div class="flex-1 h-12 bg-gray-200 rounded-xl"></div>
                        <div class="flex gap-3">
                            <div class="h-12 w-40 bg-gray-200 rounded-xl"></div>
                            <div class="h-12 w-24 bg-gray-200 rounded-xl"></div>
                        </div>
                    </div>
                    <!-- Quick filters skeleton -->
                    <div class="flex flex-wrap gap-2 mt-4">
                        <div class="h-9 w-20 bg-gray-200 rounded-full"></div>
                        <div class="h-9 w-24 bg-gray-200 rounded-full"></div>
                        <div class="h-9 w-28 bg-gray-200 rounded-full"></div>
                        <div class="h-9 w-20 bg-gray-200 rounded-full"></div>
                        <div class="h-9 w-24 bg-gray-200 rounded-full"></div>
                    </div>
                </div>
            </div>

            <div class="flex flex-col lg:flex-row gap-8">
                <!-- Sidebar skeleton -->
                <aside class="w-full lg:w-72 xl:w-80 flex-shrink-0">
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-6">
                        <div class="flex items-center justify-between">
                            <div class="h-6 bg-gray-200 rounded w-24"></div>
                            <div class="h-4 bg-gray-200 rounded w-16"></div>
                        </div>
                        <div class="space-y-3">
                            <div class="h-4 bg-gray-200 rounded w-20"></div>
                            <div class="h-12 bg-gray-200 rounded-xl"></div>
                        </div>
                        <div class="space-y-3">
                            <div class="h-4 bg-gray-200 rounded w-24"></div>
                            <div class="h-12 bg-gray-200 rounded-xl"></div>
                        </div>
                        <div class="space-y-3">
                            <div class="h-4 bg-gray-200 rounded w-28"></div>
                            <div class="h-2 bg-gray-200 rounded-full"></div>
                            <div class="flex justify-between">
                                <div class="h-12 w-20 bg-gray-200 rounded-lg"></div>
                                <div class="h-12 w-20 bg-gray-200 rounded-lg"></div>
                            </div>
                        </div>
                    </div>
                </aside>

                <!-- Products grid skeleton -->
                <section class="flex-1">
                    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
                        @for (int i = 0; i < 6; i++)
                        {
                            <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100">
                                <div class="aspect-square bg-gray-200"></div>
                                <div class="p-5 space-y-3">
                                    <div class="h-6 bg-gray-200 rounded w-3/4"></div>
                                    <div class="h-4 bg-gray-200 rounded w-1/2"></div>
                                    <div class="flex items-center justify-between mt-4">
                                        <div class="h-8 bg-gray-200 rounded w-24"></div>
                                        <div class="h-10 bg-gray-200 rounded-xl w-24"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            </div>
        </main>
    </div>

    <!-- ACTUAL CONTENT -->
    <div id="content-productos" class="hidden">
        <!-- HEADER HERO MODERNIZADO -->
        <header class="relative w-full overflow-hidden">
        <!-- Banner con overlay gradiente -->
        <div class="relative h-64 sm:h-80 lg:h-96 w-full">
            @if (!string.IsNullOrWhiteSpace(negocio?.BannerImagen?.Base64))
            {
                <img src="@negocio.BannerImagen.Base64"
                     alt="Banner @negocio?.Nombre"
                     class="absolute inset-0 h-full w-full object-cover" />
            }
            else
            {
                <div class="absolute inset-0 bg-gradient-to-br from-green-600 via-green-500 to-emerald-400"></div>
            }
            <!-- Overlay con gradiente -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>

            <!-- Patrón decorativo -->
            <div class="absolute inset-0 opacity-10" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'0.4\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>

            <!-- Contenido del header -->
            <div class="relative z-10 h-full flex flex-col justify-end pb-20 sm:pb-24">
                <div class="container mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex flex-col sm:flex-row items-center sm:items-end gap-6">
                        <!-- Logo del negocio con efecto glass -->
                        <div class="relative group">
                            <div class="absolute -inset-2 bg-gradient-to-r from-green-400 to-emerald-500 rounded-2xl blur-lg opacity-50 group-hover:opacity-75 transition-opacity"></div>
                            <div class="relative size-32 sm:size-40 lg:size-48 rounded-2xl overflow-hidden bg-white shadow-2xl ring-4 ring-white/50">
                                @if (!string.IsNullOrWhiteSpace(negocio?.imagen?.Base64))
                                {
                                    <img src="@negocio.imagen.Base64" alt="Logo @negocio?.Nombre" class="h-full w-full object-cover" />
                                }
                                else
                                {
                                    <div class="h-full w-full bg-gradient-to-br from-green-100 to-emerald-100 flex items-center justify-center">
                                        <i class="fas fa-store text-4xl text-green-600"></i>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta de información flotante -->
        <div class="relative z-20 -mt-16 container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="bg-white rounded-2xl shadow-xl p-6 sm:p-8 border border-gray-100">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
                    <!-- Info principal -->
                    <div class="text-center lg:text-left">
                        <div class="flex items-center justify-center lg:justify-start gap-3 mb-2">
                            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900">
                                @negocio?.Nombre
                            </h1>
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700">
                                <i class="fas fa-check-circle mr-1"></i> Verificado
                            </span>
                        </div>
                        <p class="text-gray-600 text-base sm:text-lg max-w-xl">
                            @(negocio?.Descripcion ?? "Tu proveedor de confianza")
                        </p>

                        <!-- Stats rápidas -->
                        <div class="flex items-center justify-center lg:justify-start gap-6 mt-4">
                            <div class="flex items-center gap-2 text-sm text-gray-500">
                                <i class="fas fa-box text-green-500"></i>
                                <span><strong class="text-gray-900">@productCount</strong> productos</span>
                            </div>
                            <div class="flex items-center gap-2 text-sm text-gray-500">
                                <i class="fas fa-tags text-orange-500"></i>
                                <span><strong class="text-gray-900">@categoryCount</strong> categorías</span>
                            </div>
                            @if (negocio?.Telefono != null)
                            {
                                <div class="flex items-center gap-2 text-sm text-gray-500">
                                    <i class="fas fa-phone text-blue-500"></i>
                                    <span>@negocio.Telefono</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Acciones -->
                    <div class="flex flex-col sm:flex-row items-center gap-3">
                        @{
                            var whatsappNum = !string.IsNullOrEmpty(negocio?.Whatsapp)
                                ? negocio.Whatsapp.Replace(" ", "").Replace("-", "")
                                : negocio?.Telefono.ToString().Replace(" ", "").Replace("(", "").Replace(")", "").Replace("-", "").Replace("+", "") ?? "";

                            var mensaje = Uri.EscapeDataString($"Hola {negocio?.Nombre}, me gustaría obtener más información.");
                            var waUrl = $"https://wa.me/57{whatsappNum}?text={mensaje}";
                        }
                        <a href="@waUrl"
                           target="_blank" rel="noopener"
                           onclick="if(window.AbasteceteTracking) AbasteceteTracking.registrarClicWhatsapp(@negocio.Id);"
                           class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-green-500 to-emerald-600 text-white font-semibold shadow-lg shadow-green-500/30 hover:shadow-xl hover:shadow-green-500/40 hover:-translate-y-0.5 transition-all duration-300">
                            <i class="fab fa-whatsapp text-xl"></i>
                            <span>WhatsApp</span>
                        </a>
                        <button id="toggleInfoPanel"
                                class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gray-100 text-gray-700 font-semibold hover:bg-gray-200 transition-colors">
                            <i class="fas fa-info-circle"></i>
                            <span>Más información</span>
                            <i class="fas fa-chevron-down transition-transform duration-300" id="toggleIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- Panel expandible de información del local -->
                <div id="infoPanel" class="info-panel border-t border-gray-100 mt-6 px-2">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                        <!-- Contacto -->
                        <div>
                            <h4 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                                <i class="fas fa-address-book text-green-500"></i> Contacto
                            </h4>
                            <div class="space-y-2 text-sm">
                                @if (negocio?.Telefono > 0)
                                {
                                    <a href="tel:@negocio.Telefono" class="flex items-center gap-2 text-gray-600 hover:text-green-600">
                                        <i class="fas fa-phone w-4"></i> @negocio.Telefono
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(negocio?.Whatsapp))
                                {
                                    <a href="https://wa.me/57@negocio.Whatsapp" target="_blank" class="flex items-center gap-2 text-gray-600 hover:text-green-600">
                                        <i class="fab fa-whatsapp w-4"></i> @negocio.Whatsapp
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(negocio?.EmailContacto))
                                {
                                    <a href="mailto:@negocio.EmailContacto" class="flex items-center gap-2 text-gray-600 hover:text-blue-600">
                                        <i class="fas fa-envelope w-4"></i> @negocio.EmailContacto
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(negocio?.SitioWeb))
                                {
                                    <a href="@negocio.SitioWeb" target="_blank" class="flex items-center gap-2 text-gray-600 hover:text-blue-600">
                                        <i class="fas fa-globe w-4"></i> Sitio web
                                    </a>
                                }
                                @if (negocio?.FechaRegistro.HasValue == true)
                                {
                                    var diasAntiguedad = (int)(DateTime.Now - negocio.FechaRegistro.Value).TotalDays;
                                    var textoAntiguedad = diasAntiguedad < 30 ? $"{diasAntiguedad} días"
                                        : diasAntiguedad < 365 ? $"{diasAntiguedad / 30} meses"
                                        : diasAntiguedad >= 365 && diasAntiguedad < 730 ? "1 año"
                                        : $"{diasAntiguedad / 365} años";
                                    <div class="flex items-center gap-2 text-gray-600 mt-2 pt-2 border-t border-gray-100">
                                        <i class="fas fa-calendar-check w-4 text-emerald-500"></i>
                                        <span>En Abastecete hace <strong class="text-emerald-600">@textoAntiguedad</strong></span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Dirección -->
                        <div>
                            <h4 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                                <i class="fas fa-map-marker-alt text-red-500"></i> Ubicación
                            </h4>
                            <div class="text-sm text-gray-600">
                                @if (!string.IsNullOrEmpty(negocio?.Direccion))
                                {
                                    <p class="mb-2">@negocio.Direccion</p>
                                }
                                @if (!string.IsNullOrEmpty(negocio?.Localizacion))
                                {
                                    <a href="https://www.google.com/maps?q=@negocio.Localizacion"
                                       target="_blank"
                                       class="inline-flex items-center gap-1 text-green-600 hover:text-green-700 font-medium">
                                        <i class="fas fa-directions"></i> Cómo llegar
                                    </a>
                                }
                            </div>
                        </div>

                        <!-- Horarios -->
                        @{
                            var tieneHorarios = !string.IsNullOrEmpty(negocio?.HorarioLunes) ||
                                               !string.IsNullOrEmpty(negocio?.HorarioMartes) ||
                                               !string.IsNullOrEmpty(negocio?.HorarioMiercoles) ||
                                               !string.IsNullOrEmpty(negocio?.HorarioJueves) ||
                                               !string.IsNullOrEmpty(negocio?.HorarioViernes) ||
                                               !string.IsNullOrEmpty(negocio?.HorarioSabado) ||
                                               !string.IsNullOrEmpty(negocio?.HorarioDomingo);
                        }
                        @if (tieneHorarios)
                        {
                            <div>
                                <h4 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                                    <i class="fas fa-clock text-orange-500"></i> Horarios
                                </h4>
                                <div class="text-sm space-y-1">
                                    @if (!string.IsNullOrEmpty(negocio?.HorarioLunes))
                                    {
                                        <div class="flex justify-between"><span class="text-gray-500">Lunes</span><span class="text-gray-700">@negocio.HorarioLunes</span></div>
                                    }
                                    @if (!string.IsNullOrEmpty(negocio?.HorarioMartes))
                                    {
                                        <div class="flex justify-between"><span class="text-gray-500">Martes</span><span class="text-gray-700">@negocio.HorarioMartes</span></div>
                                    }
                                    @if (!string.IsNullOrEmpty(negocio?.HorarioMiercoles))
                                    {
                                        <div class="flex justify-between"><span class="text-gray-500">Miércoles</span><span class="text-gray-700">@negocio.HorarioMiercoles</span></div>
                                    }
                                    @if (!string.IsNullOrEmpty(negocio?.HorarioJueves))
                                    {
                                        <div class="flex justify-between"><span class="text-gray-500">Jueves</span><span class="text-gray-700">@negocio.HorarioJueves</span></div>
                                    }
                                    @if (!string.IsNullOrEmpty(negocio?.HorarioViernes))
                                    {
                                        <div class="flex justify-between"><span class="text-gray-500">Viernes</span><span class="text-gray-700">@negocio.HorarioViernes</span></div>
                                    }
                                    @if (!string.IsNullOrEmpty(negocio?.HorarioSabado))
                                    {
                                        <div class="flex justify-between"><span class="text-gray-500">Sábado</span><span class="text-gray-700">@negocio.HorarioSabado</span></div>
                                    }
                                    @if (!string.IsNullOrEmpty(negocio?.HorarioDomingo))
                                    {
                                        <div class="flex justify-between"><span class="text-gray-500">Domingo</span><span class="text-gray-700">@negocio.HorarioDomingo</span></div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Redes Sociales -->
                        @{
                            var tieneRedes = !string.IsNullOrEmpty(negocio?.Instagram) ||
                                            !string.IsNullOrEmpty(negocio?.Facebook) ||
                                            !string.IsNullOrEmpty(negocio?.Tiktok) ||
                                            !string.IsNullOrEmpty(negocio?.Youtube) ||
                                            !string.IsNullOrEmpty(negocio?.Twitter);
                        }
                        @if (tieneRedes)
                        {
                            <div>
                                <h4 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                                    <i class="fas fa-share-alt text-purple-500"></i> Redes Sociales
                                </h4>
                                <div class="flex flex-wrap gap-2">
                                    @if (!string.IsNullOrEmpty(negocio?.Instagram))
                                    {
                                        <a href="https://instagram.com/@negocio.Instagram" target="_blank"
                                           class="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-500 via-pink-500 to-orange-400 flex items-center justify-center text-white hover:scale-110 transition-transform">
                                            <i class="fab fa-instagram"></i>
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(negocio?.Facebook))
                                    {
                                        <a href="@negocio.Facebook" target="_blank"
                                           class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center text-white hover:scale-110 transition-transform">
                                            <i class="fab fa-facebook-f"></i>
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(negocio?.Tiktok))
                                    {
                                        <a href="https://tiktok.com/@@negocio.Tiktok" target="_blank"
                                           class="w-10 h-10 rounded-xl bg-black flex items-center justify-center text-white hover:scale-110 transition-transform">
                                            <i class="fab fa-tiktok"></i>
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(negocio?.Youtube))
                                    {
                                        <a href="@negocio.Youtube" target="_blank"
                                           class="w-10 h-10 rounded-xl bg-red-600 flex items-center justify-center text-white hover:scale-110 transition-transform">
                                            <i class="fab fa-youtube"></i>
                                        </a>
                                    }
                                    @if (!string.IsNullOrEmpty(negocio?.Twitter))
                                    {
                                        <a href="https://twitter.com/@negocio.Twitter" target="_blank"
                                           class="w-10 h-10 rounded-xl bg-gray-800 flex items-center justify-center text-white hover:scale-110 transition-transform">
                                            <i class="fab fa-x-twitter"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Galería -->
                    @{
                        var galeria = negocio?.Galeria ?? new List<BusinessLogic.Models.GaleriaLocal>();
                        var galeriaAprobada = galeria.Where(g => g.Estado == BusinessLogic.Models.EstadoGaleria.Aprobada).ToList();
                    }
                    @if (galeriaAprobada.Any())
                    {
                        <div class="mt-6">
                            <h4 class="font-semibold text-gray-900 mb-3 flex items-center gap-2">
                                <i class="fas fa-images text-indigo-500"></i> Galería
                                <span class="text-sm font-normal text-gray-400">(@galeriaAprobada.Count fotos)</span>
                            </h4>
                            <div class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-2">
                                @foreach (var img in galeriaAprobada.Take(8))
                                {
                                    <div class="aspect-square rounded-lg overflow-hidden cursor-pointer hover:opacity-80 transition-opacity"
                                         onclick="abrirLightbox('@img.CloudinaryUrl')">
                                        <img src="@img.CloudinaryUrl" alt="Galería" class="w-full h-full object-cover" loading="lazy" />
                                    </div>
                                }
                                @if (galeriaAprobada.Count > 8)
                                {
                                    <div class="aspect-square rounded-lg bg-gray-100 flex items-center justify-center cursor-pointer hover:bg-gray-200 transition-colors"
                                         onclick="verTodasLasImagenes()">
                                        <span class="text-gray-600 font-medium text-sm">+@(galeriaAprobada.Count - 8)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Mini mapa -->
                    @if (!string.IsNullOrEmpty(negocio?.Localizacion))
                    {
                        <div class="mt-6 rounded-xl overflow-hidden border border-gray-200">
                            <div id="miniMap" class="h-48 w-full"></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Barra de búsqueda y ordenamiento -->
        <div class="mb-8 animate-fadeInUp">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 sm:p-6">
                <div class="flex flex-col sm:flex-row gap-4">
                    <!-- Búsqueda -->
                    <div class="flex-1 relative">
                        <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="text"
                               id="searchInput"
                               placeholder="Buscar productos..."
                               class="search-input w-full pl-12 pr-4 py-3 rounded-xl border border-gray-200 focus:border-green-500 focus:outline-none transition-all">
                    </div>

                    <!-- Ordenamiento -->
                    <div class="flex gap-3">
                        <select id="sortOrder" class="px-4 py-3 rounded-xl border border-gray-200 focus:border-green-500 focus:outline-none bg-white min-w-[160px]">
                            <option value="">Ordenar por</option>
                            <option value="price-asc">Precio: Menor a Mayor</option>
                            <option value="price-desc">Precio: Mayor a Menor</option>
                            <option value="name-asc">Nombre: A-Z</option>
                            <option value="name-desc">Nombre: Z-A</option>
                        </select>

                        <!-- Vista grid/list -->
                        <div class="hidden sm:flex items-center bg-gray-100 rounded-xl p-1">
                            <button id="viewGrid" class="p-2 rounded-lg bg-white shadow-sm text-green-600">
                                <i class="fas fa-th-large"></i>
                            </button>
                            <button id="viewList" class="p-2 rounded-lg text-gray-400 hover:text-gray-600 transition-colors">
                                <i class="fas fa-list"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Filtros rápidos (tags) -->
                <div class="flex flex-wrap gap-2 mt-4" id="quickFilters">
                    <button class="quick-filter active px-4 py-2 rounded-full text-sm font-medium bg-green-100 text-green-700 hover:bg-green-200 transition-colors" data-filter="all">
                        Todos
                    </button>
                    @if (ViewBag.categorias != null)
                    {
                        @foreach (var cat in ViewBag.categorias)
                        {
                            <button class="quick-filter px-4 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition-colors" data-filter="@cat.Id">
                                @cat.Nombre
                            </button>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="flex flex-col lg:flex-row gap-8">
            <!-- SIDEBAR DE FILTROS -->
            <aside id="filtros" class="w-full lg:w-72 xl:w-80 flex-shrink-0 animate-fadeInUp animation-delay-100">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 lg:sticky lg:top-36 lg:max-h-[calc(100vh-10rem)] lg:overflow-y-auto">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-xl font-bold text-gray-900 flex items-center gap-2">
                            <i class="fas fa-sliders-h text-green-500"></i>
                            Filtros
                        </h2>
                        <button id="filter" class="text-sm text-green-600 hover:text-green-700 font-medium flex items-center gap-1">
                            <i class="fas fa-redo text-xs"></i>
                            Limpiar
                        </button>
                    </div>

                    <!-- Categoría -->
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-folder text-orange-500 mr-2"></i>Categoría
                        </label>
                        <select id="category" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-green-500 focus:outline-none transition-all bg-white">
                            <option value="">Todas las categorías</option>
                            @foreach (var cat in ViewBag.categorias)
                            {
                                <option value="@cat.Id">@cat.Nombre</option>
                            }
                        </select>
                    </div>

                    <!-- Subcategoría -->
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            <i class="fas fa-folder-open text-blue-500 mr-2"></i>Subcategoría
                        </label>
                        <select id="subcategory" class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-green-500 focus:outline-none transition-all bg-white disabled:bg-gray-50 disabled:text-gray-400" disabled>
                            <option value="">Todas las subcategorías</option>
                        </select>
                    </div>

                    <!-- Rango de precio -->
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-4">
                            <i class="fas fa-dollar-sign text-green-500 mr-2"></i>Rango de precio
                        </label>
                        <div class="px-2">
                            <div class="relative h-2 bg-gray-200 rounded-full">
                                <input id="minPriceRange" type="range" class="range-slider" />
                                <input id="maxPriceRange" type="range" class="range-slider" />
                                <div id="rangeBar" class="pointer-events-none absolute h-2 rounded-full bg-gradient-to-r from-green-400 to-emerald-500"></div>
                            </div>
                        </div>
                        <div class="flex justify-between mt-4">
                            <div class="bg-gray-50 px-3 py-2 rounded-lg">
                                <span class="text-xs text-gray-500">Mín</span>
                                <p id="minPriceValue" class="font-bold text-gray-900"></p>
                            </div>
                            <div class="bg-gray-50 px-3 py-2 rounded-lg text-right">
                                <span class="text-xs text-gray-500">Máx</span>
                                <p id="maxPriceValue" class="font-bold text-gray-900"></p>
                            </div>
                        </div>
                    </div>

                    <!-- Contador de resultados -->
                    <div class="pt-4 border-t border-gray-100">
                        <p class="text-sm text-gray-500 text-center">
                            Mostrando <span id="resultCount" class="font-bold text-green-600">@productCount</span> productos
                        </p>
                    </div>
                </div>
            </aside>

            <!-- GRID DE PRODUCTOS -->
            <section id="productosWrapper" class="flex-1 animate-fadeInUp animation-delay-200">
                <div id="productosContainer" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6" data-view="grid">
                    @{ var index = 0; }
                    @foreach (var producto in Model)
                    {
                        <div id="producto-@producto.Id"
                             class="producto producto-card group bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 flex flex-col"
                             data-categoria-id="@producto.Categoria"
                             data-subcategoria-id="@producto.IdSubCategoria"
                             data-precio="@producto.Precio"
                             data-nombre="@producto.Nombre?.ToLower()"
                             data-imagen="@producto.ImagenUrl"
                             style="animation-delay: @(index * 50)ms">

                            <!-- Imagen del producto -->
                            <div class="producto-imagen relative aspect-square overflow-hidden bg-gray-50">
                                <img src="@producto.ImagenUrl"
                                     alt="@producto.Nombre"
                                     class="producto-image h-full w-full object-contain p-4"
                                     loading="lazy" />

                                <!-- Overlay con acciones -->
                                <div class="producto-overlay absolute inset-0 bg-black/40 flex items-center justify-center gap-3">
                                    <a href="@Url.Action("ProductDetailLocal", "Productos", new { idlocal = negocio?.Id, idProducto = producto.Id })"
                                       class="w-12 h-12 rounded-full bg-white flex items-center justify-center text-gray-900 hover:bg-green-500 hover:text-white transition-colors shadow-lg">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a href="@waUrl"
                                       target="_blank"
                                       class="w-12 h-12 rounded-full bg-white flex items-center justify-center text-gray-900 hover:bg-green-500 hover:text-white transition-colors shadow-lg">
                                        <i class="fab fa-whatsapp"></i>
                                    </a>
                                </div>

                            </div>

                            <!-- Info del producto -->
                            <div class="producto-info p-5 flex-1 flex flex-col">
                                <h3 class="producto-nombre font-semibold text-gray-900 text-lg mb-2 line-clamp-2 group-hover:text-green-600 transition-colors">
                                    @producto.Nombre
                                </h3>

                                @if (producto.TieneMultiplesMarcas)
                                {
                                    <div class="mb-2 flex items-center gap-2">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-700">
                                            <i class="fas fa-tags mr-1 text-[10px]"></i>@producto.CantidadMarcas marcas
                                        </span>
                                    </div>
                                }

                                <div class="producto-acciones flex items-center justify-between mt-auto">
                                    <div>
                                        @if (producto.TieneMultiplesMarcas && producto.PrecioMinimo.HasValue)
                                        {
                                            <p class="text-xs text-gray-500 mb-0.5">Desde</p>
                                            <p class="producto-precio text-2xl font-bold text-green-600">
                                                $@producto.PrecioMinimo.Value.ToString("N0")
                                            </p>
                                        }
                                        else
                                        {
                                            <p class="producto-precio text-2xl font-bold text-green-600">
                                                $@producto.Precio
                                            </p>
                                        }
                                        @if (producto.Unidad?.Nombre != null)
                                        {
                                            <p class="producto-unidad text-sm text-gray-500">por @producto.Unidad.Nombre</p>
                                        }
                                    </div>

                                    <a href="@Url.Action("ProductDetailLocal", "Productos", new { idlocal = negocio?.Id, idProducto = producto.Id })"
                                       class="producto-btn flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-gray-900 to-gray-800 text-white text-sm font-medium hover:from-green-600 hover:to-emerald-600 transition-all duration-300 shadow-md hover:shadow-lg">
                                        Ver más
                                        <i class="fas fa-arrow-right text-xs"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        index++;
                    }
                </div>

                <!-- Estado vacío -->
                <div id="emptyState" class="hidden py-16 text-center">
                    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gray-100 mb-6">
                        <i class="fas fa-search text-3xl text-gray-400"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">No se encontraron productos</h3>
                    <p class="text-gray-500 mb-6">Intenta ajustar los filtros o buscar algo diferente</p>
                    <button onclick="document.getElementById('filter').click()"
                            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-green-600 text-white font-medium hover:bg-green-700 transition-colors">
                        <i class="fas fa-redo"></i>
                        Limpiar filtros
                    </button>
                </div>
            </section>
        </div>
    </main>

    <!-- Botón flotante de WhatsApp -->
    @{
        var whatsappNumFloat = !string.IsNullOrEmpty(negocio?.Whatsapp)
            ? negocio.Whatsapp.Replace(" ", "").Replace("-", "")
            : negocio?.Telefono.ToString().Replace(" ", "").Replace("(", "").Replace(")", "").Replace("-", "").Replace("+", "") ?? "";
        var mensajeFloat = Uri.EscapeDataString($"¡Hola! Estoy viendo los productos de {negocio?.Nombre} en Abastécete y me gustaría hacer un pedido.");
        var waUrlFloat = $"https://wa.me/57{whatsappNumFloat}?text={mensajeFloat}";
    }
    <div class="fixed bottom-6 right-6 z-[9999] group">
        <!-- Tooltip -->
        <div class="absolute bottom-full right-0 mb-3 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 pointer-events-none">
            <div class="bg-gray-900 text-white text-sm px-4 py-2 rounded-lg shadow-lg whitespace-nowrap">
                <i class="fab fa-whatsapp mr-1"></i> Escríbenos por WhatsApp
                <div class="absolute -bottom-1 right-6 w-2 h-2 bg-gray-900 rotate-45"></div>
            </div>
        </div>
        <!-- Botón -->
        <a href="@waUrlFloat"
           target="_blank"
           onclick="if(window.AbasteceteTracking) AbasteceteTracking.registrarClicWhatsapp(@negocio.Id);"
           class="flex items-center justify-center w-16 h-16 rounded-full bg-[#25D366] text-white shadow-lg shadow-green-500/30 hover:shadow-xl hover:shadow-green-500/50 hover:scale-110 transition-all duration-300 relative">
            <!-- Ping animation -->
            <span class="absolute inset-0 rounded-full bg-[#25D366] animate-ping opacity-30"></span>
            <i class="fab fa-whatsapp text-3xl relative z-10"></i>
        </a>
    </div>

    <!-- Lightbox para galería -->
    <div id="lightbox" class="fixed inset-0 z-[60] hidden bg-black/90 items-center justify-center" onclick="cerrarLightbox(event)">
        <button onclick="cerrarLightbox()" class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors">
            <i class="fas fa-times text-xl"></i>
        </button>
        <img id="lightbox-img" src="" alt="Imagen" class="max-w-[90%] max-h-[90%] rounded-lg shadow-2xl" onclick="event.stopPropagation()" />
    </div>

    <!-- Modal de galería completa -->
    @if (galeriaAprobada.Any())
    {
        <div id="galeria-modal" class="fixed inset-0 z-[55] hidden bg-black/80 overflow-y-auto">
            <div class="min-h-screen px-4 py-8">
                <div class="max-w-6xl mx-auto">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="text-xl font-bold text-white">Galería de @negocio?.Nombre</h3>
                        <button onclick="cerrarModalGaleria()" class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition-colors">
                            <i class="fas fa-times text-xl"></i>
                        </button>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
                        @foreach (var img in galeriaAprobada)
                        {
                            <div class="aspect-square rounded-xl overflow-hidden cursor-pointer hover:opacity-90 transition-opacity"
                                 onclick="abrirLightbox('@img.CloudinaryUrl')">
                                <img src="@img.CloudinaryUrl" alt="Galería" class="w-full h-full object-cover" loading="lazy" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Variables globales
            const minPriceRange = $('#minPriceRange');
            const maxPriceRange = $('#maxPriceRange');
            const minPriceValue = $('#minPriceValue');
            const maxPriceValue = $('#maxPriceValue');
            const rangeBar = $('#rangeBar');
            const searchInput = $('#searchInput');
            const sortOrder = $('#sortOrder');
            const resultCount = $('#resultCount');
            const emptyState = $('#emptyState');
            const productosContainer = $('#productosContainer');

            // Obtener precios de productos
            let precios = [];
            $('.producto').each(function () {
                const precio = parseFloat($(this).data('precio'));
                if (!isNaN(precio)) precios.push(precio);
            });

            if (precios.length === 0) precios = [0, 1000];

            const precioMin = Math.min(...precios);
            const precioMax = Math.max(...precios);

            // Configurar sliders
            minPriceRange.attr({ min: precioMin, max: precioMax, value: precioMin });
            maxPriceRange.attr({ min: precioMin, max: precioMax, value: precioMax });
            minPriceValue.text(`$${precioMin.toLocaleString('es-CO')}`);
            maxPriceValue.text(`$${precioMax.toLocaleString('es-CO')}`);

            // --- Subcategorías ---
            $('#category').on('change', function () {
                const idCategoria = $(this).val();
                const subcatSelect = $('#subcategory');

                subcatSelect.prop('disabled', true).empty().append('<option value="">Todas las subcategorías</option>');

                if (idCategoria) {
                    $.get("/Productos/ObtenerSubCategorias", { idCategoria: idCategoria })
                        .done(function (data) {
                            if (data.length > 0) {
                                data.forEach(function (sub) {
                                    subcatSelect.append(`<option value="${sub.id}">${sub.nombre}</option>`);
                                });
                                subcatSelect.prop('disabled', false);
                            }
                            aplicarFiltros();
                        })
                        .fail(function () {
                            console.error("No se pudieron cargar las subcategorías.");
                        });
                } else {
                    aplicarFiltros();
                }
            });

            // --- Función para aplicar todos los filtros ---
            function aplicarFiltros() {
                const selectedCategory = $('#category').val();
                const selectedSubcat = $('#subcategory').val();
                const minPrice = parseFloat(minPriceRange.val());
                const maxPrice = parseFloat(maxPriceRange.val());
                const searchTerm = searchInput.val().toLowerCase().trim();

                let visibleCount = 0;

                $('.producto').each(function () {
                    const prodCat = $(this).data('categoria-id');
                    const prodSub = $(this).data('subcategoria-id');
                    const precio = parseFloat($(this).data('precio'));
                    const nombre = $(this).data('nombre') || '';

                    const coincideCategoria = !selectedCategory || prodCat == selectedCategory;
                    const coincideSubcat = !selectedSubcat || prodSub == selectedSubcat;
                    const coincidePrecio = precio >= minPrice && precio <= maxPrice;
                    const coincideBusqueda = !searchTerm || nombre.includes(searchTerm);

                    if (coincideCategoria && coincideSubcat && coincidePrecio && coincideBusqueda) {
                        $(this).show();
                        visibleCount++;
                    } else {
                        $(this).hide();
                    }
                });

                // Actualizar contador
                resultCount.text(visibleCount);

                // Mostrar/ocultar estado vacío
                if (visibleCount === 0) {
                    emptyState.removeClass('hidden');
                    productosContainer.addClass('hidden');
                } else {
                    emptyState.addClass('hidden');
                    productosContainer.removeClass('hidden');
                }

                // Aplicar ordenamiento
                aplicarOrdenamiento();
            }

            // --- Función para ordenar productos ---
            function aplicarOrdenamiento() {
                const order = sortOrder.val();
                if (!order) return;

                const productos = $('.producto:visible').get();

                productos.sort(function(a, b) {
                    const precioA = parseFloat($(a).data('precio'));
                    const precioB = parseFloat($(b).data('precio'));
                    const nombreA = $(a).data('nombre') || '';
                    const nombreB = $(b).data('nombre') || '';

                    switch(order) {
                        case 'price-asc':
                            return precioA - precioB;
                        case 'price-desc':
                            return precioB - precioA;
                        case 'name-asc':
                            return nombreA.localeCompare(nombreB);
                        case 'name-desc':
                            return nombreB.localeCompare(nombreA);
                        default:
                            return 0;
                    }
                });

                $.each(productos, function(idx, itm) {
                    productosContainer.append(itm);
                });
            }

            // --- Actualizar rango visual ---
            function actualizarRango() {
                let min = parseFloat(minPriceRange.val());
                let max = parseFloat(maxPriceRange.val());

                if (min > max) {
                    [min, max] = [max, min];
                    minPriceRange.val(min);
                    maxPriceRange.val(max);
                }

                minPriceValue.text(`$${min.toLocaleString('es-CO')}`);
                maxPriceValue.text(`$${max.toLocaleString('es-CO')}`);

                const percentMin = ((min - precioMin) / (precioMax - precioMin)) * 100;
                const percentMax = ((max - precioMin) / (precioMax - precioMin)) * 100;

                rangeBar.css({
                    left: `${percentMin}%`,
                    width: `${percentMax - percentMin}%`
                });

                aplicarFiltros();
            }

            // --- Event listeners ---
            minPriceRange.on('input', actualizarRango);
            maxPriceRange.on('input', actualizarRango);
            $('#subcategory').on('change', aplicarFiltros);
            searchInput.on('input', aplicarFiltros);
            sortOrder.on('change', aplicarFiltros);

            // Quick filters
            $('.quick-filter').on('click', function() {
                const filter = $(this).data('filter');

                $('.quick-filter').removeClass('active bg-green-100 text-green-700').addClass('bg-gray-100 text-gray-600');
                $(this).addClass('active bg-green-100 text-green-700').removeClass('bg-gray-100 text-gray-600');

                if (filter === 'all') {
                    $('#category').val('');
                } else {
                    $('#category').val(filter);
                }
                $('#category').trigger('change');
            });

            // Vista grid/lista
            $('#viewGrid').on('click', function() {
                $(this).addClass('bg-white shadow-sm text-green-600').siblings().removeClass('bg-white shadow-sm text-green-600');
                productosContainer.removeClass('list-view').addClass('sm:grid-cols-2 xl:grid-cols-3');
                productosContainer.attr('data-view', 'grid');
            });

            $('#viewList').on('click', function() {
                $(this).addClass('bg-white shadow-sm text-green-600').siblings().removeClass('bg-white shadow-sm text-green-600');
                productosContainer.addClass('list-view').removeClass('sm:grid-cols-2 xl:grid-cols-3');
                productosContainer.attr('data-view', 'list');
            });

            // --- Botón de Restablecer ---
            $('#filter').on('click', function () {
                $('#category').val('');
                $('#subcategory').empty().append('<option value="">Todas las subcategorías</option>').prop('disabled', true);
                minPriceRange.val(precioMin);
                maxPriceRange.val(precioMax);
                searchInput.val('');
                sortOrder.val('');

                $('.quick-filter').removeClass('active bg-green-100 text-green-700').addClass('bg-gray-100 text-gray-600');
                $('.quick-filter[data-filter="all"]').addClass('active bg-green-100 text-green-700').removeClass('bg-gray-100 text-gray-600');

                $('.producto').show();
                resultCount.text($('.producto').length);
                emptyState.addClass('hidden');
                productosContainer.removeClass('hidden');

                minPriceValue.text(`$${precioMin.toLocaleString('es-CO')}`);
                maxPriceValue.text(`$${precioMax.toLocaleString('es-CO')}`);

                actualizarRango();
            });

            // Inicializar
            actualizarRango();

            // --- Panel de información expandible ---
            $('#toggleInfoPanel').on('click', function() {
                const panel = $('#infoPanel');
                const icon = $('#toggleIcon');
                panel.toggleClass('expanded');
                icon.toggleClass('rotate-180');

                // Inicializar mapa si se expande por primera vez
                if (panel.hasClass('expanded') && !window.miniMapInitialized) {
                    initMiniMap();
                }
            });
        });

        // --- Mini Mapa ---
        let miniMapInitialized = false;
        function initMiniMap() {
            const mapElement = document.getElementById('miniMap');
            if (!mapElement) return;

            const localizacion = '@(negocio?.Localizacion ?? "")';
            if (!localizacion || !localizacion.includes(',')) return;

            const parts = localizacion.split(',');
            const lat = parseFloat(parts[0]);
            const lng = parseFloat(parts[1]);

            if (isNaN(lat) || isNaN(lng)) return;

            const position = { lat, lng };
            const map = new google.maps.Map(mapElement, {
                center: position,
                zoom: 15,
                mapTypeControl: false,
                streetViewControl: false,
                fullscreenControl: true,
                styles: [
                    { featureType: "poi", elementType: "labels", stylers: [{ visibility: "off" }] }
                ]
            });

            new google.maps.Marker({
                position: position,
                map: map,
                title: '@(negocio?.Nombre ?? "")',
                icon: {
                    url: 'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="%2316a34a"><path d="M12 0C7.31 0 3.5 3.81 3.5 8.5c0 6.38 8.5 15.5 8.5 15.5s8.5-9.12 8.5-15.5C20.5 3.81 16.69 0 12 0zm0 12c-1.93 0-3.5-1.57-3.5-3.5S10.07 5 12 5s3.5 1.57 3.5 3.5S13.93 12 12 12z"/></svg>'),
                    scaledSize: new google.maps.Size(40, 40)
                }
            });

            window.miniMapInitialized = true;
        }

        // --- Funciones de Galería ---
        function abrirLightbox(url) {
            const lightbox = document.getElementById('lightbox');
            const img = document.getElementById('lightbox-img');
            img.src = url;
            lightbox.classList.remove('hidden');
            lightbox.classList.add('flex');
            document.body.classList.add('overflow-hidden');
        }

        function cerrarLightbox(event) {
            if (event && event.target !== document.getElementById('lightbox') && event.target !== document.querySelector('#lightbox button')) return;
            const lightbox = document.getElementById('lightbox');
            lightbox.classList.add('hidden');
            lightbox.classList.remove('flex');
            document.body.classList.remove('overflow-hidden');
        }

        function verTodasLasImagenes() {
            const modal = document.getElementById('galeria-modal');
            if (modal) {
                modal.classList.remove('hidden');
                document.body.classList.add('overflow-hidden');
            }
        }

        function cerrarModalGaleria() {
            const modal = document.getElementById('galeria-modal');
            if (modal) {
                modal.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            }
        }

        // Cerrar con ESC
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                cerrarLightbox();
                cerrarModalGaleria();
            }
        });
    </script>
    @if (!string.IsNullOrEmpty(negocio?.Localizacion))
    {
        <script src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&libraries=places"></script>
    }
    </div>
    <!-- End of content-productos wrapper -->

    <script>
        // Skeleton loader transition
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(function() {
                document.getElementById('skeleton-productos').classList.add('hidden');
                document.getElementById('content-productos').classList.remove('hidden');
            }, 300);
        });
    </script>

    <!-- Tracking de Analíticas -->
    <script src="~/js/tracking.js"></script>
    <script>
        // Registrar visita al local al cargar la página
        document.addEventListener('DOMContentLoaded', function() {
            if (window.AbasteceteTracking) {
                AbasteceteTracking.registrarVisitaLocal(@negocio.Id);

                // Registrar vista de producto cuando hacen clic en "Ver más" o en el ojo
                document.querySelectorAll('.producto-card').forEach(function(card) {
                    var productoId = card.id.replace('producto-', '');
                    card.querySelectorAll('a[href*="ProductDetailLocal"]').forEach(function(link) {
                        link.addEventListener('click', function() {
                            AbasteceteTracking.registrarVisitaProducto(@negocio.Id, parseInt(productoId));
                        });
                    });
                });
            }
        });
    </script>
</body>

</html>
