@model List<BusinessLogic.Models.Producto>
@{
    var negocio = ViewBag.negocio as BusinessLogic.Models.Negocio;
}
@Html.Partial("_ContactModal")
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@negocio?.Nombre</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="bg-gray-100">
    <!-- HEADER NEGOCIO -->
    <header class="flex items-center justify-between bg-[#F5EFE4] p-4 shadow-md">
        <div class="flex items-center gap-4">
            <div class="h-12 w-12 overflow-hidden rounded-md border bg-white">
            @if (!string.IsNullOrWhiteSpace(negocio?.BannerImagen?.Base64))
            {
                <img src="@negocio?.BannerImagen.Base64" alt="Logo negocio"
                         class="h-full w-full object-cover" />
            }
            </div>
            <h1 class="text-2xl font-bold text-gray-800">@negocio?.Nombre</h1>
            <h1 class="text-2xl font-bold text-gray-800">@negocio?.Descripcion</h1>
        </div>
        <div>
            <span class="text-lg font-semibold text-gray-700">Celular: @negocio?.Telefono</span>
        </div>
    </header>

    <main class="flex w-full gap-6 p-6">
        <!-- FILTROS -->
        <aside id="filtros" class="w-1/5 space-y-6 overflow-auto">
            <div>
                <h2 class="mb-2 text-xl font-bold text-green-600">Filtros</h2>
            </div>
            <div class="rounded-lg bg-white p-4 shadow-md">
                <label class="mb-1 block font-semibold text-orange-600">Categoría</label>
                <select id="category" class="w-full rounded border-gray-300 p-2">
                    <option value="">Todas</option>
                    @foreach (var cat in ViewBag.categorias)
                    {
                        <option value="@cat.Id">@cat.Nombre</option>
                    }
                </select>
            </div>
            <div class="rounded-lg bg-white p-4 shadow-md">
                <label class="mb-1 block font-semibold text-orange-600">Subcategoría</label>
                <select id="subcategory" class="w-full rounded border-gray-300 p-2" disabled>
                    <option value="">Todas</option>
                </select>
            </div>
            <div class="rounded-lg bg-white p-4 shadow-md">
                <label class="mb-2 block font-semibold text-orange-600">Precio</label>
                <div class="relative h-3">
                    <input id="minPriceRange" type="range" class="absolute inset-0 h-3 w-full appearance-none bg-gray-300" />
                    <input id="maxPriceRange" type="range" class="absolute inset-0 h-3 w-full appearance-none bg-gray-300" />
                    <div id="rangeBar" class="absolute h-3 rounded bg-green-500"></div>
                </div>
                <div class="mt-2 flex justify-between text-sm text-gray-600">
                    <span id="minPriceValue"></span>
                    <span id="maxPriceValue"></span>
                </div>
            </div>
            <button id="filter" class="w-full rounded-full bg-green-700 py-2 text-white hover:bg-green-800">Restablecer</button>
        </aside>

        <!-- LISTA DE PRODUCTOS -->
        <section id="productosWrapper" class="w-4/5">
            <h2 class="mb-4 text-lg font-semibold text-green-600">Productos disponibles</h2>
            <div id="productosContainer" class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
                @foreach (var producto in Model)
                {
                    <div id="producto-@producto.Id" class="producto flex flex-col rounded-lg bg-white p-4 shadow-md" data-categoria-id="@producto.Categoria" data-subcategoria-id="@producto.IdSubCategoria" data-precio="@producto.Precio">
                        <img src="@producto.ImagenUrl" alt="@producto.Nombre" class="mb-4 h-40 w-full object-contain" />
                        <h3 class="font-semibold text-gray-800">@producto.Nombre</h3>
                        <p class="mt-2 font-bold text-orange-500">$@producto.Precio - @producto.Unidad.Nombre</p>
                        <a href="@Url.Action(
                                                "ProductDetailLocal",
                                                "Productos",
                                                new {idlocal= negocio?.Id, idProducto = producto.Id }
                                            )"
                       class="mt-3 mx-auto w-1/2 rounded-lg bg-[#1A2D3D] px-2 py-1 text-sm text-white hover:bg-[#162331] block text-center">
                            Ver
                        </a>
                    </div>
                }
            </div>
        </section>
    </main>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

</body>
</html>
