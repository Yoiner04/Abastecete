@model List<BusinessLogic.Models.Negocio>

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Proveedores Abastecete</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAPudyk3G3YG7GOEpId4xMK_WFIEenOSp8&libraries=places"></script>
</head>

<div id="loader" class="fixed inset-0 z-50 flex items-center justify-center bg-white">
    <div class="flex flex-col items-center">
        <div class="border-4 border-t-transparent h-12 w-12 animate-spin rounded-full border-green-500"></div>
        <p class="mt-3 text-lg font-semibold text-gray-700">Cargando...</p>
    </div>
</div>

<div id="location-error" class="fixed top-20 left-1/2 z-50 hidden -translate-x-1/2 rounded-lg bg-red-100 px-6 py-4 text-center text-red-700 shadow-lg">
    ⚠️ No se pudo obtener tu ubicación. Se mostrarán resultados generales.
</div>


<body class="bg-[#F4F1E9] text-gray-800">
    <section class="flex w-full items-center justify-center overflow-hidden rounded-lg bg-gray-200">
        <img src="@ViewBag.categoria.BannerImagen.Base64" alt="Banner Proveedores"
             class="max-h-64 w-full object-cover" />
    </section>

    <div class="flex flex-wrap items-center justify-between bg-white p-4 shadow-md">
        <div class="flex items-center gap-4">

            <div class="flex items-center gap-2">
                <h3 class="text-lg font-semibold text-orange-600">Categorias</h3>
                <select id="Categorias" class="rounded-lg border border-gray-300 bg-gray-50 p-2 text-sm text-gray-900 focus:ring-blue-500 focus:border-blue-500">
                    @foreach (var categoria in ViewBag.categorias)
                    {
                        if (categoria.Id == ViewBag.categoria.Id)
                        {
                            <option value="@categoria.Id" selected>@categoria.Nombre</option>
                        }
                        else
                        {
                            <option value="@categoria.Id">@categoria.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="flex items-center gap-2">
                <h3 class="text-lg font-semibold text-orange-600">Tipo Proveedor</h3>
                <select id="TipoProveedor" class="rounded-lg border border-gray-300 bg-gray-50 p-2 text-sm text-gray-900 focus:ring-blue-500 focus:border-blue-500">
                    <option selected>Selecciona un Tipo</option>
                    @foreach (var membresia in ViewBag.membresias)
                    {
                        if (membresia.Nombre == ViewBag.membresia)
                        {
                            <option value="@membresia.Nombre" selected>@membresia.Nombre</option>
                        }
                        else
                        {
                            <option value="@membresia.Nombre">@membresia.Nombre</option>
                        }
                    }
                </select>
            </div>
            <div class="flex items-center gap-2">
                <h3 class="text-lg font-semibold text-orange-600">Distancia</h3>
                <input id="labels-range-input" type="range" value="100" min="100" max="1600" step="100"
                       class="h-2 w-32 cursor-pointer appearance-none rounded-lg bg-gray-300">
                <span id="range-value" class="text-sm text-gray-700">100</span>
            </div>

        </div>
    </div>

    <div class="mt-4 flex flex-wrap gap-6 px-6 md:flex-nowrap">
        <main class="w-full space-y-6 md:w-1/2" id="contenido">
            <h2 class="text-center text-2xl font-bold text-green-600">Todos los proveedores</h2>

            <div id="providers-container" class="grid grid-cols-1 gap-6 sm:grid-cols-3">
                @foreach (var negocio in Model)
                {
                    <div class="rounded-lg bg-white p-4 text-center shadow-md">
                        
                        @if (negocio.imagen != null)
                        {
                            <div class="relative">
                                <img src="@negocio.imagen.Base64" class="h-full w-full rounded-lg object-cover">
                            </div>

                        }

                        <p class="mt-3 text-lg font-bold">@negocio.Nombre</p>
                        <a href="@Url.Action("ConsultarProductos", "Negocios", new { idLocal = @negocio.Id })"
                           class="mt-2 block rounded-lg bg-green-600 px-4 py-2 text-white hover:bg-green-700">
                            Ver
                        </a>
                    </div>
                }
            </div>
        </main>
        <aside class="h-[500px] w-full md:w-1/2">
            <div id="map" class="h-full w-full rounded-lg bg-gray-300"></div>
        </aside>
    </div>
</body>


<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
        integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>

<script>
    var isLoading = true;
    var negocios = @Html.Raw(Json.Serialize(Model));
    var map;
    var markers = [];
    var searchCircle = null;
    var ubicacionObtenida = false;
    var filtrosAplicados = false;

    function initMap() {
        map = new google.maps.Map(document.getElementById('map'), {
            center: { lat: 1.6153858, lng: -75.6042364 },
            zoom: 14,
            mapTypeControl: false,
            streetViewControl: false,
            fullscreenControl: false,
            zoomControl: false,
            rotateControl: false,
        });

        obtenerUbicacionUsuario();
        configurarEventosFiltroUbicacion();
    }

    function obtenerUbicacionUsuario() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                function (position) {
                    var latitudUsuario = position.coords.latitude;
                    var longitudUsuario = position.coords.longitude;
                    map.setCenter({ lat: latitudUsuario, lng: longitudUsuario });

                    new google.maps.Marker({
                        position: { lat: latitudUsuario, lng: longitudUsuario },
                        map: map,
                        title: "Tu ubicación",
                        icon: {
                            url: "http://maps.google.com/mapfiles/ms/icons/blue-dot.png"
                        }
                    });

                    ubicacionObtenida = true;
                    let distanciaInicial = parseInt(document.getElementById('labels-range-input').value);
                    filtrarNegociosPorDistancia(latitudUsuario, longitudUsuario, distanciaInicial);
                },
                function (error) {
                    console.warn("No se pudo obtener la ubicación:", error.message);
                    mostrarErrorUbicacion();
                    ubicacionObtenida = true;
                    filtrosAplicados = true;
                    verificarCargaCompleta();
                }
            );
        } else {
            mostrarErrorUbicacion();
            ubicacionObtenida = true;
            filtrosAplicados = true;
            verificarCargaCompleta();
        }
    }

    function cargarNegocios(listaNegocios) {
        markers.forEach(marker => marker.setMap(null));
        markers = [];

        listaNegocios.forEach(negocio => {
            if (negocio.localizacion) {
                let [latitud, longitud] = negocio.localizacion.split(",").map(parseFloat);

                let marker = new google.maps.Marker({
                    position: { lat: latitud, lng: longitud },
                    map: map,
                    title: negocio.nombre,
                    icon: {
                        url: "https://cdn-icons-png.flaticon.com/512/553/553983.png",
                        scaledSize: new google.maps.Size(40, 40),
                    }
                });
                var infoWindow = new google.maps.InfoWindow({
                    content: `
                        <div class="info-window flex max-w-[200px] flex-col items-center rounded-lg bg-white px-4 py-3 shadow-lg">
    ${negocio.imagen ? `<img src="${negocio.imagen.base64}" class="h-full w-full rounded-lg object-cover">` : `<div class="flex h-32 w-full items-center justify-center rounded-lg bg-gray-200 text-gray-500">Sin imagen</div>`}
                                <h3 class="mt-2 text-center text-base font-bold text-gray-800">${negocio.nombre}</h3>
                            <p class="flex items-center text-sm text-gray-600">
                            </p>
                        </div>`
                });

                marker.addListener("click", function () {
                    infoWindow.open(map, marker);
                });

                markers.push(marker);
            }
        });
    }

    function actualizarRadio(lat, lng, radio) {
        if (searchCircle) {
            searchCircle.setMap(null);
        }

        if (radio === 1600) {
            return;
        }

        searchCircle = new google.maps.Circle({
            map: map,
            center: { lat: lat, lng: lng },
            radius: radio,
            fillColor: "#00aaff",
            fillOpacity: 0.2,
            strokeColor: "#0055aa",
            strokeOpacity: 0.8,
            strokeWeight: 2
        });
    }

    function calcularDistancia(lat1, lon1, lat2, lon2) {
        const R = 6371e3;
        const φ1 = lat1 * Math.PI / 180, φ2 = lat2 * Math.PI / 180;
        const Δφ = (lat2 - lat1) * Math.PI / 180, Δλ = (lon2 - lon1) * Math.PI / 180;

        const a = Math.sin(Δφ / 2) * Math.sin(Δφ / 2) +
            Math.cos(φ1) * Math.cos(φ2) * Math.sin(Δλ / 2) * Math.sin(Δλ / 2);

        return R * (2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)));
    }

    function filtrarNegociosPorDistancia(latUsuario, lonUsuario, distanciaMaxima) {
        let negociosFiltrados = negocios.filter(negocio => {
            if (negocio.localizacion) {
                let [latNegocio, lonNegocio] = negocio.localizacion.split(",").map(parseFloat);
                let distancia = calcularDistancia(latUsuario, lonUsuario, latNegocio, lonNegocio);
                return distancia <= distanciaMaxima || distanciaMaxima === 1600;
            }
            return false;
        });

        cargarNegocios(negociosFiltrados);
        actualizarListaNegocios(negociosFiltrados);
        actualizarRadio(latUsuario, lonUsuario, distanciaMaxima);
        filtrosAplicados = true;
        verificarCargaCompleta();
    }

    function verificarCargaCompleta() {
        if (ubicacionObtenida && filtrosAplicados) {
            document.getElementById("loader").classList.add("hidden");
            isLoading = false;
        }
    }

    function configurarEventosFiltroUbicacion() {
        document.getElementById('labels-range-input').addEventListener('input', function () {
            let distanciaMaxima = parseInt(this.value);
            let rangeText = (distanciaMaxima === 1600) ? "Sin límites" : `${distanciaMaxima} m (${(distanciaMaxima / 1000).toFixed(1)} km)`;
            document.getElementById('range-value').innerText = rangeText;

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    function (position) {
                        filtrarNegociosPorDistancia(position.coords.latitude, position.coords.longitude, distanciaMaxima);
                    },
                    function (error) {
                        console.error("Error obteniendo ubicación:", error.message);
                    }
                );
            }
        });
    }

    function actualizarListaNegocios(negociosFiltrados) {
    let container = document.getElementById("providers-container");
    container.innerHTML = negociosFiltrados.length === 0
        ? `<p class="col-span-full text-center text-lg font-semibold text-gray-600">No se han encontrado locales con los filtros dados.</p>`
        : negociosFiltrados.map(negocio => `
            <div class="rounded-lg bg-white p-4 text-center shadow-md">
                <div class="relative">
    ${negocio.imagen ? `<img src="${negocio.imagen.base64}" class="h-full w-full rounded-lg object-cover">` : `<div class="flex h-32 w-full items-center justify-center rounded-lg bg-gray-200 text-gray-500">Sin imagen</div>`}
                        <div class="absolute top-2 left-2 flex items-center rounded-full bg-white px-2 py-1 text-sm shadow">
                    </div>
                </div>
                <p class="mt-3 text-lg font-bold">${negocio.nombre}</p>
                <a href="/Negocios/ConsultarProductos?idLocal=${negocio.id}"
                   class="mt-2 block rounded-lg bg-green-600 px-4 py-2 text-white hover:bg-green-700">
                    Ver
                </a>
            </div>
        `).join('');
}



        function aplicarFiltros() {
        var idCategoria = $("#Categorias").val();
        var tipoMembresia = $("#TipoProveedor").val();

        document.getElementById("loader").classList.remove("hidden");

        let negociosCargados = false;
        let categoriaCargada = false;
        let nuevosNegocios = []; // vamos a guardar la respuesta aquí
        let nuevaCategoria = null; // vamos a guardar el banner aquí

        // Consulta negocios
        $.ajax({
            url: "/Negocios/ConsultarNegocios",
            type: "POST",
            data: { idCategoria: idCategoria, membe: tipoMembresia || "" },
            success: function (response) {
                nuevosNegocios = response;
                negociosCargados = true;
                verificarCargaFiltros();
            },
            error: function () {
                alert("Error al cargar los negocios.");
                negociosCargados = true;
                verificarCargaFiltros();
            }
        });

        // Consulta categoría
        $.ajax({
            url: `/Categorias/ObtenerCategoria?id=${idCategoria}`,
            type: "GET",
            success: function (categoria) {
                nuevaCategoria = categoria;
                categoriaCargada = true;
                verificarCargaFiltros();
            },
            error: function () {
                console.warn("Error al actualizar el banner.");
                categoriaCargada = true;
                verificarCargaFiltros();
            }
        });

        function verificarCargaFiltros() {
            if (negociosCargados && categoriaCargada) {
                // ✅ Cuando ambos ya terminaron...

                negocios = nuevosNegocios; // Actualiza la variable global

                actualizarListaNegocios(negocios); // Ahora sí: refrescamos negocios
                cargarNegocios(negocios); // Actualizamos markers

                // Cambiar banner solo si llegó uno nuevo
                if (nuevaCategoria && nuevaCategoria.bannerImagen && nuevaCategoria.bannerImagen.base64) {
                    document.querySelector('section img').src = nuevaCategoria.bannerImagen.base64;
                } else {
                    document.querySelector('section img').src = "/path/to/placeholder/banner.jpg";
                }

                document.getElementById("loader").classList.add("hidden");
            }
        }
    }





        $("#Categorias").change(aplicarFiltros);
    $("#TipoProveedor").change(aplicarFiltros);



    window.onload = function () {
        initMap();
        configurarEventosFiltroUbicacion();
    };

    function mostrarErrorUbicacion() {
        const errorDiv = document.getElementById("location-error");
        errorDiv.classList.remove("hidden");

        setTimeout(() => {
            errorDiv.classList.add("hidden");
        }, 5000);
    }

</script>

</html>