@model List<BusinessLogic.Models.Negocio>

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abastecete</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAPudyk3G3YG7GOEpId4xMK_WFIEenOSp8&libraries=places"></script>
</head>

<body class="bg-[#F4F1E9] text-gray-800">



    <section class="my-4 flex h-40 w-full items-center justify-center rounded-lg bg-gray-200">
        <h1 class="text-3xl font-bold text-gray-800">Proveedores</h1>
    </section>

    <div class="flex flex-col gap-4 px-6 md:flex-row">

        <aside class="w-full space-y-4 md:w-1/5">

            <button id="filtro-btn"
                    class="flex w-full items-center justify-center rounded-lg bg-green-600 px-4 py-2 text-white hover:bg-green-700 md:hidden">
                <i class="fas fa-filter mr-2"></i> Filtros
            </button>

            <div id="filtro-popup" class="hidden rounded-lg bg-white p-4 shadow-md md:block">
                <h2 class="mb-4 text-xl font-bold text-green-600">Filtros</h2>

                <div class="mb-4">
                    <h3 class="text-lg font-semibold text-orange-600">Categorías</h3>
                    <select id="Categorias" class="mt-2 block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:ring-blue-500 focus:border-blue-500">
                        <option selected>Selecciona una categoria</option>
                        @foreach (var categoria in ViewBag.categorias)
                        {
                            if (categoria.Id == ViewBag.categoria)
                            {
                                <option value="@categoria.Id" selected>@categoria.Nombre</option>
                            }
                            else
                            {
                                <option value="@categoria.Id">@categoria.Nombre</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div id="filtro-popup" class="hidden rounded-lg bg-white p-4 shadow-md md:block">
                <div class="mb-4">
                    <h3 class="text-lg font-semibold text-orange-600">Cerca a tu ubicacion</h3>
                    <div class="relative mb-6">
                        <label for="labels-range-input" class="sr-only">Labels range</label>
                        <input id="labels-range-input" type="range" value="1000" min="100" max="1500" class="h-2 w-full cursor-pointer appearance-none rounded-lg bg-gray-200">
                        <span class="absolute start-0 -bottom-6 text-sm text-gray-500">0 km</span>
                        <span class="absolute start-1/3 -bottom-6 -translate-x-1/2 text-sm text-gray-500 rtl:translate-x-1/2">5 km</span>
                        <span class="absolute start-2/3 -bottom-6 -translate-x-1/2 text-sm text-gray-500 rtl:translate-x-1/2">10 km</span>
                        <span class="absolute end-0 -bottom-6 text-sm text-gray-500">15 km</span>
                    </div>
                </div>
            </div>

            <!-- Mapa -->
            <div id="map" class="h-60 w-full rounded-lg bg-gray-300"></div>

        </aside>

        <main class="ml-10 w-full space-y-6 md:w-4/5" id="contenido">
            <h2 class="text-2xl font-bold text-green-600">Todos los proveedores</h2>

            <div id="providers-container" class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
                @foreach (var negocio in Model)
                {
                    <div class="rounded-lg bg-white p-4 text-center shadow-md">
                        <div class="relative">
                            <img src="@negocio.Logotipo" class="h-full w-full rounded-lg object-cover">
                            <div class="absolute top-2 left-2 flex items-center rounded-full bg-white px-2 py-1 text-sm shadow">
                                <i class="fas fa-star mr-1 text-yellow-500"></i> @negocio.Puntuacion
                            </div>
                        </div>
                        <p class="mt-3 text-lg font-bold">@negocio.Nombre</p>
                        <a href="@Url.Action("ConsultarProductos", "Negocios", new { idLocal = @negocio.Id })"
                           class="mt-2 block rounded-lg bg-green-600 px-4 py-2 text-white hover:bg-green-700">
                            Ver
                        </a>
                    </div>
                }
            </div>


        </main>

    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        function initMap() {
            var map = new google.maps.Map(document.getElementById('map'), {
                center: { lat: 0, lng: 0 },
                zoom: 15
            });

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    function (position) {
                        var latitud = position.coords.latitude;
                        var longitud = position.coords.longitude;

                        map.setCenter({ lat: latitud, lng: longitud });

                        new google.maps.Marker({
                            position: { lat: latitud, lng: longitud },
                            map: map,
                            title: "Estás aquí"
                        });
                    },
                    function (error) {
                        console.error("Error obteniendo la ubicación: ", error.message);
                        alert("No se pudo obtener tu ubicación.");
                    }
                );
            } else {
                alert("Tu navegador no soporta la geolocalización.");
            }
        }

        window.onload = initMap;

        document.getElementById('filtro-btn').addEventListener('click', () => {
            document.getElementById('filtro-popup').classList.toggle('hidden');
        });
    </script>
    <script>
        $("#Categorias").change(function () {
            var idCategoria= $(this).val();
            if (idCategoria) {
                $.ajax({
                    url: "/Negocios/Consultar",
                    type: "POST",
                    data: { idCategoria: idCategoria },
                    success: function (response) {
                        document.body.innerHTML = response;
                        reInicializarScripts();
                    },
                    error: function () {
                        alert("Error al cargar los datos.");
                    }
                });
            }
        });

        function reInicializarScripts() {
            if (typeof initMap === "function") {
               // initMap();
            }
            $("#Categorias").off("change").on("change", function () {
                var idCategoria                     = $(this).val();
                if (idCategoria) {
                    $("body").addClass("opacity-50 pointer-events-none");

                    $.ajax({
                        url: "/Negocios/Consultar",
                        type: "POST",
                        data: { idCategoria: idCategoria },
                        success: function (response) {
                            document.body.innerHTML = response;
                            reInicializarScripts();
                        }
                    });
                }
            });

            $("body").removeClass("opacity-50 pointer-events-none");
            console.log("Scripts re-inicializados.");
        }

    </script>
</body>
</html>
