@model BusinessLogic.Models.Negocio

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrar Negocio - Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAPudyk3G3YG7GOEpId4xMK_WFIEenOSp8&libraries=places"></script>
    <style>
        /* Animaciones */
        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fadeInUp {
            animation: fadeInUp 0.5s ease-out forwards;
        }
        .delay-100 { animation-delay: 0.1s; }
        .delay-200 { animation-delay: 0.2s; }
        .delay-300 { animation-delay: 0.3s; }

        /* Mapa */
        #map {
            height: 100%;
            min-height: 400px;
            width: 100%;
            border-radius: 1rem;
        }

        /* Inputs con iconos */
        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            pointer-events: none;
            transition: color 0.2s;
        }
        .input-with-icon {
            padding-left: 42px !important;
        }
        .input-with-icon:focus + .input-icon,
        .input-with-icon:not(:placeholder-shown) + .input-icon {
            color: #23916A;
        }

        /* Upload area */
        .upload-area {
            border: 2px dashed #d1d5db;
            transition: all 0.3s ease;
        }
        .upload-area:hover, .upload-area.dragover {
            border-color: #23916A;
            background: rgba(35, 145, 106, 0.05);
        }
        .upload-area.has-image {
            border-style: solid;
            border-color: #23916A;
        }

        /* Stepper */
        .step-indicator {
            transition: all 0.3s ease;
        }
        .step-indicator.active {
            background: linear-gradient(135deg, #23916A 0%, #1a7a58 100%);
            color: white;
            transform: scale(1.1);
        }
        .step-indicator.completed {
            background: #23916A;
            color: white;
        }

        /* Secciones colapsables */
        .section-toggle {
            transition: transform 0.3s ease;
        }
        .section-toggle.open {
            transform: rotate(180deg);
        }
        .section-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
        }
        .section-content.open {
            max-height: 1000px;
        }
    </style>
</head>

<body class="bg-gray-50 min-h-screen">
    <!-- Header -->
    <header class="bg-gradient-to-r from-[#23916A] to-emerald-500 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <a href="@Url.Action("Index", "Home")" class="flex items-center justify-center w-10 h-10 rounded-xl bg-white/20 hover:bg-white/30 transition-colors">
                        <i class="fas fa-arrow-left text-white"></i>
                    </a>
                    <div>
                        <h1 class="text-xl sm:text-2xl font-bold text-white">Registrar mi Negocio</h1>
                        <p class="text-white/80 text-sm hidden sm:block">Completa la información para comenzar</p>
                    </div>
                </div>
                <img src="~/css/Images/LOGO FINAL.png" alt="Abastecete" class="h-10 hidden sm:block" />
            </div>
        </div>
    </header>

    <!-- Progress Steps -->
    <div class="bg-white border-b shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center justify-center gap-2 sm:gap-4">
                <div class="flex items-center gap-2">
                    <div class="step-indicator active w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-gray-200 text-gray-600">
                        1
                    </div>
                    <span class="text-sm font-medium text-gray-700 hidden sm:inline">Información</span>
                </div>
                <div class="w-8 sm:w-16 h-0.5 bg-gray-200"></div>
                <div class="flex items-center gap-2">
                    <div class="step-indicator w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-gray-200 text-gray-600">
                        2
                    </div>
                    <span class="text-sm font-medium text-gray-400 hidden sm:inline">Membresía</span>
                </div>
                <div class="w-8 sm:w-16 h-0.5 bg-gray-200"></div>
                <div class="flex items-center gap-2">
                    <div class="step-indicator w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold bg-gray-200 text-gray-600">
                        3
                    </div>
                    <span class="text-sm font-medium text-gray-400 hidden sm:inline">Confirmar</span>
                </div>
            </div>
        </div>
    </div>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        @using (Html.BeginForm("GuardarDatosNegocio", "Negocios", FormMethod.Post, new
        {
            id = "registroForm",
            enctype = "multipart/form-data"
        }))
        {
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Columna Izquierda - Formulario -->
                <div class="space-y-6">
                    <!-- Información Básica -->
                    <div class="animate-fadeInUp bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="bg-gradient-to-r from-[#23916A] to-emerald-500 px-5 py-3">
                            <h2 class="text-white font-bold flex items-center gap-2">
                                <i class="fas fa-store"></i>
                                Información Básica
                            </h2>
                        </div>
                        <div class="p-5 space-y-4">
                            <!-- Nombre del negocio -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">
                                    Nombre del negocio <span class="text-red-500">*</span>
                                </label>
                                <div class="relative">
                                    @Html.TextBoxFor(m => m.Nombre, new {
                                        @class = "input-with-icon w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#23916A] focus:ring-2 focus:ring-[#23916A]/20 outline-none transition-all",
                                        @placeholder = "Ej: Mi Tienda Local",
                                        @id = "nombreNegocio",
                                        @required = "required"
                                    })
                                    <i class="fas fa-store input-icon"></i>
                                </div>
                                <span id="nombreError" class="hidden text-xs text-red-500 mt-1">Por favor, ingresa el nombre de tu negocio.</span>
                            </div>

                            <!-- Descripción -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">
                                    Descripción <span class="text-red-500">*</span>
                                </label>
                                <div class="relative">
                                    @Html.TextAreaFor(m => m.Descripcion, new {
                                        @class = "w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-[#23916A] focus:ring-2 focus:ring-[#23916A]/20 outline-none transition-all resize-none",
                                        @placeholder = "Describe brevemente tu negocio...",
                                        @id = "descripcionNegocio",
                                        @rows = "3",
                                        @required = "required"
                                    })
                                </div>
                                <span id="descripcionError" class="hidden text-xs text-red-500 mt-1">Por favor, ingresa una descripción.</span>
                            </div>

                            <!-- Logo -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">
                                    Logotipo
                                </label>
                                <div id="uploadArea" class="upload-area rounded-xl p-6 text-center cursor-pointer" onclick="document.getElementById('fileInput').click()">
                                    <input type="file" id="fileInput" accept="image/*" name="logo_archivo" class="hidden" onchange="previewLogo(this)" />
                                    <div id="uploadPlaceholder">
                                        <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mx-auto mb-3">
                                            <i class="fas fa-cloud-upload-alt text-2xl text-gray-400"></i>
                                        </div>
                                        <p class="text-sm text-gray-600">Arrastra una imagen o <span class="text-[#23916A] font-medium">haz clic para seleccionar</span></p>
                                        <p class="text-xs text-gray-400 mt-1">PNG, JPG hasta 5MB</p>
                                    </div>
                                    <div id="uploadPreview" class="hidden">
                                        <img id="logoPreview" src="" alt="Preview" class="w-24 h-24 rounded-xl object-cover mx-auto mb-2" />
                                        <p id="fileName" class="text-sm text-gray-600"></p>
                                        <button type="button" onclick="event.stopPropagation(); removeLogo()" class="text-xs text-red-500 hover:text-red-600 mt-1">
                                            <i class="fas fa-times mr-1"></i>Eliminar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Contacto -->
                    <div class="animate-fadeInUp delay-100 bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-5 py-3">
                            <h2 class="text-white font-bold flex items-center gap-2">
                                <i class="fas fa-phone-alt"></i>
                                Contacto
                            </h2>
                        </div>
                        <div class="p-5 space-y-4">
                            <!-- Teléfono -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">
                                    Teléfono <span class="text-red-500">*</span>
                                </label>
                                <div class="relative">
                                    @Html.TextBoxFor(m => m.Telefono, new {
                                        @class = "input-with-icon w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all",
                                        @placeholder = "3001234567",
                                        @id = "telefonoNegocio",
                                        @type = "tel",
                                        @required = "required"
                                    })
                                    <i class="fas fa-phone input-icon"></i>
                                </div>
                            </div>

                            <!-- WhatsApp -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">
                                    WhatsApp <span class="text-gray-400 text-xs">(opcional)</span>
                                </label>
                                <div class="relative">
                                    @Html.TextBoxFor(m => m.Whatsapp, new {
                                        @class = "input-with-icon w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-green-500 focus:ring-2 focus:ring-green-500/20 outline-none transition-all",
                                        @placeholder = "3001234567",
                                        @type = "tel"
                                    })
                                    <i class="fab fa-whatsapp input-icon text-green-500"></i>
                                </div>
                            </div>

                            <!-- Email de contacto -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">
                                    Email de contacto <span class="text-gray-400 text-xs">(opcional)</span>
                                </label>
                                <div class="relative">
                                    @Html.TextBoxFor(m => m.EmailContacto, new {
                                        @class = "input-with-icon w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 outline-none transition-all",
                                        @placeholder = "contacto@minegocio.com",
                                        @type = "email"
                                    })
                                    <i class="fas fa-envelope input-icon"></i>
                                </div>
                            </div>

                            <!-- Sitio Web -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">
                                    Sitio Web <span class="text-gray-400 text-xs">(opcional)</span>
                                </label>
                                <div class="relative">
                                    @Html.TextBoxFor(m => m.SitioWeb, new {
                                        @class = "input-with-icon w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 outline-none transition-all",
                                        @placeholder = "https://www.minegocio.com",
                                        @type = "url"
                                    })
                                    <i class="fas fa-globe input-icon text-purple-500"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Redes Sociales (Colapsable) -->
                    <div class="animate-fadeInUp delay-200 bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                        <button type="button" onclick="toggleSection('redesSection')" class="w-full bg-gradient-to-r from-pink-500 to-purple-500 px-5 py-3 flex items-center justify-between">
                            <h2 class="text-white font-bold flex items-center gap-2">
                                <i class="fas fa-share-alt"></i>
                                Redes Sociales <span class="text-white/70 text-sm font-normal">(opcional)</span>
                            </h2>
                            <i class="fas fa-chevron-down section-toggle text-white" id="redesToggle"></i>
                        </button>
                        <div id="redesSection" class="section-content">
                            <div class="p-5 space-y-4">
                                <!-- Instagram -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Instagram</label>
                                    <div class="relative">
                                        @Html.TextBoxFor(m => m.Instagram, new {
                                            @class = "input-with-icon w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-pink-500 focus:ring-2 focus:ring-pink-500/20 outline-none transition-all",
                                            @placeholder = "tu_usuario"
                                        })
                                        <i class="fab fa-instagram input-icon text-pink-500"></i>
                                    </div>
                                </div>

                                <!-- Facebook -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Facebook</label>
                                    <div class="relative">
                                        @Html.TextBoxFor(m => m.Facebook, new {
                                            @class = "input-with-icon w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-blue-600 focus:ring-2 focus:ring-blue-600/20 outline-none transition-all",
                                            @placeholder = "https://facebook.com/tupagina"
                                        })
                                        <i class="fab fa-facebook input-icon text-blue-600"></i>
                                    </div>
                                </div>

                                <!-- TikTok -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">TikTok</label>
                                    <div class="relative">
                                        @Html.TextBoxFor(m => m.Tiktok, new {
                                            @class = "input-with-icon w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-800 focus:ring-2 focus:ring-gray-800/20 outline-none transition-all",
                                            @placeholder = "tu_usuario"
                                        })
                                        <i class="fab fa-tiktok input-icon"></i>
                                    </div>
                                </div>

                                <!-- YouTube -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">YouTube</label>
                                    <div class="relative">
                                        @Html.TextBoxFor(m => m.Youtube, new {
                                            @class = "input-with-icon w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-red-500 focus:ring-2 focus:ring-red-500/20 outline-none transition-all",
                                            @placeholder = "https://youtube.com/@tucanal"
                                        })
                                        <i class="fab fa-youtube input-icon text-red-500"></i>
                                    </div>
                                </div>

                                <!-- Twitter/X -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Twitter / X</label>
                                    <div class="relative">
                                        @Html.TextBoxFor(m => m.Twitter, new {
                                            @class = "input-with-icon w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-gray-800 focus:ring-2 focus:ring-gray-800/20 outline-none transition-all",
                                            @placeholder = "tu_usuario"
                                        })
                                        <i class="fab fa-x-twitter input-icon"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Horarios (Colapsable) -->
                    <div class="animate-fadeInUp delay-300 bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                        <button type="button" onclick="toggleSection('horariosSection')" class="w-full bg-gradient-to-r from-amber-500 to-orange-500 px-5 py-3 flex items-center justify-between">
                            <h2 class="text-white font-bold flex items-center gap-2">
                                <i class="fas fa-clock"></i>
                                Horarios de Atención <span class="text-white/70 text-sm font-normal">(opcional)</span>
                            </h2>
                            <i class="fas fa-chevron-down section-toggle text-white" id="horariosToggle"></i>
                        </button>
                        <div id="horariosSection" class="section-content">
                            <div class="p-5 space-y-3">
                                <p class="text-xs text-gray-500 mb-3">Formato sugerido: 8:00 AM - 6:00 PM</p>

                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="block text-xs font-medium text-gray-600 mb-1">Lunes</label>
                                        @Html.TextBoxFor(m => m.HorarioLunes, new {
                                            @class = "w-full px-3 py-2 text-sm rounded-lg border border-gray-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 outline-none",
                                            @placeholder = "8:00 - 18:00"
                                        })
                                    </div>
                                    <div>
                                        <label class="block text-xs font-medium text-gray-600 mb-1">Martes</label>
                                        @Html.TextBoxFor(m => m.HorarioMartes, new {
                                            @class = "w-full px-3 py-2 text-sm rounded-lg border border-gray-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 outline-none",
                                            @placeholder = "8:00 - 18:00"
                                        })
                                    </div>
                                    <div>
                                        <label class="block text-xs font-medium text-gray-600 mb-1">Miércoles</label>
                                        @Html.TextBoxFor(m => m.HorarioMiercoles, new {
                                            @class = "w-full px-3 py-2 text-sm rounded-lg border border-gray-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 outline-none",
                                            @placeholder = "8:00 - 18:00"
                                        })
                                    </div>
                                    <div>
                                        <label class="block text-xs font-medium text-gray-600 mb-1">Jueves</label>
                                        @Html.TextBoxFor(m => m.HorarioJueves, new {
                                            @class = "w-full px-3 py-2 text-sm rounded-lg border border-gray-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 outline-none",
                                            @placeholder = "8:00 - 18:00"
                                        })
                                    </div>
                                    <div>
                                        <label class="block text-xs font-medium text-gray-600 mb-1">Viernes</label>
                                        @Html.TextBoxFor(m => m.HorarioViernes, new {
                                            @class = "w-full px-3 py-2 text-sm rounded-lg border border-gray-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 outline-none",
                                            @placeholder = "8:00 - 18:00"
                                        })
                                    </div>
                                    <div>
                                        <label class="block text-xs font-medium text-gray-600 mb-1">Sábado</label>
                                        @Html.TextBoxFor(m => m.HorarioSabado, new {
                                            @class = "w-full px-3 py-2 text-sm rounded-lg border border-gray-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 outline-none",
                                            @placeholder = "8:00 - 14:00"
                                        })
                                    </div>
                                    <div class="col-span-2 sm:col-span-1">
                                        <label class="block text-xs font-medium text-gray-600 mb-1">Domingo</label>
                                        @Html.TextBoxFor(m => m.HorarioDomingo, new {
                                            @class = "w-full px-3 py-2 text-sm rounded-lg border border-gray-200 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 outline-none",
                                            @placeholder = "Cerrado"
                                        })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Columna Derecha - Mapa -->
                <div class="space-y-6">
                    <div class="animate-fadeInUp bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden sticky top-4">
                        <div class="bg-gradient-to-r from-red-500 to-rose-500 px-5 py-3">
                            <h2 class="text-white font-bold flex items-center gap-2">
                                <i class="fas fa-map-marker-alt"></i>
                                Ubicación del Negocio
                            </h2>
                        </div>
                        <div class="p-5 space-y-4">
                            <!-- Dirección -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1.5">
                                    Dirección <span class="text-red-500">*</span>
                                </label>
                                <div class="relative">
                                    @Html.TextBoxFor(m => m.Direccion, new {
                                        @class = "input-with-icon w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-red-500 focus:ring-2 focus:ring-red-500/20 outline-none transition-all",
                                        @placeholder = "Busca tu dirección...",
                                        @id = "searchLocation",
                                        @required = "required"
                                    })
                                    <i class="fas fa-search input-icon"></i>
                                </div>
                                <p class="text-xs text-gray-500 mt-1">
                                    <i class="fas fa-info-circle mr-1"></i>
                                    Busca la dirección o arrastra el marcador en el mapa
                                </p>
                            </div>

                            <!-- Campo oculto para coordenadas -->
                            @Html.HiddenFor(m => m.Localizacion, new { @id = "location" })

                            <!-- Mapa -->
                            <div class="rounded-xl overflow-hidden border border-gray-200" style="height: 400px;">
                                <div id="map"></div>
                            </div>

                            <!-- Coordenadas (solo lectura) -->
                            <div class="flex items-center gap-2 text-xs text-gray-500 bg-gray-50 rounded-lg px-3 py-2">
                                <i class="fas fa-crosshairs"></i>
                                <span>Coordenadas: </span>
                                <span id="coordsDisplay" class="font-mono">--</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botón Submit -->
            <div class="mt-8 flex justify-center">
                <button type="submit" id="submitBtn" class="group relative px-8 py-4 bg-gradient-to-r from-[#23916A] to-emerald-500 text-white font-bold text-lg rounded-2xl shadow-lg hover:shadow-xl transition-all hover:scale-105 flex items-center gap-3">
                    <span>Continuar al siguiente paso</span>
                    <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                </button>
            </div>
        }
    </main>

    <script>
        // ==========================================
        // MAPA
        // ==========================================
        function initMap() {
            // Coordenadas iniciales (Neiva, Huila)
            const initialLat = 2.9273;
            const initialLng = -75.2819;

            const map = new google.maps.Map(document.getElementById('map'), {
                center: { lat: initialLat, lng: initialLng },
                zoom: 14,
                styles: [
                    { featureType: "poi", stylers: [{ visibility: "simplified" }] }
                ],
                mapTypeControl: false,
                streetViewControl: false
            });

            const marker = new google.maps.Marker({
                position: { lat: initialLat, lng: initialLng },
                map: map,
                draggable: true,
                animation: google.maps.Animation.DROP,
                icon: {
                    url: 'https://maps.google.com/mapfiles/ms/icons/green-dot.png',
                    scaledSize: new google.maps.Size(40, 40)
                }
            });

            // Actualizar coordenadas
            function updateCoords(lat, lng) {
                document.getElementById('location').value = lat + ',' + lng;
                document.getElementById('coordsDisplay').textContent = lat.toFixed(6) + ', ' + lng.toFixed(6);
            }

            // SearchBox
            const searchBox = new google.maps.places.SearchBox(document.getElementById('searchLocation'));

            searchBox.addListener('places_changed', function() {
                const places = searchBox.getPlaces();
                if (places.length === 0) return;

                const place = places[0];
                map.setCenter(place.geometry.location);
                map.setZoom(17);
                marker.setPosition(place.geometry.location);
                updateCoords(place.geometry.location.lat(), place.geometry.location.lng());
            });

            // Drag marker
            marker.addListener('dragend', function() {
                const position = marker.getPosition();
                updateCoords(position.lat(), position.lng());
            });

            // Click en el mapa para mover marker
            map.addListener('click', function(e) {
                marker.setPosition(e.latLng);
                updateCoords(e.latLng.lat(), e.latLng.lng());
            });

            // Inicializar coordenadas
            updateCoords(initialLat, initialLng);
        }

        window.onload = initMap;

        // ==========================================
        // UPLOAD LOGO
        // ==========================================
        function previewLogo(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                const reader = new FileReader();

                reader.onload = function(e) {
                    document.getElementById('logoPreview').src = e.target.result;
                    document.getElementById('fileName').textContent = file.name;
                    document.getElementById('uploadPlaceholder').classList.add('hidden');
                    document.getElementById('uploadPreview').classList.remove('hidden');
                    document.getElementById('uploadArea').classList.add('has-image');
                };

                reader.readAsDataURL(file);
            }
        }

        function removeLogo() {
            document.getElementById('fileInput').value = '';
            document.getElementById('uploadPlaceholder').classList.remove('hidden');
            document.getElementById('uploadPreview').classList.add('hidden');
            document.getElementById('uploadArea').classList.remove('has-image');
        }

        // Drag and drop
        const uploadArea = document.getElementById('uploadArea');

        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.classList.add('dragover');
        });

        uploadArea.addEventListener('dragleave', () => {
            uploadArea.classList.remove('dragover');
        });

        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.classList.remove('dragover');
            const files = e.dataTransfer.files;
            if (files.length) {
                document.getElementById('fileInput').files = files;
                previewLogo(document.getElementById('fileInput'));
            }
        });

        // ==========================================
        // SECCIONES COLAPSABLES
        // ==========================================
        function toggleSection(sectionId) {
            const section = document.getElementById(sectionId);
            const toggle = document.getElementById(sectionId.replace('Section', 'Toggle'));

            section.classList.toggle('open');
            toggle.classList.toggle('open');
        }

        // ==========================================
        // VALIDACIÓN
        // ==========================================
        document.getElementById('registroForm').addEventListener('submit', function(e) {
            let isValid = true;

            // Validar nombre
            const nombre = document.getElementById('nombreNegocio');
            if (!nombre.value.trim()) {
                document.getElementById('nombreError').classList.remove('hidden');
                nombre.classList.add('border-red-500');
                isValid = false;
            } else {
                document.getElementById('nombreError').classList.add('hidden');
                nombre.classList.remove('border-red-500');
            }

            // Validar descripción
            const descripcion = document.getElementById('descripcionNegocio');
            if (!descripcion.value.trim()) {
                document.getElementById('descripcionError').classList.remove('hidden');
                descripcion.classList.add('border-red-500');
                isValid = false;
            } else {
                document.getElementById('descripcionError').classList.add('hidden');
                descripcion.classList.remove('border-red-500');
            }

            if (!isValid) {
                e.preventDefault();
                // Scroll to first error
                document.querySelector('.border-red-500')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });

        // Limpiar errores al escribir
        document.querySelectorAll('input, textarea').forEach(input => {
            input.addEventListener('input', function() {
                this.classList.remove('border-red-500');
                const errorSpan = this.parentElement.querySelector('.text-red-500') ||
                                  this.parentElement.parentElement.querySelector('.text-red-500');
                if (errorSpan) errorSpan.classList.add('hidden');
            });
        });
    </script>
</body>
</html>
