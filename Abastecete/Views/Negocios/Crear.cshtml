@model BusinessLogic.Models.Negocio;

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAPudyk3G3YG7GOEpId4xMK_WFIEenOSp8&libraries=places"></script>
    <style>
        #map {
            height: 380px;
            width: 100%;
        }
    </style>
</head>

<body class="bg-gray-100 font-sans">
    <div class="mx-auto mt-4 max-w-6xl rounded-lg bg-white p-8 shadow-lg">

        <h2 class="mb-6 text-center text-3xl font-bold text-[#F6580F]">Registro de Negocio</h2>

        @using (Html.BeginForm("GuardarDatosNegocio", "Negocios", FormMethod.Post, new
        {
            id = "registroForm",
            enctype = "multipart/form-data",
            @class = "grid grid-cols-1 md:grid-cols-2 gap-8"
        }))
        {
            <div class="md:col-span-2">
                @Html.ValidationSummary(true, "", new { @class = "text-red-500 text-sm" })
            </div>

            <!-- Lado Izquierdo -->
            <div class="space-y-4">
                <div>
                    <label class="block font-medium">Nombre del negocio</label>
                    @Html.TextBoxFor(m => m.Nombre, new { @type = "text", @class = "w-full border p-2 rounded", @placeholder = "Ingresa el nombre de tu negocio", @id = "nombreNegocio" })
                    <span id="nombreError" class="hidden text-sm text-red-500">Por favor, ingresa el nombre de tu negocio.</span>
                </div>

                <div>
                    <label class="block font-medium">Teléfono del negocio</label>
                    @Html.TextBoxFor(m => m.Telefono, new { @type = "text", @class = "w-full border p-2 rounded", @placeholder = "Ingresa el teléfono de tu negocio", @id = "telefonoNegocio" })
                    <span id="telefonoError" class="hidden text-sm text-red-500">Por favor, ingresa el teléfono de tu negocio.</span>
                </div>

                <div>
                    <label class="block font-medium">Logotipo</label>
                    <input type="file" id="fileInput" accept="image/*" name="logo_archivo"
                           class="w-full rounded border p-2 focus:outline-none focus:ring-2 focus:ring-[#e65100]" />
                </div>

                <div>
                    <label class="block font-medium">Dirección del negocio</label>
                    @Html.TextBoxFor(m => m.Direccion, new { @type = "text", @class = "w-full border p-2 rounded focus:outline-none focus:ring-2 focus:ring-[#e65100]", @placeholder = "Ingresa la dirección de tu negocio", @id = "searchLocation" })
                    <span id="direccionError" class="hidden text-sm text-red-500">Por favor, ingresa la dirección de tu negocio.</span>
                </div>

                <div>
                    <label class="block font-medium">Localización</label>
                    @Html.TextBoxFor(m => m.Localizacion, new { @type = "text", @class = "w-full border p-2 rounded focus:outline-none focus:ring-2 focus:ring-[#e65100]", @id = "location" })
                    <span id="direccionError" class="hidden text-sm text-red-500">Por favor, ingresa la dirección de tu negocio.</span>
                </div>

            </div>

            <div>
                <div id="map" class="mt-3 h-64 w-full rounded-md border"></div>
            </div>

            <div class="flex justify-center md:col-span-2">
                <button type="submit" class="w-full rounded-md bg-[#008f39] px-4 py-2 text-center font-bold text-white transition hover:bg-[#006d2c] md:w-1/2">
                    Siguiente
                </button>
            </div>
        }
    </div>



    <script>



        function initMap() {
            var map = new google.maps.Map(document.getElementById('map'), {
                center: { lat: 2.9273, lng: -75.2819 },
                zoom: 13
            });

            var marker = new google.maps.Marker({
                position: { lat: 2.9273, lng: -75.2819 },
                map: map,
                draggable: true
            });

            var searchBox = new google.maps.places.SearchBox(document.getElementById('searchLocation'));

            searchBox.addListener('places_changed', function() {
                var places = searchBox.getPlaces();
                if (places.length == 0) return;
                var place = places[0];
                map.setCenter(place.geometry.location);
                marker.setPosition(place.geometry.location);
                document.getElementById('location').value = place.geometry.location.lat() + ',' + place.geometry.location.lng();
            });

            marker.addListener('dragend', function() {
                var position = marker.getPosition();
                document.getElementById('location').value = position.lat() + ',' + position.lng();
            });
        }

        window.onload = initMap;
    </script>
</body>

