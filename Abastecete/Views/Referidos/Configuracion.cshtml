@model BusinessLogic.Models.ConfiguracionReferidos
@using BusinessLogic.Utilidades

@{
    ViewData["Title"] = "Configuracion de Referidos";
    ViewData["Description"] = "Configura los descuentos del sistema de referidos";
}

<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <div class="bg-white border-b border-gray-200">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center gap-4">
                <a href="@Url.Action("Principal", "Home")"
                   class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-600 hover:text-gray-800 transition-colors">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Configuracion de Referidos</h1>
                    <p class="text-sm text-gray-500">Configura los descuentos para referidos y duenos de codigo</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenido -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <form id="formConfiguracion" class="space-y-6">
            <!-- Estado del sistema -->
            <div class="bg-white rounded-xl border border-gray-200 p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900">Estado del Sistema</h3>
                        <p class="text-sm text-gray-500">Activa o desactiva el sistema de descuentos por referidos</p>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="descuentoActivo" name="descuentoActivo"
                               class="sr-only peer" @(Model.DescuentoActivo ? "checked" : "")>
                        <div class="w-14 h-7 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-emerald-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-0.5 after:left-[4px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-emerald-600"></div>
                        <span class="ml-3 text-sm font-medium text-gray-900" id="estadoTexto">
                            @(Model.DescuentoActivo ? "Activo" : "Inactivo")
                        </span>
                    </label>
                </div>
            </div>

            <!-- Descuento para el Referido -->
            <div class="bg-white rounded-xl border border-gray-200 p-6">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center">
                        <i class="fas fa-user-plus text-blue-600"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900">Descuento para el Referido</h3>
                        <p class="text-sm text-gray-500">Descuento que recibe quien usa el codigo en su primera compra</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Tipo de Descuento</label>
                        <select id="tipoDescuentoReferido" name="tipoDescuentoReferido"
                                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
                            @if (Model.TipoDescuentoReferido == "PORCENTAJE")
                            {
                                <option value="PORCENTAJE" selected>Porcentaje (%)</option>
                                <option value="MONTO_FIJO">Monto Fijo ($)</option>
                            }
                            else
                            {
                                <option value="PORCENTAJE">Porcentaje (%)</option>
                                <option value="MONTO_FIJO" selected>Monto Fijo ($)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Valor</label>
                        <div class="relative">
                            <span id="prefijoReferido" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">
                                @(Model.TipoDescuentoReferido == "PORCENTAJE" ? "%" : "$")
                            </span>
                            <input type="number" id="valorDescuentoReferido" name="valorDescuentoReferido"
                                   value="@Model.ValorDescuentoReferido" step="0.01" min="0"
                                   class="w-full pl-8 pr-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Credito para el Dueno -->
            <div class="bg-white rounded-xl border border-gray-200 p-6">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center">
                        <i class="fas fa-hand-holding-dollar text-emerald-600"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900">Credito para el Dueno del Codigo</h3>
                        <p class="text-sm text-gray-500">Credito que recibe quien comparte su codigo cuando el referido compra</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Tipo de Credito</label>
                        <select id="tipoDescuentoDueno" name="tipoDescuentoDueno"
                                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
                            @if (Model.TipoDescuentoDueno == "PORCENTAJE")
                            {
                                <option value="PORCENTAJE" selected>Porcentaje de la compra (%)</option>
                                <option value="MONTO_FIJO">Monto Fijo ($)</option>
                            }
                            else
                            {
                                <option value="PORCENTAJE">Porcentaje de la compra (%)</option>
                                <option value="MONTO_FIJO" selected>Monto Fijo ($)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Valor</label>
                        <div class="relative">
                            <span id="prefijoDueno" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">
                                @(Model.TipoDescuentoDueno == "PORCENTAJE" ? "%" : "$")
                            </span>
                            <input type="number" id="valorDescuentoDueno" name="valorDescuentoDueno"
                                   value="@Model.ValorDescuentoDueno" step="0.01" min="0"
                                   class="w-full pl-8 pr-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Info -->
            <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
                <div class="flex gap-3">
                    <i class="fas fa-info-circle text-blue-500 mt-0.5"></i>
                    <div class="text-sm text-blue-800">
                        <p class="font-medium mb-1">Como funciona el sistema de referidos:</p>
                        <ul class="list-disc list-inside space-y-1 text-blue-700">
                            <li>El <strong>referido</strong> recibe descuento solo en su <strong>primera compra</strong> de membresia</li>
                            <li>El <strong>dueno del codigo</strong> recibe credito cuando el referido <strong>completa una compra</strong></li>
                            <li>El credito acumulado se puede usar en futuras renovaciones o cambios de plan</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Botones -->
            <div class="flex justify-end gap-3">
                <a href="@Url.Action("Principal", "Home")"
                   class="px-6 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors">
                    Cancelar
                </a>
                <button type="submit" id="btnGuardar"
                        class="px-6 py-2.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors flex items-center gap-2">
                    <i class="fas fa-save"></i>
                    Guardar Configuracion
                </button>
            </div>
        </form>

        @if (Model.FechaActualizacion.HasValue)
        {
            <p class="text-center text-sm text-gray-500 mt-4">
                Ultima actualizacion: @Model.FechaActualizacion.Value.ToString("dd/MM/yyyy HH:mm")
            </p>
        }
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('formConfiguracion');
        const tipoReferido = document.getElementById('tipoDescuentoReferido');
        const tipoDueno = document.getElementById('tipoDescuentoDueno');
        const prefijoReferido = document.getElementById('prefijoReferido');
        const prefijoDueno = document.getElementById('prefijoDueno');
        const checkActivo = document.getElementById('descuentoActivo');
        const estadoTexto = document.getElementById('estadoTexto');

        // Actualizar prefijos segun tipo
        tipoReferido.addEventListener('change', function() {
            prefijoReferido.textContent = this.value === 'PORCENTAJE' ? '%' : '$';
        });

        tipoDueno.addEventListener('change', function() {
            prefijoDueno.textContent = this.value === 'PORCENTAJE' ? '%' : '$';
        });

        // Actualizar texto del toggle
        checkActivo.addEventListener('change', function() {
            estadoTexto.textContent = this.checked ? 'Activo' : 'Inactivo';
        });

        // Enviar formulario
        form.addEventListener('submit', async function(e) {
            e.preventDefault();

            const btnGuardar = document.getElementById('btnGuardar');
            btnGuardar.disabled = true;
            btnGuardar.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Guardando...';

            const data = {
                tipoDescuentoReferido: tipoReferido.value,
                valorDescuentoReferido: parseFloat(document.getElementById('valorDescuentoReferido').value) || 0,
                tipoDescuentoDueno: tipoDueno.value,
                valorDescuentoDueno: parseFloat(document.getElementById('valorDescuentoDueno').value) || 0,
                descuentoActivo: checkActivo.checked
            };

            try {
                const response = await fetch('@Url.Action("ActualizarConfiguracion", "Referidos")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Guardado',
                        text: result.mensaje,
                        timer: 2000,
                        showConfirmButton: false
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: result.mensaje || 'No se pudo guardar la configuracion'
                    });
                }
            } catch (error) {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Error al conectar con el servidor'
                });
            } finally {
                btnGuardar.disabled = false;
                btnGuardar.innerHTML = '<i class="fas fa-save"></i> Guardar Configuracion';
            }
        });
    });
</script>
}
