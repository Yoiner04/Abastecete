@model List<BusinessLogic.Models.Referido>
@{
    ViewData["Title"] = "Mis Referidos";
    var resumen = ViewBag.Resumen as BusinessLogic.Models.ResumenReferidos;
}

<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <div class="bg-white border-b border-gray-200">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center gap-4">
                <a href="@Url.Action("MiMembresia", "Negocios")"
                   class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-600 hover:text-gray-800 transition-colors">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Mis Referidos</h1>
                    <p class="text-sm text-gray-500">Comparte tu codigo y gana credito para tus membresias</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenido -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <!-- Tarjeta de codigo -->
        <div class="bg-gradient-to-r from-emerald-500 to-teal-600 rounded-2xl p-6 mb-6 text-white">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div>
                    <p class="text-emerald-100 text-sm mb-1">Tu codigo de referido</p>
                    <div class="flex items-center gap-3">
                        <span id="codigoReferido" class="text-3xl font-bold tracking-wider">
                            @(resumen?.CodigoReferido ?? "---")
                        </span>
                        <button onclick="copiarCodigo()" class="p-2 bg-white/20 rounded-lg hover:bg-white/30 transition-colors" title="Copiar codigo">
                            <i class="fas fa-copy"></i>
                        </button>
                    </div>
                </div>
                <div class="flex gap-2">
                    <button onclick="compartirWhatsApp()" class="px-4 py-2 bg-white/20 rounded-lg hover:bg-white/30 transition-colors flex items-center gap-2">
                        <i class="fab fa-whatsapp"></i>
                        <span class="hidden sm:inline">WhatsApp</span>
                    </button>
                    <button onclick="compartirGenerico()" class="px-4 py-2 bg-white/20 rounded-lg hover:bg-white/30 transition-colors flex items-center gap-2">
                        <i class="fas fa-share-alt"></i>
                        <span class="hidden sm:inline">Compartir</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-white rounded-xl border border-gray-200 p-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center">
                        <i class="fas fa-users text-blue-600"></i>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-gray-900">@(resumen?.TotalReferidos ?? 0)</p>
                        <p class="text-xs text-gray-500">Total Referidos</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl border border-gray-200 p-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center">
                        <i class="fas fa-shopping-cart text-emerald-600"></i>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-gray-900">@(resumen?.ReferidosCompraron ?? 0)</p>
                        <p class="text-xs text-gray-500">Han Comprado</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl border border-gray-200 p-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-purple-100 flex items-center justify-center">
                        <i class="fas fa-coins text-purple-600"></i>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-gray-900">$@((resumen?.CreditoTotalGanado ?? 0).ToString("N0"))</p>
                        <p class="text-xs text-gray-500">Total Ganado</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-xl border border-gray-200 p-4 ring-2 ring-emerald-500">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-emerald-500 flex items-center justify-center">
                        <i class="fas fa-wallet text-white"></i>
                    </div>
                    <div>
                        <p class="text-2xl font-bold text-emerald-600">$@((resumen?.CreditoDisponible ?? 0).ToString("N0"))</p>
                        <p class="text-xs text-gray-500">Credito Disponible</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Info de credito -->
        @if ((resumen?.CreditoDisponible ?? 0) > 0)
        {
            <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 mb-6">
                <div class="flex items-center gap-3">
                    <i class="fas fa-gift text-emerald-600 text-xl"></i>
                    <div>
                        <p class="font-medium text-emerald-900">Tienes credito disponible!</p>
                        <p class="text-sm text-emerald-700">Puedes usar tu credito de $@((resumen?.CreditoDisponible ?? 0).ToString("N0")) en tu proxima renovacion o cambio de plan.</p>
                    </div>
                </div>
            </div>
        }

        <!-- Lista de referidos -->
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200">
                <h3 class="text-lg font-semibold text-gray-900">Lista de Referidos</h3>
            </div>

            @if (Model.Count == 0)
            {
                <div class="p-12 text-center">
                    <div class="w-16 h-16 mx-auto bg-gray-100 rounded-full flex items-center justify-center mb-4">
                        <i class="fas fa-user-friends text-2xl text-gray-400"></i>
                    </div>
                    <h4 class="text-lg font-medium text-gray-900 mb-2">Aun no tienes referidos</h4>
                    <p class="text-gray-500 mb-4">Comparte tu codigo con amigos y colegas para empezar a ganar credito</p>
                    <button onclick="compartirGenerico()" class="px-6 py-2.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors">
                        <i class="fas fa-share-alt mr-2"></i>
                        Compartir mi codigo
                    </button>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Referido</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha Registro</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Membresia</th>
                                <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Credito Ganado</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            @foreach (var referido in Model)
                            {
                                <tr class="hover:bg-gray-50">
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center">
                                            <div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center">
                                                <span class="text-sm font-medium text-gray-600">
                                                    @(referido.Nombres?.Substring(0, 1).ToUpper())@(referido.Apellidos?.Substring(0, 1).ToUpper())
                                                </span>
                                            </div>
                                            <div class="ml-3">
                                                <p class="text-sm font-medium text-gray-900">@referido.NombreCompleto</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        @referido.FechaRegistro.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        @if (referido.HaComprado)
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                                                <i class="fas fa-check-circle mr-1"></i>
                                                Compro
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
                                                <i class="fas fa-clock mr-1"></i>
                                                Pendiente
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                        @(referido.MembresiaComprada ?? "-")
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-right">
                                        @if (referido.CreditoRecibido.HasValue && referido.CreditoRecibido > 0)
                                        {
                                            <span class="font-medium text-emerald-600">+$@referido.CreditoRecibido.Value.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span class="text-gray-400">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Como funciona -->
        <div class="mt-6 bg-white rounded-xl border border-gray-200 p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Como funciona?</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="text-center">
                    <div class="w-12 h-12 mx-auto bg-blue-100 rounded-full flex items-center justify-center mb-3">
                        <span class="text-xl font-bold text-blue-600">1</span>
                    </div>
                    <h4 class="font-medium text-gray-900 mb-1">Comparte tu codigo</h4>
                    <p class="text-sm text-gray-500">Envia tu codigo a amigos, colegas o conocidos que quieran publicar en Abastecete</p>
                </div>
                <div class="text-center">
                    <div class="w-12 h-12 mx-auto bg-emerald-100 rounded-full flex items-center justify-center mb-3">
                        <span class="text-xl font-bold text-emerald-600">2</span>
                    </div>
                    <h4 class="font-medium text-gray-900 mb-1">Ellos se registran</h4>
                    <p class="text-sm text-gray-500">Cuando se registran con tu codigo, obtienen un descuento en su primera membresia</p>
                </div>
                <div class="text-center">
                    <div class="w-12 h-12 mx-auto bg-purple-100 rounded-full flex items-center justify-center mb-3">
                        <span class="text-xl font-bold text-purple-600">3</span>
                    </div>
                    <h4 class="font-medium text-gray-900 mb-1">Tu ganas credito</h4>
                    <p class="text-sm text-gray-500">Cuando compran una membresia, recibes credito para usar en tus renovaciones</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const codigoReferido = '@(resumen?.CodigoReferido ?? "")';

    function copiarCodigo() {
        navigator.clipboard.writeText(codigoReferido).then(() => {
            Swal.fire({
                icon: 'success',
                title: 'Copiado!',
                text: 'El codigo ha sido copiado al portapapeles',
                timer: 1500,
                showConfirmButton: false
            });
        });
    }

    function compartirWhatsApp() {
        const mensaje = encodeURIComponent(`Registrate en Abastecete con mi codigo ${codigoReferido} y obtiene un descuento en tu primera membresia! https://abastecete.com/registro?ref=${codigoReferido}`);
        window.open(`https://wa.me/?text=${mensaje}`, '_blank');
    }

    function compartirGenerico() {
        if (navigator.share) {
            navigator.share({
                title: 'Codigo de Referido - Abastecete',
                text: `Registrate con mi codigo ${codigoReferido} y obtiene un descuento!`,
                url: `https://abastecete.com/registro?ref=${codigoReferido}`
            });
        } else {
            copiarCodigo();
        }
    }
</script>
}
