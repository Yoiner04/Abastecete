@model List<BusinessLogic.Models.Membresia>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Abastecete.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.6.3/flowbite.min.js"></script>

</head>

<body class="bg-gray-100 py-10">
    <br />
    <div class="mx-auto max-w-6xl px-4">
        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var membresia in Model)
            {
                <div class="flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-md transition hover:shadow-lg">
                    <div class="h-48 w-full overflow-hidden">
                        <img src="~/images/@(membresia.Nombre).png" alt="Membresía @membresia.Nombre" class="h-full w-full object-cover">
                    </div>

                    <div class="flex flex-col items-center justify-between space-y-4 p-4 text-center">
                        <h3 class="text-lg font-bold text-gray-800">@membresia.Nombre</h3>

                        <a href="@Url.Action("Publicar", "Membresias", new { nombre = membresia.Nombre })"
                           class="w-full rounded-full bg-[#F6580F] py-2 text-sm font-semibold text-white uppercase transition hover:bg-[#15803D]">
                            Seleccionar
                        </a>
                    </div>
                </div>


            }
        </div>
    </div>
    

</body>
</html>
