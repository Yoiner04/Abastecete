@model List<BusinessLogic.Models.Membresia>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Abastecete.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/1.6.3/flowbite.min.js"></script>

</head>

<body class="bg-gray-100 py-10">
    <br />
    <div class="mx-auto max-w-6xl px-4">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var membresia in Model)
            {
                <div class="flex flex-col justify-between overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-md transition hover:shadow-xl">
                    <!-- Encabezado con imagen -->
                    <div class="h-56 w-full overflow-hidden bg-gray-100">
                        <img src="@ViewBag.nombre" alt="Encabezado" class="h-full w-full object-cover" />
                    </div>

                    <!-- Contenido -->
                    <div class="flex h-[75%] flex-col justify-between p-6">
                        <div>
                            <h3 class="text-center text-xl font-bold text-gray-800">@membresia.Nombre</h3>
                            <p class="mt-2 text-center text-3xl font-bold text-black">
                                @(membresia.Costo == 0 ? "$0" : $"${membresia.Costo:N0}")
                                <span class="text-lg font-medium text-gray-400">/mes</span>
                            </p>

                            <ul class="mt-4 space-y-3 text-sm text-gray-700">
                                @foreach (var line in membresia.Descripcion.Split(new[] { '\n', '*' }, StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <li class="flex items-start gap-2">
                                        <span class="mt-[3px] text-purple-600">✔</span>
                                        <span>@line.Trim()</span>
                                    </li>
                                }
                            </ul>
                        </div>

                        <!-- Botón principal -->
                        <div class="mt-6">
                            @if (membresia.Costo == 0)
                            {
                                <a href="@Url.Action("CompletarRegistro", "Negocios", new { tipoMembresiaId = membresia.Id })"
                                   class="block w-full rounded-full border border-[#F6580F] bg-white py-2 text-center text-sm font-semibold text-[#F6580F] uppercase transition hover:bg-[#15803D]">
                                    Empieza Ahora
                                </a>

                            }
                            else
                            {
                                <a class="open-modal block w-full rounded-full bg-[#F6580F] py-2 text-center text-sm font-semibold text-white uppercase transition hover:bg-[#15803D]"
                                   data-id="@membresia.Id"
                                   data-nombre="@membresia.Nombre"
                                   data-descripcion="@membresia.Descripcion"
                                   data-costomensual="@membresia.Costo"
                                   data-costotrimestral="@membresia.Costo_trimestral"
                                   data-costosemestral="@membresia.Costo_semestral"
                                   data-costoanual="@membresia.Costo_anual"
                                   data-modal-target="default-modal"
                                   data-modal-toggle="default-modal">
                                    Empieza Ahora
                                </a>

                            }
                        </div>
                    </div>
                </div>


            }
        </div>
    </div>

    <div id="default-modal" tabindex="-1" aria-hidden="true" class="bg-opacity-40 fixed top-0 left-0 z-50 hidden h-screen w-screen overflow-x-hidden overflow-y-auto backdrop-blur-sm">
        <div class="relative mx-auto mt-24 w-full max-w-md rounded-2xl bg-white p-6 shadow-xl">
            <div class="mb-4 flex items-center justify-between border-b pb-3">
                <h3 class="text-xl font-bold text-gray-800">Seleccionar plan</h3>
                <button type="button" class="rounded-md p-1 text-gray-500 hover:bg-gray-100 hover:text-gray-700" data-modal-hide="default-modal">
                    <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="space-y-4">
                <div>
                    <label for="planes" class="mb-1 block text-sm font-medium text-gray-700">Selecciona la duración</label>
                    <select id="planes" class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm text-gray-900 focus:border-green-500 focus:ring-1 focus:ring-green-500">
                        <option value="mensual">Mensual</option>
                        <option value="trimestral">Trimestral</option>
                        <option value="semestral">Semestral</option>
                        <option value="anual">Anual</option>
                    </select>
                </div>

                <div id="plan-price" class="text-center text-lg font-semibold text-green-600"></div>

                <div class="mt-4">
                    <div id="epayco-button-container" class="flex justify-center"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const buttons = document.querySelectorAll(".open-modal");
            const selectPlanes = document.getElementById("planes");
            const epaycoContainer = document.getElementById("epayco-button-container");
            const priceLabel = document.getElementById("plan-price");

            let precios = { mensual: 0, trimestral: 0, semestral: 0, anual: 0 };
            let nombreMembresia = "";
            let descripcionMembresia = "";
            let idMembresia = 0;

            function crearBotonEpayco(precio, idMembresia) {
                epaycoContainer.innerHTML = "";

                const precioTotal = Math.round(precio);
                const precioBase = Math.round(precio / 1.19);
                const impuesto = precioTotal - precioBase;

                priceLabel.textContent = `Total a pagar: $${precioTotal.toLocaleString()} COP`;

                const epaycoScript = document.createElement("script");
                epaycoScript.src = "https://checkout.epayco.co/checkout.js";
                epaycoScript.classList.add("epayco-button");
                epaycoScript.setAttribute("data-epayco-key", "@ViewBag.apikey");
                epaycoScript.setAttribute("data-epayco-amount", precioTotal.toString());
                epaycoScript.setAttribute("data-epayco-tax", impuesto.toString());
                epaycoScript.setAttribute("data-epayco-tax-base", precioBase.toString());
                epaycoScript.setAttribute("data-epayco-name", nombreMembresia);
                epaycoScript.setAttribute("data-epayco-description", descripcionMembresia);
                epaycoScript.setAttribute("data-epayco-currency", "cop");
                epaycoScript.setAttribute("data-epayco-country", "co");
                epaycoScript.setAttribute("data-epayco-external", "false");
                epaycoScript.setAttribute("data-epayco-button", "https://multimedia.epayco.co/dashboard/btns/btn5.png");
                epaycoScript.setAttribute("data-epayco-response", `http://167.71.91.199:7076/Negocios/CompletarRegistro?tipoMembresiaId=${idMembresia}`);
                epaycoScript.setAttribute("data-epayco-test", "true");

                epaycoContainer.appendChild(epaycoScript);
            }

            selectPlanes.addEventListener("change", function () {
                if (precios[this.value] !== undefined) {
                    crearBotonEpayco(precios[this.value], idMembresia);
                }
            });

            buttons.forEach(button => {
                button.addEventListener("click", function () {
                    idMembresia = this.getAttribute("data-id");
                    nombreMembresia = this.getAttribute("data-nombre") || "Plan";
                    descripcionMembresia = this.getAttribute("data-descripcion") || "Sin descripción";
                    precios.mensual = parseFloat(this.getAttribute("data-costomensual")) || 0;
                    precios.trimestral = parseFloat(this.getAttribute("data-costotrimestral")) || 0;
                    precios.semestral = parseFloat(this.getAttribute("data-costosemestral")) || 0;
                    precios.anual = parseFloat(this.getAttribute("data-costoanual")) || 0;

                    if (precios.mensual > 0) {
                        selectPlanes.value = "mensual";
                        crearBotonEpayco(precios.mensual, idMembresia);
                    } else {
                        selectPlanes.value = "anual";
                        crearBotonEpayco(precios.anual, idMembresia);
                    }
                });
            });
        });
    </script>


</body>
</html>
