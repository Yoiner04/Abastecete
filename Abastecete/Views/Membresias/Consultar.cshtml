@model List<BusinessLogic.Models.Membresia>
@using BusinessLogic.Utilidades

@{
    ViewData["Title"] = "Gestión de Membresías";
    var tienePermiso = RolPermisos.TienePermiso("Administrar Membresias", Context.Session.GetString("permisos"));
}

<!-- Header a ancho completo -->
<div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-4">
                <a href="@Url.Action("Principal", "Home")"
                   class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-600 hover:text-gray-800 transition-colors">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Gestión de Membresías</h1>
                    <p class="text-sm text-gray-500 mt-1">Administra los planes y precios de membresías</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <a href="@Url.Action("Tipos", "Membresias")"
                   class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg transition-colors">
                    <i class="fas fa-eye mr-2"></i>
                    Ver Tipos
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Contenido con contenedor -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

<!-- Stats Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-xl border border-gray-200 p-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center">
                <i class="fas fa-crown text-emerald-600"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-gray-900">@Model.Count</p>
                <p class="text-xs text-gray-500">Total Membresías</p>
            </div>
        </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center">
                <i class="fas fa-check-circle text-green-600"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-gray-900">@Model.Count(m => m.Estado == 1)</p>
                <p class="text-xs text-gray-500">Activas</p>
            </div>
        </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-red-100 flex items-center justify-center">
                <i class="fas fa-times-circle text-red-600"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-gray-900">@Model.Count(m => m.Estado != 1)</p>
                <p class="text-xs text-gray-500">Inactivas</p>
            </div>
        </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-purple-100 flex items-center justify-center">
                <i class="fas fa-dollar-sign text-purple-600"></i>
            </div>
            <div>
                @{
                    var promedio = Model.Any() ? Model.Average(m => m.Costo) : 0;
                }
                <p class="text-2xl font-bold text-gray-900">$@promedio.ToString("N0")</p>
                <p class="text-xs text-gray-500">Precio Promedio</p>
            </div>
        </div>
    </div>
</div>

<!-- Filtros y búsqueda -->
<div class="bg-white rounded-xl border border-gray-200 p-4 mb-6">
    <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center justify-between">
        <div class="flex flex-col sm:flex-row gap-3 flex-1">
            <div class="relative flex-1 max-w-md">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                <input type="text" id="searchInput" placeholder="Buscar membresía..."
                       class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
            </div>
            <select id="filterEstado" class="px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
                <option value="">Todos los estados</option>
                <option value="1">Activas</option>
                <option value="0">Inactivas</option>
            </select>
        </div>
        <div class="flex items-center gap-2 text-sm text-gray-600">
            <span>Mostrar:</span>
            <select id="itemsPerPage" class="px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500">
                <option value="10">10</option>
                <option value="25" selected>25</option>
                <option value="50">50</option>
            </select>
        </div>
    </div>
</div>

<!-- Tabla -->
<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full" id="membresiaTable">
            <thead>
                <tr class="bg-gray-50 border-b border-gray-200">
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Nombre</th>
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Descripción</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">Mensual</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">Trimestral</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">Semestral</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">Anual</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">Productos</th>
                    <th class="px-4 py-3 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">Estado</th>
                    @if (tienePermiso)
                    {
                        <th class="px-4 py-3 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">Acciones</th>
                    }
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200" id="tableBody">
                @foreach (var membresia in Model)
                {
                    <tr class="hover:bg-gray-50 transition-colors data-row"
                        data-nombre="@membresia.Nombre.ToLower()"
                        data-estado="@membresia.Estado">
                        <td class="px-4 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center text-white font-bold">
                                    @membresia.Nombre.Substring(0, 1).ToUpper()
                                </div>
                                <div>
                                    <p class="font-semibold text-gray-900">@membresia.Nombre</p>
                                    <p class="text-xs text-gray-500">@membresia.Duracion hrs duración</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-4">
                            <div class="max-w-xs">
                                @{
                                    var lines = membresia.Descripcion?.Split(new[] { '\n', '*' }, StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
                                    var previewLines = lines.Take(2);
                                }
                                <ul class="text-sm text-gray-600 space-y-1">
                                    @foreach (var line in previewLines)
                                    {
                                        <li class="flex items-start gap-1">
                                            <i class="fas fa-check text-emerald-500 mt-0.5 text-xs"></i>
                                            <span class="truncate">@line.Trim()</span>
                                        </li>
                                    }
                                    @if (lines.Length > 2)
                                    {
                                        <li class="text-xs text-gray-400">+@(lines.Length - 2) más...</li>
                                    }
                                </ul>
                            </div>
                        </td>
                        <td class="px-4 py-4 text-center">
                            <span class="font-semibold text-gray-900">$@membresia.Costo.ToString("N0")</span>
                        </td>
                        <td class="px-4 py-4 text-center">
                            <span class="text-gray-700">$@membresia.Costo_trimestral.ToString("N0")</span>
                        </td>
                        <td class="px-4 py-4 text-center">
                            <span class="text-gray-700">$@membresia.Costo_semestral.ToString("N0")</span>
                        </td>
                        <td class="px-4 py-4 text-center">
                            <span class="text-gray-700">$@membresia.Costo_anual.ToString("N0")</span>
                        </td>
                        <td class="px-4 py-4 text-center">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                @membresia.Cantidad productos
                            </span>
                        </td>
                        <td class="px-4 py-4 text-center">
                            @if (membresia.Estado == 1)
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    <span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-1.5"></span>
                                    Activa
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                    <span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-1.5"></span>
                                    Inactiva
                                </span>
                            }
                        </td>
                        @if (tienePermiso)
                        {
                            <td class="px-4 py-4 text-center">
                                <button onclick="editarMembresia(@membresia.Id)"
                                        class="inline-flex items-center px-3 py-1.5 text-sm font-medium text-emerald-700 bg-emerald-50 hover:bg-emerald-100 rounded-lg transition-colors">
                                    <i class="fas fa-edit mr-1.5"></i>
                                    Editar
                                </button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Empty state -->
    <div id="emptyState" class="hidden py-12 text-center">
        <div class="w-16 h-16 rounded-full bg-gray-100 flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-search text-2xl text-gray-400"></i>
        </div>
        <h3 class="text-lg font-medium text-gray-900 mb-1">No se encontraron membresías</h3>
        <p class="text-gray-500">Intenta con otros filtros de búsqueda</p>
    </div>

    <!-- Paginación -->
    <div class="px-4 py-3 border-t border-gray-200 bg-gray-50">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
            <p class="text-sm text-gray-600">
                Mostrando <span id="showingFrom" class="font-medium">1</span> a <span id="showingTo" class="font-medium">@Math.Min(25, Model.Count)</span> de <span id="totalItems" class="font-medium">@Model.Count</span> membresías
            </p>
            <div class="flex items-center gap-2">
                <button id="prevPage" class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
                    <i class="fas fa-chevron-left mr-1"></i> Anterior
                </button>
                <div id="pageNumbers" class="flex items-center gap-1">
                    <!-- Se llena dinámicamente -->
                </div>
                <button id="nextPage" class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
                    Siguiente <i class="fas fa-chevron-right ml-1"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Editar Membresía -->
<div id="membership-modal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 p-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="p-6 border-b border-gray-200">
            <div class="flex items-center justify-between">
                <h2 class="text-xl font-bold text-gray-900">Editar Membresía</h2>
                <button onclick="closeModal()" class="w-8 h-8 rounded-lg hover:bg-gray-100 flex items-center justify-center text-gray-500">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <form id="membership-form" class="p-6 space-y-4">
            <input type="hidden" id="membership-id">

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Nombre</label>
                <input type="text" id="membership-name"
                       class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" required>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
                <textarea id="membership-description" rows="3"
                          class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" required></textarea>
            </div>

            <div class="grid grid-cols-3 gap-3">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Costo Mensual</label>
                    <input type="number" id="membership-cost" min="0"
                           class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" required>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Duración (Hrs)</label>
                    <input type="number" id="membership-duration" min="0"
                           class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" required>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Productos</label>
                    <input type="number" id="membership-quantity" min="0"
                           class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" required>
                </div>
            </div>

            <div class="grid grid-cols-3 gap-3">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Trimestral</label>
                    <input type="number" id="membership-cost-tri" min="0"
                           class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" required>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Semestral</label>
                    <input type="number" id="membership-cost-sem" min="0"
                           class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" required>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Anual</label>
                    <input type="number" id="membership-cost-anu" min="0"
                           class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500" required>
                </div>
            </div>

            <div class="flex items-center gap-2 pt-2">
                <input type="checkbox" id="status-checkbox"
                       class="w-4 h-4 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500">
                <label for="status-checkbox" class="text-sm font-medium text-gray-700">Membresía activa</label>
            </div>

            <div class="flex gap-3 pt-4">
                <button type="button" onclick="closeModal()"
                        class="flex-1 px-4 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium transition-colors">
                    Cancelar
                </button>
                <button type="submit"
                        class="flex-1 px-4 py-2.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 font-medium transition-colors">
                    <i class="fas fa-save mr-2"></i>Guardar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Toast de notificación -->
</div> <!-- Cierre del contenedor principal -->

<div id="toast" class="hidden fixed bottom-4 right-4 z-50">
    <div class="flex items-center gap-3 px-4 py-3 rounded-lg shadow-lg" id="toastContent">
        <i id="toastIcon" class="fas"></i>
        <span id="toastMessage" class="font-medium"></span>
    </div>
</div>

@section Scripts {
<script>
    // Variables de paginación
    let currentPage = 1;
    let itemsPerPage = 25;
    let filteredRows = [];
    let allRows = [];

    document.addEventListener('DOMContentLoaded', function() {
        allRows = Array.from(document.querySelectorAll('.data-row'));
        filteredRows = [...allRows];

        // Eventos
        document.getElementById('searchInput').addEventListener('input', applyFilters);
        document.getElementById('filterEstado').addEventListener('change', applyFilters);
        document.getElementById('itemsPerPage').addEventListener('change', function() {
            itemsPerPage = parseInt(this.value);
            currentPage = 1;
            renderPage();
        });
        document.getElementById('prevPage').addEventListener('click', () => changePage(-1));
        document.getElementById('nextPage').addEventListener('click', () => changePage(1));

        renderPage();
    });

    function applyFilters() {
        const search = document.getElementById('searchInput').value.toLowerCase();
        const estado = document.getElementById('filterEstado').value;

        filteredRows = allRows.filter(row => {
            const nombre = row.dataset.nombre;
            const rowEstado = row.dataset.estado;

            const matchSearch = !search || nombre.includes(search);
            const matchEstado = !estado || rowEstado === estado;

            return matchSearch && matchEstado;
        });

        currentPage = 1;
        renderPage();
    }

    function renderPage() {
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        const totalPages = Math.ceil(filteredRows.length / itemsPerPage);

        // Ocultar todas las filas
        allRows.forEach(row => row.style.display = 'none');

        // Mostrar filas de la página actual
        filteredRows.slice(start, end).forEach(row => row.style.display = '');

        // Actualizar info
        document.getElementById('showingFrom').textContent = filteredRows.length ? start + 1 : 0;
        document.getElementById('showingTo').textContent = Math.min(end, filteredRows.length);
        document.getElementById('totalItems').textContent = filteredRows.length;

        // Estado vacío
        document.getElementById('emptyState').classList.toggle('hidden', filteredRows.length > 0);
        document.getElementById('tableBody').style.display = filteredRows.length ? '' : 'none';

        // Paginación
        document.getElementById('prevPage').disabled = currentPage === 1;
        document.getElementById('nextPage').disabled = currentPage >= totalPages;

        renderPageNumbers(totalPages);
    }

    function renderPageNumbers(totalPages) {
        const container = document.getElementById('pageNumbers');
        container.innerHTML = '';

        const maxVisible = 5;
        let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
        let endPage = Math.min(totalPages, startPage + maxVisible - 1);

        if (endPage - startPage + 1 < maxVisible) {
            startPage = Math.max(1, endPage - maxVisible + 1);
        }

        for (let i = startPage; i <= endPage; i++) {
            const btn = document.createElement('button');
            btn.textContent = i;
            btn.className = `px-3 py-1.5 text-sm font-medium rounded-lg transition-colors ${
                i === currentPage
                    ? 'bg-emerald-600 text-white'
                    : 'text-gray-700 bg-white border border-gray-300 hover:bg-gray-50'
            }`;
            btn.onclick = () => { currentPage = i; renderPage(); };
            container.appendChild(btn);
        }
    }

    function changePage(delta) {
        const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
        currentPage = Math.max(1, Math.min(totalPages, currentPage + delta));
        renderPage();
    }

    // Modal functions
    function editarMembresia(id) {
        fetch(`/Membresias/ObtenerMembresia?id=${id}`)
            .then(response => response.json())
            .then(data => {
                document.getElementById("membership-id").value = data.id;
                document.getElementById("membership-name").value = data.nombre;
                document.getElementById("membership-description").value = data.descripcion;
                document.getElementById("membership-cost").value = data.costo;
                document.getElementById("membership-cost-tri").value = data.costo_trimestral;
                document.getElementById("membership-cost-sem").value = data.costo_semestral;
                document.getElementById("membership-cost-anu").value = data.costo_anual;
                document.getElementById("membership-duration").value = data.duracion;
                document.getElementById("membership-quantity").value = data.cantidad;
                document.getElementById("status-checkbox").checked = data.estado === 1;
                document.getElementById("membership-modal").classList.remove("hidden");
            })
            .catch(error => {
                console.error("Error:", error);
                showToast("Error al obtener la membresía", "error");
            });
    }

    function closeModal() {
        document.getElementById("membership-modal").classList.add("hidden");
    }

    // Cerrar modal con click afuera
    document.getElementById("membership-modal").addEventListener("click", function(e) {
        if (e.target === this) closeModal();
    });

    // Submit form
    document.getElementById("membership-form").addEventListener("submit", function(event) {
        event.preventDefault();

        let formData = new FormData();
        formData.append("Id", document.getElementById("membership-id").value);
        formData.append("Nombre", document.getElementById("membership-name").value);
        formData.append("Descripcion", document.getElementById("membership-description").value);
        formData.append("Costo", document.getElementById("membership-cost").value);
        formData.append("Costo_trimestral", document.getElementById("membership-cost-tri").value);
        formData.append("Costo_semestral", document.getElementById("membership-cost-sem").value);
        formData.append("Costo_anual", document.getElementById("membership-cost-anu").value);
        formData.append("Duracion", document.getElementById("membership-duration").value);
        formData.append("Cantidad", document.getElementById("membership-quantity").value);
        formData.append("Estado", document.getElementById("status-checkbox").checked ? 1 : 0);

        fetch("/Membresias/Editar", {
            method: "POST",
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            showToast(data.mensaje || "Membresía actualizada correctamente", "success");
            setTimeout(() => location.reload(), 1500);
        })
        .catch(error => {
            console.error("Error:", error);
            showToast("Error al guardar los cambios", "error");
        });
    });

    // Toast notification
    function showToast(message, type = 'success') {
        const toast = document.getElementById('toast');
        const content = document.getElementById('toastContent');
        const icon = document.getElementById('toastIcon');
        const msg = document.getElementById('toastMessage');

        content.className = `flex items-center gap-3 px-4 py-3 rounded-lg shadow-lg ${
            type === 'success' ? 'bg-green-600 text-white' : 'bg-red-600 text-white'
        }`;
        icon.className = `fas ${type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle'}`;
        msg.textContent = message;

        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 3000);
    }
</script>
}
