@model List<BusinessLogic.Models.Opinion>
@{
    ViewData["Title"] = "Opiniones de mi Negocio";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var negocio = ViewBag.Negocio as BusinessLogic.Models.Negocio;
    var resumen = ViewBag.Resumen as BusinessLogic.Models.ResumenOpiniones;
}

<div class="container mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Opiniones de @negocio?.Nombre</h1>

    <!-- Resumen de calificaciones -->
    @if (resumen != null && resumen.TotalConCalificacion > 0)
    {
        <div class="bg-white rounded-lg shadow p-6 mb-6">
            <div class="flex flex-col md:flex-row items-center gap-8">
                <div class="text-center">
                    <div class="text-5xl font-bold text-gray-800">@resumen.PromedioCalificacion.ToString("0.0")</div>
                    <div class="flex items-center justify-center gap-1 my-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            var filled = i <= Math.Round(resumen.PromedioCalificacion);
                            <i class="fas fa-star @(filled ? "text-yellow-400" : "text-gray-300")"></i>
                        }
                    </div>
                    <p class="text-gray-500">@resumen.TotalConCalificacion calificaciones</p>
                </div>

                <div class="flex-1 w-full md:w-auto">
                    @{
                        var estrellas = new[] {
                            (5, resumen.Estrellas5),
                            (4, resumen.Estrellas4),
                            (3, resumen.Estrellas3),
                            (2, resumen.Estrellas2),
                            (1, resumen.Estrellas1)
                        };
                        var maxEstrellas = estrellas.Max(e => e.Item2);
                    }
                    @foreach (var (num, cantidad) in estrellas)
                    {
                        var porcentaje = resumen.TotalConCalificacion > 0 ? (cantidad * 100.0 / resumen.TotalConCalificacion) : 0;
                        <div class="flex items-center gap-2 mb-1">
                            <span class="text-sm text-gray-600 w-16">@num estrellas</span>
                            <div class="flex-1 bg-gray-200 rounded-full h-2">
                                <div class="bg-yellow-400 h-2 rounded-full" style="width: @porcentaje%"></div>
                            </div>
                            <span class="text-sm text-gray-500 w-8">@cantidad</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Lista de opiniones -->
    @if (Model == null || Model.Count == 0)
    {
        <div class="bg-white rounded-lg shadow p-8 text-center">
            <i class="fas fa-comments text-6xl text-gray-300 mb-4"></i>
            <p class="text-gray-500 text-lg">Aún no tienes opiniones</p>
            <p class="text-gray-400 mt-2">Cuando los clientes opinen sobre tu negocio, aparecerán aquí</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var opinion in Model)
            {
                <div class="bg-white rounded-lg shadow p-6" id="opinion-@opinion.Id">
                    <div class="flex items-start gap-4">
                        <img src="@(string.IsNullOrEmpty(opinion.FotoUsuario) ? "/images/default-avatar.png" : opinion.FotoUsuario)"
                             alt="@opinion.NombreUsuario"
                             class="w-12 h-12 rounded-full object-cover">
                        <div class="flex-1">
                            <div class="flex items-center justify-between">
                                <h3 class="font-semibold text-gray-800">@opinion.NombreUsuario</h3>
                                <span class="text-sm text-gray-500">@opinion.FechaOpinion.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>

                            @if (opinion.Calificacion > 0)
                            {
                                <div class="flex items-center gap-1 my-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fas fa-star text-sm @(i <= opinion.Calificacion ? "text-yellow-400" : "text-gray-300")"></i>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(opinion.Comentario))
                            {
                                <p class="text-gray-600 mt-2">@opinion.Comentario</p>
                            }

                            <!-- Respuesta del dueño existente -->
                            @if (!string.IsNullOrEmpty(opinion.RespuestaDueno))
                            {
                                <div class="bg-orange-50 rounded-lg p-4 mt-4 border-l-4 border-orange-400">
                                    <p class="text-sm font-semibold text-orange-600 mb-1">
                                        <i class="fas fa-reply mr-1"></i> Tu respuesta
                                    </p>
                                    <p class="text-gray-700">@opinion.RespuestaDueno</p>
                                    @if (opinion.FechaRespuesta.HasValue)
                                    {
                                        <p class="text-xs text-gray-500 mt-2">@opinion.FechaRespuesta.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                    }
                                </div>
                            }
                            else
                            {
                                <!-- Formulario para responder -->
                                <div class="mt-4" id="form-respuesta-@opinion.Id">
                                    <button onclick="mostrarFormularioRespuesta(@opinion.Id)"
                                            class="text-orange-500 hover:text-orange-600 text-sm"
                                            id="btn-responder-@opinion.Id">
                                        <i class="fas fa-reply mr-1"></i> Responder
                                    </button>
                                    <div id="textarea-respuesta-@opinion.Id" class="hidden mt-3">
                                        <textarea id="respuesta-@opinion.Id"
                                                  class="w-full border rounded-lg p-3 text-sm"
                                                  rows="3"
                                                  placeholder="Escribe tu respuesta..."></textarea>
                                        <div class="flex gap-2 mt-2">
                                            <button onclick="enviarRespuesta(@opinion.Id)"
                                                    class="bg-orange-500 text-white px-4 py-2 rounded-lg text-sm hover:bg-orange-600">
                                                Enviar respuesta
                                            </button>
                                            <button onclick="cancelarRespuesta(@opinion.Id)"
                                                    class="bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm hover:bg-gray-300">
                                                Cancelar
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Cantidad de respuestas de usuarios -->
                            @if (opinion.CantidadRespuestas > 0)
                            {
                                <button onclick="cargarRespuestas(@opinion.Id)"
                                        class="text-blue-500 hover:text-blue-600 text-sm mt-3"
                                        id="btn-ver-respuestas-@opinion.Id">
                                    <i class="fas fa-comments mr-1"></i> Ver @opinion.CantidadRespuestas respuesta(s)
                                </button>
                                <div id="respuestas-@opinion.Id" class="hidden mt-4 pl-8 border-l-2 border-gray-200 space-y-3"></div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function mostrarFormularioRespuesta(idOpinion) {
            document.getElementById(`btn-responder-${idOpinion}`).classList.add('hidden');
            document.getElementById(`textarea-respuesta-${idOpinion}`).classList.remove('hidden');
        }

        function cancelarRespuesta(idOpinion) {
            document.getElementById(`btn-responder-${idOpinion}`).classList.remove('hidden');
            document.getElementById(`textarea-respuesta-${idOpinion}`).classList.add('hidden');
        }

        async function enviarRespuesta(idOpinion) {
            const respuesta = document.getElementById(`respuesta-${idOpinion}`).value.trim();
            if (!respuesta) {
                alert('Escribe una respuesta');
                return;
            }

            try {
                const response = await fetch(`/api/opiniones/${idOpinion}/responder-dueno`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ respuesta })
                });

                const data = await response.json();

                if (response.ok) {
                    location.reload();
                } else {
                    alert(data.mensaje || 'Error al enviar respuesta');
                }
            } catch (error) {
                alert('Error de conexión');
            }
        }

        async function cargarRespuestas(idOpinion) {
            const container = document.getElementById(`respuestas-${idOpinion}`);
            const btn = document.getElementById(`btn-ver-respuestas-${idOpinion}`);

            if (!container.classList.contains('hidden')) {
                container.classList.add('hidden');
                btn.innerHTML = btn.innerHTML.replace('Ocultar', 'Ver');
                return;
            }

            try {
                const response = await fetch(`/api/opiniones/${idOpinion}/respuestas`);
                const respuestas = await response.json();

                container.innerHTML = respuestas.map(r => `
                    <div class="bg-gray-50 rounded-lg p-3">
                        <div class="flex items-center gap-2 mb-2">
                            <img src="${r.fotoUsuario || '/images/default-avatar.png'}"
                                 class="w-8 h-8 rounded-full object-cover">
                            <span class="font-medium text-sm">${r.nombreUsuario}</span>
                            <span class="text-xs text-gray-500">${new Date(r.fechaOpinion).toLocaleDateString()}</span>
                        </div>
                        <p class="text-sm text-gray-700">${r.comentario}</p>
                    </div>
                `).join('');

                container.classList.remove('hidden');
                btn.innerHTML = btn.innerHTML.replace('Ver', 'Ocultar');
            } catch (error) {
                alert('Error al cargar respuestas');
            }
        }
    </script>
}
