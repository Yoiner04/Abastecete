@model List<BusinessLogic.Models.Categoria>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Abastecete.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>

<body>
    <section class="mt-12 px-6 md:px-16 lg:px-36">
        <div class="mb-6 flex flex-col items-center justify-between space-y-4 md:flex-row md:space-y-0">
            <h2 class="text-center text-lg font-bold text-gray-800 md:text-left">Gestión de Categorías</h2>
            <button id="open-add-modal"
                    class="rounded-lg bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700">
                + Agregar Categoría
            </button>
        </div>

        <div class="overflow-x-auto whitespace-nowrap">
            <table class="w-full overflow-hidden rounded-lg bg-white shadow-md">
                <thead class="bg-gray-200">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase md:px-6">Nombre</th>
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-700 uppercase md:px-6">Imagen</th>
                        <th class="px-4 py-3 text-center text-xs font-medium text-gray-700 uppercase md:px-6">Estado</th>
                        <th class="px-4 py-3 text-center text-xs font-medium text-gray-700 uppercase md:px-6">Acciones</th>
                    </tr>
                </thead>    
                <tbody id="category-table-body">
                    @foreach (var categoria in Model)
                    {
                        <tr class="hover:bg-gray-100">
                            <td class="px-4 py-3 text-gray-700">@categoria.Nombre</td>
                            <td class="px-4 py-3">
                                <img src="@categoria.Imagen" alt="@categoria.Nombre"
                                     class="h-14 w-14 rounded-full border object-cover md:w-16 md:h-16">
                            </td>
                            <td class="px-4 py-3 text-center">
                                <button class="@(categoria.Estado == 1 ? "text-green-600" : "text-red-600")">
                                    @(categoria.Estado == 1 ? "🟢 Activo" : "🔴 Inactivo")
                                </button>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <button class="text-blue-600 hover:text-blue-800" onclick="editarCategoria(@categoria.Id)">✏Editar</button>
                                <button class="text-blue-600 hover:text-blue-800" onclick="verSubCategorias(@categoria.Id)">
                                    📂 Subcategorías
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- Modal Agregar/Editar Categoría -->
    <div id="category-modal" class="bg-opacity-50 fixed inset-0 z-50 flex hidden items-center justify-center bg-black">
        <div class="mx-4 w-full max-w-md rounded-lg bg-white p-6 shadow-lg">
            <h2 class="text-center text-xl font-bold text-gray-800" id="modal-title">Agregar Categoría</h2>
            <form id="category-form" class="mt-4">
                <input type="hidden" id="category-id">

                <input type="text" id="category-name" placeholder="Nombre de la categoría"
                       class="mb-3 w-full rounded-lg border border-gray-300 bg-gray-100 p-3 text-black" required>

                <label class="block font-medium text-gray-700">Imagen</label>
                <input type="file" id="category-image" accept="image/*"
                       class="mb-3 w-full rounded-lg border border-gray-300 p-2">

                <div class="mb-3 flex justify-center">
                    <img id="image-preview" src="" alt="Vista previa"
                         class="hidden h-24 w-24 rounded-lg border object-cover">
                </div>

                <label class="block font-medium text-gray-700">
                    <input type="checkbox" id="status-checkbox" class="mr-2"> Activa
                </label>

                <button type="submit" class="w-full rounded-lg bg-green-600 py-3 font-bold text-white hover:bg-green-700">
                    Guardar
                </button>
            </form>
            <button id="close-category-modal" class="mt-3 block w-full text-center text-gray-600 hover:text-gray-800">
                Cerrar
            </button>
        </div>
    </div>

    <!-- Modal Listar/Agregar/Editar SubCategorias -->
    <!-- Modal de Subcategorías -->
    <div id="subcategorias-modal" class="bg-opacity-50 fixed inset-0 z-50 flex hidden items-center justify-center bg-black"
         onclick="cerrarSubCategorias(event)">
        <div class="mx-4 w-full max-w-md rounded-lg bg-white p-6 shadow-lg" onclick="event.stopPropagation();">
            <h2 class="text-center text-xl font-bold text-gray-800">Subcategorías</h2>

            <table id="tabla-subcategorias" class="mt-4 w-full">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="tabla-subcategorias-body">
                    <!-- Aquí se llenarán dinámicamente las subcategorías -->
                </tbody>
            </table>

            <hr class="my-4">

            <h3 id="subcategoria-form-title" class="text-lg font-bold text-gray-800">Agregar Subcategoría</h3>
            <form id="subcategoria-form">
                <input type="hidden" id="subcategoria-id">
                <input type="hidden" id="subcategoria-idCategoria">

                <label class="block font-medium text-gray-700">Nombre</label>
                <input type="text" id="subcategoria-nombre" placeholder="Nombre de la subcategoría"
                       class="mb-3 w-full rounded-lg border border-gray-300 bg-gray-100 p-3 text-black" required>

                <label class="block font-medium text-gray-700">Estado</label>
                <select id="subcategoria-estado" class="mb-3 w-full rounded-lg border border-gray-300 p-2">
                    <option value="1">Activo</option>
                    <option value="0">Inactivo</option>
                </select>

                <button type="submit" class="w-full rounded-lg bg-green-600 py-3 font-bold text-white hover:bg-green-700">
                    Guardar Subcategoría
                </button>
            </form>

            <button onclick="cerrarSubCategorias()" class="mt-3 block w-full text-center text-gray-600 hover:text-gray-800">
                Cerrar
            </button>
        </div>
    </div>



    <script>
        document.getElementById("open-add-modal").addEventListener("click", openModal);
        document.getElementById("close-category-modal").addEventListener("click", closeModal);

        function openModal() {
            document.getElementById("category-id").value = "";
            document.getElementById("category-name").value = "";
            document.getElementById("category-image").value = "";
            document.getElementById("image-preview").classList.add("hidden");
            document.getElementById("status-checkbox").checked = false;
            document.getElementById("modal-title").textContent = "Agregar Categoría";
            document.getElementById("category-modal").classList.remove("hidden");
        }

        function closeModal() {
            document.getElementById("category-modal").classList.add("hidden");
        }

        document.addEventListener("DOMContentLoaded", function () {
            window.editarCategoria = function (id) {
                fetch(`/Categorias/ObtenerCategoria?id=${id}`)
                    .then(response => response.json())
                    .then(data => {
                        document.getElementById("category-id").value = data.id;
                        document.getElementById("category-name").value = data.nombre || "Sin nombre";
                        document.getElementById("status-checkbox").checked = data.estado === 1;

                        if (data.imagen) {
                            document.getElementById("image-preview").src = data.imagen;
                            document.getElementById("image-preview").classList.remove("hidden");
                        } else {
                            document.getElementById("image-preview").classList.add("hidden");
                        }

                        document.getElementById("modal-title").textContent = "Editar Categoría";
                        document.getElementById("category-modal").classList.remove("hidden");
                    })
                    .catch(error => {
                        console.error("Error al obtener la categoría:", error);
                        alert("Error al obtener la categoría. Verifica la consola.");
                    });
            };
        });


        document.getElementById("category-form").addEventListener("submit", function (event) {
            event.preventDefault();

            let id = document.getElementById("category-id").value;
            let nombre = document.getElementById("category-name").value;
            let estado = document.getElementById("status-checkbox").checked ? 1 : 0;
            let imagenInput = document.getElementById("category-image").files[0];

            if (!nombre.trim()) {
                alert("El nombre de la categoría es obligatorio.");
                return;
            }

            let formData = new FormData();
            formData.append("Id", id || 0);
            formData.append("Nombre", nombre);
            formData.append("Estado", estado);
            if (imagenInput) {
                formData.append("Imagen", imagenInput);
            }

            let url = id ? "/Categorias/EditarCategoria" : "/Categorias/Crear";

            fetch(url, {
                method: "POST",
                body: formData
            })
                .then(response => response.json())
                .then(data => {
                    alert(data.mensaje);
                    location.reload();
                })
                .catch(error => console.error("Error:", error));
        });

        function verSubCategorias(idCategoria) {
            document.getElementById("subcategoria-idCategoria").value = idCategoria;

            fetch(`/SubCategorias/ObtenerSubCategorias?idCategoria=${idCategoria}`)
                .then(res => res.json())
                .then(subcategorias => {
                    let tableBody = document.getElementById("tabla-subcategorias-body");

                    if (!tableBody) {
                        console.error("No se encontró el tbody con ID 'tabla-subcategorias-body'");
                        return;
                    }

                    tableBody.innerHTML = "";

                    subcategorias.forEach(sub => {
                        let row = `<tr>
                            <td>${sub.nombre}</td>
                            <td>${sub.estado == 1 ? "🟢 Activo" : "🔴 Inactivo"}</td>
                            <td>
                                <button onclick="editarSubCategoria(${sub.id})">✏ Editar</button>
                            </td>
                        </tr>`;
                        tableBody.innerHTML += row;
                    });

                    document.getElementById("subcategorias-modal").classList.remove("hidden");
                })
                .catch(error => console.error("Error al cargar subcategorías:", error));
        }


        function agregarSubCategoria() {
            let idCategoria = document.getElementById("subcategoria-idCategoria").value;

            document.getElementById("subcategoria-id").value = "";
            document.getElementById("subcategoria-nombre").value = "";
            document.getElementById("subcategoria-estado").value = "1";
            document.getElementById("subcategoria-idCategoria").value = idCategoria;
            document.getElementById("subcategoria-form-title").textContent = "Agregar Subcategoría";
        }


        function editarSubCategoria(id) {
            fetch(`/SubCategorias/ObtenerSubCategorias?idCategoria=${document.getElementById("subcategoria-idCategoria").value}`)
                .then(res => res.json())
                .then(subcategorias => {
                    let sub = subcategorias.find(s => s.id == id);
                    if (!sub) {
                        console.error("Subcategoría no encontrada");
                        return;
                    }

                    document.getElementById("subcategoria-id").value = sub.id;
                    document.getElementById("subcategoria-nombre").value = sub.nombre;
                    document.getElementById("subcategoria-estado").value = sub.estado;
                    document.getElementById("subcategoria-idCategoria").value = sub.idCategoria;
                    document.getElementById("subcategoria-form-title").textContent = "Editar Subcategoría";
                })
                .catch(error => console.error("Error al obtener la subcategoría:", error));
        }


        document.getElementById("subcategoria-form").addEventListener("submit", function (event) {
            event.preventDefault();

            let id = document.getElementById("subcategoria-id").value;
            let idCategoria = document.getElementById("subcategoria-idCategoria").value;
            let nombre = document.getElementById("subcategoria-nombre").value;
            let estado = document.getElementById("subcategoria-estado").value;

            if (!nombre.trim()) {
                alert("El nombre de la subcategoría es obligatorio.");
                return;
            }

            let url = id ? "/SubCategorias/EditarSubCategoria" : "/SubCategorias/CrearSubCategoria";
            let data = new URLSearchParams({ Id: id, IdCategoria: idCategoria, Nombre: nombre, Estado: estado });

            fetch(url, {
                method: "POST",
                body: data,
                headers: { "Content-Type": "application/x-www-form-urlencoded" }
            })
                .then(response => response.json())
                .then(data => {
                    alert(data.mensaje);
                    location.reload();
                })
                .catch(error => console.error("Error:", error));
        });

        function cerrarSubCategorias(event) {
            if (!event || event.target.id === "subcategorias-modal") {
                document.getElementById("subcategorias-modal").classList.add("hidden");
            }
        }


    </script>
</body>