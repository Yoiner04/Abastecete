@model List<BusinessLogic.Models.Categoria>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>

<body>
    <!-- CATEGORÍAS (TARJETAS RECTANGULARES) -->
    <section class="space-y-3 p-10">
        <div class="grid grid-cols-2 gap-6 sm:grid-cols-4 md:grid-cols-4 lg:grid-cols-5">
            @foreach (var categoria in Model.Where(c => c.Estado != 0))
            {
                <form method="post" action="@Url.Action("Consultar", "Negocios")">
                    <input type="hidden" name="idCategoria" value="@categoria.Id" />
                    <button type="submit" class="w-full transform overflow-hidden rounded-lg bg-white shadow-md transition-transform hover:shadow-lg hover:scale-105">
                        <img src="@categoria.Imagen" alt="@categoria.Nombre" class="h-90 w-full object-cover">
                        <div class="p-4">
                            <p class="text-center text-lg font-semibold text-gray-800">@categoria.Nombre</p>
                        </div>
                    </button>
                </form>
            }
        </div>
    </section>
</body>
