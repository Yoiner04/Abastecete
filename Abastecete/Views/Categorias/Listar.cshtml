@model List<BusinessLogic.Models.Categoria>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>

<body>
    <!-- CATEGORÍAS (TARJETAS RESPONSIVAS) -->
    <section class="p-6 md:p-10">
        <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
            @foreach (var categoria in Model.Where(c => c.Estado != 0))
            {
                <form method="post" action="@Url.Action("Consultar", "Negocios")">
                    <input type="hidden" name="idCategoria" value="@categoria.Id" />
                    <button type="submit" class="group w-full min-h-80 overflow-hidden rounded-2xl bg-white shadow-md transition-transform hover:scale-105 hover:shadow-lg">
                        <div class="flex h-full flex-col">
                            <div class="h-40 w-full overflow-hidden md:h-44 lg:h-48">
                                @if (categoria.Imagen != null)
                                {
                                    <img src="@categoria.Imagen.Base64" alt="@categoria.Nombre"
                                         class="h-full w-full object-contain transition-transform duration-300" />
                                }
                                else
                                {
                                    <div class="flex h-full w-full items-center justify-center bg-gray-100 text-sm text-gray-400">
                                        Sin imagen
                                    </div>
                                }
                            </div>
                            <div class="p-3">
                                <p class="text-center text-xl font-semibold text-gray-800 md:text-base">
                                    @categoria.Nombre
                                </p>
                            </div>
                        </div>
                    </button>
                </form>
            }
        </div>
    </section>
</body>
