@model List<BusinessLogic.Models.OfertaFlash>

@{
    ViewData["Title"] = "Gestionar Ofertas Flash";
}

<div class="container mx-auto p-6">
    <h2 class="text-2xl font-bold text-center text-[#23916A] mb-6">Gestionar Ofertas Flash</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="bg-green-500 text-white p-3 rounded mb-4">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="bg-red-500 text-white p-3 rounded mb-4">
            @TempData["ErrorMessage"]
        </div>
    }

    <table class="min-w-full bg-white shadow-md rounded-lg overflow-hidden">
        <thead class="bg-gray-200">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Imagen</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Título</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Descripción</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Negocio</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Estado</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-600 uppercase">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var oferta in Model)
            {
                <tr class="border-b">
                    <td class="px-6 py-4">
                        <img src="@oferta.FotoLocal" alt="Local" class="w-16 h-16 rounded-md shadow-md">
                    </td>
                    <td class="px-6 py-4">@oferta.Titulo</td>
                    <td class="px-6 py-4">@oferta.Descripcion</td>
                    <td class="px-6 py-4">@oferta.NombreLocal</td>
                    <td class="px-6 py-4">
                        @if (oferta.Estado == 1)
                        {
                            <span class="text-green-600 font-semibold">Aprobada</span>
                        }
                        else
                        {
                            <span class="text-red-600 font-semibold">Pendiente</span>
                        }
                    </td>
                    <td class="px-6 py-4">
                        @if (oferta.Estado == 0)
                        {
                            <form asp-action="AprobarOferta" method="post">
                                <input type="hidden" name="id" value="@oferta.Id">
                                <button type="submit" class="bg-[#23916A] hover:bg-[#1E7E5A] text-white px-4 py-2 rounded-md">
                                    Aprobar
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-gray-500">✔ Aprobada</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>