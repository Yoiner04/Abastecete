@model BusinessLogic.Models.OfertaFlash

@{
    ViewData["Title"] = "Crear Oferta Flash";
    bool puedeCrearOferta = ViewBag.PuedeCrearOferta;
    int duracion = ViewBag.DuracionOferta ?? 24;
    int cantidadActual = ViewBag.CantidadOfertas ?? 0;
    int limiteSimultaneas = duracion == 12 ? 3 : 5;
}

<style>
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @@keyframes pulse-slow {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
    }
    @@keyframes shimmer {
        0% { background-position: -200% 0; }
        100% { background-position: 200% 0; }
    }
    .animate-fadeInUp {
        animation: fadeInUp 0.5s ease-out forwards;
    }
    .animate-pulse-slow {
        animation: pulse-slow 2s ease-in-out infinite;
    }
    .flash-icon {
        background: linear-gradient(90deg, #f97316, #fbbf24, #f97316);
        background-size: 200% 100%;
        animation: shimmer 2s linear infinite;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .form-input {
        transition: all 0.2s ease;
    }
    .form-input:focus {
        border-color: #23916A;
        box-shadow: 0 0 0 3px rgba(35, 145, 106, 0.1);
    }
    .product-image-container {
        transition: all 0.3s ease;
    }
    .product-image-container:hover {
        transform: scale(1.02);
    }
    .submit-btn {
        transition: all 0.3s ease;
    }
    .submit-btn:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(35, 145, 106, 0.3);
    }
    .submit-btn:active:not(:disabled) {
        transform: translateY(0);
    }
    .info-badge {
        transition: all 0.2s ease;
    }
    .info-badge:hover {
        transform: scale(1.05);
    }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-8 px-4">
    <div class="mx-auto max-w-2xl">
        <!-- Header con icono animado -->
        <div class="mb-6 text-center animate-fadeInUp" style="animation-delay: 0.1s; opacity: 0;">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gradient-to-br from-orange-400 to-orange-600 shadow-lg mb-4">
                <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z"/>
                </svg>
            </div>
            <h1 class="text-3xl font-bold text-gray-800">
                Crear <span class="flash-icon">Oferta Flash</span>
            </h1>
            <p class="mt-2 text-gray-500">Promociona tus productos con ofertas de tiempo limitado</p>
        </div>

        <!-- Card principal -->
        <div class="rounded-2xl bg-white p-6 md:p-8 shadow-xl animate-fadeInUp" style="animation-delay: 0.2s; opacity: 0;">

            @if (!puedeCrearOferta)
            {
                <!-- Estado de límite alcanzado -->
                <div class="text-center py-8">
                    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-red-100 mb-4">
                        <svg class="w-10 h-10 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                        </svg>
                    </div>

                    <div class="space-y-3">
                        @if ((bool)ViewBag.ExcedeSimultaneas)
                        {
                            <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                                <p class="text-red-700 font-medium">
                                    <i class="fas fa-exclamation-circle mr-2"></i>
                                    ¡Has alcanzado el límite de ofertas simultáneas!
                                </p>
                                <p class="text-red-600 text-sm mt-1">Tu membresía permite máximo @limiteSimultaneas ofertas activas al mismo tiempo.</p>
                            </div>
                        }

                        @if ((bool)ViewBag.ExcedeTotal)
                        {
                            <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                                <p class="text-red-700 font-medium">
                                    <i class="fas fa-ban mr-2"></i>
                                    ¡Has alcanzado el límite total de ofertas!
                                </p>
                                <p class="text-red-600 text-sm mt-1">Tu membresía ha agotado el cupo de ofertas permitidas.</p>
                            </div>
                        }
                    </div>

                    <a href="@Url.Action("Index", "Membresias")" class="inline-flex items-center mt-6 px-6 py-3 bg-gradient-to-r from-orange-500 to-orange-600 text-white font-semibold rounded-lg hover:from-orange-600 hover:to-orange-700 transition-all shadow-md hover:shadow-lg">
                        <i class="fas fa-crown mr-2"></i>
                        Mejorar Membresía
                    </a>
                </div>
            }
            else
            {
                <!-- Badges informativos -->
                <div class="flex flex-wrap gap-3 mb-6 justify-center">
                    <div class="info-badge inline-flex items-center px-4 py-2 rounded-full bg-orange-50 border border-orange-200">
                        <i class="fas fa-clock text-orange-500 mr-2"></i>
                        <span class="text-sm font-medium text-orange-700">Duración: @duracion horas</span>
                    </div>
                    <div class="info-badge inline-flex items-center px-4 py-2 rounded-full bg-green-50 border border-green-200">
                        <i class="fas fa-layer-group text-green-500 mr-2"></i>
                        <span class="text-sm font-medium text-green-700">@cantidadActual / @limiteSimultaneas activas</span>
                    </div>
                </div>

                <!-- Mensaje informativo -->
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
                    <div class="flex items-start">
                        <i class="fas fa-info-circle text-blue-500 mt-0.5 mr-3"></i>
                        <div class="text-sm text-blue-700">
                            <p class="font-medium mb-1">¿Cómo funcionan las Ofertas Flash?</p>
                            <ul class="list-disc list-inside space-y-1 text-blue-600">
                                <li>Tu oferta será revisada antes de publicarse</li>
                                <li>Una vez aprobada, durará <strong>@duracion horas</strong></li>
                                <li>Aparecerá destacada en el inicio para todos los usuarios</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <form asp-action="Crear" method="post" class="space-y-5" id="formOferta">
                    <fieldset @(puedeCrearOferta ? "" : "disabled")>

                        <!-- Título -->
                        <div class="mb-5">
                            <label asp-for="Titulo" class="flex items-center text-sm font-semibold text-gray-700 mb-2">
                                <i class="fas fa-heading text-gray-400 mr-2"></i>
                                Título de la Oferta
                            </label>
                            <input asp-for="Titulo"
                                   class="form-input w-full rounded-lg border border-gray-300 p-3 text-gray-700 placeholder-gray-400 focus:outline-none"
                                   placeholder="Ej: ¡50% de descuento en productos seleccionados!"
                                   maxlength="50"
                                   required>
                            <div class="flex justify-between mt-1">
                                <span asp-validation-for="Titulo" class="text-sm text-red-500"></span>
                                <span id="contadorTitulo" class="text-xs text-gray-400">0/50</span>
                            </div>
                        </div>

                        <!-- Descripción -->
                        <div class="mb-5">
                            <label asp-for="Descripcion" class="flex items-center text-sm font-semibold text-gray-700 mb-2">
                                <i class="fas fa-align-left text-gray-400 mr-2"></i>
                                Descripción
                            </label>
                            <textarea asp-for="Descripcion"
                                      class="form-input w-full rounded-lg border border-gray-300 p-3 text-gray-700 placeholder-gray-400 focus:outline-none resize-none"
                                      rows="3"
                                      placeholder="Describe los detalles de tu oferta: condiciones, productos incluidos, etc."
                                      maxlength="500"
                                      required></textarea>
                            <div class="flex justify-between mt-1">
                                <span asp-validation-for="Descripcion" class="text-sm text-red-500"></span>
                                <span id="contadorDescripcion" class="text-xs text-gray-400">0/500</span>
                            </div>
                        </div>

                        <!-- Selector de producto con imagen -->
                        <div class="mb-5">
                            <label class="flex items-center text-sm font-semibold text-gray-700 mb-2">
                                <i class="fas fa-box text-gray-400 mr-2"></i>
                                Producto Destacado
                            </label>
                            <div class="flex flex-col md:flex-row gap-4">
                                <div class="flex-1">
                                    <select id="productoSeleccionado" name="productoSeleccionado"
                                            class="form-input w-full rounded-lg border border-gray-300 p-3 text-gray-700 focus:outline-none cursor-pointer"
                                            required>
                                        <option value="">Seleccione un producto...</option>
                                        @if (ViewBag.Productos != null)
                                        {
                                            foreach (var producto in ViewBag.Productos)
                                            {
                                                <option value="@producto.Value" data-imagen="@ViewBag.ImagenesProductos[producto.Value]">@producto.Text</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="product-image-container flex justify-center md:justify-end">
                                    <div class="relative w-28 h-28 rounded-xl border-2 border-dashed border-gray-300 overflow-hidden bg-gray-50 flex items-center justify-center">
                                        <img id="imagenProducto" src="" alt="Imagen del producto"
                                             class="w-full h-full object-contain hidden">
                                        <div id="placeholderImagen" class="text-center p-2">
                                            <i class="fas fa-image text-3xl text-gray-300 mb-1"></i>
                                            <p class="text-xs text-gray-400">Vista previa</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Info de tiempos (solo visual) -->
                        <div class="bg-gray-50 rounded-lg p-4 mb-5">
                            <h4 class="text-sm font-semibold text-gray-700 mb-3 flex items-center">
                                <i class="fas fa-calendar-alt text-gray-400 mr-2"></i>
                                Información de Tiempos
                            </h4>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                <div class="bg-white rounded-lg p-3 border border-gray-200">
                                    <p class="text-xs text-gray-500 mb-1">Duración</p>
                                    <p class="font-semibold text-gray-800">@duracion horas</p>
                                </div>
                                <div class="bg-white rounded-lg p-3 border border-gray-200">
                                    <p class="text-xs text-gray-500 mb-1">Fecha de Inicio</p>
                                    <p class="font-semibold text-gray-800">Al aprobar</p>
                                </div>
                                <div class="bg-white rounded-lg p-3 border border-gray-200">
                                    <p class="text-xs text-gray-500 mb-1">Expiración</p>
                                    <p class="font-semibold text-gray-800">+@duracion hrs</p>
                                </div>
                            </div>
                        </div>

                        <!-- Botón submit -->
                        <button type="submit"
                                class="submit-btn w-full py-4 rounded-xl bg-gradient-to-r from-[#23916A] to-[#1E7E5A] text-white font-bold text-lg shadow-md flex items-center justify-center gap-2 hover:from-[#1E7E5A] hover:to-[#196B4D] disabled:opacity-50 disabled:cursor-not-allowed">
                            <i class="fas fa-bolt"></i>
                            Publicar Oferta Flash
                        </button>

                        <p class="text-center text-xs text-gray-500 mt-3">
                            <i class="fas fa-shield-alt mr-1"></i>
                            Tu oferta será revisada por nuestro equipo antes de publicarse
                        </p>
                    </fieldset>
                </form>
            }
        </div>

        <!-- Mensajes de éxito/error -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div id="successAlert" class="mt-4 bg-green-50 border border-green-200 rounded-lg p-4 flex items-center animate-fadeInUp" style="animation-delay: 0.3s; opacity: 0;">
                <i class="fas fa-check-circle text-green-500 text-xl mr-3"></i>
                <p class="text-green-700 font-medium">@TempData["SuccessMessage"]</p>
                <button onclick="this.parentElement.remove()" class="ml-auto text-green-400 hover:text-green-600">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div id="errorAlert" class="mt-4 bg-red-50 border border-red-200 rounded-lg p-4 flex items-center animate-fadeInUp" style="animation-delay: 0.3s; opacity: 0;">
                <i class="fas fa-exclamation-circle text-red-500 text-xl mr-3"></i>
                <p class="text-red-700 font-medium">@TempData["ErrorMessage"]</p>
                <button onclick="this.parentElement.remove()" class="ml-auto text-red-400 hover:text-red-600">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const selectProducto = document.getElementById("productoSeleccionado");
        const imagenProducto = document.getElementById("imagenProducto");
        const placeholderImagen = document.getElementById("placeholderImagen");
        const tituloInput = document.getElementById("Titulo");
        const descripcionInput = document.getElementById("Descripcion");
        const contadorTitulo = document.getElementById("contadorTitulo");
        const contadorDescripcion = document.getElementById("contadorDescripcion");

        // Actualizar imagen del producto al seleccionar
        if (selectProducto) {
            selectProducto.addEventListener("change", function () {
                const selectedOption = selectProducto.options[selectProducto.selectedIndex];
                const imageUrl = selectedOption.getAttribute("data-imagen");

                if (imageUrl && imageUrl.trim() !== "") {
                    imagenProducto.src = imageUrl;
                    imagenProducto.classList.remove("hidden");
                    placeholderImagen.classList.add("hidden");
                } else {
                    imagenProducto.src = "";
                    imagenProducto.classList.add("hidden");
                    placeholderImagen.classList.remove("hidden");
                }
            });
        }

        // Contadores de caracteres
        if (tituloInput && contadorTitulo) {
            const updateTituloCounter = () => {
                const len = tituloInput.value.length;
                contadorTitulo.textContent = `${len}/50`;
                contadorTitulo.classList.toggle("text-red-500", len >= 45);
            };
            tituloInput.addEventListener("input", updateTituloCounter);
            updateTituloCounter();
        }

        if (descripcionInput && contadorDescripcion) {
            const updateDescripcionCounter = () => {
                const len = descripcionInput.value.length;
                contadorDescripcion.textContent = `${len}/500`;
                contadorDescripcion.classList.toggle("text-red-500", len >= 450);
            };
            descripcionInput.addEventListener("input", updateDescripcionCounter);
            updateDescripcionCounter();
        }

        // Auto-ocultar alertas después de 5 segundos
        const alerts = document.querySelectorAll("#successAlert, #errorAlert");
        alerts.forEach(alert => {
            setTimeout(() => {
                alert.style.transition = "opacity 0.5s ease";
                alert.style.opacity = "0";
                setTimeout(() => alert.remove(), 500);
            }, 5000);
        });

        // Animación de carga del formulario
        const form = document.getElementById("formOferta");
        if (form) {
            form.addEventListener("submit", function(e) {
                const btn = form.querySelector('button[type="submit"]');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Enviando...';
                }
            });
        }
    });
</script>
