@model BusinessLogic.Models.OfertaFlash

@{
    ViewData["Title"] = "Crear Oferta Flash";
    bool puedeCrearOferta = ViewBag.PuedeCrearOferta;
}

<div class="mt-12 flex items-center justify-center bg-gray-100">
    <div class="w-full max-w-lg rounded-lg bg-white p-8 shadow-lg">
        <h2 class="text-center text-2xl font-bold text-[#23916A]">Crear Nueva Oferta Flash</h2>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-4 rounded bg-green-100 px-4 py-3 text-green-800 shadow">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-4 rounded bg-red-100 px-4 py-3 text-red-800 shadow">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (!ViewBag.PuedeCrearOferta)
        {

            <div class="text-center text-red-600 font-semibold space-y-2">
                @if ((bool)ViewBag.ExcedeSimultaneas)
                {
                    <p>¡Has alcanzado el límite de ofertas simultáneas para tu membresía!</p>
                }

                @if ((bool)ViewBag.ExcedeTotal)
                {
                    <p>¡Has alcanzado el límite total de ofertas permitidas por tu membresía!</p>
                }
            </div>
        }

        else
        {
            <p class="mb-4 text-center text-gray-600">
                Las ofertas flash tienen una duración de <strong>@ViewBag.DuracionOferta horas</strong>. Asegúrate de completar la información correctamente.
            </p>

            <form asp-action="Crear" method="post" class="space-y-4">
                <fieldset @(puedeCrearOferta ? "" : "disabled")>
                    <div>
                        <label asp-for="Titulo" class="block font-semibold">Título de la Oferta</label>
                        <input asp-for="Titulo" class="w-full rounded-md border border-gray-300 p-2 focus:ring-2 focus:ring-blue-400" placeholder="Ej: Descuento del 50%" required>
                        <span asp-validation-for="Titulo" class="text-sm text-red-500"></span>
                    </div>

                    <div>
                        <label asp-for="Descripcion" class="block font-semibold">Descripción</label>
                        <textarea asp-for="Descripcion" class="w-full rounded-md border border-gray-300 p-2 focus:ring-2 focus:ring-blue-400" rows="4" placeholder="Describe los detalles de la oferta..." required></textarea>
                        <span asp-validation-for="Descripcion" class="text-sm text-red-500"></span>
                    </div>

                    <div class="flex items-center gap-4">
                        <div class="w-1/2">
                            <label class="block font-semibold">Seleccionar Producto</label>
                            <select id="productoSeleccionado" name="productoSeleccionado" class="w-full rounded-md border border-gray-300 p-2 focus:ring-2 focus:ring-blue-400" required>
                                <option value="">Seleccione un producto</option>
                                @foreach (var producto in ViewBag.Productos)
                                {
                                    <option value="@producto.Value" data-imagen="@ViewBag.ImagenesProductos[producto.Value]">@producto.Text</option>
                                }
                            </select>
                        </div>

                        <div class="flex w-1/2 justify-center">
                            <img id="imagenProducto" src="" alt="Imagen del producto" class="h-32 w-32 rounded-md border border-gray-300 object-contain">
                        </div>
                    </div>

                    <div>
                        <label class="block font-semibold">Duración de la Oferta</label>
                        <input type="text" class="w-full rounded-md border border-gray-300 bg-gray-100 p-2" value="@ViewBag.DuracionOferta horas (Automático por membresía)" disabled>
                    </div>

                    <div class="mt-2 flex gap-4">
                        <div class="w-1/2">
                            <label class="block font-semibold">Fecha de Inicio</label>
                            <input type="text" class="w-full rounded-md border border-gray-300 bg-gray-100 p-2" value="Según aprobación" disabled>
                        </div>
                        <div class="w-1/2">
                            <label class="block font-semibold">Fecha de Expiración</label>
                            <input type="text" class="w-full rounded-md border border-gray-300 bg-gray-100 p-2" value="@ViewBag.DuracionOferta horas al ser aprobada" disabled>
                        </div>
                    </div>

                    <button type="submit" class="mt-3 w-full rounded-md bg-[#23916A] py-2 font-semibold text-white transition duration-200 hover:bg-[#1E7E5A]">
                        Publicar Oferta Flash
                    </button>
                </fieldset>
            </form>
        }
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var selectProducto = document.getElementById("productoSeleccionado");
        var imagenProducto = document.getElementById("imagenProducto");

        selectProducto.addEventListener("change", function () {
            var selectedOption = selectProducto.options[selectProducto.selectedIndex];
            var imageUrl = selectedOption.getAttribute("data-imagen");

            if (imageUrl) {
                imagenProducto.src = imageUrl;
            } else {
                imagenProducto.src = "";
            }
        });
    });
</script>