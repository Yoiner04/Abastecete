@model List<BusinessLogic.Models.OfertaFlash>

@{
    ViewData["Title"] = "Ofertas Flash - Abastecete";
    ViewData["Description"] = "Descubre ofertas de tiempo limitado de proveedores locales. No te pierdas los mejores descuentos.";
}

<!-- SKELETON LOADER -->
<div id="skeleton-ofertas" class="animate-pulse p-6 lg:p-10">
    <!-- Header Skeleton -->
    <div class="flex justify-between items-center mb-4 pl-10 pr-10">
        <div class="h-8 bg-gray-200 rounded w-64"></div>
        <div class="h-6 bg-gray-200 rounded w-32"></div>
    </div>

    <!-- Grid Skeleton -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Skeleton Card 1 -->
        <div class="bg-white p-4 rounded-lg shadow-md">
            <div class="aspect-square bg-gray-200 rounded-md mb-4"></div>
            <div class="space-y-3">
                <div class="h-6 bg-gray-200 rounded w-3/4 mx-auto"></div>
                <div class="h-4 bg-gray-200 rounded w-full"></div>
                <div class="h-4 bg-gray-200 rounded w-2/3 mx-auto"></div>
                <div class="h-6 bg-gray-200 rounded w-1/2 mx-auto mt-4"></div>
            </div>
        </div>

        <!-- Skeleton Card 2 -->
        <div class="bg-white p-4 rounded-lg shadow-md">
            <div class="aspect-square bg-gray-200 rounded-md mb-4"></div>
            <div class="space-y-3">
                <div class="h-6 bg-gray-200 rounded w-3/4 mx-auto"></div>
                <div class="h-4 bg-gray-200 rounded w-full"></div>
                <div class="h-4 bg-gray-200 rounded w-2/3 mx-auto"></div>
                <div class="h-6 bg-gray-200 rounded w-1/2 mx-auto mt-4"></div>
            </div>
        </div>

        <!-- Skeleton Card 3 -->
        <div class="bg-white p-4 rounded-lg shadow-md">
            <div class="aspect-square bg-gray-200 rounded-md mb-4"></div>
            <div class="space-y-3">
                <div class="h-6 bg-gray-200 rounded w-3/4 mx-auto"></div>
                <div class="h-4 bg-gray-200 rounded w-full"></div>
                <div class="h-4 bg-gray-200 rounded w-2/3 mx-auto"></div>
                <div class="h-6 bg-gray-200 rounded w-1/2 mx-auto mt-4"></div>
            </div>
        </div>

        <!-- Skeleton Card 4 -->
        <div class="bg-white p-4 rounded-lg shadow-md">
            <div class="aspect-square bg-gray-200 rounded-md mb-4"></div>
            <div class="space-y-3">
                <div class="h-6 bg-gray-200 rounded w-3/4 mx-auto"></div>
                <div class="h-4 bg-gray-200 rounded w-full"></div>
                <div class="h-4 bg-gray-200 rounded w-2/3 mx-auto"></div>
                <div class="h-6 bg-gray-200 rounded w-1/2 mx-auto mt-4"></div>
            </div>
        </div>

        <!-- Skeleton Card 5 -->
        <div class="bg-white p-4 rounded-lg shadow-md">
            <div class="aspect-square bg-gray-200 rounded-md mb-4"></div>
            <div class="space-y-3">
                <div class="h-6 bg-gray-200 rounded w-3/4 mx-auto"></div>
                <div class="h-4 bg-gray-200 rounded w-full"></div>
                <div class="h-4 bg-gray-200 rounded w-2/3 mx-auto"></div>
                <div class="h-6 bg-gray-200 rounded w-1/2 mx-auto mt-4"></div>
            </div>
        </div>

        <!-- Skeleton Card 6 -->
        <div class="bg-white p-4 rounded-lg shadow-md">
            <div class="aspect-square bg-gray-200 rounded-md mb-4"></div>
            <div class="space-y-3">
                <div class="h-6 bg-gray-200 rounded w-3/4 mx-auto"></div>
                <div class="h-4 bg-gray-200 rounded w-full"></div>
                <div class="h-4 bg-gray-200 rounded w-2/3 mx-auto"></div>
                <div class="h-6 bg-gray-200 rounded w-1/2 mx-auto mt-4"></div>
            </div>
        </div>
    </div>
</div>

<!-- CONTENIDO REAL -->
<div id="content-ofertas" class="hidden">
    <!-- OFERTAS FLASH -->
    <section class="off-section p-6 lg:p-10" id="ofertas-container">
    <!-- Encabezado -->
    <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-bold text-gray-800 pl-10">Todas las Ofertas Flash</h2>
        <a href="@Url.Action("Principal", "Home")" class="text-sm pr-10 font-medium text-gray-600 hover:text-gray-800 flex items-center">
            Volver al inicio <span class="ml-1">&gt;</span>
        </a>
    </div>

    <div id="offers-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var oferta in Model)
        {
            var tiempoOfertaStr = oferta.TiempoOferta.ToString("yyyy-MM-ddTHH:mm:ss");
            @if (oferta.Estado == 1) // ✅ Solo muestra ofertas aprobadas
            {
                <div class="bg-white p-4 rounded-lg shadow-md flex flex-col relative">
                    <div class="relative aspect-square overflow-hidden rounded-md bg-gray-300">
                        <img src="@oferta.ImagenProductoOfertaFlash" alt="Imagen del Producto" class="absolute inset-0 w-full h-full object-cover">
                    </div>

                    <div class="absolute top-4 left-4 w-20 h-20 rounded-full overflow-hidden border-2 border-white shadow-md">
                        <img src="@oferta.FotoLocal" alt="Local" class="w-full h-full object-cover">
                    </div>

                    <div class="text-center mt-4">
                        <h3 class="text-lg font-bold text-gray-800">
                            @oferta.Titulo <span class="text-gray-500">(@oferta.ProductoOfertaFlash)</span>
                        </h3>
                        <p class="text-gray-600">@oferta.Descripcion</p>
                        <p class="text-sm text-gray-500 font-medium">📍 @oferta.NombreLocal</p>

                        <div class="mt-4">
                            <span class="text-red-500 font-semibold">
                                ⏳ Expira en <span class="countdown-timer" data-expiration="@tiempoOfertaStr"></span>
                            </span>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
            document.getElementById('skeleton-ofertas').classList.add('hidden');
            document.getElementById('content-ofertas').classList.remove('hidden');
        }, 300);
    });

    function actualizarContadores() {
        document.querySelectorAll(".countdown-timer").forEach(timer => {
            const expirationTime = new Date(timer.dataset.expiration).getTime();
            const now = new Date().getTime();
            const timeLeft = expirationTime - now;

            if (timeLeft > 0) {
                const hours = Math.floor(timeLeft / (1000 * 60 * 60));
                const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);
                timer.innerText = `${hours}h ${minutes}m ${seconds}s`;
            } else {
                timer.innerText = "Expirado";
            }
        });
    }
    setInterval(actualizarContadores, 1000);
    actualizarContadores();
</script>
