<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abastécete - Productos</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
    <div class="max-w-4xl mx-auto p-6 bg-white shadow-lg rounded-lg mt-10">
        <h1 class="text-3xl font-bold text-green-600 mb-6">Agregar Producto</h1>
        <form class="space-y-4">
            <div>
                <label class="block text-gray-700 font-medium" for="categoria">Categoría</label>
                <input type="number" id="subcategoria" name="subcategoria" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500">
            </div>

            <div>
                <label class="block text-gray-700 font-medium" for="subcategoria">Subcategoría</label>
                <input type="number" id="subcategoria" name="subcategoria" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500">
            </div>

            <div>
                <label class="block text-gray-700 font-medium" for="nombre">Productos</label>
                
            </div>

            <button type="submit" class="w-full bg-green-600 text-white font-bold py-2 px-4 rounded-lg hover:bg-green-700 transition">Agregar Producto</button>
        </form>
    </div>
</body>
