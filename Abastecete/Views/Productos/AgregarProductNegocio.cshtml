<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAPudyk3G3YG7GOEpId4xMK_WFIEenOSp8&libraries=places"></script>
</head>

<body class="bg-gray-100 p-6">
    <div class="max-w-3xl mx-auto bg-white p-6 rounded-lg shadow-md">
        <h2 class="text-xl font-semibold mb-4">Agregar Producto</h2>

        <form id="productForm" class="space-y-4">
            <select id="category" class="w-full p-2 border rounded">
                <option value="">Seleccione una categoría</option>
            </select>

            <select id="subcategory" class="w-full p-2 border rounded">
                <option value="">Seleccione una subcategoría</option>
            </select>

            <select id="product" class="w-full p-2 border rounded">
                <option value="">Seleccione un producto</option>
            </select>

            <select id="unit" class="w-full p-2 border rounded">
                <option value="">Seleccione una unidad de medida</option>
            </select>

            <input type="number" id="price" class="w-full p-2 border rounded" placeholder="Ingrese el valor">

            <button type="button" onclick="addProduct()" class="w-full bg-[#23916A] text-white py-2 rounded-lg">Registrar</button>
        </form>
    </div>

    <div class="max-w-3xl mx-auto bg-white p-6 rounded-lg shadow-md mt-6">
        <h2 class="text-xl font-semibold mb-4">Productos Añadidos</h2>
        <table class="w-full border-collapse border border-gray-300">
            <thead>
                <tr class="bg-gray-200">
                    <th class="border p-2">Categoría</th>
                    <th class="border p-2">Subcategoría</th>
                    <th class="border p-2">Producto</th>
                    <th class="border p-2">Unidad</th>
                    <th class="border p-2">Valor</th>
                    <th class="border p-2">Acciones</th>
                </tr>
            </thead>
            <tbody id="productTableBody"></tbody>
        </table>

        <button class="w-full bg-orange-500 text-white py-2 rounded-lg mt-4">Finalizar Registro</button>
    </div>

    <script>
        function addProduct() {
            let category = document.getElementById("category").value;
            let subcategory = document.getElementById("subcategory").value;
            let product = document.getElementById("product").value;
            let unit = document.getElementById("unit").value;
            let price = document.getElementById("price").value;

            if (!category || !subcategory || !product || !unit || !price) {
                alert("Por favor, complete todos los campos.");
                return;
            }

            let tableBody = document.getElementById("productTableBody");
            let row = document.createElement("tr");
            row.innerHTML = `
                <td class="border p-2">${category}</td>
                <td class="border p-2">${subcategory}</td>
                <td class="border p-2">${product}</td>
                <td class="border p-2">${unit}</td>
                <td class="border p-2">${price}</td>
                <td class="border p-2 text-center">
                    <button onclick="removeProduct(this)" class="bg-red-500 text-white px-2 py-1 rounded">Eliminar</button>
                </td>
            `;
            tableBody.appendChild(row);
        }

        function removeProduct(button) {
            button.parentElement.parentElement.remove();
        }
    </script>
</body>
</html>
