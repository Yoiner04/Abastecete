@using BusinessLogic.Models
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAPudyk3G3YG7GOEpId4xMK_WFIEenOSp8&libraries=places"></script>
</head>

<body class="bg-gray-100 p-6">

    <div class="mt-12 flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-center lg:gap-10">

        <!-- Formulario -->
        <div class="w-full max-w-xl rounded-lg bg-white p-6 shadow-lg">
            <h2 class="mb-4 text-center text-2xl font-bold text-gray-700">Agregar Producto</h2>

            <form id="productForm" class="space-y-4">
                <select id="category" class="w-full rounded-lg border border-gray-300 bg-gray-50 p-3 focus:outline-none focus:ring-2 focus:ring-green-500">
                    <option value="">Seleccione una categoría</option>
                    @foreach (Categoria cate in ViewBag.categorias)
                    {
                        <option data-nombre="@cate.Nombre" value="@cate.Id">@cate.Nombre</option>
                    }
                </select>

                <select id="subcategory" disabled class="w-full rounded-lg border border-gray-300 bg-gray-50 p-3">
                    <option value="">Seleccione una subcategoría</option>
                </select>

                <select id="product" disabled class="w-full rounded-lg border border-gray-300 bg-gray-50 p-3">
                    <option value="">Seleccione un producto</option>
                </select>

                <select id="unit" disabled class="w-full rounded-lg border border-gray-300 bg-gray-50 p-3">
                    <option value="">Seleccione una unidad de medida</option>
                </select>

                <input type="number" id="price" placeholder="Ingrese el valor"
                       class="w-full rounded-lg border border-gray-300 bg-gray-50 p-3 focus:outline-none focus:ring-2 focus:ring-green-500" />

                <button type="button" onclick="addProduct()"
                        class="w-full rounded-lg bg-green-600 py-3 text-white transition hover:bg-green-700">
                    Registrar
                </button>
            </form>
        </div>

        <!-- Tabla -->
        <div class="w-full max-w-xl rounded-lg bg-white p-6 shadow-lg">
            <h2 class="mb-4 text-center text-2xl font-bold text-gray-700">Productos Añadidos</h2>

            <div class="overflow-auto rounded-lg border border-gray-300">
                <table class="min-w-full border-collapse text-sm">
                    <thead class="bg-gray-200 text-gray-700">
                        <tr>
                            <th class="border px-4 py-2 text-left">Categoría</th>
                            <th class="border px-4 py-2 text-left">Subcategoría</th>
                            <th class="border px-4 py-2 text-left">Producto</th>
                            <th class="border px-4 py-2 text-left">Unidad</th>
                            <th class="border px-4 py-2 text-left">Valor</th>
                            <th class="border px-4 py-2 text-left">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="productTableBody" class="bg-white text-gray-700"></tbody>
                </table>
            </div>

            <form id="finalizarForm" method="post">
                <input type="hidden" name="productosJson" id="productosJson">
                <button type="button" onclick="finalizarRegistro()"
                        class="mt-6 w-full rounded-lg bg-orange-500 py-3 text-white transition hover:bg-orange-600">
                    Finalizar Registro
                </button>
            </form>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#category").change(function () {
                var idCategoria =  $(this).val();
                if (idCategoria) {
                    $("#subcategory").prop("disabled", false);
                    $.ajax({
                        url: "/SubCategorias/ObtenerSubCategorias",
                        type: "GET",
                        data: { idCategoria: idCategoria },
                        dataType: "json",
                        success: function (response) {
                            $("#subcategory").empty(); 
                            $("#subcategory").append('<option value="">Seleccione una subcategoría</option>');

                            $.each(response, function (index, item) {
                                $("#subcategory").append(`<option data-nombre="${item.nombre}" value="${item.id}">${item.nombre}</option>`);
                            });
                        },
                        error: function () {
                            alert("Error al obtener subcategorías.");
                        }
                    });
                } else {
                    $("#subcategory").empty();
                    $("#subcategory").append('<option value="">Seleccione una subcategoría</option>');
                }
            });

            $("#subcategory").change(function(){
                var subCategoriaId = $(this).val();
                if(subCategoriaId){
                    $("#product").prop("disabled", false);
                    $.ajax({
                        url:"/Productos/obtenerProductosSubcategoria",
                        type:"GET",
                        data:{subCategoriaId:subCategoriaId},
                        dataType:"json",
                        success:function(response){
                            $("#product").empty();
                            $("#product").append('<option value="">Seleccione un producto</option>');
                            $.each(response,function(index,item){
                                $("#product").append(`<option data-nombre=${item.nombre} value="${item.id}">${item.nombre}</option>`);
                            });
                        },
                    })
                }
                
            });
            $("#product").change(function(){
                var productoId = $(this).val(); // ✅ corregido: ahora tomamos el id del producto
                if(productoId){
                    $("#unit").prop("disabled", false);
                    $.ajax({
                        url: "/Unidad/ConsultarUnidades",
                        type: "GET",
                        data: { id_producto: productoId }, // ✅ enviamos el parámetro correcto
                        dataType: "json",
                        success: function(response){
                            $("#unit").empty();
                            $("#unit").append('<option value="">Seleccione una unidad</option>');
                            $.each(response, function(index, item){
                                $("#unit").append(`<option data-nombre=${item.nombre} value="${item.id}">${item.nombre}</option>`);
                            });
                        }
                    });
                }
            });

        });
    </script>

    <script>

        function finalizarRegistro() {
            let filas = $("#productTableBody tr");
            let productos = [];

            filas.each(function () {
                let celdas = $(this).find("td");
                productos.push({
                    producto: celdas.eq(2).data('idproducto'),
                    medida: celdas.eq(3).data('idunidad'),
                    valor: parseFloat(celdas.eq(4).data('idprecio'))
                });
            });

            $("#productosJson").val(JSON.stringify(productos));
            console.log(productos);

            $.ajax({
                url: '@Url.Action("FinalizarRegistroProductos", "Productos")',
                type: 'POST',
                data: { productosJson: JSON.stringify(productos) },
                success: function (response) {
                    alert(response.mensaje);
                    window.location.reload();
                },
                error: function () {
                    alert("Hubo un error al registrar los productos.");
                }
            });
        }


        function addProduct() {

            let categoryid = document.getElementById("category").value;
            let subcategoryid = document.getElementById("subcategory").value;
            let productid = document.getElementById("product").value;
            let unitid = document.getElementById("unit").value;
            let priceid = document.getElementById("price").value;


            let category = document.getElementById("category").selectedOptions[0].getAttribute("data-nombre");
            let subcategory = document.getElementById("subcategory").selectedOptions[0].getAttribute("data-nombre");
            let product = document.getElementById("product").selectedOptions[0].getAttribute("data-nombre");
            let unit = document.getElementById("unit").selectedOptions[0].getAttribute("data-nombre");
            let price = document.getElementById("price").value;

            if (!category || !subcategory || !product || !unit || !price) {
                console.log(category,subcategory,product,unit,price);
                alert("Por favor, complete todos los campos.");
                return;
            }

            let tableBody = document.getElementById("productTableBody");
            let row = document.createElement("tr");
                row.innerHTML = `
            <td class="border p-2" data-idcategoria="${categoryid}">${category}</td>
            <td class="border p-2" data-idsubcategoria="${subcategoryid}">${subcategory}</td>
            <td class="border p-2" data-idproducto="${productid}">${product}</td>
            <td class="border p-2" data-idunidad="${unitid}">${unit}</td>
            <td class="border p-2" data-idprecio="${priceid}">${price}</td>
            <td class="border p-2 text-center">
                <button onclick="removeProduct(this)" class="rounded bg-red-500 px-2 py-1 text-white">Eliminar</button>
            </td>
        `;
            tableBody.appendChild(row);
        }

        function removeProduct(button) {
            button.parentElement.parentElement.remove();
        }
    </script>
</body>
</html>
