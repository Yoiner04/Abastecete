                            <span class="text-yellow-500 mr-1"><i class="fas fa-star"></i></span>
                            <span>5.0</span>
                        </div>
                        <!-- Botón favorito -->
                        <button class="absolute top-2 right-2 bg-white p-2 rounded-full shadow text-gray-600 hover:text-green-600">
                            <i class="far fa-heart"></i>
                        </button>
                    </div>

                    <!-- Información del proveedor -->
                    <div class="mt-4 text-center">
                        <p class="text-lg font-bold text-gray-800">Producto</p>
                        <button class="mt-2 bg-green-600 text-white px-4 py-2 rounded-full text-sm font-medium hover:bg-green-700">
                            Ver
                        </button>
                    </div>
                </div>

                <!-- Copia la tarjeta para mostrar más proveedores -->
                <div class="bg-white border border-gray-200 rounded-lg shadow-md p-4 flex flex-col items-center">
                    <!-- Imagen y botones -->
                    <div class="relative w-full">
                        <div class="bg-gray-200 h-52 rounded-lg"></div>
                        <!-- Calificación -->
                        <div class="absolute top-2 left-2 bg-white rounded-full flex items-center px-2 py-1 text-sm font-medium shadow">
                            <span class="text-yellow-500 mr-1"><i class="fas fa-star"></i></span>
                            <span>5.0</span>
                        </div>
                        <!-- Botón favorito -->
                        <button class="absolute top-2 right-2 bg-white p-2 rounded-full shadow text-gray-600 hover:text-green-600">
                            <i class="far fa-heart"></i>
                        </button>
                    </div>

                    <!-- Información del proveedor -->
                    <div class="mt-4 text-center">
                        <p class="text-lg font-bold text-gray-800">Producto</p>
                        <button class="mt-2 bg-green-600 text-white px-4 py-2 rounded-full text-sm font-medium hover:bg-green-700">
                            Ver
                        </button>
                    </div>
                </div>
                <!-- Agrega más tarjetas según sea necesario -->
            </div>

            <!-- Paginación -->
            <div class="mt-6 flex justify-center space-x-2">
                <button class="w-8 h-8 bg-gray-300 rounded-full text-gray-600 font-bold hover:bg-gray-400">&lt;</button>
                <button class="w-8 h-8 bg-green-600 text-white rounded-full font-bold">1</button>
                <button class="w-8 h-8 bg-gray-300 rounded-full text-gray-600 font-bold hover:bg-gray-400">2</button>
                <button class="w-8 h-8 bg-gray-300 rounded-full text-gray-600 font-bold hover:bg-gray-400">3</button>
                <button class="w-8 h-8 bg-gray-300 rounded-full text-gray-600 font-bold hover:bg-gray-400">&gt;</button>
            </div>
        </main>
    </div>

    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    
