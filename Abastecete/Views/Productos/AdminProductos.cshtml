@model List<BusinessLogic.Models.Producto>
@using BusinessLogic.Utilidades
@{
    ViewData["Title"] = "Administrar Productos";
    var categorias = ViewBag.Categorias as List<BusinessLogic.Models.Categoria> ?? new List<BusinessLogic.Models.Categoria>();
    var marcas = ViewBag.Marcas as List<BusinessLogic.Models.Marca> ?? new List<BusinessLogic.Models.Marca>();
    var permisos = Context.Session.GetString("permisos");
    var puedeAdministrar = RolPermisos.TienePermiso("Administrar Roles", permisos);
}

<style>
    .modal { transition: opacity 0.2s ease, visibility 0.2s ease; }
    .modal.hidden { opacity: 0; visibility: hidden; }
    .modal:not(.hidden) { opacity: 1; visibility: visible; }
</style>

<!-- Header a ancho completo -->
<div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-4">
                <a href="@Url.Action("Principal", "Home")"
                   class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors">
                    <i class="fas fa-arrow-left text-gray-600"></i>
                </a>
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Administrar Productos</h1>
                    <p class="text-sm text-gray-500 mt-1">Gestiona todos los productos del sistema</p>
                </div>
            </div>
            @if (puedeAdministrar)
            {
                <button onclick="abrirModalProducto()"
                        class="inline-flex items-center gap-2 px-4 py-2 bg-[#23916A] text-white rounded-lg hover:bg-[#1a6b4f] transition-colors">
                    <i class="fas fa-plus"></i>
                    <span>Nuevo Producto</span>
                </button>
            }
        </div>
    </div>
</div>

<!-- Contenido con contenedor -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

<!-- Stats Cards -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-4">
        <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center">
            <i class="fas fa-box text-green-600 text-xl"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-gray-900">@Model.Count</p>
            <p class="text-sm text-gray-500">Total Productos</p>
        </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-4">
        <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center">
            <i class="fas fa-trademark text-blue-600 text-xl"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-gray-900">@marcas.Count(m => m.Activo)</p>
            <p class="text-sm text-gray-500">Marcas Activas</p>
        </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-4">
        <div class="w-12 h-12 rounded-lg bg-purple-100 flex items-center justify-center">
            <i class="fas fa-tags text-purple-600 text-xl"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-gray-900">@categorias.Count</p>
            <p class="text-sm text-gray-500">Categorías</p>
        </div>
    </div>
</div>

<!-- Filtros -->
<div class="bg-white rounded-xl border border-gray-200 mb-6 p-4">
    <div class="flex items-center gap-2 mb-4">
        <i class="fas fa-filter text-gray-400"></i>
        <h2 class="font-semibold text-gray-900">Filtros de Búsqueda</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Buscar</label>
            <div class="relative">
                <input type="text" id="filtro-buscar" placeholder="Nombre o SKU..."
                       class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#23916A] focus:border-[#23916A] transition-all">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
            </div>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Categoría</label>
            <select id="filtro-categoria" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#23916A] transition-all">
                <option value="">Todas</option>
                @foreach (var cat in categorias)
                {
                    <option value="@cat.Id">@cat.Nombre</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Subcategoría</label>
            <select id="filtro-subcategoria" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#23916A] transition-all" disabled>
                <option value="">Todas</option>
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Marca</label>
            <select id="filtro-marca" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#23916A] transition-all">
                <option value="">Todas</option>
                @foreach (var marca in marcas)
                {
                    <option value="@marca.Id">@marca.Nombre</option>
                }
            </select>
        </div>
        <div class="flex items-end">
            <button id="btn-buscar" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium">
                <i class="fas fa-search"></i>
                Buscar
            </button>
        </div>
    </div>
</div>

<!-- Tabla de Productos -->
<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Producto</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden sm:table-cell">SKU</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Marca</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden md:table-cell">Categoría</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden lg:table-cell">Subcategoría</th>
                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                </tr>
            </thead>
            <tbody id="tabla-productos" class="bg-white divide-y divide-gray-200">
                @foreach (var producto in Model)
                {
                    <tr class="hover:bg-gray-50 producto-row transition-colors" data-id="@producto.Id"
                        data-nombre="@producto.Nombre.ToLower()"
                        data-sku="@(producto.SKU?.ToLower() ?? "")"
                        data-marca="@(producto.NombreMarca?.ToLower() ?? "")">
                        <td class="px-4 py-4">
                            <div class="flex items-center gap-3">
                                @if (!string.IsNullOrEmpty(producto.ImagenUrl))
                                {
                                    <img src="@producto.ImagenUrl" alt="@producto.Nombre"
                                         class="w-12 h-12 rounded-lg object-cover border border-gray-200">
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded-lg bg-gray-100 flex items-center justify-center">
                                        <i class="fas fa-image text-gray-400"></i>
                                    </div>
                                }
                                <div>
                                    <p class="font-medium text-gray-900">@producto.Nombre</p>
                                    @if (!string.IsNullOrEmpty(producto.Descripcion))
                                    {
                                        <p class="text-xs text-gray-500 max-w-xs truncate">@producto.Descripcion</p>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-4 hidden sm:table-cell">
                            @if (!string.IsNullOrEmpty(producto.SKU))
                            {
                                <span class="inline-flex items-center px-2 py-1 rounded text-xs font-mono bg-gray-100 text-gray-700">
                                    @producto.SKU
                                </span>
                            }
                            else
                            {
                                <span class="text-gray-400">-</span>
                            }
                        </td>
                        <td class="px-4 py-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                @(producto.NombreMarca ?? "Sin marca")
                            </span>
                        </td>
                        <td class="px-4 py-4 text-sm text-gray-600 hidden md:table-cell">@producto.NombreCategoria</td>
                        <td class="px-4 py-4 text-sm text-gray-600 hidden lg:table-cell">@producto.NombreSubCategoria</td>
                        <td class="px-4 py-4 text-center">
                            @if (puedeAdministrar)
                            {
                                <div class="flex items-center justify-center gap-1">
                                    <button onclick="editarProducto(@producto.Id)"
                                            class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button onclick="eliminarProducto(@producto.Id, '@producto.Nombre.Replace("'", "\\'").Replace("\"", "\\\"")')"
                                            class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Eliminar">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <span class="text-xs text-gray-400">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-12">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 flex items-center justify-center">
                <i class="fas fa-box-open text-2xl text-gray-400"></i>
            </div>
            <p class="text-gray-500 mb-2">No hay productos registrados</p>
            <p class="text-sm text-gray-400">Haz clic en "Nuevo Producto" para agregar uno</p>
        </div>
    }

    <!-- Paginación -->
    @if (Model.Any())
    {
        <div class="px-4 py-3 bg-gray-50 border-t border-gray-200">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-2">
                    <span class="text-sm text-gray-700">Mostrar</span>
                    <select id="items-per-page" class="px-2 py-1 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-[#23916A]">
                        <option value="10">10</option>
                        <option value="25" selected>25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span class="text-sm text-gray-700">por página</span>
                </div>
                <div class="flex items-center gap-1">
                    <button id="btn-prev" class="px-3 py-1.5 rounded-lg border border-gray-300 text-sm text-gray-600 hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <div id="pagination-numbers" class="flex items-center gap-1"></div>
                    <button id="btn-next" class="px-3 py-1.5 rounded-lg border border-gray-300 text-sm text-gray-600 hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
                <p id="pagination-info" class="text-sm text-gray-500"></p>
            </div>
        </div>
    }
</div>

<!-- Modal Crear/Editar Producto -->
<div id="modal-producto" class="modal hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen px-4 py-8">
        <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" onclick="cerrarModal()"></div>
        <div class="relative bg-white rounded-2xl shadow-xl max-w-2xl w-full p-6">
            <div class="flex items-center justify-between mb-6">
                <h3 id="modal-titulo" class="text-lg font-semibold text-gray-900">
                    <i class="fas fa-box text-[#23916A] mr-2"></i>
                    Nuevo Producto
                </h3>
                <button onclick="cerrarModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>

            <form id="form-producto" onsubmit="guardarProducto(event)">
                <input type="hidden" id="producto-id" value="0">
                <input type="hidden" id="producto-cloudinary-id" value="">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Nombre del producto *</label>
                        <input type="text" id="producto-nombre" placeholder="Ej: Coca-Cola 600ml"
                               class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#23916A] focus:border-[#23916A] transition-all"
                               required maxlength="100">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">SKU</label>
                        <input type="text" id="producto-sku" placeholder="Ej: COCA-600ML"
                               class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#23916A] focus:border-[#23916A] transition-all"
                               maxlength="50">
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
                    <textarea id="producto-descripcion" rows="2" placeholder="Descripción del producto..."
                              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#23916A] focus:border-[#23916A] transition-all"></textarea>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Categoría *</label>
                        <select id="producto-categoria" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#23916A] transition-all" required>
                            <option value="">Seleccionar...</option>
                            @foreach (var cat in categorias)
                            {
                                <option value="@cat.Id">@cat.Nombre</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Subcategoría *</label>
                        <select id="producto-subcategoria" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#23916A] transition-all" required disabled>
                            <option value="">Seleccione categoría primero</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Marca</label>
                        <select id="producto-marca" class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#23916A] transition-all">
                            <option value="1">Sin Marca</option>
                            @foreach (var marca in marcas.Where(m => m.Activo))
                            {
                                <option value="@marca.Id">@marca.Nombre</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Imagen del producto</label>
                    <div class="flex items-start gap-4">
                        <div class="flex-1">
                            <input id="producto-imagen" type="file" accept="image/*"
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#23916A] text-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-green-50 file:text-green-700 hover:file:bg-green-100">
                            <p class="mt-1 text-xs text-gray-500">Formatos: JPG, PNG, GIF. Se subirá a Cloudinary.</p>
                        </div>
                        <img id="imagen-preview" src="" alt="Vista previa"
                             class="hidden w-20 h-20 rounded-lg border object-cover">
                    </div>
                </div>

                <div id="error-mensaje" class="hidden mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
                    <i class="fas fa-exclamation-circle mr-2"></i>
                    <span id="error-texto"></span>
                </div>

                <div class="flex gap-3 pt-4 border-t border-gray-200">
                    <button type="button" onclick="cerrarModal()"
                            class="flex-1 px-4 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors font-medium">
                        Cancelar
                    </button>
                    <button type="submit" id="btn-guardar"
                            class="flex-1 px-4 py-2.5 bg-[#23916A] text-white rounded-lg hover:bg-[#1a6b4f] transition-colors font-medium">
                        <i class="fas fa-save mr-2"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Confirmación Eliminar -->
<div id="modal-confirmar" class="modal hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen px-4">
        <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" onclick="cerrarModalConfirmar()"></div>
        <div class="relative bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 text-center">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-red-100 flex items-center justify-center">
                <i class="fas fa-exclamation-triangle text-2xl text-red-600"></i>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Confirmar Eliminación</h3>
            <p id="confirmar-mensaje" class="text-gray-500 mb-6"></p>
            <input type="hidden" id="confirmar-id">
            <div class="flex gap-3">
                <button onclick="cerrarModalConfirmar()"
                        class="flex-1 px-4 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium transition-colors">
                    Cancelar
                </button>
                <button id="btn-confirmar-eliminar"
                        class="flex-1 px-4 py-2.5 bg-red-600 text-white rounded-lg hover:bg-red-700 font-medium transition-colors">
                    <i class="fas fa-trash mr-2"></i>Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast -->
<div id="toast" class="fixed bottom-4 right-4 z-50 transform translate-y-full opacity-0 transition-all duration-300">
    <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-4 flex items-center gap-3 max-w-sm">
        <div id="toast-icon" class="w-10 h-10 rounded-full flex items-center justify-center bg-green-100 text-green-600">
            <i class="fas fa-check"></i>
        </div>
        <div>
            <p id="toast-title" class="font-medium text-gray-900">Éxito</p>
            <p id="toast-message" class="text-sm text-gray-500">Operación completada</p>
        </div>
    </div>
</div>

</div> <!-- Cierre del contenedor principal -->

@section Scripts {
<script>
    // =============== PAGINACIÓN ===============
    let currentPage = 1;
    let itemsPerPage = 25;
    const allRows = Array.from(document.querySelectorAll('.producto-row'));
    let filteredRows = [...allRows];

    function updatePagination() {
        const totalItems = filteredRows.length;
        const totalPages = Math.ceil(totalItems / itemsPerPage);
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;

        allRows.forEach(row => row.style.display = 'none');
        filteredRows.slice(start, end).forEach(row => row.style.display = '');

        const showing = Math.min(end, totalItems);
        document.getElementById('pagination-info').textContent =
            totalItems > 0 ? `Mostrando ${start + 1}-${showing} de ${totalItems} productos` : 'Sin resultados';

        document.getElementById('btn-prev').disabled = currentPage === 1;
        document.getElementById('btn-next').disabled = currentPage === totalPages || totalPages === 0;

        const numbersContainer = document.getElementById('pagination-numbers');
        numbersContainer.innerHTML = '';

        const maxButtons = 5;
        let startPage = Math.max(1, currentPage - Math.floor(maxButtons / 2));
        let endPage = Math.min(totalPages, startPage + maxButtons - 1);

        if (endPage - startPage + 1 < maxButtons) {
            startPage = Math.max(1, endPage - maxButtons + 1);
        }

        for (let i = startPage; i <= endPage; i++) {
            const btn = document.createElement('button');
            btn.textContent = i;
            btn.className = `px-3 py-1.5 rounded-lg text-sm transition-colors ${i === currentPage
                ? 'bg-[#23916A] text-white'
                : 'border border-gray-300 text-gray-600 hover:bg-gray-100'}`;
            btn.onclick = () => { currentPage = i; updatePagination(); };
            numbersContainer.appendChild(btn);
        }
    }

    document.getElementById('items-per-page')?.addEventListener('change', function() {
        itemsPerPage = parseInt(this.value);
        currentPage = 1;
        updatePagination();
    });

    document.getElementById('btn-prev')?.addEventListener('click', () => {
        if (currentPage > 1) { currentPage--; updatePagination(); }
    });

    document.getElementById('btn-next')?.addEventListener('click', () => {
        const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
        if (currentPage < totalPages) { currentPage++; updatePagination(); }
    });

    // =============== FILTROS ===============
    let subcategoriasCache = {};

    document.getElementById('filtro-categoria').addEventListener('change', function() {
        cargarSubcategorias(this.value, 'filtro-subcategoria');
    });

    document.getElementById('producto-categoria').addEventListener('change', function() {
        cargarSubcategorias(this.value, 'producto-subcategoria');
    });

    function cargarSubcategorias(idCategoria, selectId) {
        const select = document.getElementById(selectId);
        select.innerHTML = '<option value="">Cargando...</option>';
        select.disabled = true;

        if (!idCategoria) {
            select.innerHTML = '<option value="">Todas</option>';
            return;
        }

        if (subcategoriasCache[idCategoria]) {
            llenarSubcategorias(subcategoriasCache[idCategoria], selectId);
            return;
        }

        fetch(`/SubCategorias/ObtenerSubCategorias?idCategoria=${idCategoria}`)
            .then(response => response.json())
            .then(data => {
                subcategoriasCache[idCategoria] = data;
                llenarSubcategorias(data, selectId);
            })
            .catch(() => {
                select.innerHTML = '<option value="">Error al cargar</option>';
            });
    }

    function llenarSubcategorias(subcategorias, selectId) {
        const select = document.getElementById(selectId);
        const isFilter = selectId.startsWith('filtro');
        select.innerHTML = isFilter ? '<option value="">Todas</option>' : '<option value="">Seleccionar...</option>';
        subcategorias.forEach(sub => {
            select.innerHTML += `<option value="${sub.id}">${sub.nombre}</option>`;
        });
        select.disabled = false;
    }

    // Búsqueda con filtros
    document.getElementById('btn-buscar').addEventListener('click', buscarProductos);
    document.getElementById('filtro-buscar').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') buscarProductos();
    });

    function buscarProductos() {
        const termino = document.getElementById('filtro-buscar').value.toLowerCase();
        const idCategoria = document.getElementById('filtro-categoria').value;
        const idSubCategoria = document.getElementById('filtro-subcategoria').value;
        const idMarca = document.getElementById('filtro-marca').value;

        // Si hay filtros de servidor, recargar página
        if (idCategoria || idSubCategoria || idMarca) {
            const params = new URLSearchParams();
            if (termino) params.append('termino', termino);
            if (idCategoria) params.append('idCategoria', idCategoria);
            if (idSubCategoria) params.append('idSubCategoria', idSubCategoria);
            if (idMarca) params.append('idMarca', idMarca);
            window.location.href = `/Productos/AdminProductos?${params.toString()}`;
            return;
        }

        // Filtro local por término
        filteredRows = allRows.filter(row => {
            const nombre = row.dataset.nombre || '';
            const sku = row.dataset.sku || '';
            return nombre.includes(termino) || sku.includes(termino);
        });

        currentPage = 1;
        updatePagination();
    }

    // =============== MODAL PRODUCTO ===============
    function abrirModalProducto() {
        limpiarFormulario();
        document.getElementById('modal-titulo').innerHTML = '<i class="fas fa-box text-[#23916A] mr-2"></i>Nuevo Producto';
        document.getElementById('modal-producto').classList.remove('hidden');
    }

    function cerrarModal() {
        document.getElementById('modal-producto').classList.add('hidden');
    }

    function limpiarFormulario() {
        document.getElementById('producto-id').value = '0';
        document.getElementById('producto-cloudinary-id').value = '';
        document.getElementById('producto-nombre').value = '';
        document.getElementById('producto-sku').value = '';
        document.getElementById('producto-descripcion').value = '';
        document.getElementById('producto-categoria').value = '';
        document.getElementById('producto-subcategoria').innerHTML = '<option value="">Seleccione categoría primero</option>';
        document.getElementById('producto-subcategoria').disabled = true;
        document.getElementById('producto-marca').value = '1';
        document.getElementById('producto-imagen').value = '';
        document.getElementById('imagen-preview').classList.add('hidden');
        document.getElementById('error-mensaje').classList.add('hidden');
    }

    // Preview de imagen
    document.getElementById('producto-imagen').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const preview = document.getElementById('imagen-preview');
                preview.src = e.target.result;
                preview.classList.remove('hidden');
            };
            reader.readAsDataURL(file);
        }
    });

    // Editar producto
    function editarProducto(id) {
        fetch(`/Productos/ObtenerProducto?id=${id}`)
            .then(response => response.json())
            .then(data => {
                document.getElementById('producto-id').value = data.id;
                document.getElementById('producto-cloudinary-id').value = data.cloudinaryPublicId || '';
                document.getElementById('producto-nombre').value = data.nombre;
                document.getElementById('producto-sku').value = data.sku || '';
                document.getElementById('producto-descripcion').value = data.descripcion || '';
                document.getElementById('producto-categoria').value = data.categoria;
                document.getElementById('producto-marca').value = data.idMarca || 1;

                cargarSubcategoriasYSeleccionar(data.categoria, data.idSubCategoria);

                if (data.imagenUrl) {
                    const preview = document.getElementById('imagen-preview');
                    preview.src = data.imagenUrl;
                    preview.classList.remove('hidden');
                } else {
                    document.getElementById('imagen-preview').classList.add('hidden');
                }

                document.getElementById('modal-titulo').innerHTML = '<i class="fas fa-edit text-blue-500 mr-2"></i>Editar Producto';
                document.getElementById('modal-producto').classList.remove('hidden');
            })
            .catch(error => {
                showToast('error', 'Error', 'Error al cargar el producto');
            });
    }

    function cargarSubcategoriasYSeleccionar(idCategoria, idSubCategoria) {
        const select = document.getElementById('producto-subcategoria');

        if (subcategoriasCache[idCategoria]) {
            llenarSubcategorias(subcategoriasCache[idCategoria], 'producto-subcategoria');
            select.value = idSubCategoria;
            return;
        }

        fetch(`/SubCategorias/ObtenerSubCategorias?idCategoria=${idCategoria}`)
            .then(response => response.json())
            .then(data => {
                subcategoriasCache[idCategoria] = data;
                llenarSubcategorias(data, 'producto-subcategoria');
                select.value = idSubCategoria;
            });
    }

    // Guardar producto
    function guardarProducto(e) {
        e.preventDefault();

        const id = document.getElementById('producto-id').value;
        const nombre = document.getElementById('producto-nombre').value.trim();
        const sku = document.getElementById('producto-sku').value.trim();
        const descripcion = document.getElementById('producto-descripcion').value.trim();
        const idSubCategoria = document.getElementById('producto-subcategoria').value;
        const idMarca = document.getElementById('producto-marca').value;
        const imagenInput = document.getElementById('producto-imagen').files[0];
        const cloudinaryId = document.getElementById('producto-cloudinary-id').value;

        if (!nombre) {
            mostrarError('El nombre del producto es obligatorio');
            return;
        }

        if (!idSubCategoria) {
            mostrarError('Debe seleccionar una subcategoría');
            return;
        }

        const formData = new FormData();
        formData.append('nombre', nombre);
        formData.append('sku', sku);
        formData.append('descripcion', descripcion);
        formData.append('idSubCategoria', idSubCategoria);
        formData.append('idMarca', idMarca);
        if (imagenInput) formData.append('imagen', imagenInput);
        if (cloudinaryId) formData.append('cloudinaryPublicId', cloudinaryId);

        const url = id && id !== '0'
            ? `/Productos/EditarProductoAdmin?id=${id}`
            : '/Productos/CrearProductoAdmin';

        const btnGuardar = document.getElementById('btn-guardar');
        btnGuardar.disabled = true;
        btnGuardar.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Guardando...';

        fetch(url, { method: 'POST', body: formData })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    cerrarModal();
                    showToast('success', 'Éxito', data.mensaje || 'Producto guardado correctamente');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    mostrarError(data.mensaje || 'Error al guardar el producto');
                }
            })
            .catch(() => mostrarError('Error de conexión al guardar'))
            .finally(() => {
                btnGuardar.disabled = false;
                btnGuardar.innerHTML = '<i class="fas fa-save mr-2"></i>Guardar';
            });
    }

    function mostrarError(mensaje) {
        document.getElementById('error-texto').textContent = mensaje;
        document.getElementById('error-mensaje').classList.remove('hidden');
    }

    // =============== ELIMINAR PRODUCTO ===============
    function eliminarProducto(id, nombre) {
        document.getElementById('confirmar-id').value = id;
        document.getElementById('confirmar-mensaje').textContent =
            `¿Estás seguro de que deseas eliminar el producto "${nombre}"? Esta acción no se puede deshacer.`;
        document.getElementById('modal-confirmar').classList.remove('hidden');
    }

    function cerrarModalConfirmar() {
        document.getElementById('modal-confirmar').classList.add('hidden');
    }

    document.getElementById('btn-confirmar-eliminar').addEventListener('click', function() {
        const id = document.getElementById('confirmar-id').value;

        fetch(`/Productos/EliminarProductoAdmin?id=${id}`, { method: 'DELETE' })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    cerrarModalConfirmar();
                    showToast('success', 'Éxito', data.mensaje || 'Producto eliminado correctamente');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast('error', 'Error', data.mensaje || 'Error al eliminar');
                }
            })
            .catch(() => showToast('error', 'Error', 'Error de conexión'));
    });

    // =============== TOAST ===============
    function showToast(type, title, message) {
        const toast = document.getElementById('toast');
        const icon = document.getElementById('toast-icon');
        const titleEl = document.getElementById('toast-title');
        const messageEl = document.getElementById('toast-message');

        titleEl.textContent = title;
        messageEl.textContent = message;

        if (type === 'success') {
            icon.className = 'w-10 h-10 rounded-full flex items-center justify-center bg-green-100 text-green-600';
            icon.innerHTML = '<i class="fas fa-check"></i>';
        } else {
            icon.className = 'w-10 h-10 rounded-full flex items-center justify-center bg-red-100 text-red-600';
            icon.innerHTML = '<i class="fas fa-times"></i>';
        }

        toast.classList.remove('translate-y-full', 'opacity-0');

        setTimeout(() => {
            toast.classList.add('translate-y-full', 'opacity-0');
        }, 3000);
    }

    // Inicializar paginación
    if (allRows.length > 0) {
        updatePagination();
    }
</script>
}
