@model BusinessLogic.Models.Negocio
@{
    var producto = ViewBag.SelectedProduct as BusinessLogic.Models.Producto;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model?.Nombre - @producto?.Nombre</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="bg-white">

    <header class="relative w-full bg-[#F5EFE4] shadow-md">
        <div class="relative h-56 w-full">
            <img src="/ruta/a/la/imagen/de/fondo.jpg" alt="Fondo"
                 class="absolute inset-0 h-full w-full object-contain brightness-50" />
            <div class="relative top-[69%] z-10 flex flex-row items-start gap-4 px-4 sm:top-24 md:items-start md:gap-6 md:px-10">
                <div class="flex size-32 items-center justify-center overflow-hidden rounded-xl border bg-white shadow-lg sm:size-60">
                    @if (!string.IsNullOrWhiteSpace(Model?.imagen?.Base64))
                    {
                        <img src="@Model.imagen.Base64" alt="Logo negocio" class="h-full w-full object-cover" />
                    }
                </div>
                <div class="absolute top-1/2 left-44 -translate-y-1/2 text-left sm:left-72">
                    <h1 class="text-3xl leading-tight font-extrabold tracking-tight text-gray-800 sm:text-4xl">
                        @Model?.Nombre
                    </h1>
                    <p class="text-base font-semibold tracking-wide text-[#15803D] uppercase sm:text-lg">
                        @Model?.Descripcion
                    </p>
                    <p class="text-base font-semibold tracking-wide text-[#15803D] uppercase sm:text-lg">
                        @Model?.Telefono
                    </p>
                </div>
            </div>
        </div>
    </header>

    @Html.Partial("_ContactModal")

    <!-- DETALLE DE PRODUCTO -->
    <main class="mx-auto mt-8 max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">

            <!-- GALERÍA -->
            <section>
                <div class="overflow-hidden rounded-lg border">
                    <img id="main-img"
                         src="@producto?.ImagenUrl"
                         alt="@producto?.Nombre"
                         class="h-64 w-full object-contain sm:h-80 md:h-96" />
                </div>
            </section>

            <!-- DATOS -->
            <section>
                <h2 class="text-2xl font-bold sm:text-3xl">@producto?.Nombre</h2>
                <div class="mt-2 flex items-center space-x-4">
                    <span class="text-xl font-bold text-green-600 sm:text-2xl">$@producto?.Precio</span>
                </div>
                <a href="tel:@Model?.Telefono"
                   class="mt-6 block w-full rounded-lg bg-green-600 py-3 text-center text-sm text-white hover:bg-green-700 sm:text-base">
                    Contáctanos
                </a>
            </section>
        </div>

        <!-- UBICACIÓN -->
        <section class="mt-10">
            <h3 class="mb-4 text-xl font-semibold sm:text-2xl">Ubicación</h3>
            <div class="mb-4">
                <input id="location" type="hidden" value="@Model?.Localizacion" />
            </div>
            <div id="map" class="h-64 w-full rounded-lg border sm:h-80 md:h-96"></div>
        </section>
    </main>

    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAPudyk3G3YG7GOEpId4xMK_WFIEenOSp8&libraries=places"></script>
    <script>
        function initMap() {
          const defaultLatLng = { lat: 2.9273, lng: -75.2819 };
          const locField = document.getElementById('location');
          let initial = defaultLatLng;
          if (locField && locField.value.includes(',')) {
            const parts = locField.value.split(',');
            initial = { lat: parseFloat(parts[0]), lng: parseFloat(parts[1]) };
          }
          const map = new google.maps.Map(document.getElementById('map'), { center: initial, zoom: 13 });
          const marker = new google.maps.Marker({ position: initial, map, draggable: true });
          const searchBox = new google.maps.places.SearchBox(document.getElementById('searchLocation'));
          searchBox.addListener('places_changed', () => {
            const places = searchBox.getPlaces(); if (!places.length) return;
            const loc = places[0].geometry.location;
            map.setCenter(loc); marker.setPosition(loc);
            locField.value = `${loc.lat()},${loc.lng()}`;
          });
          marker.addListener('dragend', () => {
            const pos = marker.getPosition(); locField.value = `${pos.lat()},${pos.lng()}`;
          });
        }
        window.onload = initMap;
    </script>
</body>
</html>