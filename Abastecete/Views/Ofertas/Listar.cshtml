<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>

<body>
    @* <section class="w-full bg-gray-200 h-80 flex items-center justify-center mb-8 rounded-lg" style="margin-top: 10px;">
        <h1 class="text-3xl font-bold text-gray-800">Promociones especiales</h1>
    </section> *@


    <!-- OFERTAS FLASH -->
    <div class="off-section p-6 lg:p-10 bg-gray-100" id="ofertas-container">
        <div id="offers-container" class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 gap-6"></div>
    </div>

    <script>
        const offers = [
            { name: "PAPA PASTUSA 50 KG", oldPrice: "$60", newPrice: "$50", available: 30, sold: 30, progress: 30, bgColor: "bg-green-100", image: "/css/Images/papa.jpg" },
            { name: "Cerveza X 6 LATA DORADA", oldPrice: "$1500", newPrice: "$1400", available: 99, sold: 1, progress: 1, bgColor: "bg-orange-200", image: "/css/Images/lata.jpg" },
            { name: "TOMATE UVALINA 500 gr", oldPrice: "$300", newPrice: "$200", available: 100, sold: 199, progress: 199, bgColor: "bg-green-100", image: "/css/Images/tomate.jpg" },
            { name: "YOGURT NATURAL 1L", oldPrice: "$250", newPrice: "$200", available: 80, sold: 50, progress: 62, bgColor: "bg-orange-200", image: "/css/Images/yogurt.jpeg" },
            { name: "CAFÉ PREMIUM 500g", oldPrice: "$400", newPrice: "$350", available: 20, sold: 15, progress: 75, bgColor: "bg-green-100", image: "/css/Images/cafe.jpeg" },
            { name: "ARROZ EXTRA 25KG", oldPrice: "$100", newPrice: "$90", available: 50, sold: 10, progress: 20, bgColor: "bg-orange-200", image: "/css/Images/arroz.jpg" }
        ];

        const offersContainer = document.getElementById("offers-container");

        const renderOffers = () => {
            offersContainer.innerHTML = ""; // Limpiar contenedor antes de renderizar

            offers.forEach((offer) => {
                const card = document.createElement("div");
                card.className = `${offer.bgColor} p-4 rounded-lg shadow-md flex flex-col items-center text-center transition-transform transform hover:scale-105`;

                card.innerHTML = `
                    <div class="relative w-32 h-40 overflow-hidden rounded-md bg-gray-300">
                        <img src="${offer.image}" alt="${offer.name}" class="w-full h-full object-cover">
                    </div>
                    <h3 class="text-sm font-semibold text-gray-800 mt-3">${offer.name}</h3>
                    <p class="text-xs text-gray-500 line-through">${offer.oldPrice}</p>
                    <p class="text-lg font-bold text-green-600">${offer.newPrice}</p>
                    <p class="text-xs text-gray-600">Disponible: <span class="text-green-600 font-bold">${offer.available}</span></p>


                    <p class="text-xs text-gray-500 mt-1">${offer.sold} vendidos</p>

                    <button class="mt-3 bg-orange-500 text-white px-4 py-2 rounded-full text-xs hover:bg-orange-600">
                        Comprar Ahora
                    </button>
                `;

                offersContainer.appendChild(card);
            });
        };

        // Renderizar ofertas al cargar la página
        renderOffers();
    </script>

    <!-- PROVEEDORES -->
    <section class="proovedores-section p-6 lg:p-10" style="background-color: #F4F1E9">
        <div class="flex flex-col lg:flex-row justify-between items-center mb-6">
            <h2 class="text-2xl font-bold text-gray-800 text-center lg:text-left pl-0 lg:pl-10">🏪  Mejores Proveedores</h2>
        </div>

        <!-- Contenedor de Proveedores -->
        <div id="providers-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"></div>

        <!-- Sección destacada -->
        <div class="mt-8 bg-green-600 text-white text-center p-6 rounded-lg shadow-lg flex flex-col items-center">
            <h3 class="text-lg lg:text-xl font-bold">Encuentra los mejores proveedores</h3>
            <p class="text-2xl lg:text-3xl font-bold mt-2">📦 ABASTECE TU NEGOCIO YA</p>
            <button class="mt-4 bg-orange-500 text-white px-6 py-2 rounded-full text-lg hover:bg-orange-600">
                Ver más
            </button>
        </div>
    </section>

    <script>
        const providers = [
            { name: "MERCA FRUVER", category: "FRUTAS Y VERDURAS", image: "/images/aa.jpg", buttonColor: "#23916A" },
            { name: "LICORERIA MANOLO", category: "BEBIDAS", image: "/images/provider2.jpg", buttonColor: "#F66623" },
            { name: "CATCH BIG", category: "DESPENSA", image: "/images/provider3.jpg", buttonColor: "#F66623" },
            { name: "RAPICUNDI", category: "MERCADO", image: "/images/provider4.jpg", buttonColor: "#23916A" },
            { name: "SUPER CARNES", category: "CARNES", image: "/images/provider5.jpg", buttonColor: "#23916A" },
            { name: "LACTEOMANIA", category: "LÁCTEOS", image: "/images/provider6.jpg", buttonColor: "#F66623" }
        ];

        const providersGrid = document.getElementById("providers-grid");

        const renderProviders = () => {
            providersGrid.innerHTML = ""; // Limpiar antes de renderizar

            providers.forEach((provider) => {
                const card = document.createElement("div");
                card.className = "bg-white rounded-xl shadow-md p-6 flex flex-col items-center text-center transition-transform transform hover:scale-105";

                card.innerHTML = `
                    <img src="${provider.image}" alt="${provider.name}" class="w-20 h-20 lg:w-24 lg:h-24 rounded-lg">
                    <h3 class="text-lg font-bold text-gray-700 mt-3">${provider.name}</h3>
                    <p class="text-sm text-gray-600">${provider.category}</p>
                    <button class="mt-3 text-white px-4 py-2 rounded-full text-sm hover:opacity-90" style="background-color: ${provider.buttonColor}">
                        Ver Ahora &rarr;
                    </button>
                `;

                providersGrid.appendChild(card);
            });
        };

        // Renderizar proveedores al cargar la página
        renderProviders();
    </script>


</body>
