@model BusinessLogic.Models.DashboardAdmin
@{
    var periodoSeleccionado = ViewBag.PeriodoSeleccionado as string ?? "7d";
}

<!-- Header con barra blanca -->
<div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <a href="@Url.Action("Index", "Home")" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="text-xl font-bold text-gray-900">Dashboard Administrador</h1>
                    <p class="text-gray-500 text-sm">Estadísticas globales del sistema</p>
                </div>
            </div>
            <!-- Selector de período -->
            <div class="flex items-center gap-2">
                <select id="selectPeriodo" class="px-4 py-2 rounded-lg border border-gray-300 text-sm focus:border-[#23916A] focus:ring-2 focus:ring-[#23916A]/20 outline-none">
                    @if (periodoSeleccionado == "today") { <option value="today" selected>Hoy</option> } else { <option value="today">Hoy</option> }
                    @if (periodoSeleccionado == "7d") { <option value="7d" selected>Últimos 7 días</option> } else { <option value="7d">Últimos 7 días</option> }
                    @if (periodoSeleccionado == "30d") { <option value="30d" selected>Últimos 30 días</option> } else { <option value="30d">Últimos 30 días</option> }
                    @if (periodoSeleccionado == "90d") { <option value="90d" selected>Últimos 90 días</option> } else { <option value="90d">Últimos 90 días</option> }
                    @if (periodoSeleccionado == "year") { <option value="year" selected>Este año</option> } else { <option value="year">Este año</option> }
                </select>
            </div>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- Tarjetas de estadísticas principales -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <!-- Usuarios activos -->
        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500 mb-1">Usuarios activos</p>
                    <p class="text-2xl font-bold text-gray-900">@Model.Estadisticas.TotalUsuariosActivos.ToString("N0")</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center">
                    <i class="fas fa-users text-blue-600"></i>
                </div>
            </div>
            <div class="mt-3 text-sm text-gray-400">
                <span class="text-blue-600 font-medium">+@Model.Estadisticas.NuevosUsuariosPeriodo</span> nuevos en el período
            </div>
        </div>

        <!-- Locales activos -->
        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500 mb-1">Locales activos</p>
                    <p class="text-2xl font-bold text-gray-900">@Model.Estadisticas.TotalLocalesActivos.ToString("N0")</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center">
                    <i class="fas fa-store text-green-600"></i>
                </div>
            </div>
            <div class="mt-3 text-sm text-gray-400">
                <span class="text-green-600 font-medium">+@Model.Estadisticas.NuevosLocalesPeriodo</span> nuevos en el período
            </div>
        </div>

        <!-- Visitas totales -->
        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500 mb-1">Visitas a locales</p>
                    <p class="text-2xl font-bold text-gray-900">@Model.Estadisticas.TotalVisitasLocales.ToString("N0")</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-purple-100 flex items-center justify-center">
                    <i class="fas fa-eye text-purple-600"></i>
                </div>
            </div>
            @if (Model.Estadisticas.CambioVisitas.HasValue)
            {
                var cambio = Model.Estadisticas.CambioVisitas.Value;
                var colorCambio = cambio >= 0 ? "text-green-600" : "text-red-600";
                var iconoCambio = cambio >= 0 ? "fa-arrow-up" : "fa-arrow-down";
                <div class="mt-3 flex items-center gap-1 text-sm @colorCambio">
                    <i class="fas @iconoCambio text-xs"></i>
                    <span>@Math.Abs(cambio)%</span>
                    <span class="text-gray-400">vs período anterior</span>
                </div>
            }
        </div>

        <!-- Clics WhatsApp -->
        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500 mb-1">Clics en WhatsApp</p>
                    <p class="text-2xl font-bold text-gray-900">@Model.Estadisticas.TotalClicsWhatsapp.ToString("N0")</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-emerald-100 flex items-center justify-center">
                    <i class="fab fa-whatsapp text-emerald-600 text-xl"></i>
                </div>
            </div>
            @if (Model.Estadisticas.CambioWhatsapp.HasValue)
            {
                var cambio = Model.Estadisticas.CambioWhatsapp.Value;
                var colorCambio = cambio >= 0 ? "text-green-600" : "text-red-600";
                var iconoCambio = cambio >= 0 ? "fa-arrow-up" : "fa-arrow-down";
                <div class="mt-3 flex items-center gap-1 text-sm @colorCambio">
                    <i class="fas @iconoCambio text-xs"></i>
                    <span>@Math.Abs(cambio)%</span>
                    <span class="text-gray-400">vs período anterior</span>
                </div>
            }
        </div>
    </div>

    <!-- Segunda fila de estadísticas -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
        <!-- Total productos -->
        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-orange-100 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-box text-orange-600"></i>
                </div>
                <div>
                    <p class="text-sm text-gray-500">Productos registrados</p>
                    <p class="text-xl font-bold text-gray-900">@Model.Estadisticas.TotalProductosActivos.ToString("N0")</p>
                </div>
            </div>
        </div>

        <!-- Vistas de productos -->
        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-pink-100 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-chart-line text-pink-600"></i>
                </div>
                <div>
                    <p class="text-sm text-gray-500">Vistas de productos</p>
                    <p class="text-xl font-bold text-gray-900">@Model.Estadisticas.TotalVisitasProductos.ToString("N0")</p>
                </div>
            </div>
        </div>

        <!-- Búsquedas -->
        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-cyan-100 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-search text-cyan-600"></i>
                </div>
                <div>
                    <p class="text-sm text-gray-500">Apariciones en búsquedas</p>
                    <p class="text-xl font-bold text-gray-900">@Model.Estadisticas.TotalBusquedas.ToString("N0")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráficos y tablas -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
        <!-- Gráfico principal -->
        <div class="lg:col-span-2 bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900">Actividad del sistema</h3>
                <div class="flex gap-4 text-sm">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="toggleVisitas" checked class="rounded text-purple-600 focus:ring-purple-500">
                        <span class="text-gray-600">Visitas</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="toggleUsuarios" checked class="rounded text-blue-600 focus:ring-blue-500">
                        <span class="text-gray-600">Nuevos usuarios</span>
                    </label>
                </div>
            </div>
            <div class="h-72">
                <canvas id="chartActividad"></canvas>
            </div>
        </div>

        <!-- Distribución de membresías -->
        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Membresías</h3>
            @if (Model.DistribucionMembresias.Any())
            {
                <div class="space-y-4">
                    @foreach (var membresia in Model.DistribucionMembresias)
                    {
                        var total = membresia.Activas + membresia.Pendientes + membresia.Vencidas;
                        var porcentajeActivas = total > 0 ? (membresia.Activas * 100 / total) : 0;
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-sm font-medium text-gray-700">@membresia.NombreMembresia</span>
                                <span class="text-sm text-gray-500">@total total</span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-2">
                                <div class="bg-[#23916A] h-2 rounded-full transition-all" style="width: @porcentajeActivas%"></div>
                            </div>
                            <div class="flex justify-between text-xs text-gray-500 mt-1">
                                <span class="text-green-600">@membresia.Activas activas</span>
                                <span class="text-yellow-600">@membresia.Pendientes pendientes</span>
                                <span class="text-red-600">@membresia.Vencidas vencidas</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-8 text-gray-400">
                    <i class="fas fa-id-card text-4xl mb-2"></i>
                    <p class="text-sm">Sin datos de membresías</p>
                </div>
            }
        </div>
    </div>

    <!-- Locales más visitados y actividad reciente -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Locales más visitados -->
        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Locales más visitados</h3>
            @if (Model.LocalesMasVisitados.Any())
            {
                <div class="space-y-3">
                    @foreach (var local in Model.LocalesMasVisitados.Take(5))
                    {
                        <div class="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-50 transition-colors">
                            @if (!string.IsNullOrEmpty(local.LogoUrl))
                            {
                                <img src="@local.LogoUrl" alt="@local.NombreLocal" class="w-10 h-10 rounded-lg object-cover">
                            }
                            else
                            {
                                <div class="w-10 h-10 rounded-lg bg-gray-200 flex items-center justify-center">
                                    <i class="fas fa-store text-gray-400"></i>
                                </div>
                            }
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-gray-900 truncate">@local.NombreLocal</p>
                                <p class="text-xs text-gray-500 truncate">@local.Direccion</p>
                            </div>
                            <div class="text-right">
                                <p class="text-sm font-semibold text-[#23916A]">@local.TotalVisitas.ToString("N0")</p>
                                <p class="text-xs text-gray-400">visitas</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-8 text-gray-400">
                    <i class="fas fa-store text-4xl mb-2"></i>
                    <p class="text-sm">Sin datos aún</p>
                </div>
            }
        </div>

        <!-- Actividad reciente -->
        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Actividad reciente</h3>
            @if (Model.ActividadReciente.Any())
            {
                <div class="space-y-3 max-h-80 overflow-y-auto">
                    @foreach (var actividad in Model.ActividadReciente.Take(10))
                    {
                        var (icono, color) = actividad.TipoEvento switch
                        {
                            "VISITA_LOCAL" => ("fa-eye", "bg-blue-100 text-blue-600"),
                            "VISITA_PRODUCTO" => ("fa-box", "bg-purple-100 text-purple-600"),
                            "CLIC_WHATSAPP" => ("fa-whatsapp", "bg-green-100 text-green-600"),
                            "BUSQUEDA_APARICION" => ("fa-search", "bg-orange-100 text-orange-600"),
                            _ => ("fa-circle", "bg-gray-100 text-gray-600")
                        };
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-full @color flex items-center justify-center flex-shrink-0">
                                <i class="@(actividad.TipoEvento == "CLIC_WHATSAPP" ? "fab" : "fas") @icono text-sm"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm text-gray-900">
                                    @switch (actividad.TipoEvento)
                                    {
                                        case "VISITA_LOCAL":
                                            <span>Visita a <strong>@actividad.NombreLocal</strong></span>
                                            break;
                                        case "VISITA_PRODUCTO":
                                            <span>Vieron <strong>@(actividad.NombreProducto ?? "producto")</strong> en @actividad.NombreLocal</span>
                                            break;
                                        case "CLIC_WHATSAPP":
                                            <span>Clic WhatsApp en <strong>@actividad.NombreLocal</strong></span>
                                            break;
                                        case "BUSQUEDA_APARICION":
                                            <span><strong>@actividad.NombreLocal</strong> en resultados de búsqueda</span>
                                            break;
                                        default:
                                            <span>Actividad en <strong>@actividad.NombreLocal</strong></span>
                                            break;
                                    }
                                </p>
                                <p class="text-xs text-gray-400">@actividad.FechaHora.ToString("dd/MM HH:mm")</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-8 text-gray-400">
                    <i class="fas fa-history text-4xl mb-2"></i>
                    <p class="text-sm">Sin actividad reciente</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Datos iniciales del gráfico
        const datosGrafico = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DatosGrafico.Select(d => new {
            fecha = d.Fecha.ToString("yyyy-MM-dd"),
            fechaCorta = d.Fecha.ToString("dd MMM"),
            visitas = d.Visitas,
            clicsWhatsapp = d.ClicsWhatsapp,
            nuevosUsuarios = d.NuevosUsuarios,
            nuevosLocales = d.NuevosLocales
        })));

        // Configuración del gráfico
        const ctx = document.getElementById('chartActividad').getContext('2d');
        const chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: datosGrafico.map(d => d.fechaCorta),
                datasets: [
                    {
                        label: 'Visitas',
                        data: datosGrafico.map(d => d.visitas),
                        borderColor: '#9333EA',
                        backgroundColor: 'rgba(147, 51, 234, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2
                    },
                    {
                        label: 'Nuevos usuarios',
                        data: datosGrafico.map(d => d.nuevosUsuarios),
                        borderColor: '#3B82F6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        backgroundColor: 'white',
                        titleColor: '#111827',
                        bodyColor: '#6B7280',
                        borderColor: '#E5E7EB',
                        borderWidth: 1,
                        padding: 12,
                        displayColors: true,
                        boxPadding: 4
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            color: '#9CA3AF',
                            font: { size: 11 }
                        }
                    },
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: '#F3F4F6'
                        },
                        ticks: {
                            color: '#9CA3AF',
                            font: { size: 11 },
                            precision: 0
                        }
                    }
                },
                interaction: {
                    mode: 'nearest',
                    axis: 'x',
                    intersect: false
                }
            }
        });

        // Toggle datasets
        document.getElementById('toggleVisitas').addEventListener('change', function() {
            chart.data.datasets[0].hidden = !this.checked;
            chart.update();
        });

        document.getElementById('toggleUsuarios').addEventListener('change', function() {
            chart.data.datasets[1].hidden = !this.checked;
            chart.update();
        });

        // Cambio de período
        document.getElementById('selectPeriodo').addEventListener('change', function() {
            window.location.href = '@Url.Action("DashboardAdmin", "Analiticas")?periodo=' + this.value;
        });
    </script>
}
