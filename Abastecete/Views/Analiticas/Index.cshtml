@model BusinessLogic.Models.DashboardAnaliticas
@{
    ViewData["Title"] = "Analíticas del Local";
    ViewData["Description"] = "Visualiza las estadísticas de tu negocio: visitas al perfil, clics en WhatsApp, vistas de productos y apariciones en búsquedas.";
    var local = ViewBag.Local as BusinessLogic.Models.Negocio;
    var periodoSeleccionado = ViewBag.PeriodoSeleccionado as string ?? "7d";
}

<!-- Skeleton de carga -->
<div id="skeleton-analiticas" class="animate-pulse">
    <!-- Header skeleton -->
    <div class="bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-6 h-6 bg-gray-200 rounded"></div>
                    <div>
                        <div class="h-6 w-32 bg-gray-200 rounded mb-2"></div>
                        <div class="h-4 w-48 bg-gray-200 rounded"></div>
                    </div>
                </div>
                <div class="h-10 w-40 bg-gray-200 rounded-lg"></div>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <!-- Stats cards skeleton -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
                <div class="flex items-center justify-between">
                    <div class="flex-1">
                        <div class="h-4 w-24 bg-gray-200 rounded mb-2"></div>
                        <div class="h-8 w-16 bg-gray-200 rounded"></div>
                    </div>
                    <div class="w-12 h-12 rounded-full bg-gray-200"></div>
                </div>
                <div class="mt-3 h-4 w-32 bg-gray-200 rounded"></div>
            </div>
            <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
                <div class="flex items-center justify-between">
                    <div class="flex-1">
                        <div class="h-4 w-24 bg-gray-200 rounded mb-2"></div>
                        <div class="h-8 w-16 bg-gray-200 rounded"></div>
                    </div>
                    <div class="w-12 h-12 rounded-full bg-gray-200"></div>
                </div>
                <div class="mt-3 h-4 w-32 bg-gray-200 rounded"></div>
            </div>
            <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
                <div class="flex items-center justify-between">
                    <div class="flex-1">
                        <div class="h-4 w-24 bg-gray-200 rounded mb-2"></div>
                        <div class="h-8 w-16 bg-gray-200 rounded"></div>
                    </div>
                    <div class="w-12 h-12 rounded-full bg-gray-200"></div>
                </div>
                <div class="mt-3 h-4 w-32 bg-gray-200 rounded"></div>
            </div>
            <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
                <div class="flex items-center justify-between">
                    <div class="flex-1">
                        <div class="h-4 w-24 bg-gray-200 rounded mb-2"></div>
                        <div class="h-8 w-16 bg-gray-200 rounded"></div>
                    </div>
                    <div class="w-12 h-12 rounded-full bg-gray-200"></div>
                </div>
                <div class="mt-3 h-4 w-32 bg-gray-200 rounded"></div>
            </div>
        </div>

        <!-- Chart and products skeleton -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 bg-white rounded-xl shadow-sm p-6 border border-gray-100">
                <div class="h-6 w-40 bg-gray-200 rounded mb-4"></div>
                <div class="h-72 bg-gray-200 rounded"></div>
            </div>
            <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
                <div class="h-6 w-40 bg-gray-200 rounded mb-4"></div>
                <div class="space-y-3">
                    <div class="flex items-center gap-3 p-2">
                        <div class="w-10 h-10 rounded-lg bg-gray-200"></div>
                        <div class="flex-1">
                            <div class="h-4 w-32 bg-gray-200 rounded mb-1"></div>
                            <div class="h-3 w-20 bg-gray-200 rounded"></div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 p-2">
                        <div class="w-10 h-10 rounded-lg bg-gray-200"></div>
                        <div class="flex-1">
                            <div class="h-4 w-32 bg-gray-200 rounded mb-1"></div>
                            <div class="h-3 w-20 bg-gray-200 rounded"></div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 p-2">
                        <div class="w-10 h-10 rounded-lg bg-gray-200"></div>
                        <div class="flex-1">
                            <div class="h-4 w-32 bg-gray-200 rounded mb-1"></div>
                            <div class="h-3 w-20 bg-gray-200 rounded"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tips skeleton -->
        <div class="mt-6 bg-gray-200 rounded-xl p-6 h-48"></div>
    </div>
</div>

<!-- Contenido real (oculto inicialmente) -->
<div id="content-analiticas" class="hidden">
<!-- Header con barra blanca -->
<div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <a href="@Url.Action("Index", "Home")" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <div>
                    <h1 class="text-xl font-bold text-gray-900">Analíticas</h1>
                    <p class="text-gray-500 text-sm">Estadísticas de @local?.Nombre</p>
                </div>
            </div>
            <!-- Selector de período -->
            <div class="flex items-center gap-2">
                <select id="selectPeriodo" class="px-4 py-2 rounded-lg border border-gray-300 text-sm focus:border-[#23916A] focus:ring-2 focus:ring-[#23916A]/20 outline-none">
                    @if (periodoSeleccionado == "today") { <option value="today" selected>Hoy</option> } else { <option value="today">Hoy</option> }
                    @if (periodoSeleccionado == "7d") { <option value="7d" selected>Últimos 7 días</option> } else { <option value="7d">Últimos 7 días</option> }
                    @if (periodoSeleccionado == "30d") { <option value="30d" selected>Últimos 30 días</option> } else { <option value="30d">Últimos 30 días</option> }
                    @if (periodoSeleccionado == "90d") { <option value="90d" selected>Últimos 90 días</option> } else { <option value="90d">Últimos 90 días</option> }
                    @if (periodoSeleccionado == "year") { <option value="year" selected>Este año</option> } else { <option value="year">Este año</option> }
                </select>
            </div>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- Tarjetas de estadísticas -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <!-- Visitas al perfil -->
        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500 mb-1">Visitas al perfil</p>
                    <p class="text-2xl font-bold text-gray-900" id="stat-visitas">@Model.Estadisticas.TotalVisitas.ToString("N0")</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center">
                    <i class="fas fa-eye text-blue-600"></i>
                </div>
            </div>
            @if (Model.Estadisticas.CambioVisitas.HasValue)
            {
                var cambio = Model.Estadisticas.CambioVisitas.Value;
                var colorCambio = cambio >= 0 ? "text-green-600" : "text-red-600";
                var iconoCambio = cambio >= 0 ? "fa-arrow-up" : "fa-arrow-down";
                <div class="mt-3 flex items-center gap-1 text-sm @colorCambio">
                    <i class="fas @iconoCambio text-xs"></i>
                    <span id="cambio-visitas">@Math.Abs(cambio)%</span>
                    <span class="text-gray-400">vs período anterior</span>
                </div>
            }
        </div>

        <!-- Clics en WhatsApp -->
        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500 mb-1">Clics en WhatsApp</p>
                    <p class="text-2xl font-bold text-gray-900" id="stat-whatsapp">@Model.Estadisticas.TotalClicsWhatsapp.ToString("N0")</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center">
                    <i class="fab fa-whatsapp text-green-600 text-xl"></i>
                </div>
            </div>
            @if (Model.Estadisticas.CambioClicsWhatsapp.HasValue)
            {
                var cambio = Model.Estadisticas.CambioClicsWhatsapp.Value;
                var colorCambio = cambio >= 0 ? "text-green-600" : "text-red-600";
                var iconoCambio = cambio >= 0 ? "fa-arrow-up" : "fa-arrow-down";
                <div class="mt-3 flex items-center gap-1 text-sm @colorCambio">
                    <i class="fas @iconoCambio text-xs"></i>
                    <span id="cambio-whatsapp">@Math.Abs(cambio)%</span>
                    <span class="text-gray-400">vs período anterior</span>
                </div>
            }
        </div>

        <!-- Vistas de productos -->
        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500 mb-1">Vistas de productos</p>
                    <p class="text-2xl font-bold text-gray-900" id="stat-productos">@Model.Estadisticas.TotalVisitasProductos.ToString("N0")</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-purple-100 flex items-center justify-center">
                    <i class="fas fa-box text-purple-600"></i>
                </div>
            </div>
            @if (Model.Estadisticas.CambioVisitasProductos.HasValue)
            {
                var cambio = Model.Estadisticas.CambioVisitasProductos.Value;
                var colorCambio = cambio >= 0 ? "text-green-600" : "text-red-600";
                var iconoCambio = cambio >= 0 ? "fa-arrow-up" : "fa-arrow-down";
                <div class="mt-3 flex items-center gap-1 text-sm @colorCambio">
                    <i class="fas @iconoCambio text-xs"></i>
                    <span id="cambio-productos">@Math.Abs(cambio)%</span>
                    <span class="text-gray-400">vs período anterior</span>
                </div>
            }
        </div>

        <!-- Apariciones en búsqueda -->
        <div class="bg-white rounded-xl shadow-sm p-5 border border-gray-100">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-500 mb-1">En búsquedas</p>
                    <p class="text-2xl font-bold text-gray-900" id="stat-busquedas">@Model.Estadisticas.TotalAparicionesBusqueda.ToString("N0")</p>
                </div>
                <div class="w-12 h-12 rounded-full bg-orange-100 flex items-center justify-center">
                    <i class="fas fa-search text-orange-600"></i>
                </div>
            </div>
            <div class="mt-3 text-sm text-gray-400">
                Veces que apareciste en resultados
            </div>
        </div>
    </div>

    <!-- Gráfico y productos más vistos -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Gráfico de visitas -->
        <div class="lg:col-span-2 bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-900">Visitas en el tiempo</h3>
                <div class="flex gap-4 text-sm">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="toggleVisitas" checked class="rounded text-blue-600 focus:ring-blue-500">
                        <span class="text-gray-600">Visitas</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="toggleWhatsapp" checked class="rounded text-green-600 focus:ring-green-500">
                        <span class="text-gray-600">WhatsApp</span>
                    </label>
                </div>
            </div>
            <div class="h-72">
                <canvas id="chartVisitas"></canvas>
            </div>
        </div>

        <!-- Productos más vistos -->
        <div class="bg-white rounded-xl shadow-sm p-6 border border-gray-100">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Productos más vistos</h3>
            @if (Model.ProductosMasVistos.Any())
            {
                <div class="space-y-3" id="lista-productos">
                    @foreach (var producto in Model.ProductosMasVistos)
                    {
                        <div class="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-50 transition-colors">
                            @if (!string.IsNullOrEmpty(producto.ImagenUrl))
                            {
                                <img src="@producto.ImagenUrl" alt="@producto.NombreProducto" class="w-10 h-10 rounded-lg object-cover">
                            }
                            else
                            {
                                <div class="w-10 h-10 rounded-lg bg-gray-200 flex items-center justify-center">
                                    <i class="fas fa-box text-gray-400"></i>
                                </div>
                            }
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-gray-900 truncate">@producto.NombreProducto</p>
                                <p class="text-xs text-gray-500">@producto.TotalVistas vistas</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-8 text-gray-400">
                    <i class="fas fa-chart-bar text-4xl mb-2"></i>
                    <p class="text-sm">Sin datos aún</p>
                </div>
            }
        </div>
    </div>

    <!-- Tips para mejorar -->
    <div class="mt-6 bg-gradient-to-r from-[#23916A] to-[#1a6b4f] rounded-xl p-6 text-white">
        <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0">
                <i class="fas fa-lightbulb text-xl"></i>
            </div>
            <div>
                <h3 class="font-semibold text-lg mb-2">Tips para aumentar tus visitas</h3>
                <ul class="space-y-1 text-sm text-white/90">
                    <li><i class="fas fa-check mr-2"></i>Mantén tus productos actualizados con fotos de calidad</li>
                    <li><i class="fas fa-check mr-2"></i>Completa toda la información de tu negocio</li>
                    <li><i class="fas fa-check mr-2"></i>Responde rápido a los mensajes de WhatsApp</li>
                    <li><i class="fas fa-check mr-2"></i>Comparte el enlace de tu tienda en redes sociales</li>
                </ul>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Mostrar contenido después de cargar el DOM
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(function() {
                document.getElementById('skeleton-analiticas').style.display = 'none';
                document.getElementById('content-analiticas').classList.remove('hidden');
                document.getElementById('content-analiticas').style.transition = 'opacity 300ms';
                document.getElementById('content-analiticas').style.opacity = '1';
            }, 100);
        });
    </script>
    <script>
        // Datos iniciales del gráfico
        const datosGrafico = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DatosGrafico.Select(d => new {
            fecha = d.Fecha.ToString("yyyy-MM-dd"),
            fechaCorta = d.Fecha.ToString("dd MMM"),
            visitas = d.Visitas,
            clicsWhatsapp = d.ClicsWhatsapp
        })));

        // Configuración del gráfico
        const ctx = document.getElementById('chartVisitas').getContext('2d');
        const chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: datosGrafico.map(d => d.fechaCorta),
                datasets: [
                    {
                        label: 'Visitas',
                        data: datosGrafico.map(d => d.visitas),
                        borderColor: '#3B82F6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2
                    },
                    {
                        label: 'WhatsApp',
                        data: datosGrafico.map(d => d.clicsWhatsapp),
                        borderColor: '#22C55E',
                        backgroundColor: 'rgba(34, 197, 94, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 2
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                        backgroundColor: 'white',
                        titleColor: '#111827',
                        bodyColor: '#6B7280',
                        borderColor: '#E5E7EB',
                        borderWidth: 1,
                        padding: 12,
                        displayColors: true,
                        boxPadding: 4
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false
                        },
                        ticks: {
                            color: '#9CA3AF',
                            font: { size: 11 }
                        }
                    },
                    y: {
                        beginAtZero: true,
                        grid: {
                            color: '#F3F4F6'
                        },
                        ticks: {
                            color: '#9CA3AF',
                            font: { size: 11 },
                            precision: 0
                        }
                    }
                },
                interaction: {
                    mode: 'nearest',
                    axis: 'x',
                    intersect: false
                }
            }
        });

        // Toggle datasets
        document.getElementById('toggleVisitas').addEventListener('change', function() {
            chart.data.datasets[0].hidden = !this.checked;
            chart.update();
        });

        document.getElementById('toggleWhatsapp').addEventListener('change', function() {
            chart.data.datasets[1].hidden = !this.checked;
            chart.update();
        });

        // Cambio de período
        document.getElementById('selectPeriodo').addEventListener('change', function() {
            window.location.href = '@Url.Action("Index", "Analiticas")?periodo=' + this.value;
        });
    </script>
}
