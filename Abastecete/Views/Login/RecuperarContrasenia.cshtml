@{
    Layout = null;
    string correoIngresado = TempData["CorreoIngresado"] as string ?? "";
    bool mostrarCodigo = TempData["MostrarCodigo"] != null && (bool)TempData["MostrarCodigo"];
}

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar Contraseña - Abastécete</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="relative flex items-center justify-center min-h-screen">

    <div class="absolute inset-0 bg-cover bg-center z-[-2]"
         style="background-image: url('/css/Images/señora.jpg');"></div>

    <div class="absolute inset-0 bg-black opacity-70 z-[-1]"></div>

    <div class="bg-white shadow-lg rounded-lg flex max-w-4xl w-full">
        <div class="w-1/2 bg-[#F8F1E6] p-8 flex flex-col justify-center items-center">
            <img src="~/css/Images/Logo 2.png" alt="Logo Abastécete">
            <h2 class="text-2xl font-bold text-[#23916A]">Recupera tu Contraseña</h2>
            <p class="text-gray-600 text-center mt-2">Ingresa tu correo y recibirás un código para restablecer tu contraseña.</p>
        </div>

        <div class="w-1/2 p-8 flex flex-col justify-center">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger text-center bg-red-500 text-white p-3 rounded-md">
                    @TempData["Error"]
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success text-center bg-green-500 text-white p-3 rounded-md">
                    @TempData["Success"]
                </div>
            }

            <form asp-action="RecuperarContrasenia" method="post" class="space-y-4">
                <label for="Correo" class="block font-medium text-gray-700">Correo Electrónico</label>
                <input type="email" id="Correo" name="Correo" value="@correoIngresado" placeholder="Ingresa tu correo"
                       class="w-full p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-[#E6581E]" required>

                <button type="submit"
                        class="w-full bg-[#1E7D46] text-white font-bold py-3 rounded-lg hover:bg-[#165B32] transition duration-300">
                    Enviar Código
                </button>
            </form>

            @if (mostrarCodigo)
            {
                <form asp-action="ValidarCodigoRecuperacion" method="post" class="space-y-4 mt-4">
                    <label for="Codigo" class="block font-medium text-gray-700">Código de Recuperación</label>
                    <input type="text" id="Codigo" name="Codigo" placeholder="Ingresa tu código"
                           class="w-full p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-[#E6581E]" required>

                    <input type="hidden" name="Correo" value="@correoIngresado" />

                    <button type="submit"
                            class="w-full bg-[#1E7D46] text-white font-bold py-3 rounded-lg hover:bg-[#165B32] transition duration-300">
                        Verificar Código
                    </button>
                </form>
            }

            <div class="mt-4 text-center">
                <a href="@Url.Action("Login", "Login")" class="text-[#E6581E] font-semibold hover:underline">Volver al inicio de sesión</a>
            </div>
        </div>
    </div>
</body>
</html>
