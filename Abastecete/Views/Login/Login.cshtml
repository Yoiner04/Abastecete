@model BusinessLogic.Models.Usuario;

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Abastecete.styles.css" asp-append-version="true" />
</head>

<body>
    <div class="login-container">
        <div class="login-box">

            <!-- Imagen Superior -->
            <div class="login-image text-center">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Principal">
                    <img src="~/css/Images/LOGO FINAL.png" alt="Abastecete Login" class="img-fluid">
                </a>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger text-center" id="errorMessage">
                    @TempData["Error"]
                </div>
            }

            @using (Html.BeginForm("Login", "Login", FormMethod.Post, new { id = "loginForm" }))
            {
                <div class="form-group mb-3">
                    <label for="email">Correo Electrónico</label>
                    @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", @type = "email", @id = "email", @name = "email", @placeholder = "Ingresa tu correo" })
                    <span id="correoError" class="text-danger text-sm hidden">El correo es obligatorio.</span>
                </div>
                <div class="form-group mb-3">
                    <label for="password">Contraseña</label>
                    @Html.PasswordFor(m => m.Contrasenia, new { @class = "form-control", @id = "password", @name = "password", @placeholder = "Ingresa tu contraseña" })
                    <span id="contraseniaError" class="text-danger text-sm hidden">La contraseña es obligatoria.</span>
                </div>

                <button type="submit" class="btn-login">Iniciar Sesión</button>

                <div class="forgot-password">
                    <a href="/Login/RecuperarContrasenia">¿Olvidaste tu contraseña?</a>
                </div>
                <div class="mt-6 text-center">
                    <p class="text-sm">o inicia sesión con</p>
                    <div class="flex flex-col md:flex-row gap-2 mt-2">
                        @if (Context.Session.GetString("userEmail") != null)
                        {
                            <p>Bienvenido, @Context.Session.GetString("userName")</p>
                        }
                        else
                        {
                            <a href="/Login/LoginWithGoogle" class="btn btn-light">
                                <img src="https://developers.google.com/identity/images/g-logo.png" width="20" />
                                Iniciar sesión con Google
                            </a>
                        }
                    </div>
                </div>
                <div class="register">
                    <p>¿No tienes cuenta? <a asp-area="" asp-controller="Usuarios" asp-action="Registrar">Regístrate aquí</a></p>
                </div>
            }

            <div class="back-button text-center mb-3">
                <a href="/" class="btn-back">Regresar</a>
            </div>
        </div>
        <div class="image-section">
            <img src="~/css/Images/login.png" alt="Promoción" style="width: 100%; height: auto;" />
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("loginForm");
            const errorMessage = document.getElementById("errorMessage");

            // Evita el reenvío del formulario en la recarga
            if (window.performance && window.performance.navigation.type === 1) {
                window.history.replaceState({}, document.title, window.location.href);

                // Ocultar mensaje de error si la página se recarga
                if (errorMessage) {
                    errorMessage.style.display = "none";
                }
            }

            form.addEventListener("submit", function (event) {
                const email = document.getElementById("email");
                const password = document.getElementById("password");

                // Limpia los errores previos
                email.classList.remove("border-red");
                password.classList.remove("border-red");
                document.getElementById("correoError").classList.add("hidden");
                document.getElementById("contraseniaError").classList.add("hidden");

                let valid = true;

                // Validación del correo
                if (!email.value.trim()) {
                    document.getElementById("correoError").classList.remove("hidden");
                    email.classList.add("border-red");
                    valid = false;
                }

                // Validación de la contraseña
                if (!password.value.trim()) {
                    document.getElementById("contraseniaError").classList.remove("hidden");
                    password.classList.add("border-red");
                    valid = false;
                } else if (password.value.trim().length <= 8) {
                    document.getElementById("contraseniaError").classList.remove("hidden");
                    password.classList.add("border-red");
                    valid = false;
                }

                // Si los campos no son válidos, evita el envío del formulario
                if (!valid) {
                    event.preventDefault();
                }
            });
        });
    </script>

    <!-- Estilo para los bordes rojos -->
    <style>
        .border-red {
            border: 0.5px solid red !important;
        }

        .hidden {
            display: none;
        }

        /* Color rojo para los mensajes de error */
        .text-danger {
            color: red !important;
        }
    </style>
</body>
</html>