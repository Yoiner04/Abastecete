<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Abastecete.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>

<body>
    <section class="mt-12 px-6 md:px-16 lg:px-36">
        <!-- Encabezado -->
        <div class="flex flex-col md:flex-row justify-between items-center mb-6 space-y-4 md:space-y-0">
            <h2 class="text-lg font-bold text-gray-800 text-center md:text-left">Gestión de Usuarios</h2>
            <input type="text" id="user-search" placeholder="Buscar usuario..." class="w-full md:w-1/3 p-3 rounded-lg bg-gray-100 border border-gray-300 text-black">
        </div>

        <!-- Tabla de Usuarios -->
        <div class="overflow-x-auto">
            <table class="w-full bg-white rounded-lg shadow-md overflow-hidden">
                <thead class="bg-gray-200">
                    <tr>
                        <th class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase">Nombre</th>
                        <th class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase">Rol</th>
                        <th class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase">Membresía</th>
                        <th class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase">Correo</th>
                        <th class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase">Teléfono</th>
                        <th class="px-4 md:px-6 py-3 text-center text-xs font-medium text-gray-700 uppercase">Estado</th>
                        <th class="px-4 md:px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase">Tipo de Documento</th>
                        <th class="px-4 md:px-6 py-3 text-center text-xs font-medium text-gray-700 uppercase">Acciones</th>
                    </tr>
                </thead>
                <tbody id="user-table-body" class="divide-y divide-gray-300">
                    <!-- Se llenará dinámicamente con JS -->
                </tbody>
            </table>
        </div>
    </section>

    <!-- Modal Editar Usuario -->
    <div id="user-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <div class="p-6 rounded-lg shadow-lg bg-white w-full max-w-md mx-4">
            <h2 class="text-center text-xl font-bold text-gray-800" id="modal-title">Editar Usuario</h2>
            <form id="user-form" class="mt-4">
                <input type="text" id="user-name" placeholder="Nombre del usuario"
                       class="w-full p-3 rounded-lg bg-gray-100 border border-gray-300 text-black mb-3" required>

                <label class="block text-gray-700 font-medium">Rol</label>
                <select id="user-role" class="w-full p-3 rounded-lg bg-gray-100 border border-gray-300 text-black mb-3" required>
                    <option value="Admin">Admin</option>
                    <option value="Usuario">Usuario</option>
                    <option value="Invitado">Invitado</option>
                </select>

                <label class="block text-gray-700 font-medium">Membresía</label>
                <select id="user-membership" class="w-full p-3 rounded-lg bg-gray-100 border border-gray-300 text-black mb-3" required>
                    <option value="Premium">Premium</option>
                    <option value="Básica">Básica</option>
                    <option value="Ninguna">Ninguna</option>
                </select>

                <input type="email" id="user-email" placeholder="Correo electrónico"
                       class="w-full p-3 rounded-lg bg-gray-100 border border-gray-300 text-black mb-3" required>

                <input type="tel" id="user-phone" placeholder="Teléfono"
                       class="w-full p-3 rounded-lg bg-gray-100 border border-gray-300 text-black mb-3" required>

                <label class="block text-gray-700 font-medium">Tipo de Documento</label>
                <select id="user-document" class="w-full p-3 rounded-lg bg-gray-100 border border-gray-300 text-black mb-3" required>
                    <option value="DNI">DNI</option>
                    <option value="Pasaporte">Pasaporte</option>
                    <option value="Licencia de Conducir">Licencia de Conducir</option>
                </select>

                <button type="submit" class="w-full bg-green-600 text-white py-3 rounded-lg font-bold hover:bg-green-700">
                    Guardar Cambios
                </button>
            </form>
            <button id="close-user-modal" class="block w-full text-center mt-3 text-gray-600 hover:text-gray-800">
                Cerrar
            </button>
        </div>
    </div>

    <script>
        let users = [
            { name: "Juan Pérez", role: "Admin", membership: "Premium", email: "juan@example.com", phone: "123456789", status: "Activo", documentType: "DNI" },
            { name: "María López", role: "Usuario", membership: "Básica", email: "maria@example.com", phone: "987654321", status: "Inactivo", documentType: "Pasaporte" },
            { name: "Carlos Rodríguez", role: "Usuario", membership: "Premium", email: "carlos@example.com", phone: "1122334455", status: "Activo", documentType: "DNI" }
        ];

        const tableBody = document.getElementById("user-table-body");
        const userModal = document.getElementById("user-modal");
        const userSearchInput = document.getElementById("user-search");
        let selectedUserIndex = null;

        function renderUsers(filteredUsers = users) {
            tableBody.innerHTML = "";
            filteredUsers.forEach((user, index) => {
                const row = document.createElement("tr");
                row.className = "hover:bg-gray-100";
                row.innerHTML = `
                    <td class="px-4 py-3 text-gray-700">${user.name}</td>
                    <td class="px-4 py-3 text-gray-700">${user.role}</td>
                    <td class="px-4 py-3 text-gray-700">${user.membership}</td>
                    <td class="px-4 py-3 text-gray-700">${user.email}</td>
                    <td class="px-4 py-3 text-gray-700">${user.phone}</td>
                    <td class="px-4 py-3 text-center">${user.status === "Activo" ? "🟢 Activo" : "🔴 Inactivo"}</td>
                    <td class="px-4 py-3 text-gray-700">${user.documentType}</td>
                    <td class="px-4 py-3 text-center">
                        <button class="text-blue-600 hover:text-blue-800 mr-2 md:mr-4" onclick="editUser(${index})">✏</button>
                    </td>`;
                tableBody.appendChild(row);
            });
        }

        function editUser(index) {
            selectedUserIndex = index;
            document.getElementById("user-name").value = users[index].name;
            document.getElementById("user-role").value = users[index].role;
            document.getElementById("user-membership").value = users[index].membership;
            document.getElementById("user-email").value = users[index].email;
            document.getElementById("user-phone").value = users[index].phone;
            document.getElementById("user-document").value = users[index].documentType;
            userModal.classList.remove("hidden");
        }

        document.getElementById("close-user-modal").addEventListener("click", () => {
            userModal.classList.add("hidden");
        });

        userSearchInput.addEventListener("input", () => {
            const query = userSearchInput.value.toLowerCase();
            const filteredUsers = users.filter(user =>
                Object.values(user).some(value => value.toLowerCase().includes(query))
            );
            renderUsers(filteredUsers);
        });

        renderUsers();
    </script>
</body>