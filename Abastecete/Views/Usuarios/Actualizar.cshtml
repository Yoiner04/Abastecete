@using BusinessLogic.Models
@model BusinessLogic.Models.Usuario;

@{
    Layout = null;
}

<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="flex min-h-screen items-center justify-center bg-gray-100">
    
    <div class="w-full max-w-3xl rounded-2xl bg-white px-10 py-8 shadow-2xl">
        <h2 class="mb-6 text-center text-3xl font-bold text-green-600">Actualizar Información</h2>

        @using (Html.BeginForm("Actualizar", "Usuarios", FormMethod.Post, new { id = "actualizarForm", @class = "grid grid-cols-1 md:grid-cols-2 gap-6" }))
        {
            <div class="md:col-span-2">
                @Html.ValidationSummary(true, "", new { @class = "text-red-500 text-sm" })
            </div>

            <div>
                <label class="block font-medium text-gray-700">Nombre <span class="text-red-500">*</span></label>
                @Html.TextBoxFor(m => m.Persona.Nombre, new { @class = "w-full border p-3 rounded-lg focus:ring-2 focus:ring-green-400 outline-none" })
            </div>

            <div>
                <label class="block font-medium text-gray-700">Apellido <span class="text-red-500">*</span></label>
                @Html.TextBoxFor(m => m.Persona.Apellido, new { @class = "w-full border p-3 rounded-lg focus:ring-2 focus:ring-green-400 outline-none" })
            </div>

            <div>
                <label class="block font-medium text-gray-700">Tipo de Documento <span class="text-red-500">*</span></label>
                <select class="w-full rounded-lg border p-3 outline-none focus:ring-2 focus:ring-green-400" name="Persona.TipoDeDocumento.Id">
                    <option value="">Seleccione</option>
                    @foreach (TipoDocumento td in ViewBag.TiposDocumento)
                    {
                        if (Model.Persona.TipoDeDocumento != null && Model.Persona.TipoDeDocumento.Id == td.Id)
                        {
                            <option value="@td.Id" selected>@td.Nombre</option>
                        }
                        else
                        {
                            <option value="@td.Id">@td.Nombre</option>
                        }
                    }
                </select>
            </div>


            <div>
                <label class="block font-medium text-gray-700">Documento <span class="text-red-500">*</span></label>
                @Html.TextBoxFor(m => m.Persona.Documento, new { @class = "w-full border p-3 rounded-lg focus:ring-2 focus:ring-green-400 outline-none", @oninput = "this.value=this.value.replace(/[^0-9]/g,'');" })
            </div>

            <div>
                <label class="block font-medium text-gray-700">Teléfono <span class="text-red-500">*</span></label>
                @Html.TextBoxFor(m => m.Persona.Telefono, new { @class = "w-full border p-3 rounded-lg focus:ring-2 focus:ring-green-400 outline-none", @oninput = "this.value=this.value.replace(/[^0-9]/g,'');" })
            </div>

            <div>
                <label class="block font-medium text-gray-700">Correo Electrónico <span class="text-red-500">*</span></label>
                @Html.TextBoxFor(m => m.Correo, new { @class = "w-full border p-3 rounded-lg focus:ring-2 focus:ring-green-400 outline-none", @readonly = "readonly" })
            </div>

            <div class="md:col-span-2">
                <button type="submit" class="w-full transform rounded-lg bg-green-500 py-3 text-lg font-bold text-white transition-transform hover:scale-105">Actualizar Información</button>
            </div>
        }
    </div>

</body>
</html>
