@using BusinessLogic.Models
@model BusinessLogic.Models.Usuario;

@{
    Layout = null;
}

<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro de Usuario</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

<body class="relative flex min-h-screen items-center justify-center bg-gray-100" style="background-image: url('/css/Images/fondo_registroUsuario.jpg'); background-size: cover; background-position: center;">
    <!-- Fondo con desenfoque -->
    <div class="bg-opacity-70 absolute inset-0 bg-black"></div>

    <!-- Contenedor del formulario -->
    <div class="relative w-full max-w-3xl rounded-2xl bg-white px-10 py-4 shadow-2xl">
        <h2 class="mb-6 text-center text-3xl font-bold text-green-600">Crea tu cuenta</h2>

        @using (Html.BeginForm("Registrar", "Usuarios", FormMethod.Post, new { id = "registroForm", @class = "grid grid-cols-1 md:grid-cols-2 gap-6" }))
        {
            <div class="md:col-span-2">
                @Html.ValidationSummary(true, "", new { @class = "text-red-500 text-sm" })
            </div>

            <div>
                <label class="block font-medium text-gray-700">Nombre <span class="text-red-500">*</span></label>
                @Html.TextBoxFor(m => m.Persona.Nombre, new { @type = "text", @class = "w-full border p-3 rounded-lg focus:ring-2 focus:ring-green-400 outline-none", @placeholder = "Ingresa tu nombre", @id = "nombre" })
            </div>

            <div>
                <label class="block font-medium text-gray-700">Apellido <span class="text-red-500">*</span></label>
                @Html.TextBoxFor(m => m.Persona.Apellido, new { @type = "text", @class = "w-full border p-3 rounded-lg focus:ring-2 focus:ring-green-400 outline-none", @placeholder = "Ingresa tu apellido", @id = "apellido" })
            </div>

            <div>
                <label class="block font-medium text-gray-700">Tipo de Documento <span class="text-red-500">*</span></label>
                <select class="w-full rounded-lg border p-3 outline-none focus:ring-2 focus:ring-green-400" id="tipoDeDocumento" name="Persona.TipoDeDocumento.Id">
                    <option value="">Seleccione</option>
                    @foreach (TipoDocumento td in ViewBag.TiposDocumento)
                    {
                        <option value="@td.Id">@td.Nombre</option>
                    }
                </select>
            </div>

            <div>
                <label class="block font-medium text-gray-700">Documento <span class="text-red-500">*</span></label>
                @Html.TextBoxFor(m => m.Persona.Documento, new { @type = "text", @class = "w-full border p-3 rounded-lg focus:ring-2 focus:ring-green-400 outline-none", @placeholder = "Ingresa tu documento", @oninput = "this.value=this.value.replace(/[^0-9]/g,'');", @id = "documento" })
            </div>

            <div>
                <label class="block font-medium text-gray-700">Teléfono <span class="text-red-500">*</span></label>
                @Html.TextBoxFor(m => m.Persona.Telefono, new { @type = "text", @class = "w-full border p-3 rounded-lg focus:ring-2 focus:ring-green-400 outline-none", @placeholder = "Ingresa tu teléfono", @oninput = "this.value=this.value.replace(/[^0-9]/g,'');", @id = "telefono" })
            </div>

            <div>
                <label class="block font-medium text-gray-700">Correo Electrónico <span class="text-red-500">*</span></label>
                @Html.TextBoxFor(m => m.Correo, new { @type = "email", @class = "w-full border p-3 rounded-lg focus:ring-2 focus:ring-green-400 outline-none", @placeholder = "Ingresa tu correo", @id = "correo" })
            </div>

            <div>
                <label class="block font-medium text-gray-700">Contraseña <span class="text-red-500">*</span></label>
                @Html.TextBoxFor(m => m.Contrasenia, new { @type = "password", @class = "w-full border p-3 rounded-lg focus:ring-2 focus:ring-green-400 outline-none", @placeholder = "Ingresa tu contraseña", @id = "password" })
            </div>

            <div>
                <label class="block font-medium text-gray-700">Confirmar Contraseña <span class="text-red-500">*</span></label>
                <input type="password" id="confirmPassword" class="w-full rounded-lg border p-3 outline-none focus:ring-2 focus:ring-green-400" placeholder="Confirma tu contraseña">
            </div>

            <div class="md:col-span-2">
                <label class="block font-medium text-gray-700">Código de Referido (Opcional)</label>
                @Html.TextBoxFor(m => m.CodigoReferido, new { @type = "text", @class = "w-full border p-3 rounded-lg focus:ring-2 focus:ring-gray-400 outline-none", @placeholder = "Ingresa el código de referido (opcional)", @id = "codigoReferido" })
            </div>

            <div class="md:col-span-2">
                <button class="w-full transform rounded-lg bg-orange-500 py-3 text-lg font-bold text-white transition-transform hover:scale-105">Registrarse</button>
            </div>
        }

        <p class="mt-6 text-center text-sm text-gray-600">
            ¿Ya tienes una cuenta? <a href="@Url.Action("Login", "Login")" class="font-bold text-green-600 hover:underline">Inicia sesión</a>
        </p>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.querySelector("form");
            form.addEventListener("submit", function (event) {
                let valid = true;

                // Limpia los mensajes de error previos
                const errorMessages = document.querySelectorAll(".text-red-500");
                errorMessages.forEach(msg => msg.classList.add("hidden"));
                const fields = {
                    nombre: document.querySelector("[name='Persona.Nombre']"),
                    apellido: document.querySelector("[name='Persona.Apellido']"),
                    tipoDeDocumento: document.querySelector("[name='Persona.TipoDeDocumento.Id']"),
                    documento: document.querySelector("[name='Persona.Documento']"),
                    telefono: document.querySelector("[name='Persona.Telefono']"),
                    correo: document.querySelector("[name='Correo']"),
                    contrasenia: document.querySelector("[name='Contrasenia']"),
                    confirmPassword: document.querySelector("#confirmPassword")
                };

                // Limpia los bordes rojos
                for (const key in fields) {
                    fields[key].classList.remove("border-red-500");
                }

                // Validaciones
                if (!fields.nombre.value.trim()) {
                    document.getElementById("nombreError").classList.remove("hidden");
                    fields.nombre.classList.add("border-red-500");
                    valid = false;
                }
                if (!fields.apellido.value.trim()) {
                    document.getElementById("apellidoError").classList.remove("hidden");
                    fields.apellido.classList.add("border-red-500");
                    valid = false;
                }
                if (!fields.tipoDeDocumento.value.trim()) {
                    document.getElementById("tipoDeDocumentoError").classList.remove("hidden");
                    fields.tipoDeDocumento.classList.add("border-red-500");
                    valid = false;
                }
                if (!/^\d{10,15}$/.test(fields.documento.value.trim())) {
                    document.getElementById("documentoError").classList.remove("hidden");
                    fields.documento.classList.add("border-red-500");
                    valid = false;
                }
                if (!/^3\d{9}$/.test(fields.telefono.value.trim())) {
                    document.getElementById("telefonoError").classList.remove("hidden");
                    fields.telefono.classList.add("border-red-500");
                    valid = false;
                }
                if (!fields.correo.value.trim()) {
                    document.getElementById("correoError").classList.remove("hidden");
                    fields.correo.classList.add("border-red-500");
                    valid = false;
                }
                if (fields.contrasenia.value.trim().length < 8) {
                    document.getElementById("contraseniaError").classList.remove("hidden");
                    fields.contrasenia.classList.add("border-red-500");
                    valid = false;
                }

                // Validación de que las contraseñas coinciden
                if (fields.contrasenia.value.trim() !== fields.confirmPassword.value.trim()) {
                    document.getElementById("errorMessage").classList.remove("hidden");
                    fields.confirmPassword.classList.add("border-red-500");
                    valid = false;
                }

     
            });
        });
    </script>

    <style>
        .border-red-500 {
            border: 0.5px solid red !important;
        }

        .hidden {
            display: none;
        }
    </style>

</body>
</html>