@model BusinessLogic.Models.Usuario;

@{
    Layout = null;
}

<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro de Usuario</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-3xl">
        <h2 class="text-2xl font-bold text-green-600 text-center mb-6">Crea tu cuenta</h2>

        @using (Html.BeginForm("Registrar", "Usuarios", FormMethod.Post, new { @class = "grid grid-cols-1 md:grid-cols-2 gap-4" }))
        {
            <div>
                <label class="block font-medium">Nombre</label>
                @Html.TextBoxFor(m => m.Persona.Nombre, new { @type = "text", @class = "w-full border p-2 rounded", @placeholder = "Ingresa tu nombre" })
            </div>
            <div>
                <label class="block font-medium">Apellido</label>
                @Html.TextBoxFor(m => m.Persona.Apellido, new { @type = "text", @class = "w-full border p-2 rounded", @placeholder = "Ingresa tu apellido" })
            </div>
            @* <div>
                <label class="block font-medium">Tipo de Documento</label>
                <select class="w-full border p-2 rounded">
                    <option value="dni">DNI</option>
                    <option value="pasaporte">Pasaporte</option>
                    <option value="cedula">Cédula</option>
                </select>
            </div> *@
            <div>
                <label class="block font-medium">Tipo de Documento</label>
                @Html.TextBoxFor(m => m.Persona.TipoDeDocumento, new { @type = "text", @class = "w-full border p-2 rounded", @placeholder = "Ingresa tu nombre" })
            </div>
            <div>
                <label class="block font-medium">Documento</label>
                @Html.TextBoxFor(m => m.Persona.Documento, new { @type = "text", @class = "w-full border p-2 rounded", @placeholder = "Ingresa tu documento" })
            </div>
            <div>
                <label class="block font-medium">Teléfono</label>
                @Html.TextBoxFor(m => m.Persona.Telefono, new { @type = "text", @class = "w-full border p-2 rounded", @placeholder = "Ingresa tu teléfono" })
            </div>
            <div>
                <label class="block font-medium">Correo Electrónico</label>
                @Html.TextBoxFor(m => m.Correo, new { @type = "text", @class = "w-full border p-2 rounded", @placeholder = "Ingresa tu correo" })
            </div>
            <div>
                <label class="block font-medium">Contraseña</label>
                @Html.TextBoxFor(m => m.Contrasenia, new { @type = "text", @class = "w-full border p-2 rounded", @placeholder = "Ingresa tu contraseña" })
            </div>
            <div>
                <label class="block font-medium">Código de Referido</label>
                @Html.TextBoxFor(m => m.CodigoReferido, new { @type = "text", @class = "w-full border p-2 rounded", @placeholder = "Ingresa el código de referido (opcional)" })
            </div>

            <div class="md:col-span-2">
                <button class="w-full bg-orange-500 text-white font-bold py-2 rounded">Registrarse</button>
            </div>
        }
        
        <div class="mt-6 text-center">
            <p class="text-sm">o regístrate con</p>
            <div class="flex flex-col md:flex-row gap-2 mt-2">
                <button class="w-full flex items-center justify-center border p-2 rounded bg-gray-100">
                    <img src="https://www.svgrepo.com/show/355037/google.svg" alt="Google" class="w-5 h-5 mr-2">
                    Regístrate con Google
                </button>
                <button class="w-full flex items-center justify-center border p-2 rounded bg-gray-100">
                    <img src="https://www.svgrepo.com/show/512317/apple.svg" alt="Apple" class="w-5 h-5 mr-2">
                    Regístrate con Apple
                </button>
            </div>
        </div>

        <p class="text-center text-sm mt-4">
            ¿Ya tienes una cuenta? <a href="@Url.Action("Login", "Login")" class="text-green-600 font-bold">Inicia sesión</a>
        </p>
    </div>
</body>
</html>
