@using BusinessLogic.Models
@model BusinessLogic.Models.Usuario;

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Cuenta - Abastecete</title>
    <link rel="icon" type="image/png" href="~/images/LOGO%20FINAL.png" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                }
            }
        }
    </script>
</head>

<body class="relative min-h-screen font-sans" style="background-image: url('/css/Images/fondo_registroUsuario.jpg'); background-size: cover; background-position: center;">
    <!-- Overlay oscuro -->
    <div class="absolute inset-0 bg-black/60"></div>

    <div class="relative z-10 flex min-h-screen">
        <!-- Panel Izquierdo - Branding -->
        <div class="relative hidden flex-col justify-between overflow-hidden p-12 lg:flex lg:w-1/2">
            <!-- Decoración de fondo con blur -->
            <div class="absolute inset-0 bg-emerald-900/30 backdrop-blur-sm"></div>
            <div class="absolute top-0 right-0 h-96 w-96 translate-x-1/2 -translate-y-1/2 rounded-full bg-emerald-500/20 blur-3xl"></div>
            <div class="absolute bottom-0 left-0 h-72 w-72 -translate-x-1/2 translate-y-1/2 rounded-full bg-orange-400/10 blur-3xl"></div>

            <div class="relative z-10">
                <div class="mb-8 flex items-center gap-3">
                    <img src="/images/LOGO%20FINAL.png" alt="Abastecete" class="h-14 w-14 rounded-xl object-contain shadow-lg">
                    <span class="text-2xl font-bold text-white drop-shadow-lg">Abastecete</span>
                </div>
                <h1 class="mb-4 text-4xl font-bold text-white">Impulsa tu negocio</h1>
                <p class="text-lg text-emerald-100">Conecta con miles de clientes y haz crecer tus ventas con nuestra plataforma.</p>
            </div>

            <div class="relative z-10 space-y-6">
                <div class="flex items-start gap-4">
                    <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-white/20 backdrop-blur-sm">
                        <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-semibold text-white">Ofertas Flash</h3>
                        <p class="text-sm text-emerald-200">Publica ofertas y atrae clientes al instante</p>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-white/20 backdrop-blur-sm">
                        <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-semibold text-white">Estadísticas</h3>
                        <p class="text-sm text-emerald-200">Analiza el rendimiento de tu negocio</p>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-white/20 backdrop-blur-sm">
                        <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="font-semibold text-white">Comunidad</h3>
                        <p class="text-sm text-emerald-200">Miles de negocios ya confían en nosotros</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Panel Derecho - Formulario -->
        <div class="flex w-full items-center justify-center p-6 sm:p-12 lg:w-1/2">
            <div class="w-full max-w-lg rounded-2xl bg-white/95 p-8 shadow-2xl backdrop-blur-md">
                <!-- Logo móvil -->
                <div class="mb-6 flex items-center justify-center gap-3 lg:hidden">
                    <img src="/images/LOGO%20FINAL.png" alt="Abastecete" class="h-12 w-12 rounded-xl object-contain shadow-md">
                    <span class="text-xl font-bold text-gray-800">Abastecete</span>
                </div>

                <div class="mb-6 text-center">
                    <h2 class="mb-1 text-2xl font-bold text-gray-800">Crea tu cuenta</h2>
                    <p class="text-sm text-gray-500">Completa tus datos para comenzar</p>
                </div>  

                @using (Html.BeginForm("Registrar", "Usuarios", FormMethod.Post, new { id = "registroForm", @class = "space-y-5" }))
                {
                    <!-- Mensajes de error del servidor -->
                    <div id="serverErrors">
                        @Html.ValidationSummary(true, "", new { @class = "bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm" })
                    </div>

                    <!-- Nombre y Apellido -->
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div class="space-y-1.5">
                            <label class="text-sm font-medium text-gray-700">Nombre <span class="text-red-500">*</span></label>
                            <div class="relative">
                                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                    </svg>
                                </div>
                                @Html.TextBoxFor(m => m.Persona.Nombre, new { @class = "w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none", @placeholder = "Tu nombre", @id = "nombre" })
                            </div>
                            <span id="nombreError" class="hidden text-xs text-red-500">El nombre es obligatorio</span>
                        </div>

                        <div class="space-y-1.5">
                            <label class="text-sm font-medium text-gray-700">Apellido <span class="text-red-500">*</span></label>
                            <div class="relative">
                                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                    </svg>
                                </div>
                                @Html.TextBoxFor(m => m.Persona.Apellido, new { @class = "w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none", @placeholder = "Tu apellido", @id = "apellido" })
                            </div>
                            <span id="apellidoError" class="hidden text-xs text-red-500">El apellido es obligatorio</span>
                        </div>
                    </div>

                    <!-- Tipo Documento y Documento -->
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div class="space-y-1.5">
                            <label class="text-sm font-medium text-gray-700">Tipo documento <span class="text-red-500">*</span></label>
                            <div class="relative">
                                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"/>
                                    </svg>
                                </div>
                                <select class="w-full cursor-pointer appearance-none rounded-xl border border-gray-200 bg-gray-50 py-3 pr-4 pl-10 transition-all outline-none focus:border-emerald-500 focus:bg-white focus:ring-2 focus:ring-emerald-500/20" id="tipoDeDocumento" name="Persona.TipoDeDocumento.Id">
                                    <option value="">Seleccionar</option>
                                    @foreach (TipoDocumento td in ViewBag.TiposDocumento)
                                    {
                                        <option value="@td.Id">@td.Nombre</option>
                                    }
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
                                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                    </svg>
                                </div>
                            </div>
                            <span id="tipoDeDocumentoError" class="hidden text-xs text-red-500">Selecciona un tipo</span>
                        </div>

                        <div class="space-y-1.5">
                            <label class="text-sm font-medium text-gray-700">Documento <span class="text-red-500">*</span></label>
                            <div class="relative">
                                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/>
                                    </svg>
                                </div>
                                @Html.TextBoxFor(m => m.Persona.Documento, new { @class = "w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none", @placeholder = "Número de documento", @oninput = "this.value=this.value.replace(/[^0-9]/g,'');", @id = "documento" })
                            </div>
                            <span id="documentoError" class="hidden text-xs text-red-500">Debe tener entre 6 y 15 dígitos</span>
                        </div>
                    </div>

                    <!-- Teléfono y Correo -->
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div class="space-y-1.5">
                            <label class="text-sm font-medium text-gray-700">Teléfono <span class="text-red-500">*</span></label>
                            <div class="relative">
                                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                    </svg>
                                </div>
                                @Html.TextBoxFor(m => m.Persona.Telefono, new { @class = "w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none", @placeholder = "3001234567", @oninput = "this.value=this.value.replace(/[^0-9]/g,'');", @maxlength = "10", @id = "telefono" })
                            </div>
                            <span id="telefonoError" class="hidden text-xs text-red-500">Debe iniciar con 3 y tener 10 dígitos</span>
                        </div>

                        <div class="space-y-1.5">
                            <label class="text-sm font-medium text-gray-700">Correo <span class="text-red-500">*</span></label>
                            <div class="relative">
                                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                    </svg>
                                </div>
                                @Html.TextBoxFor(m => m.Correo, new { @type = "email", @class = "w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none", @placeholder = "correo@ejemplo.com", @id = "correo" })
                            </div>
                            <span id="correoError" class="hidden text-xs text-red-500">Ingresa un correo válido</span>
                        </div>
                    </div>

                    <!-- Contraseñas -->
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div class="space-y-1.5">
                            <label class="text-sm font-medium text-gray-700">Contraseña <span class="text-red-500">*</span></label>
                            <div class="relative">
                                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                    </svg>
                                </div>
                                @Html.TextBoxFor(m => m.Contrasenia, new { @type = "password", @class = "w-full pl-10 pr-12 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none", @placeholder = "Mínimo 8 caracteres", @id = "password", @autocomplete = "new-password" })
                                <button type="button" onclick="togglePassword('password', this)" class="absolute inset-y-0 right-0 flex items-center pr-3">
                                    <svg class="h-5 w-5 text-gray-400 hover:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                    </svg>
                                </button>
                            </div>
                            <span id="contraseniaError" class="hidden text-xs text-red-500">Mínimo 8 caracteres</span>
                        </div>

                        <div class="space-y-1.5">
                            <label class="text-sm font-medium text-gray-700">Confirmar <span class="text-red-500">*</span></label>
                            <div class="relative">
                                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                                    </svg>
                                </div>
                                <input type="password" id="confirmPassword" autocomplete="new-password" class="w-full rounded-xl border border-gray-200 bg-gray-50 py-3 pr-12 pl-10 transition-all outline-none focus:border-emerald-500 focus:bg-white focus:ring-2 focus:ring-emerald-500/20" placeholder="Repite la contraseña">
                                <button type="button" onclick="togglePassword('confirmPassword', this)" class="absolute inset-y-0 right-0 flex items-center pr-3">
                                    <svg class="h-5 w-5 text-gray-400 hover:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                    </svg>
                                </button>
                            </div>
                            <span id="errorMessage" class="hidden text-xs text-red-500">Las contraseñas no coinciden</span>
                        </div>
                    </div>

                    <!-- Código Referido (Opcional) -->
                    <div class="space-y-1.5">
                        <label class="text-sm font-medium text-gray-700">Código de referido <span class="font-normal text-gray-400">(opcional)</span></label>
                        <div class="relative">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                                <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
                                </svg>
                            </div>
                            @Html.TextBoxFor(m => m.CodigoReferido, new { @class = "w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all outline-none", @placeholder = "COD1234567", @id = "codigoReferido", data_val = "false" })
                        </div>
                    </div>

                    <!-- Botón Submit -->
                    <button type="submit" id="submitBtn" class="flex w-full transform items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-700 py-3.5 font-semibold text-white shadow-lg shadow-emerald-500/30 transition-all duration-200 hover:-translate-y-0.5 hover:from-emerald-700 hover:to-emerald-800 hover:shadow-emerald-500/40">
                        <span>Crear cuenta</span>
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                        </svg>
                    </button>
                }

                <!-- Link a Login -->
                <p class="mt-8 text-center text-gray-600">
                    ¿Ya tienes una cuenta?
                    <a href="@Url.Action("Login", "Login")" class="font-semibold text-emerald-600 transition-colors hover:text-emerald-700">
                        Inicia sesión
                    </a>
                </p>
            </div>
        </div>
    </div>

    <script>
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector('svg');
            if (input.type === 'password') {
                input.type = 'text';
                icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>';
            } else {
                input.type = 'password';
                icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>';
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("registroForm");

            form.addEventListener("submit", function (event) {
                let valid = true;

                // Limpiar errores previos
                document.querySelectorAll('.error-field').forEach(el => el.classList.remove('error-field', 'border-red-500'));
                document.querySelectorAll('[id$="Error"], #errorMessage').forEach(el => el.classList.add('hidden'));

                const fields = {
                    nombre: document.querySelector("[name='Persona.Nombre']"),
                    apellido: document.querySelector("[name='Persona.Apellido']"),
                    tipoDeDocumento: document.querySelector("[name='Persona.TipoDeDocumento.Id']"),
                    documento: document.querySelector("[name='Persona.Documento']"),
                    telefono: document.querySelector("[name='Persona.Telefono']"),
                    correo: document.querySelector("[name='Correo']"),
                    contrasenia: document.querySelector("[name='Contrasenia']"),
                    confirmPassword: document.getElementById("confirmPassword")
                };

                function showError(field, errorId) {
                    field.classList.add('error-field', 'border-red-500');
                    document.getElementById(errorId).classList.remove('hidden');
                    valid = false;
                }

                // Validaciones
                if (!fields.nombre.value.trim()) showError(fields.nombre, 'nombreError');
                if (!fields.apellido.value.trim()) showError(fields.apellido, 'apellidoError');
                if (!fields.tipoDeDocumento.value) showError(fields.tipoDeDocumento, 'tipoDeDocumentoError');
                if (!/^\d{6,15}$/.test(fields.documento.value.trim())) showError(fields.documento, 'documentoError');
                if (!/^3\d{9}$/.test(fields.telefono.value.trim())) showError(fields.telefono, 'telefonoError');
                if (!fields.correo.value.trim() || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(fields.correo.value)) showError(fields.correo, 'correoError');
                if (fields.contrasenia.value.length < 8) showError(fields.contrasenia, 'contraseniaError');
                if (fields.contrasenia.value !== fields.confirmPassword.value) showError(fields.confirmPassword, 'errorMessage');

                if (!valid) {
                    event.preventDefault();
                    // Scroll al primer error
                    const firstError = document.querySelector('.error-field');
                    if (firstError) {
                        firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                }
            });

            // Validación en tiempo real
            const inputs = document.querySelectorAll('input, select');
            inputs.forEach(input => {
                input.addEventListener('blur', function() {
                    this.classList.remove('error-field', 'border-red-500');
                    const parent = this.closest('[class*="space-y"]');
                    if (parent) {
                        const errorSpan = parent.querySelector('[id$="Error"]');
                        if (errorSpan) errorSpan.classList.add('hidden');
                    }
                });
            });
        });
    </script>

    <style>
        .error-field {
            border-color: #ef4444 !important;
            background-color: #fef2f2 !important;
        }

        select {
            background-image: none;
        }

        /* Ocultar icono de ojo del navegador (Edge/Chrome) */
        input::-ms-reveal,
        input::-ms-clear {
            display: none;
        }

        input::-webkit-credentials-auto-fill-button,
        input::-webkit-password-auto-fill-button {
            display: none !important;
            visibility: hidden;
            pointer-events: none;
        }
    </style>
</body>
</html>
