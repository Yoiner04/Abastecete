@model List<BusinessLogic.Models.AddonTipo>
@using BusinessLogic.Utilidades
@{
    ViewData["Title"] = "Gestión de Addons";
    ViewData["Description"] = "Administra los addons disponibles para la venta";
    var permisos = Context.Session.GetString("permisosSistema") ?? "";
    var puedeAdministrar = RolPermisos.TienePermiso("ADMIN_ADDONS", permisos);
}

<style>
    .modal { transition: opacity 0.2s ease, visibility 0.2s ease; }
    .modal.hidden { opacity: 0; visibility: hidden; }
    .modal:not(.hidden) { opacity: 1; visibility: visible; }
</style>

<!-- Skeleton de carga -->
<div id="loading-skeleton" class="animate-pulse">
    <div class="bg-white border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 bg-gray-200 rounded-lg"></div>
                    <div>
                        <div class="h-8 w-56 bg-gray-200 rounded"></div>
                        <div class="h-4 w-64 bg-gray-200 rounded mt-2"></div>
                    </div>
                </div>
                <div class="h-10 w-36 bg-gray-200 rounded-lg"></div>
            </div>
        </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
            @for (int i = 0; i < 4; i++)
            {
                <div class="bg-white rounded-xl border border-gray-200 p-4">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 bg-gray-200 rounded-lg"></div>
                        <div class="flex-1">
                            <div class="h-8 w-16 bg-gray-200 rounded mb-1"></div>
                            <div class="h-4 w-24 bg-gray-200 rounded"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
            <div class="p-4 space-y-3">
                @for (int i = 0; i < 5; i++)
                {
                    <div class="h-16 bg-gray-200 rounded"></div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Contenido real -->
<div id="main-content" class="hidden">
<!-- Header -->
<div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-4">
                <a href="@Url.Action("Principal", "Home")"
                   class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors">
                    <i class="fas fa-arrow-left text-gray-600"></i>
                </a>
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Gestión de Addons</h1>
                    <p class="text-sm text-gray-500 mt-1">Administra los addons disponibles para la venta</p>
                </div>
            </div>
            @if (puedeAdministrar)
            {
                <button onclick="abrirModalAddon()"
                    class="inline-flex items-center gap-2 px-4 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition-colors">
                    <i class="fas fa-plus"></i>
                    <span>Nuevo Addon</span>
                </button>
            }
        </div>
    </div>
</div>

<!-- Contenido con contenedor -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

<!-- Stats Cards -->
<div class="grid grid-cols-1 sm:grid-cols-4 gap-4 mb-6">
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-4">
        <div class="w-12 h-12 rounded-lg bg-orange-100 flex items-center justify-center">
            <i class="fas fa-puzzle-piece text-orange-600 text-xl"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-gray-900">@Model.Count</p>
            <p class="text-sm text-gray-500">Total Addons</p>
        </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-4">
        <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center">
            <i class="fas fa-check-circle text-green-600 text-xl"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-gray-900">@Model.Count(a => a.Estado)</p>
            <p class="text-sm text-gray-500">Activos</p>
        </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-4">
        <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center">
            <i class="fas fa-box text-blue-600 text-xl"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-gray-900">@Model.Count(a => a.TipoLimite == "PRODUCTOS")</p>
            <p class="text-sm text-gray-500">Productos</p>
        </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-4">
        <div class="w-12 h-12 rounded-lg bg-purple-100 flex items-center justify-center">
            <i class="fas fa-bolt text-purple-600 text-xl"></i>
        </div>
        <div>
            <p class="text-2xl font-bold text-gray-900">@Model.Count(a => a.TipoLimite == "OFERTAS_FLASH")</p>
            <p class="text-sm text-gray-500">Ofertas Flash</p>
        </div>
    </div>
</div>

<!-- Filtros -->
<div class="bg-white rounded-xl border border-gray-200 mb-6 p-4">
    <div class="flex flex-col sm:flex-row gap-4">
        <div class="flex-1 relative">
            <input type="text" id="filtro-buscar" placeholder="Buscar addon por nombre o código..."
                   class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
        </div>
        <select id="filtro-tipo" class="px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 transition-all">
            <option value="">Todos los tipos</option>
            <option value="PRODUCTOS">Productos</option>
            <option value="OFERTAS_FLASH">Ofertas Flash</option>
            <option value="DURACION_OFERTA">Duración Oferta</option>
        </select>
        <select id="filtro-estado" class="px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 transition-all">
            <option value="">Todos los estados</option>
            <option value="1">Activos</option>
            <option value="0">Inactivos</option>
        </select>
    </div>
</div>

<!-- Tabla de Addons -->
<div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Addon</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider hidden md:table-cell">Tipo</th>
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Cantidad</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Precio</th>
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Estado</th>
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                </tr>
            </thead>
            <tbody id="tabla-addons" class="bg-white divide-y divide-gray-200">
                @foreach (var addon in Model)
                {
                    var colorTipo = addon.TipoLimite switch {
                        "PRODUCTOS" => "blue",
                        "OFERTAS_FLASH" => "purple",
                        "DURACION_OFERTA" => "amber",
                        _ => "gray"
                    };
                    var iconoTipo = addon.TipoLimite switch {
                        "PRODUCTOS" => "fa-box",
                        "OFERTAS_FLASH" => "fa-bolt",
                        "DURACION_OFERTA" => "fa-clock",
                        _ => "fa-puzzle-piece"
                    };
                    <tr class="hover:bg-gray-50 addon-row transition-colors"
                        data-id="@addon.Id"
                        data-nombre="@addon.Nombre.ToLower()"
                        data-codigo="@addon.Codigo.ToLower()"
                        data-tipo="@addon.TipoLimite"
                        data-activo="@(addon.Estado ? "1" : "0")">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center">
                                    <i class="@(string.IsNullOrEmpty(addon.Icono) ? "fas fa-puzzle-piece" : addon.Icono) text-xl text-white"></i>
                                </div>
                                <div>
                                    <p class="font-semibold text-gray-900">@addon.Nombre</p>
                                    <p class="text-xs text-gray-400 font-mono">@addon.Codigo</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4 hidden md:table-cell">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-@(colorTipo)-100 text-@(colorTipo)-800">
                                <i class="fas @iconoTipo mr-1"></i>
                                @addon.TipoLimite.Replace("_", " ")
                            </span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <span class="text-lg font-bold text-gray-900">+@addon.Cantidad</span>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <span class="text-lg font-bold text-green-600">$@addon.Precio.ToString("N0")</span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            @if (addon.Estado)
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    <i class="fas fa-check-circle mr-1"></i> Activo
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                    <i class="fas fa-times-circle mr-1"></i> Inactivo
                                </span>
                            }
                        </td>
                        <td class="px-6 py-4 text-center">
                            @if (puedeAdministrar)
                            {
                                <div class="flex items-center justify-center gap-1">
                                    <button onclick="editarAddon(@addon.Id)"
                                            class="p-2 text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    @if (addon.Estado)
                                    {
                                        <button onclick="desactivarAddon(@addon.Id, '@addon.Nombre.Replace("'", "\\'")')"
                                                class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors" title="Desactivar">
                                            <i class="fas fa-ban"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button onclick="activarAddon(@addon.Id)"
                                                class="p-2 text-green-600 hover:bg-green-50 rounded-lg transition-colors" title="Activar">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-xs text-gray-400">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-12">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-orange-100 flex items-center justify-center">
                <i class="fas fa-puzzle-piece text-2xl text-orange-400"></i>
            </div>
            <p class="text-gray-500 mb-2">No hay addons registrados</p>
            <p class="text-sm text-gray-400">Haz clic en "Nuevo Addon" para agregar uno</p>
        </div>
    }

    <!-- Paginación -->
    @if (Model.Any())
    {
        <div class="px-4 py-3 bg-gray-50 border-t border-gray-200">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-2">
                    <span class="text-sm text-gray-700">Mostrar</span>
                    <select id="items-per-page" class="px-2 py-1 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-orange-500">
                        <option value="10">10</option>
                        <option value="25" selected>25</option>
                        <option value="50">50</option>
                    </select>
                    <span class="text-sm text-gray-700">por página</span>
                </div>
                <div class="flex items-center gap-1">
                    <button id="btn-prev" class="px-3 py-1.5 rounded-lg border border-gray-300 text-sm text-gray-600 hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <div id="pagination-numbers" class="flex items-center gap-1"></div>
                    <button id="btn-next" class="px-3 py-1.5 rounded-lg border border-gray-300 text-sm text-gray-600 hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
                <p id="pagination-info" class="text-sm text-gray-500"></p>
            </div>
        </div>
    }
</div>

<!-- Modal Crear/Editar Addon -->
<div id="modal-addon" class="modal hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen px-4 py-8">
        <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" onclick="cerrarModal()"></div>
        <div class="relative bg-white rounded-2xl shadow-xl max-w-lg w-full p-6">
            <div class="flex items-center justify-between mb-6">
                <h3 id="modal-titulo" class="text-lg font-semibold text-gray-900">
                    <i class="fas fa-puzzle-piece text-orange-500 mr-2"></i>
                    Nuevo Addon
                </h3>
                <button onclick="cerrarModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>

            <form id="form-addon" onsubmit="guardarAddon(event)">
                <input type="hidden" id="addon-id" value="0">

                <div class="space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Código *</label>
                            <input type="text" id="addon-codigo" placeholder="Ej: ADDON_PRODUCTOS_50"
                                   class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all font-mono text-sm"
                                   required maxlength="50">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Nombre *</label>
                            <input type="text" id="addon-nombre" placeholder="Ej: +50 Productos"
                                   class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all"
                                   required maxlength="100">
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
                        <textarea id="addon-descripcion" rows="2" placeholder="Descripción del addon..."
                                  class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all"
                                  maxlength="255"></textarea>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Tipo de Límite *</label>
                            <select id="addon-tipo" required
                                    class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all">
                                <option value="">Seleccionar...</option>
                                <option value="PRODUCTOS">Productos</option>
                                <option value="OFERTAS_FLASH">Ofertas Flash</option>
                                <option value="DURACION_OFERTA">Duración Oferta</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Cantidad a agregar *</label>
                            <input type="number" id="addon-cantidad" placeholder="50"
                                   class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all"
                                   required min="1" max="10000">
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Precio (COP) *</label>
                            <div class="relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500">$</span>
                                <input type="number" id="addon-precio" placeholder="50000"
                                       class="w-full pl-8 pr-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all"
                                       required min="0" step="1000">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Icono FontAwesome</label>
                            <div class="relative">
                                <input type="text" id="addon-icono" placeholder="fas fa-box"
                                       class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition-all"
                                       maxlength="50">
                                <i id="icono-preview" class="fas fa-puzzle-piece absolute left-3 top-1/2 -translate-y-1/2 text-orange-500"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="error-mensaje" class="hidden mt-4 p-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700">
                    <i class="fas fa-exclamation-circle mr-2"></i>
                    <span id="error-texto"></span>
                </div>

                <div class="flex gap-3 mt-6 pt-4 border-t border-gray-200">
                    <button type="button" onclick="cerrarModal()"
                            class="flex-1 px-4 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors font-medium">
                        Cancelar
                    </button>
                    <button type="submit" id="btn-guardar"
                            class="flex-1 px-4 py-2.5 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition-colors font-medium">
                        <i class="fas fa-save mr-2"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Confirmación -->
<div id="modal-confirmar" class="modal hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen px-4">
        <div class="fixed inset-0 bg-black/50 backdrop-blur-sm" onclick="cerrarModalConfirmar()"></div>
        <div class="relative bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 text-center">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-red-100 flex items-center justify-center">
                <i class="fas fa-exclamation-triangle text-2xl text-red-600"></i>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Confirmar Desactivación</h3>
            <p id="confirmar-mensaje" class="text-gray-500 mb-6"></p>
            <input type="hidden" id="confirmar-id">
            <div class="flex gap-3">
                <button onclick="cerrarModalConfirmar()"
                        class="flex-1 px-4 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium transition-colors">
                    Cancelar
                </button>
                <button id="btn-confirmar"
                        class="flex-1 px-4 py-2.5 bg-red-600 text-white rounded-lg hover:bg-red-700 font-medium transition-colors">
                    <i class="fas fa-ban mr-2"></i>Desactivar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast -->
<div id="toast" class="fixed bottom-4 right-4 z-50 transform translate-y-full opacity-0 transition-all duration-300">
    <div class="bg-white rounded-xl shadow-lg border border-gray-200 p-4 flex items-center gap-3 max-w-sm">
        <div id="toast-icon" class="w-10 h-10 rounded-full flex items-center justify-center bg-green-100 text-green-600">
            <i class="fas fa-check"></i>
        </div>
        <div>
            <p id="toast-title" class="font-medium text-gray-900">Éxito</p>
            <p id="toast-message" class="text-sm text-gray-500">Operación completada</p>
        </div>
    </div>
</div>

</div>
</div>

@section Scripts {
<script>
    // Mostrar contenido después de cargar
    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
            document.getElementById('loading-skeleton').style.display = 'none';
            document.getElementById('main-content').classList.remove('hidden');
        }, 300);
    });

    // =============== PAGINACIÓN ===============
    let currentPage = 1;
    let itemsPerPage = 25;
    const allRows = Array.from(document.querySelectorAll('.addon-row'));
    let filteredRows = [...allRows];

    function updatePagination() {
        const totalItems = filteredRows.length;
        const totalPages = Math.ceil(totalItems / itemsPerPage);
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;

        allRows.forEach(row => row.style.display = 'none');
        filteredRows.slice(start, end).forEach(row => row.style.display = '');

        const showing = Math.min(end, totalItems);
        document.getElementById('pagination-info').textContent =
            totalItems > 0 ? `Mostrando ${start + 1}-${showing} de ${totalItems} addons` : 'Sin resultados';

        document.getElementById('btn-prev').disabled = currentPage === 1;
        document.getElementById('btn-next').disabled = currentPage === totalPages || totalPages === 0;

        const numbersContainer = document.getElementById('pagination-numbers');
        numbersContainer.innerHTML = '';

        const maxButtons = 5;
        let startPage = Math.max(1, currentPage - Math.floor(maxButtons / 2));
        let endPage = Math.min(totalPages, startPage + maxButtons - 1);

        if (endPage - startPage + 1 < maxButtons) {
            startPage = Math.max(1, endPage - maxButtons + 1);
        }

        for (let i = startPage; i <= endPage; i++) {
            const btn = document.createElement('button');
            btn.textContent = i;
            btn.className = `px-3 py-1.5 rounded-lg text-sm transition-colors ${i === currentPage
                ? 'bg-orange-600 text-white'
                : 'border border-gray-300 text-gray-600 hover:bg-gray-100'}`;
            btn.onclick = () => { currentPage = i; updatePagination(); };
            numbersContainer.appendChild(btn);
        }
    }

    document.getElementById('items-per-page')?.addEventListener('change', function() {
        itemsPerPage = parseInt(this.value);
        currentPage = 1;
        updatePagination();
    });

    document.getElementById('btn-prev')?.addEventListener('click', () => {
        if (currentPage > 1) { currentPage--; updatePagination(); }
    });

    document.getElementById('btn-next')?.addEventListener('click', () => {
        const totalPages = Math.ceil(filteredRows.length / itemsPerPage);
        if (currentPage < totalPages) { currentPage++; updatePagination(); }
    });

    // =============== FILTROS ===============
    document.getElementById('filtro-buscar').addEventListener('input', aplicarFiltros);
    document.getElementById('filtro-tipo').addEventListener('change', aplicarFiltros);
    document.getElementById('filtro-estado').addEventListener('change', aplicarFiltros);

    function aplicarFiltros() {
        const termino = document.getElementById('filtro-buscar').value.toLowerCase();
        const tipo = document.getElementById('filtro-tipo').value;
        const estado = document.getElementById('filtro-estado').value;

        filteredRows = allRows.filter(row => {
            const nombre = row.dataset.nombre || '';
            const codigo = row.dataset.codigo || '';
            const tipoRow = row.dataset.tipo;
            const activo = row.dataset.activo;

            const matchTexto = nombre.includes(termino) || codigo.includes(termino);
            const matchTipo = !tipo || tipoRow === tipo;
            const matchEstado = !estado || activo === estado;

            return matchTexto && matchTipo && matchEstado;
        });

        currentPage = 1;
        updatePagination();
    }

    // =============== MODAL ADDON ===============
    function abrirModalAddon() {
        limpiarFormulario();
        document.getElementById('modal-titulo').innerHTML = '<i class="fas fa-puzzle-piece text-orange-500 mr-2"></i>Nuevo Addon';
        document.getElementById('modal-addon').classList.remove('hidden');
    }

    function cerrarModal() {
        document.getElementById('modal-addon').classList.add('hidden');
    }

    function limpiarFormulario() {
        document.getElementById('addon-id').value = '0';
        document.getElementById('addon-codigo').value = '';
        document.getElementById('addon-nombre').value = '';
        document.getElementById('addon-descripcion').value = '';
        document.getElementById('addon-tipo').value = '';
        document.getElementById('addon-cantidad').value = '';
        document.getElementById('addon-precio').value = '';
        document.getElementById('addon-icono').value = '';
        document.getElementById('icono-preview').className = 'fas fa-puzzle-piece absolute left-3 top-1/2 -translate-y-1/2 text-orange-500';
        document.getElementById('error-mensaje').classList.add('hidden');
    }

    // Preview de icono
    document.getElementById('addon-icono').addEventListener('input', function() {
        const icono = this.value.trim() || 'fas fa-puzzle-piece';
        document.getElementById('icono-preview').className = icono + ' absolute left-3 top-1/2 -translate-y-1/2 text-orange-500';
    });

    // Editar addon
    function editarAddon(id) {
        fetch(`/Addons/ObtenerAddon?id=${id}`)
            .then(response => response.json())
            .then(data => {
                if (!data.success) {
                    showToast('error', 'Error', data.mensaje || 'Error al cargar el addon');
                    return;
                }

                const addon = data.addon;
                document.getElementById('addon-id').value = addon.id;
                document.getElementById('addon-codigo').value = addon.codigo;
                document.getElementById('addon-nombre').value = addon.nombre;
                document.getElementById('addon-descripcion').value = addon.descripcion || '';
                document.getElementById('addon-tipo').value = addon.tipoLimite;
                document.getElementById('addon-cantidad').value = addon.cantidad;
                document.getElementById('addon-precio').value = addon.precio;
                document.getElementById('addon-icono').value = addon.icono || '';

                if (addon.icono) {
                    document.getElementById('icono-preview').className = addon.icono + ' absolute left-3 top-1/2 -translate-y-1/2 text-orange-500';
                }

                document.getElementById('modal-titulo').innerHTML = '<i class="fas fa-edit text-orange-500 mr-2"></i>Editar Addon';
                document.getElementById('modal-addon').classList.remove('hidden');
            })
            .catch(() => showToast('error', 'Error', 'Error al cargar el addon'));
    }

    // Guardar addon
    function guardarAddon(e) {
        e.preventDefault();

        const id = parseInt(document.getElementById('addon-id').value) || 0;
        const addon = {
            id: id,
            codigo: document.getElementById('addon-codigo').value.trim(),
            nombre: document.getElementById('addon-nombre').value.trim(),
            descripcion: document.getElementById('addon-descripcion').value.trim(),
            tipoLimite: document.getElementById('addon-tipo').value,
            cantidad: parseInt(document.getElementById('addon-cantidad').value) || 0,
            precio: parseFloat(document.getElementById('addon-precio').value) || 0,
            icono: document.getElementById('addon-icono').value.trim(),
            estado: true
        };

        if (!addon.codigo || !addon.nombre) {
            mostrarError('Código y nombre son obligatorios');
            return;
        }

        if (!addon.tipoLimite) {
            mostrarError('Debes seleccionar un tipo de límite');
            return;
        }

        if (addon.cantidad <= 0) {
            mostrarError('La cantidad debe ser mayor a 0');
            return;
        }

        const url = id > 0 ? '/Addons/ActualizarAddon' : '/Addons/CrearAddon';

        const btnGuardar = document.getElementById('btn-guardar');
        btnGuardar.disabled = true;
        btnGuardar.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Guardando...';

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(addon)
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    cerrarModal();
                    showToast('success', 'Éxito', data.mensaje || 'Addon guardado correctamente');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    mostrarError(data.mensaje || 'Error al guardar el addon');
                }
            })
            .catch(() => mostrarError('Error de conexión al guardar'))
            .finally(() => {
                btnGuardar.disabled = false;
                btnGuardar.innerHTML = '<i class="fas fa-save mr-2"></i>Guardar';
            });
    }

    function mostrarError(mensaje) {
        document.getElementById('error-texto').textContent = mensaje;
        document.getElementById('error-mensaje').classList.remove('hidden');
    }

    // =============== DESACTIVAR/ACTIVAR ADDON ===============
    function desactivarAddon(id, nombre) {
        document.getElementById('confirmar-id').value = id;
        document.getElementById('confirmar-mensaje').textContent =
            `¿Estás seguro de que deseas desactivar el addon "${nombre}"? Los usuarios no podrán comprarlo.`;
        document.getElementById('modal-confirmar').classList.remove('hidden');
    }

    function cerrarModalConfirmar() {
        document.getElementById('modal-confirmar').classList.add('hidden');
    }

    document.getElementById('btn-confirmar')?.addEventListener('click', function() {
        const id = document.getElementById('confirmar-id').value;

        fetch(`/Addons/CambiarEstado?id=${id}&estado=false`, { method: 'POST' })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    cerrarModalConfirmar();
                    showToast('success', 'Éxito', data.mensaje || 'Addon desactivado correctamente');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast('error', 'Error', data.mensaje || 'Error al desactivar');
                }
            })
            .catch(() => showToast('error', 'Error', 'Error de conexión'));
    });

    function activarAddon(id) {
        fetch(`/Addons/CambiarEstado?id=${id}&estado=true`, { method: 'POST' })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast('success', 'Éxito', data.mensaje || 'Addon activado correctamente');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast('error', 'Error', data.mensaje || 'Error al activar');
                }
            })
            .catch(() => showToast('error', 'Error', 'Error de conexión'));
    }

    // =============== TOAST ===============
    function showToast(type, title, message) {
        const toast = document.getElementById('toast');
        const icon = document.getElementById('toast-icon');
        const titleEl = document.getElementById('toast-title');
        const messageEl = document.getElementById('toast-message');

        titleEl.textContent = title;
        messageEl.textContent = message;

        if (type === 'success') {
            icon.className = 'w-10 h-10 rounded-full flex items-center justify-center bg-green-100 text-green-600';
            icon.innerHTML = '<i class="fas fa-check"></i>';
        } else {
            icon.className = 'w-10 h-10 rounded-full flex items-center justify-center bg-red-100 text-red-600';
            icon.innerHTML = '<i class="fas fa-times"></i>';
        }

        toast.classList.remove('translate-y-full', 'opacity-0');

        setTimeout(() => {
            toast.classList.add('translate-y-full', 'opacity-0');
        }, 3000);
    }

    // Inicializar paginación
    if (allRows.length > 0) {
        updatePagination();
    }
</script>
}
