@model List<BusinessLogic.Models.Unidad>
@using BusinessLogic.Models
@{
    ViewData["Title"] = "Gestión de Unidades - Abastecete";
    ViewData["Description"] = "Administra las unidades de medida y tipos de unidad para los productos en Abastecete. Gestiona kg, litros, unidades y más categorías de medición.";
    var tiposUnidad = ViewBag.TiposUnidad as List<TipoUnidad> ?? new List<TipoUnidad>();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Abastécete</title>
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        .modal {
            transition: opacity 0.2s ease, visibility 0.2s ease;
        }
        .modal.hidden {
            opacity: 0;
            visibility: hidden;
        }
        .modal:not(.hidden) {
            opacity: 1;
            visibility: visible;
        }
    </style>
</head>

<body class="bg-gray-50 min-h-screen">
    <!-- Skeleton Loader -->
    <div id="skeleton-unidad" class="animate-pulse">
        <!-- Header Skeleton -->
        <header class="bg-white shadow-sm border-b border-gray-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="h-6 w-24 bg-gray-200 rounded"></div>
                        <div class="h-6 w-px bg-gray-200"></div>
                        <div class="h-8 w-64 bg-gray-200 rounded"></div>
                    </div>
                </div>
            </div>
        </header>

        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <!-- Tabs Skeleton -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 mb-6">
                <div class="border-b border-gray-200">
                    <nav class="flex -mb-px">
                        <div class="px-6 py-4 w-32 h-12 bg-gray-200 rounded-t"></div>
                        <div class="px-6 py-4 w-40 h-12 bg-gray-100 rounded-t ml-2"></div>
                    </nav>
                </div>

                <!-- Content Skeleton -->
                <div class="p-6">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                        <div class="flex-1">
                            <div class="h-6 w-48 bg-gray-200 rounded mb-2"></div>
                            <div class="h-4 w-64 bg-gray-200 rounded"></div>
                        </div>
                        <div class="h-10 w-40 bg-gray-200 rounded-lg"></div>
                    </div>

                    <!-- Table Skeleton -->
                    <div class="overflow-x-auto rounded-lg border border-gray-200">
                        <div class="min-w-full divide-y divide-gray-200">
                            <!-- Header -->
                            <div class="bg-gray-50 px-6 py-3 flex gap-4">
                                <div class="h-4 w-12 bg-gray-200 rounded"></div>
                                <div class="h-4 w-32 bg-gray-200 rounded"></div>
                                <div class="h-4 w-24 bg-gray-200 rounded"></div>
                                <div class="h-4 w-24 bg-gray-200 rounded"></div>
                                <div class="h-4 w-24 bg-gray-200 rounded ml-auto"></div>
                            </div>
                            <!-- Rows -->
                            <div class="bg-white divide-y divide-gray-200">
                                <div class="px-6 py-4 flex gap-4 items-center">
                                    <div class="h-4 w-12 bg-gray-200 rounded"></div>
                                    <div class="h-4 w-32 bg-gray-200 rounded"></div>
                                    <div class="h-6 w-24 bg-gray-200 rounded-full"></div>
                                    <div class="h-6 w-20 bg-gray-200 rounded-full"></div>
                                    <div class="h-4 w-20 bg-gray-200 rounded ml-auto"></div>
                                </div>
                                <div class="px-6 py-4 flex gap-4 items-center">
                                    <div class="h-4 w-12 bg-gray-200 rounded"></div>
                                    <div class="h-4 w-32 bg-gray-200 rounded"></div>
                                    <div class="h-6 w-24 bg-gray-200 rounded-full"></div>
                                    <div class="h-6 w-20 bg-gray-200 rounded-full"></div>
                                    <div class="h-4 w-20 bg-gray-200 rounded ml-auto"></div>
                                </div>
                                <div class="px-6 py-4 flex gap-4 items-center">
                                    <div class="h-4 w-12 bg-gray-200 rounded"></div>
                                    <div class="h-4 w-32 bg-gray-200 rounded"></div>
                                    <div class="h-6 w-24 bg-gray-200 rounded-full"></div>
                                    <div class="h-6 w-20 bg-gray-200 rounded-full"></div>
                                    <div class="h-4 w-20 bg-gray-200 rounded ml-auto"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Contenido Real -->
    <div id="content-unidad" class="hidden">
        <!-- Header -->
        <header class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <a href="/" class="flex items-center gap-2 text-gray-600 hover:text-green-600 transition-colors">
                        <i class="fas fa-arrow-left"></i>
                        <span class="hidden sm:inline">Inicio</span>
                    </a>
                    <div class="h-6 w-px bg-gray-200"></div>
                    <h1 class="text-xl sm:text-2xl font-bold text-gray-900">
                        <i class="fas fa-balance-scale text-green-500 mr-2"></i>
                        Gestión de Unidades
                    </h1>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Tabs -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 mb-6">
            <div class="border-b border-gray-200">
                <nav class="flex -mb-px">
                    <button id="tabUnidades" onclick="showTab('unidades')"
                            class="tab-btn active px-6 py-4 text-sm font-medium border-b-2 border-green-500 text-green-600">
                        <i class="fas fa-ruler mr-2"></i>Unidades
                    </button>
                    <button id="tabTipos" onclick="showTab('tipos')"
                            class="tab-btn px-6 py-4 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300">
                        <i class="fas fa-layer-group mr-2"></i>Tipos de Unidad
                    </button>
                </nav>
            </div>

            <!-- Tab Content: Unidades -->
            <div id="contentUnidades" class="p-6">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900">Unidades de Medida</h2>
                        <p class="text-sm text-gray-500">Gestiona las unidades disponibles para los productos</p>
                    </div>
                    <button onclick="abrirModalUnidad()"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                        <i class="fas fa-plus"></i>
                        Nueva Unidad
                    </button>
                </div>

                <!-- Tabla Unidades -->
                <div class="overflow-x-auto rounded-lg border border-gray-200">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nombre</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tipo</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Estado</th>
                                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tablaUnidades" class="bg-white divide-y divide-gray-200">
                            @foreach (var unidad in Model)
                            {
                                <tr class="hover:bg-gray-50" data-id="@unidad.Id">
                                    <td class="px-6 py-4 text-sm text-gray-500">@unidad.Id</td>
                                    <td class="px-6 py-4">
                                        <span class="text-sm font-medium text-gray-900">@unidad.Nombre</span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                            @(unidad.NombreTipoUnidad ?? "Sin tipo")
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        @if (unidad.Estado == 1)
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                <i class="fas fa-check-circle mr-1"></i> Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                                <i class="fas fa-times-circle mr-1"></i> Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <button onclick="editarUnidad(@unidad.Id, '@unidad.Nombre', @unidad.Estado, @(unidad.IdTipoUnidad ?? 0))"
                                                class="text-blue-600 hover:text-blue-800 mr-3" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button onclick="eliminarUnidad(@unidad.Id, '@unidad.Nombre')"
                                                class="text-red-600 hover:text-red-800" title="Eliminar">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-12">
                        <i class="fas fa-inbox text-4xl text-gray-300 mb-4"></i>
                        <p class="text-gray-500">No hay unidades registradas</p>
                    </div>
                }
            </div>

            <!-- Tab Content: Tipos de Unidad -->
            <div id="contentTipos" class="p-6 hidden">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900">Tipos de Unidad</h2>
                        <p class="text-sm text-gray-500">Categorías para agrupar las unidades (Peso, Volumen, etc.)</p>
                    </div>
                    <button onclick="abrirModalTipo()"
                            class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
                        <i class="fas fa-plus"></i>
                        Nuevo Tipo
                    </button>
                </div>

                <!-- Tabla Tipos -->
                <div class="overflow-x-auto rounded-lg border border-gray-200">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Nombre</th>
                                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tablaTipos" class="bg-white divide-y divide-gray-200">
                            @foreach (var tipo in tiposUnidad)
                            {
                                <tr class="hover:bg-gray-50" data-id="@tipo.Id">
                                    <td class="px-6 py-4 text-sm text-gray-500">@tipo.Id</td>
                                    <td class="px-6 py-4">
                                        <span class="text-sm font-medium text-gray-900">@tipo.Nombre</span>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <button onclick="editarTipo(@tipo.Id, '@tipo.Nombre')"
                                                class="text-blue-600 hover:text-blue-800 mr-3" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button onclick="eliminarTipo(@tipo.Id, '@tipo.Nombre')"
                                                class="text-red-600 hover:text-red-800" title="Eliminar">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!tiposUnidad.Any())
                {
                    <div class="text-center py-12">
                        <i class="fas fa-inbox text-4xl text-gray-300 mb-4"></i>
                        <p class="text-gray-500">No hay tipos de unidad registrados</p>
                    </div>
                }
            </div>
        </div>
    </main>

    <!-- Modal Unidad -->
    <div id="modalUnidad" class="modal hidden fixed inset-0 z-50 overflow-y-auto">
        <div class="flex items-center justify-center min-h-screen px-4">
            <div class="fixed inset-0 bg-black/50" onclick="cerrarModalUnidad()"></div>
            <div class="relative bg-white rounded-2xl shadow-xl max-w-md w-full p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 id="modalUnidadTitle" class="text-lg font-semibold text-gray-900">Nueva Unidad</h3>
                    <button onclick="cerrarModalUnidad()" class="text-gray-400 hover:text-gray-600">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <form id="formUnidad" onsubmit="guardarUnidad(event)">
                    <input type="hidden" id="unidadId" value="">

                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Nombre *</label>
                            <input type="text" id="unidadNombre" required
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500"
                                   placeholder="Ej: Kg, L, Unidad">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Tipo de Unidad *</label>
                            <select id="unidadTipo" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500">
                                <option value="">Seleccione un tipo</option>
                                @foreach (var tipo in tiposUnidad)
                                {
                                    <option value="@tipo.Id">@tipo.Nombre</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Estado</label>
                            <div class="flex items-center gap-4">
                                <label class="flex items-center">
                                    <input type="radio" name="unidadEstado" value="1" checked
                                           class="text-green-600 focus:ring-green-500">
                                    <span class="ml-2 text-sm text-gray-700">Activo</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="radio" name="unidadEstado" value="0"
                                           class="text-red-600 focus:ring-red-500">
                                    <span class="ml-2 text-sm text-gray-700">Inactivo</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-3 mt-6">
                        <button type="button" onclick="cerrarModalUnidad()"
                                class="flex-1 px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50">
                            Cancelar
                        </button>
                        <button type="submit"
                                class="flex-1 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
                            <i class="fas fa-save mr-2"></i>Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Tipo Unidad -->
    <div id="modalTipo" class="modal hidden fixed inset-0 z-50 overflow-y-auto">
        <div class="flex items-center justify-center min-h-screen px-4">
            <div class="fixed inset-0 bg-black/50" onclick="cerrarModalTipo()"></div>
            <div class="relative bg-white rounded-2xl shadow-xl max-w-md w-full p-6">
                <div class="flex items-center justify-between mb-4">
                    <h3 id="modalTipoTitle" class="text-lg font-semibold text-gray-900">Nuevo Tipo de Unidad</h3>
                    <button onclick="cerrarModalTipo()" class="text-gray-400 hover:text-gray-600">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <form id="formTipo" onsubmit="guardarTipo(event)">
                    <input type="hidden" id="tipoId" value="">

                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Nombre *</label>
                            <input type="text" id="tipoNombre" required
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                                   placeholder="Ej: Peso, Volumen, Cantidad">
                        </div>
                    </div>

                    <div class="flex gap-3 mt-6">
                        <button type="button" onclick="cerrarModalTipo()"
                                class="flex-1 px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50">
                            Cancelar
                        </button>
                        <button type="submit"
                                class="flex-1 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                            <i class="fas fa-save mr-2"></i>Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Confirmación -->
    <div id="modalConfirm" class="modal hidden fixed inset-0 z-50 overflow-y-auto">
        <div class="flex items-center justify-center min-h-screen px-4">
            <div class="fixed inset-0 bg-black/50" onclick="cerrarModalConfirm()"></div>
            <div class="relative bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 text-center">
                <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-red-100 flex items-center justify-center">
                    <i class="fas fa-exclamation-triangle text-2xl text-red-600"></i>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 mb-2">Confirmar Eliminación</h3>
                <p id="confirmMessage" class="text-gray-500 mb-6"></p>
                <div class="flex gap-3">
                    <button onclick="cerrarModalConfirm()"
                            class="flex-1 px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50">
                        Cancelar
                    </button>
                    <button id="btnConfirmDelete" onclick=""
                            class="flex-1 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">
                        <i class="fas fa-trash mr-2"></i>Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div id="toast" class="fixed bottom-4 right-4 transform translate-y-20 opacity-0 transition-all duration-300 z-50">
        <div class="bg-gray-900 text-white px-6 py-3 rounded-xl shadow-lg flex items-center gap-3">
            <i id="toastIcon" class="fas fa-check-circle text-green-400"></i>
            <span id="toastMessage"></span>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Tabs
        function showTab(tab) {
            const tabs = ['unidades', 'tipos'];
            tabs.forEach(t => {
                const btn = document.getElementById('tab' + t.charAt(0).toUpperCase() + t.slice(1));
                const content = document.getElementById('content' + t.charAt(0).toUpperCase() + t.slice(1));

                if (t === tab) {
                    btn.classList.add('border-green-500', 'text-green-600');
                    btn.classList.remove('border-transparent', 'text-gray-500');
                    content.classList.remove('hidden');
                } else {
                    btn.classList.remove('border-green-500', 'text-green-600');
                    btn.classList.add('border-transparent', 'text-gray-500');
                    content.classList.add('hidden');
                }
            });
        }

        // Toast
        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const icon = document.getElementById('toastIcon');
            const msg = document.getElementById('toastMessage');

            msg.textContent = message;
            icon.className = type === 'success'
                ? 'fas fa-check-circle text-green-400'
                : 'fas fa-exclamation-circle text-red-400';

            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // === UNIDADES ===
        function abrirModalUnidad() {
            document.getElementById('modalUnidadTitle').textContent = 'Nueva Unidad';
            document.getElementById('unidadId').value = '';
            document.getElementById('unidadNombre').value = '';
            document.getElementById('unidadTipo').value = '';
            document.querySelector('input[name="unidadEstado"][value="1"]').checked = true;
            document.getElementById('modalUnidad').classList.remove('hidden');
        }

        function cerrarModalUnidad() {
            document.getElementById('modalUnidad').classList.add('hidden');
        }

        function editarUnidad(id, nombre, estado, tipoId) {
            document.getElementById('modalUnidadTitle').textContent = 'Editar Unidad';
            document.getElementById('unidadId').value = id;
            document.getElementById('unidadNombre').value = nombre;
            document.getElementById('unidadTipo').value = tipoId || '';
            document.querySelector(`input[name="unidadEstado"][value="${estado}"]`).checked = true;
            document.getElementById('modalUnidad').classList.remove('hidden');
        }

        function guardarUnidad(e) {
            e.preventDefault();
            const id = document.getElementById('unidadId').value;
            const nombre = document.getElementById('unidadNombre').value;
            const tipoId = document.getElementById('unidadTipo').value;
            const estado = document.querySelector('input[name="unidadEstado"]:checked').value;

            const url = id ? '/Unidad/Editar' : '/Unidad/Crear';
            const data = id
                ? { id, nombre, estado, tipoUnidadId: tipoId || null }
                : { nombre, estado, tipoUnidadId: tipoId || null };

            $.post(url, data, function(response) {
                if (response.success) {
                    showToast(response.mensaje);
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(response.mensaje, 'error');
                }
            }).fail(function() {
                showToast('Error al guardar', 'error');
            });
        }

        function eliminarUnidad(id, nombre) {
            document.getElementById('confirmMessage').textContent = `¿Está seguro de eliminar la unidad "${nombre}"?`;
            document.getElementById('btnConfirmDelete').onclick = function() {
                $.post('/Unidad/Eliminar', { id }, function(response) {
                    if (response.success) {
                        showToast(response.mensaje);
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast(response.mensaje, 'error');
                    }
                    cerrarModalConfirm();
                }).fail(function() {
                    showToast('Error al eliminar', 'error');
                    cerrarModalConfirm();
                });
            };
            document.getElementById('modalConfirm').classList.remove('hidden');
        }

        // === TIPOS DE UNIDAD ===
        function abrirModalTipo() {
            document.getElementById('modalTipoTitle').textContent = 'Nuevo Tipo de Unidad';
            document.getElementById('tipoId').value = '';
            document.getElementById('tipoNombre').value = '';
            document.getElementById('modalTipo').classList.remove('hidden');
        }

        function cerrarModalTipo() {
            document.getElementById('modalTipo').classList.add('hidden');
        }

        function editarTipo(id, nombre) {
            document.getElementById('modalTipoTitle').textContent = 'Editar Tipo de Unidad';
            document.getElementById('tipoId').value = id;
            document.getElementById('tipoNombre').value = nombre;
            document.getElementById('modalTipo').classList.remove('hidden');
        }

        function guardarTipo(e) {
            e.preventDefault();
            const id = document.getElementById('tipoId').value;
            const nombre = document.getElementById('tipoNombre').value;

            const url = id ? '/TipoUnidad/Editar' : '/TipoUnidad/Crear';
            const data = id ? { id, nombre } : { nombre };

            $.post(url, data, function(response) {
                if (response.success) {
                    showToast(response.mensaje);
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(response.mensaje, 'error');
                }
            }).fail(function() {
                showToast('Error al guardar', 'error');
            });
        }

        function eliminarTipo(id, nombre) {
            document.getElementById('confirmMessage').textContent = `¿Está seguro de eliminar el tipo "${nombre}"?`;
            document.getElementById('btnConfirmDelete').onclick = function() {
                $.post('/TipoUnidad/Eliminar', { id }, function(response) {
                    if (response.success) {
                        showToast(response.mensaje);
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast(response.mensaje, 'error');
                    }
                    cerrarModalConfirm();
                }).fail(function() {
                    showToast('Error al eliminar', 'error');
                    cerrarModalConfirm();
                });
            };
            document.getElementById('modalConfirm').classList.remove('hidden');
        }

        function cerrarModalConfirm() {
            document.getElementById('modalConfirm').classList.add('hidden');
        }

        // Skeleton Loader
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(function() {
                document.getElementById('skeleton-unidad').classList.add('hidden');
                document.getElementById('content-unidad').classList.remove('hidden');
            }, 300);
        });
    </script>
    </div>
</body>
</html>
