@{
    Layout = null;
}
@using BusinessLogic.Utilidades
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Abastecete.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>

<body>
    @{
        string permisos = HttpContextAccessor.HttpContext.Session.GetString("permisos");
    }

    <div class="menu-overlay" id="menuOverlay">
        <ul class="menu-options">
            <div>
                <h5>Lo que tenemos para ti<h5 />
            </div>
            <li>
                <a asp-area="" asp-controller="Proveedores" asp-action="Consultar">Proveedores</a>
            </li>
            <li><a href="#">Unetenos</a></li>
            <li><a href="#">Promociones</a></li>
            <br />

            <div>
                <h5>Categorias<h5 />
            </div>
            <li>
                <a href="#">Cárnicos </a>
                <ul class="submenu">
                    <li><a href="#">Res</a></li>
                    <li><a href="#">Pollo</a></li>
                    <li><a href="#">Cerdo</a></li>
                    <li><a href="#">Pescado</a></li>
                </ul>
            </li>
            <li><a href="#">Verduras</a></li>
            <li><a href="#">Frutas</a></li>
            <li><a href="#">Granos</a></li>
            <li><a href="#">Lacteos</a></li>
            <br />

            <div>
                <h5>Sobre nosotros<h5 />
            </div>
            <li><a href="#">WhatsApp</a></li>
            <li><a href="#">¿Quiénes somos?</a></li>
            <li><a href="#">Nuestras soluciones</a></li>
            <li><a href="#">Centro de ayuda</a></li>
            <br />

            @if (permisos != null)
            {
                @if (RolPermisos.TienePermiso("Administrar Usuarios", permisos))
                {
                    <li>
                        <a asp-area="" asp-controller="Usuarios" asp-action="Consultar">Usuarios</a>
                    </li>
                }
                @* @if (RolPermisos.TienePermiso("Administrar Negocios", permisos))
                {
                    <li class="nav-item">
                        <a asp-area="" asp-controller="Negocios" asp-action="Consultar">Negocios</a>
                    </li>
                }

                @if (RolPermisos.TienePermiso("Administrar Categorias", permisos))
                {
                    <li class="nav-item">
                        <a asp-area="" asp-controller="Categorias" asp-action="Consultar">Categorias</a>
                    </li>
                } *@
            }
        </ul>
    </div>

    <header>
        <div class="sticky-header">
            <nav class="navbar navbar-expand-sm navbar-light border-bottom box-shadow mb-0">
                <div class="container-fluid">
                    <!-- Izquierda: Botón Hamburguesa y Logo -->
                    <div class="d-flex align-items-center">
                        <div class="burger-btn me-2" id="burgerBtn">
                            <span class="burger-line"></span>
                            <span class="burger-line"></span>
                            <span class="burger-line"></span>
                        </div>
                        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Principal">
                            <img src="~/css/Images/LOGO FINAL.png" alt="Abastecete Logo" style="height: 55px; margin-left: 10px;" />
                        </a>
                    </div>

                    <!-- Centro: Opciones de Navegación -->
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link" style="color: #000;" href="#">
                                <i class="fa fa-search me-1"></i> Buscar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" style="color: #000;" href="#">Categorías</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" style="color: #000;" href="#">Promociones</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" style="color: #000;" href="#">Contacto</a>
                        </li>
                    </ul>

                    <div class="d-flex">
                        @if (permisos != null)
                        {
                            <div class="dropdown">
                                <button class="btn btn-custom3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="~/css/Images/avatar.png" alt="Usuario" style="width: 25px; height: 25px;">
                                </button>
                                <ul class="dropdown-menu">
                                    <a class="nav-link" asp-area="" asp-controller="Login" asp-action="Login">Cerrar Sesión</a>
                                    <a class="nav-link" asp-area="" asp-controller="Usuarios" asp-action="Actualizar">Actualizar Información</a>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn-custom2" asp-area="" asp-controller="Login" asp-action="Login">Únete a nosotros</a>
                        }
                    </div>
                </div>
            </nav>
        </div>
    </header>
</body>
</html>
