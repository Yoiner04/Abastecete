@using BusinessLogic.Utilidades
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model List<BusinessLogic.Models.Categoria>

@{
    ViewData["Title"] = "Abastecete - Encuentra proveedores locales";
    ViewData["Description"] = "Descubre los mejores proveedores locales cerca de ti. Categorías, ofertas flash y negocios verificados.";
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["Description"]" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Abastecete.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/images/Logo A naranja.png" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        html {
            scroll-behavior: smooth;
        }
        /* Scrollbar moderno */
        #content-panel::-webkit-scrollbar {
            width: 8px;
        }
        #content-panel::-webkit-scrollbar-track {
            background: transparent;
        }
        #content-panel::-webkit-scrollbar-thumb {
            background: rgba(0,0,0,0.2);
            border-radius: 4px;
        }
        #content-panel::-webkit-scrollbar-thumb:hover {
            background: rgba(0,0,0,0.3);
        }
        /* Animaciones suaves */
        .card-hover {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(0,0,0,0.12);
        }
        /* Efecto shimmer para loading */
        .shimmer {
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200% 100%;
            animation: shimmer 1.5s infinite;
        }
        @@keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }
        /* Badge flotante */
        .floating-badge {
            animation: float 3s ease-in-out infinite;
        }
        @@keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-5px); }
        }
        /* Categorías con scroll horizontal en móvil */
        .categories-scroll {
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        .categories-scroll::-webkit-scrollbar {
            display: none;
        }
        /* Imagen con zoom suave */
        .img-zoom {
            transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .group:hover .img-zoom {
            transform: scale(1.08);
        }
        /* Gradiente overlay */
        .gradient-overlay {
            background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.6) 100%);
        }
        /* Mapa con borde redondeado - forzar en todos los elementos internos */
        #map, #map > div, #map iframe, #map .gm-style > div:first-child {
            border-radius: 16px !important;
        }
        /* Contenedor del mapa con clip para forzar bordes */
        .map-container {
            border-radius: 16px;
            overflow: hidden;
            -webkit-mask-image: -webkit-radial-gradient(white, black);
            mask-image: radial-gradient(white, black);
        }
        /* Loader de filtrado */
        .filter-loader {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            padding: 16px 24px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            display: flex;
            align-items: center;
            gap: 12px;
            z-index: 100;
            opacity: 0;
            transition: opacity 0.2s ease;
            pointer-events: none;
        }
        .filter-loader.visible {
            opacity: 1;
        }
        .filter-loader .spinner {
            width: 20px;
            height: 20px;
            border: 3px solid #f0f0f0;
            border-top-color: #F66623;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @@keyframes spin {
            to { transform: rotate(360deg); }
        }
        /* Card seleccionada */
        .card-selected {
            box-shadow: 0 0 0 2px #F66623, 0 12px 40px rgba(246,102,35,0.2) !important;
        }
        /* Animación de entrada para cards */
        .negocio-card {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.4s ease-out forwards;
        }
        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        /* Delay escalonado para cada card */
        .negocio-card:nth-child(1) { animation-delay: 0.05s; }
        .negocio-card:nth-child(2) { animation-delay: 0.1s; }
        .negocio-card:nth-child(3) { animation-delay: 0.15s; }
        .negocio-card:nth-child(4) { animation-delay: 0.2s; }
        .negocio-card:nth-child(5) { animation-delay: 0.25s; }
        .negocio-card:nth-child(6) { animation-delay: 0.3s; }
        /* Transición suave del grid */
        #negocios-grid {
            transition: opacity 0.3s ease;
        }
        /* Contador con animación */
        #contador-negocios {
            transition: all 0.3s ease;
        }
    </style>
</head>

<body class="bg-[#f7f7f7]">

    <!-- Skeleton Loader Moderno -->
    <div id="skeleton-principal">
        <div class="flex h-screen">
            <div class="w-full lg:w-[58%] p-6 space-y-8 overflow-hidden">
                <!-- Categorías skeleton -->
                <div class="flex gap-4 overflow-hidden">
                    @for(int i = 0; i < 8; i++)
                    {
                        <div class="flex-shrink-0 w-20">
                            <div class="w-14 h-14 mx-auto rounded-xl shimmer"></div>
                            <div class="h-3 w-16 mx-auto mt-2 rounded shimmer"></div>
                        </div>
                    }
                </div>
                <!-- Cards skeleton -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    @for(int i = 0; i < 4; i++)
                    {
                        <div class="bg-white rounded-2xl overflow-hidden shadow-sm">
                            <div class="aspect-[4/3] shimmer"></div>
                            <div class="p-4 space-y-3">
                                <div class="h-4 w-3/4 rounded shimmer"></div>
                                <div class="h-3 w-1/2 rounded shimmer"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="hidden lg:block lg:w-[42%] shimmer"></div>
        </div>
    </div>

    <!-- Contenido Principal -->
    <div id="content-principal" class="hidden">
        @{
            string? permisos = HttpContextAccessor.HttpContext?.Session.GetString("permisos");
            var bannerInicio = ViewBag.BannerInicio as IEnumerable<dynamic> ?? new List<object>();
            var horizontales = bannerInicio.Where(b => (string)b.Formato == "16:9").Select(b => (string)b.Url ?? "/images/default.webp").ToList();
            var cuadrados = bannerInicio.Where(b => (string)b.Formato == "1:1").Select(b => (string)b.Url ?? "/images/default.webp").Take(2).ToList();
            var imgIzquierda = cuadrados.ElementAtOrDefault(0) ?? "/images/lateral1.webp";
            var imgDerecha = cuadrados.ElementAtOrDefault(1) ?? "/images/lateral2.webp";
            var primeraHorizontal = horizontales.FirstOrDefault() ?? "/images/default.webp";
        }

        <!-- Layout Principal Estilo Airbnb -->
        <div class="flex min-h-screen">

            <!-- Panel Izquierdo: Contenido (58%) -->
            <div id="content-panel" class="w-full lg:w-[58%] overflow-y-auto bg-[#f7f7f7]">

                <!-- Barra de Categorías Sticky -->
                <div class="sticky top-0 z-20 bg-white border-b border-gray-100">
                    <div class="max-w-5xl mx-auto px-4 py-3">
                        <div class="flex items-center gap-6 overflow-x-auto categories-scroll">
                            @foreach (var categoria in Model)
                            {
                                <form method="post" action="@Url.Action("Consultar", "Negocios")" class="flex-shrink-0">
                                    <input type="hidden" name="idCategoria" value="@categoria.Id" />
                                    <button type="submit" class="group flex flex-col items-center gap-1 px-1 py-2 border-b-2 border-transparent hover:border-gray-900 transition-all">
                                        <div class="w-6 h-6 flex items-center justify-center opacity-60 group-hover:opacity-100 transition-opacity">
                                            <img src="@(categoria.Imagen?.Base64 ?? "/images/default.webp")" alt="@categoria.Nombre" class="w-full h-full object-contain">
                                        </div>
                                        <span class="text-[11px] font-medium text-gray-500 group-hover:text-gray-900 whitespace-nowrap transition-colors">@categoria.Nombre</span>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>

                <!-- Header con Contador -->
                <div class="max-w-5xl mx-auto px-4 pt-6 pb-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <h1 class="text-2xl font-bold text-gray-900">
                                <span id="contador-negocios" class="text-[#F66623]">0</span> negocios
                            </h1>
                            <p class="text-sm text-gray-500 mt-1">en el área del mapa</p>
                        </div>
                        <button onclick="resetearFiltros()" class="flex items-center gap-2 px-4 py-2 rounded-full border border-gray-300 hover:border-gray-900 hover:shadow-md transition-all text-sm font-medium">
                            <i class="fas fa-sliders-h"></i>
                            Filtros
                        </button>
                    </div>
                </div>

                <!-- Grid de Negocios Estilo Airbnb -->
                <div class="max-w-5xl mx-auto px-4 pb-8">
                    <div id="negocios-grid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
                        <!-- Se llena dinámicamente -->
                    </div>

                    <!-- Empty State -->
                    <div id="no-negocios-msg" class="hidden py-20 text-center">
                        <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-gray-100 flex items-center justify-center">
                            <i class="fas fa-map-marker-alt text-4xl text-gray-300"></i>
                        </div>
                        <h3 class="text-xl font-semibold text-gray-900 mb-2">No hay negocios en esta área</h3>
                        <p class="text-gray-500 max-w-sm mx-auto">Prueba moviendo el mapa o haciendo zoom para explorar otras zonas</p>
                        <button onclick="resetearFiltros()" class="mt-6 px-6 py-3 bg-[#F66623] text-white rounded-lg font-medium hover:bg-[#e55a1a] transition-colors">
                            Ver todos los negocios
                        </button>
                    </div>
                </div>

                <!-- Separador -->
                <div class="border-t border-gray-200"></div>

                <!-- Ofertas Flash -->
                @{
                    var ofertas = (ViewBag.OfertasFlash as IEnumerable<dynamic>)?.Where(o => o.Estado == 1).Take(4);
                }
                @if (ofertas != null && ofertas.Any())
                {
                    <section class="max-w-5xl mx-auto px-4 py-10">
                        <div class="flex items-center justify-between mb-6">
                            <div>
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="px-3 py-1 bg-red-500 text-white text-xs font-bold rounded-full floating-badge">
                                        <i class="fas fa-bolt mr-1"></i>FLASH
                                    </span>
                                </div>
                                <h2 class="text-xl font-bold text-gray-900">Ofertas por tiempo limitado</h2>
                            </div>
                            <a href="@Url.Action("ConsultarTodo", "OfertasFlash")" class="text-sm font-semibold text-gray-900 hover:underline flex items-center gap-1">
                                Ver todas <i class="fas fa-arrow-right text-xs"></i>
                            </a>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            @foreach (var oferta in ofertas)
                            {
                                <a href="@Url.Action("ConsultarProductos", "Negocios", new { idLocal = oferta.IdLocal })" class="group block">
                                    <div class="bg-white rounded-2xl overflow-hidden shadow-sm card-hover">
                                        <div class="relative aspect-[16/9] overflow-hidden">
                                            <img src="@oferta.ImagenProductoOfertaFlash" alt="Oferta" class="w-full h-full object-cover img-zoom">
                                            <div class="absolute inset-0 gradient-overlay"></div>
                                            <div class="absolute bottom-3 left-3 right-3">
                                                <p class="text-white font-bold text-lg line-clamp-1">@oferta?.Titulo</p>
                                                <p class="text-white/80 text-sm">@oferta?.NombreLocal</p>
                                            </div>
                                            <div class="absolute top-3 right-3 bg-red-500 text-white px-3 py-1.5 rounded-lg text-sm font-bold shadow-lg">
                                                <i class="fas fa-clock mr-1"></i>
                                                <span class="countdown-timer" data-expiration="@oferta?.TiempoOferta?.ToString("yyyy-MM-ddTHH:mm:ss")">--:--</span>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    </section>
                }

                <!-- Separador -->
                <div class="border-t border-gray-200"></div>

                <!-- Banner Promocional -->
                <section class="max-w-5xl mx-auto px-4 py-10">
                    <div class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-[#23916A] to-[#1a6b4f]">
                        <div class="absolute inset-0 opacity-10">
                            <div class="absolute top-0 right-0 w-96 h-96 bg-white rounded-full -translate-y-1/2 translate-x-1/2"></div>
                            <div class="absolute bottom-0 left-0 w-64 h-64 bg-white rounded-full translate-y-1/2 -translate-x-1/2"></div>
                        </div>
                        <div class="relative flex flex-col lg:flex-row items-center p-8 lg:p-12">
                            <div class="flex-1 text-center lg:text-left mb-6 lg:mb-0">
                                <span class="inline-block px-4 py-1 bg-white/20 rounded-full text-white text-sm font-medium mb-4">
                                    <i class="fas fa-store mr-2"></i>¿Tienes un negocio?
                                </span>
                                <h2 class="text-3xl lg:text-4xl font-bold text-white mb-3">Únete a Abastecete</h2>
                                <p class="text-white/80 text-lg mb-6 max-w-md">Miles de clientes están buscando proveedores como tú</p>
                                <a href="/Login" class="inline-flex items-center gap-2 px-6 py-3 bg-[#F66623] text-white rounded-xl font-semibold hover:bg-[#e55a1a] transition-all hover:shadow-lg hover:-translate-y-0.5">
                                    Registrar mi negocio
                                    <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                            <div class="lg:w-80">
                                <img src="/images/mujer.png" alt="Únete" class="max-h-64 object-contain drop-shadow-2xl">
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Mejores Proveedores -->
                <section class="max-w-5xl mx-auto px-4 py-10">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-xl font-bold text-gray-900">Proveedores destacados</h2>
                        <a href="@Url.Action("Listar", "Categorias")" class="text-sm font-semibold text-gray-900 hover:underline flex items-center gap-1">
                            Ver todos <i class="fas fa-arrow-right text-xs"></i>
                        </a>
                    </div>
                    <div id="providers-list" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4"></div>
                </section>

                <!-- Footer espaciado -->
                <div class="h-20 lg:hidden"></div>

            </div>
            <!-- Fin Panel Izquierdo -->

            <!-- Panel Derecho: Mapa (42%) -->
            <div id="map-panel" class="hidden lg:block lg:w-[42%] fixed right-0 pr-4 transition-all duration-200">
                <div class="map-container relative w-full h-full shadow-xl border border-gray-200 bg-white">
                    <div id="map" class="w-full h-full"></div>

                    <!-- Loader de filtrado -->
                    <div id="filter-loader" class="filter-loader">
                        <div class="spinner"></div>
                        <span class="text-sm font-medium text-gray-700">Actualizando...</span>
                    </div>

                    <!-- Contador de negocios en el mapa -->
                    <div class="absolute top-4 left-4 bg-white/95 backdrop-blur-sm rounded-full px-4 py-2 shadow-lg flex items-center gap-2">
                        <div class="w-3 h-3 bg-[#F66623] rounded-full animate-pulse"></div>
                        <span class="text-sm font-semibold text-gray-800"><span id="map-counter">0</span> negocios</span>
                    </div>

                    <!-- Controles del mapa -->
                    <div class="absolute top-4 right-4 flex flex-col gap-2">
                        <button onclick="map.setZoom(map.getZoom() + 1)" class="w-10 h-10 bg-white/95 backdrop-blur-sm rounded-xl shadow-lg flex items-center justify-center hover:bg-white hover:scale-105 transition-all">
                            <i class="fas fa-plus text-gray-700"></i>
                        </button>
                        <button onclick="map.setZoom(map.getZoom() - 1)" class="w-10 h-10 bg-white/95 backdrop-blur-sm rounded-xl shadow-lg flex items-center justify-center hover:bg-white hover:scale-105 transition-all">
                            <i class="fas fa-minus text-gray-700"></i>
                        </button>
                    </div>

                    <!-- Botones de control -->
                    <div class="absolute bottom-4 right-4 flex flex-col gap-2">
                        <button onclick="centrarMapa()" class="bg-white/95 backdrop-blur-sm rounded-xl px-4 py-2.5 shadow-lg flex items-center gap-2 hover:bg-white hover:shadow-xl transition-all text-sm font-medium">
                            <i class="fas fa-location-crosshairs text-[#F66623]"></i>
                            Mi ubicación
                        </button>
                        <button onclick="verTodosNegocios()" class="bg-white/95 backdrop-blur-sm rounded-xl px-4 py-2.5 shadow-lg flex items-center gap-2 hover:bg-white hover:shadow-xl transition-all text-sm font-medium">
                            <i class="fas fa-store text-[#23916A]"></i>
                            Ver todos
                        </button>
                    </div>

                    <!-- Leyenda -->
                    <div class="absolute bottom-4 left-4 bg-white/95 backdrop-blur-sm rounded-xl px-3 py-2 shadow-lg">
                        <div class="flex items-center gap-3 text-xs">
                            <div class="flex items-center gap-1.5">
                                <div class="w-4 h-4 rounded-full bg-[#F66623] border-2 border-white shadow"></div>
                                <span class="text-gray-600">Negocio</span>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <div class="w-4 h-4 rounded-full bg-[#23916A] border-2 border-white shadow"></div>
                                <span class="text-gray-600">Seleccionado</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botón Mapa Móvil -->
            <button id="btn-ver-mapa-mobile" onclick="abrirMapaModal()"
                class="lg:hidden fixed bottom-6 left-1/2 -translate-x-1/2 bg-gray-900 text-white rounded-full px-6 py-3 shadow-2xl z-50 flex items-center gap-2 hover:bg-gray-800 transition-all">
                <i class="fas fa-map"></i>
                <span class="font-medium">Mapa</span>
            </button>

        </div>

        <!-- Modal Mapa Móvil -->
        <div id="modal-mapa" class="fixed inset-0 z-[9999] hidden lg:hidden">
            <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="cerrarMapaModal()"></div>
            <div class="absolute inset-x-0 bottom-0 h-[85vh] bg-white rounded-t-3xl overflow-hidden shadow-2xl flex flex-col animate-slide-up">
                <div class="flex items-center justify-between p-4 border-b">
                    <h3 class="font-bold text-lg">Explorar en el mapa</h3>
                    <button onclick="cerrarMapaModal()" class="w-10 h-10 rounded-full hover:bg-gray-100 flex items-center justify-center transition-colors">
                        <i class="fas fa-times text-gray-600"></i>
                    </button>
                </div>
                <div id="map-mobile" class="flex-1"></div>
            </div>
        </div>

        <style>
            @@keyframes slide-up {
                from { transform: translateY(100%); }
                to { transform: translateY(0); }
            }
            .animate-slide-up {
                animation: slide-up 0.3s ease-out;
            }
        </style>

    </div>

    <!-- Scripts -->
    <script>
        // Variables globales
        let map, mapMobile;
        let markers = [], markersMobile = [];
        let negocios = @Html.Raw(ViewBag.NegociosJson ?? "[]");
        let negociosFiltrados = [...negocios];
        let negocioResaltado = null;
        let infoWindow = null;

        // Inicialización
        document.addEventListener('DOMContentLoaded', function() {
            console.log('=== DEBUG NEGOCIOS ===');
            console.log('Cantidad de negocios:', negocios.length);
            console.log('Datos:', JSON.stringify(negocios, null, 2));

            setTimeout(() => {
                document.getElementById('skeleton-principal').classList.add('hidden');
                document.getElementById('content-principal').classList.remove('hidden');
                renderizarNegocios(negocios);
                inicializarProveedores();
                ajustarPosicionMapa(); // Posicionar mapa inicialmente
            }, 400);

            // Escuchar scroll para ajustar mapa antes del footer
            window.addEventListener('scroll', ajustarPosicionMapa);
            window.addEventListener('resize', ajustarPosicionMapa);
        });

        // Ajustar posición del mapa para que no pase del header ni del footer
        function ajustarPosicionMapa() {
            const mapPanel = document.getElementById('map-panel');
            if (!mapPanel || window.innerWidth < 1024) return;

            // Obtener el header
            const header = document.querySelector('header#header, header, nav.fixed');
            const headerHeight = header ? header.getBoundingClientRect().bottom : 90;

            // Buscar el footer (bg-gray-900 es la clase del footer)
            const footer = document.querySelector('footer.bg-gray-900, footer, .mt-10.bg-gray-900');

            const viewportHeight = window.innerHeight;

            // El mapa empieza después del header con margen
            const mapTop = Math.max(headerHeight + 12, 100);

            // Calcular bottom basado en si el footer es visible
            let mapBottom = 20; // Por defecto 20px del borde inferior

            if (footer) {
                const footerRect = footer.getBoundingClientRect();
                // Si el footer está visible en el viewport
                if (footerRect.top < viewportHeight) {
                    // El mapa debe terminar antes del footer
                    mapBottom = viewportHeight - footerRect.top + 20;
                }
            }

            // Aplicar estilos
            mapPanel.style.top = mapTop + 'px';
            mapPanel.style.bottom = mapBottom + 'px';

            // Verificar que el mapa tenga altura mínima razonable
            const mapHeight = viewportHeight - mapTop - mapBottom;
            if (mapHeight < 200) {
                mapPanel.style.opacity = '0';
                mapPanel.style.pointerEvents = 'none';
            } else {
                mapPanel.style.opacity = '1';
                mapPanel.style.pointerEvents = 'auto';
            }
        }

        // Google Maps
        function initMap() {
            const center = { lat: 1.6144, lng: -75.6062 };

            map = new google.maps.Map(document.getElementById('map'), {
                center: center,
                zoom: 13,
                styles: getMapStyles(),
                mapTypeControl: false,
                streetViewControl: false,
                fullscreenControl: false,
                zoomControl: false
            });

            infoWindow = new google.maps.InfoWindow();
            agregarMarcadores(map, markers);
            map.addListener('idle', () => filtrarConDebounce(map));

            if (negocios.length > 0) {
                ajustarZoom(map);
            }
        }

        function initMapMobile() {
            if (mapMobile) return;

            mapMobile = new google.maps.Map(document.getElementById('map-mobile'), {
                center: map?.getCenter() || { lat: 1.6144, lng: -75.6062 },
                zoom: map?.getZoom() || 13,
                styles: getMapStyles(),
                mapTypeControl: false,
                streetViewControl: false,
                fullscreenControl: false
            });

            agregarMarcadores(mapMobile, markersMobile);
            mapMobile.addListener('idle', () => filtrarConDebounce(mapMobile));
        }

        // Debounce para suavizar el filtrado
        let filtroTimeout = null;
        function filtrarConDebounce(mapInstance) {
            if (filtroTimeout) clearTimeout(filtroTimeout);

            // Mostrar loader
            const loader = document.getElementById('filter-loader');
            if (loader) loader.classList.add('visible');

            filtroTimeout = setTimeout(() => {
                filtrarPorAreaVisible(mapInstance);
                // Ocultar loader después de un momento
                setTimeout(() => {
                    if (loader) loader.classList.remove('visible');
                }, 300);
            }, 200);
        }

        function getMapStyles() {
            // Estilo por defecto con colores naturales, solo ocultamos POIs innecesarios
            return [
                { featureType: "poi.business", stylers: [{ visibility: "off" }] },
                { featureType: "poi.park", elementType: "labels.text", stylers: [{ visibility: "off" }] },
                { featureType: "transit", stylers: [{ visibility: "off" }] }
            ];
        }

        function agregarMarcadores(mapInstance, markersArray) {
            markersArray.forEach(m => m.setMap(null));
            markersArray.length = 0;

            let marcadoresCreados = 0;
            console.log('Negocios recibidos:', negocios);

            negocios.forEach((negocio, index) => {
                let lat = negocio.Latitud;
                let lng = negocio.Longitud;

                // Si no hay coordenadas, intentar parsear de Localizacion
                if ((!lat || !lng || lat === 0 || lng === 0) && negocio.Localizacion) {
                    const coordMatch = negocio.Localizacion.match(/(-?\d+\.?\d*)\s*,\s*(-?\d+\.?\d*)/);
                    if (coordMatch) {
                        lat = parseFloat(coordMatch[1]);
                        lng = parseFloat(coordMatch[2]);
                        console.log(`Coordenadas parseadas de Localizacion: ${lat}, ${lng}`);
                    }
                }

                console.log(`Negocio ${negocio.Nombre}: lat=${lat}, lng=${lng}`);

                // Solo crear marcador si tiene coordenadas válidas
                if (lat && lng && lat !== 0 && lng !== 0) {
                    const marker = new google.maps.Marker({
                        position: { lat: lat, lng: lng },
                        map: mapInstance,
                        title: negocio.Nombre,
                        icon: getMarkerIcon(false)
                    });

                    marker.negocioId = negocio.Id;
                    marker.negocioData = negocio;

                    marker.addListener('click', () => {
                        mostrarInfoWindow(marker, negocio, mapInstance);
                        resaltarNegocio(negocio.Id);
                    });

                    marker.addListener('mouseover', () => {
                        if (negocioResaltado !== negocio.Id) {
                            marker.setIcon(getMarkerIcon(true));
                            marker.setZIndex(1000);
                        }
                    });

                    marker.addListener('mouseout', () => {
                        if (negocioResaltado !== negocio.Id) {
                            marker.setIcon(getMarkerIcon(false));
                            marker.setZIndex(1);
                        }
                    });

                    markersArray.push(marker);
                    marcadoresCreados++;
                }
            });

            // Actualizar contador en el mapa
            const mapCounter = document.getElementById('map-counter');
            if (mapCounter) {
                mapCounter.textContent = marcadoresCreados;
            }

            console.log(`Total marcadores creados: ${marcadoresCreados}`);
        }

        function getMarkerIcon(isActive) {
            const color = isActive ? '#23916A' : '#F66623';
            const size = isActive ? 50 : 42;

            // Pin clásico estilo Google Maps
            const svg = `
                <svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}" viewBox="0 0 48 48">
                    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
                        <feDropShadow dx="0" dy="2" stdDeviation="2" flood-opacity="0.3"/>
                    </filter>
                    <path filter="url(%23shadow)" d="M24 4C15.163 4 8 11.163 8 20c0 11 16 24 16 24s16-13 16-24c0-8.837-7.163-16-16-16z" fill="${color}"/>
                    <circle cx="24" cy="20" r="8" fill="white"/>
                    <circle cx="24" cy="20" r="4" fill="${color}"/>
                </svg>
            `;

            return {
                url: 'data:image/svg+xml,' + encodeURIComponent(svg),
                scaledSize: new google.maps.Size(size, size),
                anchor: new google.maps.Point(size/2, size)
            };
        }

        function mostrarInfoWindow(marker, negocio, mapInstance) {
            const content = `
                <div style="padding: 8px; max-width: 200px;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <img src="${negocio.Imagen}" style="width: 48px; height: 48px; border-radius: 8px; object-fit: cover;">
                        <div>
                            <p style="margin: 0; font-weight: 600; font-size: 14px;">${negocio.Nombre}</p>
                            <p style="margin: 4px 0 0; font-size: 12px; color: #666;">${negocio.Localizacion || ''}</p>
                        </div>
                    </div>
                    <a href="/Negocios/ConsultarProductos?idLocal=${negocio.Id}"
                       style="display: block; margin-top: 10px; padding: 8px; background: #F66623; color: white; text-align: center; border-radius: 8px; text-decoration: none; font-size: 13px; font-weight: 500;">
                        Ver productos
                    </a>
                </div>
            `;
            infoWindow.setContent(content);
            infoWindow.open(mapInstance, marker);
        }

        function ajustarZoom(mapInstance) {
            const bounds = new google.maps.LatLngBounds();
            let hasValid = false;

            negocios.forEach(n => {
                if (n.Latitud && n.Longitud && n.Latitud !== 0 && n.Longitud !== 0) {
                    bounds.extend({ lat: n.Latitud, lng: n.Longitud });
                    hasValid = true;
                }
            });

            if (hasValid) mapInstance.fitBounds(bounds);
        }

        function filtrarPorAreaVisible(mapInstance) {
            const bounds = mapInstance.getBounds();
            if (!bounds) return;

            // Filtrar negocios que están dentro del área visible del mapa
            negociosFiltrados = negocios.filter(n => {
                let lat = n.Latitud;
                let lng = n.Longitud;

                // Si no hay coordenadas, intentar parsear de Localizacion
                if ((!lat || !lng || lat === 0 || lng === 0) && n.Localizacion) {
                    const coordMatch = n.Localizacion.match(/(-?\d+\.?\d*)\s*,\s*(-?\d+\.?\d*)/);
                    if (coordMatch) {
                        lat = parseFloat(coordMatch[1]);
                        lng = parseFloat(coordMatch[2]);
                    }
                }

                // Si no tiene coordenadas válidas, no mostrar
                if (!lat || !lng || lat === 0 || lng === 0) return false;

                // Verificar si está dentro del área visible
                return bounds.contains({ lat: lat, lng: lng });
            });

            renderizarNegocios(negociosFiltrados);

            // Actualizar contador del mapa
            const mapCounter = document.getElementById('map-counter');
            if (mapCounter) {
                mapCounter.textContent = negociosFiltrados.length;
            }

            // También actualizar visibilidad de marcadores
            markers.forEach(marker => {
                const pos = marker.getPosition();
                const isVisible = bounds.contains(pos);
                marker.setVisible(isVisible);
            });
        }

        // Formatear ubicación - si son coordenadas, mostrar "Florencia, Caquetá"
        function formatearUbicacion(ubicacion) {
            if (!ubicacion) return 'Florencia, Caquetá';
            // Si parece ser coordenadas (ej: "1.6143,-75.6062"), mostrar ubicación genérica
            if (/^-?\d+\.?\d*\s*,\s*-?\d+\.?\d*$/.test(ubicacion.trim())) {
                return 'Florencia, Caquetá';
            }
            return ubicacion;
        }

        // Renderizar cards estilo Airbnb con transición suave
        function renderizarNegocios(lista) {
            const grid = document.getElementById('negocios-grid');
            const noMsg = document.getElementById('no-negocios-msg');
            const contador = document.getElementById('contador-negocios');

            // Animar el contador
            contador.textContent = lista.length;

            if (lista.length === 0) {
                // Fade out del grid antes de ocultarlo
                grid.style.opacity = '0';
                setTimeout(() => {
                    grid.classList.add('hidden');
                    noMsg.classList.remove('hidden');
                    noMsg.style.opacity = '0';
                    setTimeout(() => noMsg.style.opacity = '1', 50);
                }, 200);
                return;
            }

            noMsg.classList.add('hidden');
            grid.classList.remove('hidden');

            // Fade out -> actualizar -> fade in
            grid.style.opacity = '0.3';

            setTimeout(() => {
                grid.innerHTML = lista.map(negocio => `
                <div id="negocio-${negocio.Id}"
                     class="negocio-card group cursor-pointer card-hover"
                     onclick="verNegocio(${negocio.Id})"
                     onmouseenter="resaltarMarcador(${negocio.Id})"
                     onmouseleave="quitarResaltadoMarcador(${negocio.Id})">

                    <!-- Imagen -->
                    <div class="relative aspect-[4/3] rounded-xl overflow-hidden bg-gray-100">
                        <img src="${negocio.Imagen}" alt="${negocio.Nombre}"
                             class="w-full h-full object-cover img-zoom"
                             onerror="this.src='/images/default.webp'">

                        <!-- Badge verificado -->
                        <div class="absolute top-3 left-3 bg-white/95 backdrop-blur-sm rounded-full px-2.5 py-1 flex items-center gap-1.5 shadow-sm">
                            <i class="fas fa-check-circle text-[#23916A] text-xs"></i>
                            <span class="text-xs font-medium">Verificado</span>
                        </div>

                        <!-- Favorito -->
                        <button onclick="event.stopPropagation()" class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/80 hover:bg-white flex items-center justify-center transition-all hover:scale-110">
                            <i class="far fa-heart text-gray-700"></i>
                        </button>
                    </div>

                    <!-- Info -->
                    <div class="pt-3">
                        <div class="flex items-start justify-between gap-2">
                            <h3 class="font-semibold text-gray-900 truncate">${negocio.Nombre}</h3>
                            <div class="flex items-center gap-1 flex-shrink-0">
                                <i class="fas fa-star text-xs"></i>
                                <span class="text-sm font-medium">5.0</span>
                            </div>
                        </div>
                        <p class="text-gray-500 text-sm mt-0.5 truncate">
                            <i class="fas fa-map-marker-alt text-[#F66623] text-xs mr-1"></i>
                            ${formatearUbicacion(negocio.Localizacion)}
                        </p>
                        <p class="text-gray-900 text-sm mt-1.5">
                            <span class="font-semibold">Ver catálogo</span>
                        </p>
                    </div>
                </div>
            `).join('');

                // Fade in después de actualizar
                requestAnimationFrame(() => {
                    grid.style.opacity = '1';
                });
            }, 100);
        }

        function resaltarNegocio(id) {
            negocioResaltado = id;

            document.querySelectorAll('.negocio-card').forEach(c => c.classList.remove('card-selected'));

            const card = document.getElementById(`negocio-${id}`);
            if (card) {
                card.classList.add('card-selected');
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            markers.forEach(m => {
                m.setIcon(getMarkerIcon(m.negocioId === id));
                if (m.negocioId === id) m.setZIndex(1000);
            });
        }

        function resaltarMarcador(id) {
            markers.forEach(m => {
                if (m.negocioId === id) {
                    m.setIcon(getMarkerIcon(true));
                    m.setZIndex(1000);
                }
            });
        }

        function quitarResaltadoMarcador(id) {
            if (negocioResaltado === id) return;
            markers.forEach(m => {
                if (m.negocioId === id) {
                    m.setIcon(getMarkerIcon(false));
                    m.setZIndex(1);
                }
            });
        }

        function verNegocio(id) {
            window.location.href = `/Negocios/ConsultarProductos?idLocal=${id}`;
        }

        function resetearFiltros() {
            negocioResaltado = null;
            renderizarNegocios(negocios);
            if (map) ajustarZoom(map);
            if (infoWindow) infoWindow.close();
        }

        function verTodosNegocios() {
            if (map && markers.length > 0) {
                ajustarZoom(map);
            } else if (map) {
                // Si no hay marcadores, centrar en Florencia
                map.setCenter({ lat: 1.6144, lng: -75.6062 });
                map.setZoom(13);
            }
        }

        let userMarker = null;

        function centrarMapa() {
            if (!navigator.geolocation) {
                alert('Tu navegador no soporta geolocalización');
                return;
            }

            // Mostrar loading en el botón
            const btn = document.querySelector('[onclick="centrarMapa()"]');
            const originalContent = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin text-[#F66623]"></i> Ubicando...';
            btn.disabled = true;

            navigator.geolocation.getCurrentPosition(
                (position) => {
                    const userLocation = {
                        lat: position.coords.latitude,
                        lng: position.coords.longitude
                    };

                    console.log('Ubicación del usuario:', userLocation);

                    // Centrar mapa en la ubicación del usuario
                    if (map) {
                        map.setCenter(userLocation);
                        map.setZoom(15);

                        // Agregar o actualizar marcador del usuario
                        if (userMarker) {
                            userMarker.setPosition(userLocation);
                        } else {
                            userMarker = new google.maps.Marker({
                                position: userLocation,
                                map: map,
                                title: 'Tu ubicación',
                                icon: {
                                    url: 'data:image/svg+xml,' + encodeURIComponent(`
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                                            <circle cx="12" cy="12" r="10" fill="#4285F4" stroke="white" stroke-width="3"/>
                                            <circle cx="12" cy="12" r="4" fill="white"/>
                                        </svg>
                                    `),
                                    scaledSize: new google.maps.Size(24, 24),
                                    anchor: new google.maps.Point(12, 12)
                                },
                                zIndex: 999
                            });
                        }
                    }

                    // Restaurar botón
                    btn.innerHTML = originalContent;
                    btn.disabled = false;
                },
                (error) => {
                    console.error('Error de geolocalización:', error);
                    let mensaje = 'No se pudo obtener tu ubicación';
                    switch(error.code) {
                        case error.PERMISSION_DENIED:
                            mensaje = 'Permiso de ubicación denegado. Actívalo en la configuración del navegador.';
                            break;
                        case error.POSITION_UNAVAILABLE:
                            mensaje = 'Ubicación no disponible';
                            break;
                        case error.TIMEOUT:
                            mensaje = 'Tiempo de espera agotado';
                            break;
                    }
                    alert(mensaje);

                    // Restaurar botón
                    btn.innerHTML = originalContent;
                    btn.disabled = false;
                },
                {
                    enableHighAccuracy: true,
                    timeout: 10000,
                    maximumAge: 0
                }
            );
        }

        // Modal mapa
        function abrirMapaModal() {
            document.getElementById('modal-mapa').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
            setTimeout(() => initMapMobile(), 100);
        }

        function cerrarMapaModal() {
            document.getElementById('modal-mapa').classList.add('hidden');
            document.body.style.overflow = '';
        }

        // Proveedores
        function inicializarProveedores() {
            const providers = JSON.parse('@Html.Raw(ViewBag.LocalesAleatoriosJson)');
            const container = document.getElementById("providers-list");
            const DEFAULT_IMAGE = "/images/Logo2.jpg";

            for (let i = 0; i < Math.min(4, providers.length || 4); i++) {
                const provider = providers[i] || { Nombre: "Tu negocio aquí", imagen: { Base64: DEFAULT_IMAGE } };
                const isPlaceholder = !providers[i];

                const card = document.createElement("div");
                card.className = "group cursor-pointer";
                card.onclick = () => {
                    if (isPlaceholder) window.location.href = "/Login";
                    else window.location.href = `/Negocios/ConsultarProductos?idLocal=${provider.Id}`;
                };

                card.innerHTML = `
                    <div class="relative aspect-square rounded-xl overflow-hidden bg-gray-100 card-hover">
                        <img src="${provider.imagen?.Base64 || DEFAULT_IMAGE}" alt="${provider.Nombre}"
                             class="w-full h-full object-cover img-zoom">
                        ${!isPlaceholder ? `
                            <div class="absolute top-2 right-2 w-6 h-6 rounded-full bg-[#23916A] flex items-center justify-center">
                                <i class="fas fa-check text-white text-xs"></i>
                            </div>
                        ` : ''}
                    </div>
                    <p class="mt-2 font-medium text-sm text-gray-900 truncate">${provider.Nombre}</p>
                    <p class="text-xs text-gray-500">${isPlaceholder ? 'Regístrate' : 'Proveedor verificado'}</p>
                `;

                container.appendChild(card);
            }
        }

        // Temporizadores
        function actualizarContadores() {
            document.querySelectorAll(".countdown-timer").forEach(timer => {
                const exp = new Date(timer.dataset.expiration).getTime();
                const now = Date.now();
                const left = exp - now;

                if (left > 0) {
                    const h = Math.floor(left / 3600000);
                    const m = Math.floor((left % 3600000) / 60000);
                    const s = Math.floor((left % 60000) / 1000);
                    timer.textContent = `${h}h ${m}m ${s}s`;
                } else {
                    timer.textContent = "Expirado";
                }
            });
        }
        setInterval(actualizarContadores, 1000);
        actualizarContadores();
    </script>

    <!-- Google Maps API -->
    <script async defer src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&callback=initMap"></script>

</body>
</html>
