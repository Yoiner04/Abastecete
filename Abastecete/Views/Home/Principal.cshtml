@using BusinessLogic.Utilidades
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model List<BusinessLogic.Models.Categoria>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Abastecete.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>

<body>
    @{
        string permisos = HttpContextAccessor.HttpContext.Session.GetString("permisos");
    }
    <!-- IMAGENES CON CARRUSEL -->
    <section class="hero-section flex flex-col items-center gap-3 p-3 sm:p-5">
        <!-- Carrusel y dos imágenes -->
        <div class="flex w-full flex-col justify-between gap-3 sm:flex-row sm:gap-6">
            <!-- Carrusel -->
            <div class="relative h-[200px] flex-grow overflow-hidden rounded-lg sm:flex-grow-[2] sm:h-[250px] lg:h-[400px]">
                <img id="carouselImage" src="~/images/carrusel1.webp" alt="Carrusel"
                     class="h-full w-full rounded-lg object-cover transition-opacity duration-500">
                <button id="prevBtn"
                        class="absolute top-1/2 left-2 z-10 -translate-y-1/2 transform rounded-full bg-white px-2 py-1 text-black sm:left-3 sm:px-3 sm:py-2">
                    <svg class="h-6 w-6 text-gray-800" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 1 1 5l4 4" />
                    </svg>
                </button>
                <button id="nextBtn"
                        class="absolute top-1/2 right-2 z-10 -translate-y-1/2 transform rounded-full bg-white px-2 py-1 text-black sm:right-3 sm:px-3 sm:py-2">
                    <svg class="h-6 w-6 text-gray-800" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4" />
                    </svg>
                </button>
            </div>
            <div class="flex h-[200px] w-full flex-col gap-2 sm:flex-col sm:w-[200px] sm:h-[250px] lg:w-[250px] lg:h-[400px]">
                <div class="h-1/2 flex-1">
                    <img src="/images/lateral1.webp?t=@DateTime.Now.Ticks" alt="Imagen 1" class="h-full w-full rounded-lg object-cover">
                </div>
                <div class="h-1/2 flex-1">
                    <img src="/images/lateral2.webp?t=@DateTime.Now.Ticks" alt="Imagen 2" class="h-full w-full rounded-lg object-cover">
                </div>
            </div>
        </div>
    </section>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const images = ["/images/carrusel1.webp", "/images/carrusel2.webp", "/images/carrusel3.webp"];
            let currentIndex = 0;
            const carouselImage = document.getElementById("carouselImage");
            const prevBtn = document.getElementById("prevBtn");
            const nextBtn = document.getElementById("nextBtn");

            function updateImage() {
                carouselImage.classList.add("opacity-0");
                setTimeout(() => {
                    carouselImage.src = images[currentIndex] + "?t=" + new Date().getTime(); // Evita caché
                    carouselImage.classList.remove("opacity-0");
                }, 300);
            }

            prevBtn.addEventListener("click", function () {
                currentIndex = (currentIndex - 1 + images.length) % images.length;
                updateImage();
            });

            nextBtn.addEventListener("click", function () {
                currentIndex = (currentIndex + 1) % images.length;
                updateImage();
            });

            // Cambio automático cada 5 segundos
            setInterval(() => {
                currentIndex = (currentIndex + 1) % images.length;
                updateImage();
            }, 5000);
        });
    </script>

    <!-- CATEGORÍAS (BURBUJAS) -->
    <section class="space-y-3 p-10" id="categories-container">
        <!-- Encabezado -->
        <div class="mb-4 flex items-center justify-between">
            <h2 class="pl-10 text-lg font-bold text-gray-800">Categorías</h2>
            <a href="@Url.Action("Listar", "Categorias")" class="flex items-center pr-10 text-sm font-medium text-gray-600 hover:text-gray-800">
                Ver todo <span class="ml-1">&gt;</span>
            </a>
        </div>

        @{
            // Filtrar categorías activas (Estado != 0)
            var categoriasActivas = Model.Where(c => c.Estado != 0).ToList();

            int totalCategorias = categoriasActivas.Count;
            int mitad = totalCategorias / 2;
            int primeraFila = (totalCategorias % 2 == 0) ? mitad : mitad + 1;
        }

        <!-- Primera Fila -->
        <div class="mb-6 flex flex-wrap justify-center gap-4">
            @for (int i = 0; i < primeraFila; i++)
            {
                <div class="flex w-[28%] flex-col items-center sm:w-[22%] md:w-[12%] lg:w-[12%]">
                    <div class="category aspect-square w-full bg-gray-200 shadow-lg">
                        <img src="@categoriasActivas[i].Imagen" alt="@categoriasActivas[i].Nombre" class="h-full w-full object-cover">
                    </div>
                    <p class="mt-2 text-center text-xs font-medium sm:text-sm">
                        @categoriasActivas[i].Nombre
                    </p>
                </div>
            }
        </div>

        <!-- Segunda Fila -->
        <div class="flex flex-wrap justify-center gap-4">
            @for (int i = primeraFila; i < totalCategorias; i++)
            {
                <div class="flex w-[28%] flex-col items-center sm:w-[22%] md:w-[12%] lg:w-[12%]">
                    <div class="category aspect-square w-full bg-gray-200 shadow-lg">
                        <img src="@categoriasActivas[i].Imagen" alt="@categoriasActivas[i].Nombre" class="h-full w-full object-cover">
                    </div>
                    <p class="mt-2 text-center text-xs font-medium sm:text-sm">
                        @categoriasActivas[i].Nombre
                    </p>
                </div>
            }
        </div>

    </section>

    <!-- OFERTAS FLASH -->
    <section class="off-section p-6 lg:p-10" id="ofertas-container">
        
        @{
            var ofertas = (ViewBag.OfertasFlash as IEnumerable<dynamic>)?.Where(o => o.Estado == 1).Take(6);
        }

        <!-- Encabezado -->
        <div class="mb-4 flex items-center justify-between">
            <h2 class="pl-10 text-lg font-bold text-gray-800">Ofertas flash: Por tiempo limitado</h2>
            @if (ofertas != null && ofertas.Any())
            {
                <a href="@Url.Action("ConsultarTodo", "OfertasFlash")" class="flex items-center pr-10 text-sm font-medium text-gray-600 hover:text-gray-800">
                    Ver todo <span class="ml-1">&gt;</span>
                </a>
            }
        </div>

        
        @if (ofertas != null && ofertas.Any())
        {

            <div id="offers-container" class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-3">
                @foreach (var oferta in ofertas)
                {
                    <div class="relative flex flex-col rounded-lg bg-white p-4 shadow-md">
                        <div class="relative aspect-square overflow-hidden rounded-md bg-gray-300">
                            <img src="@oferta.ImagenProductoOfertaFlash" alt="Imagen del Producto" class="absolute inset-0 h-full w-full object-cover">
                        </div>

                        <div class="border-2 absolute top-4 left-4 h-28 w-28 overflow-hidden rounded-full border-white shadow-md">
                            <img src="@oferta.FotoLocal" alt="Local" class="h-full w-full object-cover">

                        </div>

                        <!-- Información de la oferta -->
                        <div class="mt-4 text-center">
                            <h3 class="text-lg font-bold text-gray-800">
                                @oferta.Titulo <span class="text-gray-500">(@oferta.ProductoOfertaFlash)</span>
                            </h3>
                            <p class="text-gray-600">@oferta.Descripcion</p>
                            <p class="text-sm font-medium text-gray-500">📍 @oferta.NombreLocal</p>

                            <!-- Temporizador -->
                            <div class="mt-4">
                                <span class="font-semibold text-red-500">
                                    ⏳ Expira en <span class="countdown-timer" data-expiration="@oferta.TiempoOferta?.ToString("yyyy-MM-ddTHH:mm:ss")"></span>
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="mt-6 flex justify-center">
                <img src="~/images/sinofertas.jpg" alt="Sin Ofertas" class="h-auto w-full max-w-5xl rounded-lg shadow-md">
            </div>
        }

    </section>
    <script>
        function actualizarContadores() {
            document.querySelectorAll(".countdown-timer").forEach(timer => {
                const expirationTime = new Date(timer.dataset.expiration).getTime();
                const now = new Date().getTime();
                const timeLeft = expirationTime - now;

                if (timeLeft > 0) {
                    const hours = Math.floor(timeLeft / (1000 * 60 * 60));
                    const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
                    const seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);
                    timer.innerText = `${hours}h ${minutes}m ${seconds}s`;
                } else {
                    timer.innerText = "Expirado";
                }
            });
        }
        setInterval(actualizarContadores, 1000);
        actualizarContadores();
    </script>

    <!-- PROVEEDORES -->
    <section class="proovedores-section p-6 lg:p-10" style="background-color: #F4F1E9">
        <div class="mb-4 flex flex-col items-center justify-between lg:flex-row">
            <h2 class="pl-0 text-center text-lg font-bold text-gray-800 lg:text-left lg:pl-10">Mejores proveedores</h2>
            <a href="#" class="flex items-center pr-0 text-sm font-medium text-gray-600 hover:text-gray-800 lg:pr-10">
                Ver todo <span class="ml-1">&gt;</span>
            </a>
        </div>

        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3" id="providers-grid"></div>
    </section>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const providers = JSON.parse('@Html.Raw(ViewBag.LocalesAleatoriosJson)');

            const providersGrid = document.getElementById("providers-grid");

            const defaultImage = "/images/Logo2.jpg";
            const defaultText = "Acá podría estar tu local";
            const isSmallScreen = window.innerWidth < 1024;

            for (let i = 0; i < 7; i++) {
                const provider = providers[i] || { Nombre: defaultText, Logotipo: defaultImage };

                const card = document.createElement("div");

                if (i === 2) {
                    const highlightedSection = document.createElement("div");
                    highlightedSection.className = "rounded-xl flex flex-col lg:flex-row px-0 py-6 lg:col-span-1 lg:row-span-2 overflow-hidden";
                    highlightedSection.style.backgroundColor = "#23916A";

                    highlightedSection.innerHTML = `

            <div class="flex h-full w-full items-end justify-center lg:w-1/2">
                        <img src="/images/mujer.png" alt="Imagen de mujer" class="h-auto w-full object-contain">
            </div>
            <div class="mt-4 flex w-full flex-col justify-center px-6 text-center lg:w-1/2 lg:text-start lg:mt-0">
                <h3 class="mb-2 text-base font-bold text-white lg:text-xl">Encuentra mejores proveedores</h3>
                <p class="mb-4 text-lg leading-tight font-bold text-white lg:text-3xl">ABASTECE TU<br>NEGOCIO YA</p>
                <button class="mx-auto mt-3 rounded-full px-4 py-2 text-sm text-white lg:text-base lg:px-5 lg:mx-0" style="background-color: #F66623">
                    Ver más
                </button>
            </div>
        `;

                    providersGrid.appendChild(highlightedSection);
                }


                if (isSmallScreen && i > 1 && i > 3) return;

                const isPlaceholder = provider.Nombre === defaultText;
                const buttonText = isPlaceholder ? "Registrarme" : "Ver Ahora";
                const buttonArrow = isPlaceholder ? "" : " &rarr;";

                card.className = "bg-white rounded-xl shadow-md p-4 lg:p-6 flex items-center gap-4 col-span-1";

                card.innerHTML = `
                        <img src="${provider.Logotipo || defaultImage}" alt="${provider.Nombre}" class="h-16 w-16 rounded-xl lg:w-20 lg:h-20">
                        <div>
                            <h3 class="text-sm font-bold text-gray-600 lg:text-lg">${provider.Nombre || defaultText}</h3>
                            <p class="text-base text-black lg:text-xl">${isPlaceholder ? "¡Anímate a unirte!" : "PROVEEDOR VERIFICADO"}</p>
                            <button class="mt-3 rounded-full px-3 py-1 text-xs text-white lg:text-sm lg:px-4"
                                style="background-color: ${i % 2 === 0 ? "#23916A" : "#F66623"}">
                                ${buttonText}${buttonArrow}
                            </button>
                        </div>
                    `;

                providersGrid.appendChild(card);
            }
        });
    </script>

    <!-- CARRUSEL DE LOCALES -->
    <section class="relative bg-[#23916A] p-10">
        <div id="carousel" class="relative mx-auto w-full max-w-screen-xl" data-carousel="slide">
            <!-- Contenedor del Carrusel -->
            <div id="carousel-wrapper" class="relative w-full overflow-hidden">
                <div id="carousel-container" class="flex gap-3 transition-transform duration-700 ease-in-out">
                    @if (ViewBag.Negocios != null && ViewBag.Negocios.Count > 0)
                    {
                        var negociosList = (List<BusinessLogic.Models.Negocio>)ViewBag.Negocios;
                        var negociosDuplicados = negociosList.Concat(negociosList).ToList();

                        @foreach (var negocio in negociosDuplicados)
                        {
                            <div class="card flex h-[20rem] w-1/3 flex-none flex-col justify-between rounded-lg bg-gray-200 shadow-md sm:w-full sm:h-[22rem] md:w-1/3">
                                <div class="flex h-72 items-center justify-center pt-4">
                                    <img src="@negocio.Logotipo" alt="@negocio.Nombre"
                                         class="size-full rounded-full border border-gray-300 object-contain shadow-sm" />
                                </div>
                                <div class="rounded-b-lg bg-white py-2 text-center">
                                    <p class="text-sm font-bold text-gray-800">@negocio.Nombre</p>
                                    <p class="text-xs text-gray-600">@negocio.Localizacion</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-center text-lg text-white">⚠ No hay negocios registrados aún.</p>
                    }
                </div>
            </div>

            <!-- Botón Izquierdo -->
            <button type="button" class="absolute top-1/2 left-[-5rem] z-30 -translate-y-1/2 rounded-full bg-white/50 p-2 shadow-lg hover:bg-white/70"
                    style="pointer-events: auto;" data-carousel-prev>
                <svg class="h-6 w-6 text-gray-800" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 1 1 5l4 4" />
                </svg>
            </button>

            <!-- Botón Derecho -->
            <button type="button" class="absolute top-1/2 right-[-5rem] z-30 -translate-y-1/2 rounded-full bg-white/50 p-2 shadow-lg hover:bg-white/70"
                    style="pointer-events: auto;" data-carousel-next>
                <svg class="h-6 w-6 text-gray-800" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4" />
                </svg>
            </button>
        </div>
    </section>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const carouselContainer = document.getElementById('carousel-container');
            const prevButton = document.querySelector("[data-carousel-prev]");
            const nextButton = document.querySelector("[data-carousel-next]");
            const cards = carouselContainer.querySelectorAll(".card");

            let currentIndex = cards.length / 2;
            const cardWidth = cards[0].getBoundingClientRect().width + 16;
            const totalCards = cards.length;
            const visibleCards = 3;

            carouselContainer.style.transform = `translateX(${-currentIndex * cardWidth}px)`;

            function updateCarousel() {
                carouselContainer.style.transition = "transform 0.7s ease-in-out";
                const offset = -currentIndex * cardWidth;
                carouselContainer.style.transform = `translateX(${offset}px)`;
            }

            function checkLoop() {
                if (currentIndex === 0) {
                    setTimeout(() => {
                        carouselContainer.style.transition = "none";
                        currentIndex = totalCards / 2;
                        carouselContainer.style.transform = `translateX(${-currentIndex * cardWidth}px)`;
                    }, 700);
                } else if (currentIndex === totalCards - visibleCards) {
                    setTimeout(() => {
                        carouselContainer.style.transition = "none";
                        currentIndex = totalCards / 2 - visibleCards;
                        carouselContainer.style.transform = `translateX(${-currentIndex * cardWidth}px)`;
                    }, 700);
                }
            }

            function nextSlide() {
                currentIndex++;
                updateCarousel();
                checkLoop();
            }

            function prevSlide() {
                currentIndex--;
                updateCarousel();
                checkLoop();
            }

            function autoSlide() {
                nextSlide();
            }

            let interval = setInterval(autoSlide, 4000);

            nextButton.addEventListener("click", () => {
                clearInterval(interval);
                nextSlide();
                interval = setInterval(autoSlide, 4000);
            });

            prevButton.addEventListener("click", () => {
                clearInterval(interval);
                prevSlide();
                interval = setInterval(autoSlide, 4000);
            });
        });
    </script>

    <!-- DESCUENTOS -->
    <section id="discounts-section" class="discounts-section p-6 lg:p-10">
        <div class="mb-6 text-center lg:text-start">
            <h2 class="text-3xl font-bold text-[#F66623] lg:text-5xl">DESCUENTOS</h2>
            <h2 class="text-5xl font-bold text-[#23916A] lg:text-8xl">IMPERDIBLES</h2>
        </div>

        @for (int i = 0; i < categoriasActivas.Count; i++)
        {
            var categoriaNombre = categoriasActivas[i].Nombre;
            var rutaBase = $"/images/{categoriaNombre}/";
            var imagenPorDefecto = "/images/default.webp"; // Imagen por defecto

            <div class="mb-10 @(i % 2 == 0 ? "bg-white p-5" : "bg-[#A3D7C2] p-5")">
                <div class="mb-4 flex flex-col items-center justify-between lg:flex-row">
                    <h2 class="pl-0 text-center text-lg font-bold text-gray-800 lg:text-left lg:pl-10">
                        @categoriaNombre
                    </h2>
                    <a href="#" class="mt-2 flex items-center pr-0 text-sm font-medium text-gray-600 hover:text-gray-800 lg:pr-10 lg:mt-0">
                        Ver más
                        <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </a>
                </div>

                <!-- Rejilla de imágenes -->
                <div class="grid grid-cols-1 gap-4 lg:grid-cols-5">
                    <!-- Pantallas grandes -->
                    <img src="@($"{rutaBase}banner1.webp")" onerror="this.src='@imagenPorDefecto'" class="col-span-3 hidden h-60 w-full rounded-tl-3xl object-cover lg:block">
                    <img src="@($"{rutaBase}banner6.webp")" onerror="this.src='@imagenPorDefecto'" class="col-span-1 hidden h-60 w-full rounded-tl-3xl rounded-br-3xl object-cover lg:block">
                    <img src="@($"{rutaBase}banner3.webp")" onerror="this.src='@imagenPorDefecto'" class="col-span-1 hidden h-60 w-full rounded-tl-3xl rounded-br-3xl object-cover lg:block">
                    <img src="@($"{rutaBase}banner4.webp")" onerror="this.src='@imagenPorDefecto'" class="col-span-1 hidden h-60 w-full object-cover lg:block">
                    <img src="@($"{rutaBase}banner5.webp")" onerror="this.src='@imagenPorDefecto'" class="col-span-1 hidden h-60 w-full object-cover lg:block">
                    <img src="@($"{rutaBase}banner2.webp")" onerror="this.src='@imagenPorDefecto'" class="col-span-3 hidden h-60 w-full object-cover lg:block">

                    <!-- Pantallas pequeñas -->
                    <img src="@($"{rutaBase}banner1.webp")" onerror="this.src='@imagenPorDefecto'" class="block h-16 w-full rounded-tl-3xl object-cover lg:hidden">
                    <div class="block grid grid-cols-2 gap-4 lg:hidden">
                        <img src="@($"{rutaBase}banner4.webp")" onerror="this.src='@imagenPorDefecto'" class="h-32 w-full rounded-tl-3xl object-cover">
                        <img src="@($"{rutaBase}banner3.webp")" onerror="this.src='@imagenPorDefecto'" class="h-32 w-full rounded-br-3xl object-cover">
                    </div>
                    <img src="@($"{rutaBase}banner2.webp")" onerror="this.src='@imagenPorDefecto'" class="block h-16 w-full rounded-br-3xl object-cover lg:hidden">
                    <div class="block grid grid-cols-2 gap-4 lg:hidden">
                        <img src="@($"{rutaBase}banner5.webp")" onerror="this.src='@imagenPorDefecto'" class="h-32 w-full rounded-tl-3xl object-cover">
                        <img src="@($"{rutaBase}banner6.webp")" onerror="this.src='@imagenPorDefecto'" class="h-32 w-full rounded-br-3xl object-cover">
                    </div>
                </div>
            </div>
        }
    </section>

</body>
</html>