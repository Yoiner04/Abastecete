@using BusinessLogic.Utilidades
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model List<BusinessLogic.Models.Categoria>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Abastecete.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>

<body>
    @{
        string permisos = HttpContextAccessor.HttpContext.Session.GetString("permisos");
    }
    <!-- IMAGENES CON CARRUSEL -->
    <section class="hero-section flex flex-col items-center p-3 sm:p-5 gap-3">

        @if (permisos != null && RolPermisos.TienePermiso("Administrar Banners", permisos))
        {
            <div class="w-full flex justify-start mb-3">
                @Html.Partial("BannerModal")
                <a onclick="abrirBannerModal()" class="bg-green-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-green-700
                    sm:px-2 sm:py-1 sm:text-xs
                    md:px-6 md:py-3 md:text-lg">
                    Editar Banners
                </a>
            </div>
        }

        <!-- Carrusel y dos imágenes -->
        <div class="flex flex-col sm:flex-row justify-between w-full gap-3 sm:gap-6">
            <!-- Carrusel -->
            <div class="flex-grow sm:flex-grow-[2] h-[200px] sm:h-[250px] lg:h-[400px] relative rounded-lg overflow-hidden">
                <img id="carouselImage" src="~/images/carrusel1.webp" alt="Carrusel"
                     class="w-full h-full object-cover rounded-lg transition-opacity duration-500">
                <button id="prevBtn"
                        class="absolute left-2 sm:left-3 top-1/2 transform -translate-y-1/2 bg-white text-black rounded-full px-2 sm:px-3 py-1 sm:py-2 z-10">
                    <svg class="w-6 h-6 text-gray-800" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 1 1 5l4 4" />
                    </svg>
                </button>
                <button id="nextBtn"
                        class="absolute right-2 sm:right-3 top-1/2 transform -translate-y-1/2 bg-white text-black rounded-full px-2 sm:px-3 py-1 sm:py-2 z-10">
                    <svg class="w-6 h-6 text-gray-800" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4" />
                    </svg>
                </button>
            </div>
            <div class="flex flex-col sm:flex-col gap-2 w-full sm:w-[200px] lg:w-[250px] h-[200px] sm:h-[250px] lg:h-[400px]">
                <div class="flex-1 h-1/2">
                    <img src="/images/lateral1.webp?t=@DateTime.Now.Ticks" alt="Imagen 1" class="w-full h-full object-cover rounded-lg">
                </div>
                <div class="flex-1 h-1/2">
                    <img src="/images/lateral2.webp?t=@DateTime.Now.Ticks" alt="Imagen 2" class="w-full h-full object-cover rounded-lg">
                </div>
            </div>
        </div>
    </section>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const images = ["/images/carrusel1.webp", "/images/carrusel2.webp", "/images/carrusel3.webp"];
            let currentIndex = 0;
            const carouselImage = document.getElementById("carouselImage");
            const prevBtn = document.getElementById("prevBtn");
            const nextBtn = document.getElementById("nextBtn");

            function updateImage() {
                carouselImage.classList.add("opacity-0");
                setTimeout(() => {
                    carouselImage.src = images[currentIndex] + "?t=" + new Date().getTime(); // Evita caché
                    carouselImage.classList.remove("opacity-0");
                }, 300);
            }

            prevBtn.addEventListener("click", function () {
                currentIndex = (currentIndex - 1 + images.length) % images.length;
                updateImage();
            });

            nextBtn.addEventListener("click", function () {
                currentIndex = (currentIndex + 1) % images.length;
                updateImage();
            });

            // Cambio automático cada 5 segundos
            setInterval(() => {
                currentIndex = (currentIndex + 1) % images.length;
                updateImage();
            }, 5000);
        });
    </script>

    <!-- CATEGORÍAS (BURBUJAS) -->
    <section class="p-10 space-y-3" id="categories-container">
        <!-- Encabezado -->
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-bold text-gray-800 pl-10">Categorías</h2>
            <a href="@Url.Action("Consultar", "Negocios")" class="text-sm pr-10 font-medium text-gray-600 hover:text-gray-800 flex items-center">
                Ver todo <span class="ml-1">&gt;</span>
            </a>
        </div>

        @{
            // Filtrar categorías activas (Estado != 0)
            var categoriasActivas = Model.Where(c => c.Estado != 0).ToList();

            int totalCategorias = categoriasActivas.Count;
            int mitad = totalCategorias / 2;
            int primeraFila = (totalCategorias % 2 == 0) ? mitad : mitad + 1;
        }

        <!-- Primera Fila -->
        <div class="flex flex-wrap justify-center gap-4 sm:space-x-6 mb-6">
            @for (int i = 0; i < primeraFila; i++)
            {
                <div class="flex flex-col items-center">
                    <div class="category rounded-full w-20 h-20 sm:w-24 sm:h-24 md:w-32 md:h-32 lg:w-40 lg:h-40 bg-gray-300 overflow-hidden shadow-lg">
                        <img src="@categoriasActivas[i].Imagen" alt="@categoriasActivas[i].Nombre" class="w-full h-full object-cover">
                    </div>
                    <p class="text-center mt-2 text-xs sm:text-sm font-medium">@categoriasActivas[i].Nombre</p>
                </div>
            }
        </div>

        <!-- Segunda Fila -->
        <div class="flex flex-wrap justify-center gap-4 sm:space-x-6">
            @for (int i = primeraFila; i < totalCategorias; i++)
            {
                <div class="flex flex-col items-center">
                    <div class="category rounded-full w-20 h-20 sm:w-24 sm:h-24 md:w-32 md:h-32 lg:w-40 lg:h-40 bg-gray-300 overflow-hidden shadow-lg">
                        <img src="@categoriasActivas[i].Imagen" alt="@categoriasActivas[i].Nombre" class="w-full h-full object-cover">
                    </div>
                    <p class="text-center mt-2 text-xs sm:text-sm font-medium">@categoriasActivas[i].Nombre</p>
                </div>
            }
        </div>
    </section>

    <!-- OFERTAS FLASH -->
    <section class="off-section p-6 lg:p-10" id="ofertas-container">
        <div class="flex flex-col lg:flex-row justify-between items-center mb-4">
            <!-- Título y Temporizador -->
            <div class="flex items-center gap-3 pl-0 lg:pl-10 mb-4 lg:mb-0">
                <h2 class="text-lg font-bold text-gray-800">Ofertas Flash</h2>
                <span class="bg-green-600 text-white px-3 py-1 rounded-full text-xs lg:text-sm font-medium">
                    05 : 02 : 00
                </span>
            </div>

            <!-- Enlace Ver Todo -->
            <a href="#" class="text-sm pr-0 lg:pr-10 font-medium text-gray-600 hover:text-gray-800 flex items-center">
                Ver todo <span class="ml-1">&gt;</span>
            </a>
        </div>

        <div id="offers-container" class="grid grid-cols-1 lg:grid-cols-3 gap-6"></div>
    </section>

    <script>
        const offers = [
            { name: "PAPA PASTUSA 50 KG", oldPrice: "$60", newPrice: "$50", available: 30, sold: 30, progress: 30, bgColor: "bg-green-100", image: "/css/Images/papa.jpg" },
            { name: "Cerveza X 6 LATA DORADA", oldPrice: "$1500", newPrice: "$1400", available: 99, sold: 1, progress: 1, bgColor: "bg-orange-200", image: "/css/Images/lata.jpg" },
            { name: "TOMATE UVALINA 500 gr", oldPrice: "$300", newPrice: "$200", available: 100, sold: 199, progress: 199, bgColor: "bg-green-100", image: "/css/Images/tomate.jpg" },
            { name: "YOGURT NATURAL 1L", oldPrice: "$250", newPrice: "$200", available: 80, sold: 50, progress: 62, bgColor: "bg-orange-200", image: "/css/Images/yogurt.jpeg" },
            { name: "CAFÉ PREMIUM 500g", oldPrice: "$400", newPrice: "$350", available: 20, sold: 15, progress: 75, bgColor: "bg-green-100", image: "/css/Images/cafe.jpeg" },
            { name: "ARROZ EXTRA 25KG", oldPrice: "$100", newPrice: "$90", available: 50, sold: 10, progress: 20, bgColor: "bg-orange-200", image: "/css/Images/arroz.jpg" }
        ];

        const offersContainer = document.getElementById("offers-container");

        const renderOffers = () => {
            offersContainer.innerHTML = ""; // Limpiar contenedor antes de renderizar

            const maxOffers = window.innerWidth < 768 ? 4 : offers.length;

            offers.slice(0, maxOffers).forEach((offer) => {
                const card = document.createElement("div");
                card.className = `${offer.bgColor} p-4 rounded-lg shadow-md flex flex-col lg:flex-row items-center lg:items-start`;

                card.innerHTML = `
                    <div class="relative w-24 h-32 lg:w-32 lg:h-48 flex-shrink-0 overflow-hidden rounded-md bg-gray-300">
                        <img src="${offer.image}" alt="${offer.name}" class="absolute inset-0 w-full h-full object-cover">
                    </div>
                    <div class="text-center lg:text-left lg:ml-4">
                        <h3 class="text-sm lg:text-lg font-bold text-gray-800 mb-1">${offer.name}</h3>
                        <p class="text-xs lg:text-sm text-gray-500 line-through">${offer.oldPrice}</p>
                        <p class="text-sm lg:text-lg text-green-600 font-bold mb-2">${offer.newPrice}</p>
                        <p class="text-xs lg:text-sm text-gray-600">Disponible: <span class="text-green-600 font-bold">${offer.available}</span></p>
                        <div class="flex flex-col lg:flex-row items-center lg:justify-between gap-2 mt-4">
                            <button class="bg-orange-500 text-white px-4 py-2 rounded-full text-xs lg:text-sm hover:bg-orange-600">
                                Ver Ahora
                            </button>
                            <button class="text-gray-500 hover:text-gray-800"❤️</button>
                        </div>
                        <div class="relative mt-2">
                            <div class="w-full bg-gray-200 h-2 rounded-full overflow-hidden">
                                <div class="bg-orange-500 h-2" style="width: ${offer.progress}%;"></div>
                            </div>
                            <p class="text-xs text-gray-500 mt-1">${offer.sold} vendidos</p>
                        </div>
                    </div>
                `;

                offersContainer.appendChild(card);
            });
        };

        // Renderizar ofertas al cargar la página y ajustar dinámicamente en `resize`
        renderOffers();
        window.addEventListener("resize", renderOffers);
    </script>

    <!-- PROVEEDORES -->
    <section class="proovedores-section p-6 lg:p-10" style="background-color: #F4F1E9">
        <div class="flex flex-col lg:flex-row justify-between items-center mb-4">
            <h2 class="text-lg font-bold text-gray-800 text-center lg:text-left pl-0 lg:pl-10">Mejores proveedores</h2>
            <a href="#" class="text-sm font-medium text-gray-600 hover:text-gray-800 flex items-center pr-0 lg:pr-10">
                Ver todo <span class="ml-1">&gt;</span>
            </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6" id="providers-grid"></div>
    </section>
    <script>
        const providers = [
            { name: "MERCA FRUVER", category: "FRUTAS Y VERDURAS", image: "/images/aa.jpg", buttonColor: "#23916A" },
            { name: "LICORERIA MANOLO", category: "BEBIDAS", image: "/images/provider2.jpg", buttonColor: "#F66623" },
            { name: "CATCH BIG", category: "DESPENSA", image: "/images/provider3.jpg", buttonColor: "#F66623" },
            { name: "RAPICUNDI", category: "MERCADO", image: "/images/provider4.jpg", buttonColor: "#23916A" },
            { name: "SUPER CARNES", category: "CARNES", image: "/images/provider5.jpg", buttonColor: "#23916A" },
            { name: "LACTEOMANIA", category: "LÁCTEOS", image: "/images/provider6.jpg", buttonColor: "#F66623" }
        ];

        const providersGrid = document.getElementById("providers-grid");

        const isSmallScreen = window.innerWidth < 1024;

        providers.forEach((provider, index) => {
            const card = document.createElement("div");

            if (index === 2) {
                const highlightedSection = document.createElement("div");
                highlightedSection.className = "rounded-xl flex flex-col lg:flex-row items-center py-6 px-6 lg:row-span-2 lg:col-span-1";
                highlightedSection.style.backgroundColor = "#23916A";

                highlightedSection.innerHTML = `
                    <img src="/images/a.png" alt="Imagen de mujer" class="w-40 lg:w-72 h-40 lg:h-72">
                    <div class="mt-4 lg:mt-0 lg:ml-6 text-center lg:text-left">
                        <h3 class="text-white text-base lg:text-xl font-bold mb-2">Encuentra mejores proveedores</h3>
                        <p class="text-white text-lg lg:text-3xl font-bold mb-4 leading-tight">ABASTECE TU NEGOCIO YA</p>
                        <button class="text-white text-sm lg:text-base px-4 lg:px-5 py-2 mt-3 rounded-full" style="background-color: #F66623">
                            Ver más
                        </button>
                    </div>
                `;
                providersGrid.appendChild(highlightedSection);
            }

            if (isSmallScreen && index > 1 && index > 3) return;

            card.className = "bg-white rounded-xl shadow-md p-4 lg:p-6 flex items-center gap-4 col-span-1";

            card.innerHTML = `
                <img src="${provider.image}" alt="${provider.name}" class="w-16 lg:w-20 h-16 lg:h-20 rounded-xl">
                <div>
                    <h3 class="text-sm lg:text-lg font-bold text-gray-600">${provider.name}</h3>
                    <p class="text-base lg:text-xl text-black">${provider.category}</p>
                    <button class="text-white text-xs lg:text-sm px-3 lg:px-4 py-1 mt-3 rounded-full" style="background-color: ${provider.buttonColor}">
                        Ver Ahora &rarr;
                    </button>
                </div>
            `;

            providersGrid.appendChild(card);

            if (!isSmallScreen && index === 5) {
                const additionalProvider = document.createElement("div");
                additionalProvider.className = "bg-white rounded-xl shadow-md p-4 lg:p-6 flex items-center gap-4 col-span-1";

                additionalProvider.innerHTML = `
                    <img src="/images/provider7.jpg" alt="NEW PROVIDER" class="w-16 lg:w-20 h-16 lg:h-20 rounded-xl">
                    <div>
                        <h3 class="text-sm lg:text-lg font-bold text-gray-600">NEW PROVIDER</h3>
                        <p class="text-base lg:text-xl text-black">NUEVO</p>
                        <button class="text-white text-xs lg:text-sm px-3 lg:px-4 py-1 mt-3 rounded-full" style="background-color: #23916A">
                            Ver Ahora &rarr;
                        </button>
                    </div>
                `;

                providersGrid.appendChild(additionalProvider);
            }
        });
    </script>

    <!-- CARRUSEL DE LOCALES -->
    <section class="p-10 bg-[#23916A] relative">
        <div id="carousel" class="relative w-full max-w-screen-xl mx-auto" data-carousel="slide">
            <!-- Contenedor del Carrusel -->
            <div id="carousel-wrapper" class="relative overflow-hidden w-full">
                <div id="carousel-container" class="flex gap-3 transition-transform duration-700 ease-in-out">
                    @if (ViewBag.Negocios != null && ViewBag.Negocios.Count > 0)
                    {
                        var negociosList = (List<BusinessLogic.Models.Negocio>)ViewBag.Negocios;
                        var negociosDuplicados = negociosList.Concat(negociosList).ToList();

                        @foreach (var negocio in negociosDuplicados)
                        {
                            <div class="card bg-gray-200 rounded-lg shadow-md flex flex-col justify-between flex-none w-1/3 h-[15rem] md:w-1/3 sm:w-full sm:h-[20rem]">
                                <div class="flex-1 bg-gray-300 rounded-t-lg bg-cover bg-center"
                                     style="background-image: url('@negocio.Logotipo')">
                                </div>
                                <div class="bg-white rounded-b-lg py-2 text-center">
                                    <p class="font-bold text-sm text-gray-800">@negocio.Nombre</p>
                                    <p class="text-xs text-gray-600">@negocio.Localizacion</p>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-center text-white text-lg">⚠ No hay negocios registrados aún.</p>
                    }
                </div>
            </div>

            <!-- Botón Izquierdo -->
            <button type="button" class="absolute top-1/2 left-[-5rem] z-30 -translate-y-1/2 bg-white/50 hover:bg-white/70 rounded-full p-2 shadow-lg"
                    style="pointer-events: auto;" data-carousel-prev>
                <svg class="w-6 h-6 text-gray-800" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 1 1 5l4 4" />
                </svg>
            </button>

            <!-- Botón Derecho -->
            <button type="button" class="absolute top-1/2 right-[-5rem] z-30 -translate-y-1/2 bg-white/50 hover:bg-white/70 rounded-full p-2 shadow-lg"
                    style="pointer-events: auto;" data-carousel-next>
                <svg class="w-6 h-6 text-gray-800" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4" />
                </svg>
            </button>
        </div>
    </section>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const carouselContainer = document.getElementById('carousel-container');
            const prevButton = document.querySelector("[data-carousel-prev]");
            const nextButton = document.querySelector("[data-carousel-next]");
            const cards = carouselContainer.querySelectorAll(".card");

            let currentIndex = cards.length / 2;
            const cardWidth = cards[0].getBoundingClientRect().width + 16;
            const totalCards = cards.length;
            const visibleCards = 3;

            carouselContainer.style.transform = `translateX(${-currentIndex * cardWidth}px)`;

            function updateCarousel() {
                carouselContainer.style.transition = "transform 0.7s ease-in-out";
                const offset = -currentIndex * cardWidth;
                carouselContainer.style.transform = `translateX(${offset}px)`;
            }

            function checkLoop() {
                if (currentIndex === 0) {
                    setTimeout(() => {
                        carouselContainer.style.transition = "none";
                        currentIndex = totalCards / 2;
                        carouselContainer.style.transform = `translateX(${-currentIndex * cardWidth}px)`;
                    }, 700);
                } else if (currentIndex === totalCards - visibleCards) {
                    setTimeout(() => {
                        carouselContainer.style.transition = "none";
                        currentIndex = totalCards / 2 - visibleCards;
                        carouselContainer.style.transform = `translateX(${-currentIndex * cardWidth}px)`;
                    }, 700);
                }
            }

            function nextSlide() {
                currentIndex++;
                updateCarousel();
                checkLoop();
            }

            function prevSlide() {
                currentIndex--;
                updateCarousel();
                checkLoop();
            }

            function autoSlide() {
                nextSlide();
            }

            let interval = setInterval(autoSlide, 4000);

            nextButton.addEventListener("click", () => {
                clearInterval(interval);
                nextSlide();
                interval = setInterval(autoSlide, 4000);
            });

            prevButton.addEventListener("click", () => {
                clearInterval(interval);
                prevSlide();
                interval = setInterval(autoSlide, 4000);
            });
        });
    </script>

    <!-- ULTIMAS PROMOCIONES -->
    <section class="hero-section flex flex-col items-center p-10 gap-5" id="promociones-container">
        <!-- Títulos y subtítulos -->
        <div class="w-full text-center lg:text-left">
            <h1 class="text-4xl lg:text-8xl font-bold" style="color: #23916A;">
                <span class="text-black">Nuestras</span> últimas promociones
            </h1>
            <p class="mt-1 text-gray-600 text-lg lg:text-2xl">
                Para que no gastes de más y conozcas a todos nuestros
                vendedores
            </p>
        </div>

        <!-- Botón y vendedor del mes -->
        <div class="flex flex-col lg:flex-row items-center w-full max-w-7xl mt-3 gap-6">
            <!-- Botón -->
            <button class="flex items-center justify-center gap-3 text-white px-6 py-3 lg:px-10 lg:py-4 rounded-full text-sm lg:text-lg font-bold shadow-md"
                    style="background-color: #23916A;">
                <i class="fas fa-shopping-cart text-xl lg:text-2xl"></i> Llévame ahí
            </button>

            <!-- Vendedor del mes -->
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 lg:w-16 lg:h-16 bg-gray-300 rounded-md flex items-center justify-center">
                    <img src="/images/vendedor-placeholder.png" alt="Imagen del vendedor"
                         class="w-10 h-10 lg:w-12 lg:h-12 object-cover rounded-md" />
                </div>
                <div class="text-center lg:text-left">
                    <p class="text-base lg:text-lg font-bold" style="color: #F66623;">Nuestro vendedor del mes</p>
                    <p class="text-yellow-500 text-sm lg:text-base font-medium">⭐ 4.8/5</p>
                    <p class="text-xs lg:text-sm text-gray-500">(1k+ reviews)</p>
                </div>
            </div>
        </div>

    </section>

    <!-- DESCUENTOS -->
    <section id="discounts-section" class="discounts-section p-6 lg:p-10">
        <div class="mb-6 text-center lg:text-start">
            <h2 class="text-3xl lg:text-5xl font-bold text-[#F66623]">DESCUENTOS</h2>
            <h2 class="text-5xl lg:text-8xl font-bold text-[#23916A]">IMPERDIBLES</h2>
        </div>

        @if (permisos != null && RolPermisos.TienePermiso("Administrar Banners", permisos))
        {
            <div class="w-full flex justify-start mb-3">
                @Html.Partial("CategoryBannerModal")
                <a onclick="abrirCategoryBannerModal()" class="bg-green-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-green-700
                sm:px-2 sm:py-1 sm:text-xs
                md:px-6 md:py-3 md:text-lg">
                    Editar Banners
                </a>
            </div>
        }

        @for (int i = 0; i < categoriasActivas.Count; i++)
        {
            var categoriaNombre = categoriasActivas[i].Nombre;
            var rutaBase = $"/images/{categoriaNombre}/";
            var imagenPorDefecto = "/images/default.webp"; // Imagen por defecto

            <div class="mb-10 @(i % 2 == 0 ? "bg-white p-5" : "bg-[#A3D7C2] p-5")">
                <div class="flex flex-col lg:flex-row justify-between items-center mb-4">
                    <h2 class="text-lg font-bold text-gray-800 text-center lg:text-left pl-0 lg:pl-10">
                        @categoriaNombre
                    </h2>
                    <a href="#" class="text-sm font-medium text-gray-600 hover:text-gray-800 flex items-center pr-0 lg:pr-10 mt-2 lg:mt-0">
                        Ver más
                        <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </a>
                </div>

                <!-- Rejilla de imágenes -->
                <div class="grid grid-cols-1 lg:grid-cols-5 gap-4">
                    <!-- Pantallas grandes -->
                    <img src="@($"{rutaBase}banner1.webp")" onerror="this.src='@imagenPorDefecto'" class="hidden lg:block rounded-tl-3xl h-60 col-span-3">
                    <img src="@($"{rutaBase}banner6.webp")" onerror="this.src='@imagenPorDefecto'" class="hidden lg:block rounded-tl-3xl rounded-br-3xl h-60 col-span-1">
                    <img src="@($"{rutaBase}banner3.webp")" onerror="this.src='@imagenPorDefecto'" class="hidden lg:block rounded-tl-3xl rounded-br-3xl h-60 col-span-1">
                    <img src="@($"{rutaBase}banner4.webp")" onerror="this.src='@imagenPorDefecto'" class="hidden lg:block h-60 col-span-1">
                    <img src="@($"{rutaBase}banner5.webp")" onerror="this.src='@imagenPorDefecto'" class="hidden lg:block h-60 col-span-1">
                    <img src="@($"{rutaBase}banner2.webp")" onerror="this.src='@imagenPorDefecto'" class="hidden lg:block h-60 col-span-3">

                    <!-- Pantallas pequeñas -->
                    <img src="@($"{rutaBase}banner1.webp")" onerror="this.src='@imagenPorDefecto'" class="block lg:hidden h-16 rounded-tl-3xl w-full object-cover">
                    <div class="block lg:hidden grid grid-cols-2 gap-4">
                        <img src="@($"{rutaBase}banner4.webp")" onerror="this.src='@imagenPorDefecto'" class="h-32 w-full object-cover rounded-tl-3xl">
                        <img src="@($"{rutaBase}banner3.webp")" onerror="this.src='@imagenPorDefecto'" class="h-32 w-full object-cover rounded-br-3xl">
                    </div>
                    <img src="@($"{rutaBase}banner2.webp")" onerror="this.src='@imagenPorDefecto'" class="block lg:hidden h-16 w-full object-cover rounded-br-3xl">
                    <div class="block lg:hidden grid grid-cols-2 gap-4">
                        <img src="@($"{rutaBase}banner5.webp")" onerror="this.src='@imagenPorDefecto'" class="h-32 w-full object-cover rounded-tl-3xl">
                        <img src="@($"{rutaBase}banner6.webp")" onerror="this.src='@imagenPorDefecto'" class="h-32 w-full object-cover rounded-br-3xl">
                    </div>
                </div>
            </div>
        }
    </section>

