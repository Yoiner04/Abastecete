@using BusinessLogic.Utilidades
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model List<BusinessLogic.Models.Categoria>

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Abastecete - Tu marketplace de confianza</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Abastecete.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <style>
        html {
            scroll-behavior: smooth;
        }
    </style>

</head>

<body class="bg-gray-50">

    @{
        string permisos = HttpContextAccessor.HttpContext.Session.GetString("permisos");

        var bannerInicio = ViewBag.BannerInicio as IEnumerable<dynamic> ?? new List<object>();

        var horizontales = bannerInicio
        .Where(b => (string)b.Formato == "16:9")
        .Select(b => (string)b.Url ?? "/images/default.webp")
        .ToList();

        var cuadrados = bannerInicio
        .Where(b => (string)b.Formato == "1:1")
        .Select(b => (string)b.Url ?? "/images/default.webp")
        .Take(2)
        .ToList();

        var imgIzquierda = cuadrados.ElementAtOrDefault(0) ?? "/images/lateral1.webp";
        var imgDerecha = cuadrados.ElementAtOrDefault(1) ?? "/images/lateral2.webp";

        var primeraHorizontal = horizontales.FirstOrDefault() ?? "/images/default.webp";
    }


    <!-- Hero Section Modernizada -->
    <section class="hero-section bg-gradient-to-b from-[#F4F1E9] to-gray-50 px-4 py-6 sm:px-6 lg:px-10">
        <div class="mx-auto max-w-7xl">
            <div class="flex w-full flex-col gap-4 sm:flex-row sm:gap-6">
                <!-- Carrusel Principal -->
                <div class="relative h-[220px] w-full overflow-hidden rounded-2xl shadow-xl sm:flex-grow-[2] sm:h-[280px] lg:h-[420px]">
                    <img id="carouselImage" src="@primeraHorizontal" alt="Carrusel"
                        class="h-full w-full object-cover transition-all duration-500" />

                    <!-- Overlay degradado -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>

                    <!-- Botón Anterior -->
                    <button id="prevBtn"
                        class="absolute top-1/2 left-3 z-10 -translate-y-1/2 transform rounded-full bg-white/90 p-2.5 shadow-lg backdrop-blur-sm transition-all duration-200 hover:bg-white hover:scale-110 hover:shadow-xl sm:left-4 sm:p-3">
                        <svg class="h-5 w-5 text-gray-700" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 1 1 5l4 4" />
                        </svg>
                    </button>

                    <!-- Botón Siguiente -->
                    <button id="nextBtn"
                        class="absolute top-1/2 right-3 z-10 -translate-y-1/2 transform rounded-full bg-white/90 p-2.5 shadow-lg backdrop-blur-sm transition-all duration-200 hover:bg-white hover:scale-110 hover:shadow-xl sm:right-4 sm:p-3">
                        <svg class="h-5 w-5 text-gray-700" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4" />
                        </svg>
                    </button>

                    <!-- Indicadores del carrusel -->
                    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2">
                        <span class="h-2 w-8 rounded-full bg-white/80"></span>
                        <span class="h-2 w-2 rounded-full bg-white/40"></span>
                        <span class="h-2 w-2 rounded-full bg-white/40"></span>
                    </div>
                </div>

                <!-- Imágenes laterales -->
                <div class="flex h-[180px] w-full gap-3 sm:flex-col sm:w-[200px] sm:h-[280px] lg:w-[280px] lg:h-[420px] lateral-full-mobile">
                    <div class="flex-1 overflow-hidden rounded-2xl shadow-lg transition-transform duration-300 hover:scale-[1.02]">
                        <img src="@imgIzquierda" alt="Imagen lateral 1" class="h-full w-full object-cover">
                    </div>
                    <div class="flex-1 overflow-hidden rounded-2xl shadow-lg transition-transform duration-300 hover:scale-[1.02]">
                        <img src="@imgDerecha" alt="Imagen lateral 2" class="h-full w-full object-cover">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const images = [
        @foreach (var img in horizontales)
                {
                    @Html.Raw($"\"{img}\",")
                }
            ];

            let currentIndex = 0;
            let isTransitioning = false;
            const carouselImage = document.getElementById("carouselImage");
            const prevBtn = document.getElementById("prevBtn");
            const nextBtn = document.getElementById("nextBtn");

            function updateImage() {
                if (isTransitioning || images.length === 0) return;

                isTransitioning = true;
                carouselImage.classList.add("opacity-0");

                setTimeout(() => {
                    carouselImage.src = images[currentIndex];
                }, 250);

                carouselImage.addEventListener("transitionend", () => {
                    carouselImage.classList.remove("opacity-0");
                    isTransitioning = false;
                }, { once: true });
            }

            prevBtn.addEventListener("click", function () {
                currentIndex = (currentIndex - 1 + images.length) % images.length;
                updateImage();
                resetInterval();
            });

            nextBtn.addEventListener("click", function () {
                currentIndex = (currentIndex + 1) % images.length;
                updateImage();
                resetInterval();
            });

            let interval = setInterval(() => {
                currentIndex = (currentIndex + 1) % images.length;
                updateImage();
            }, 5000);

            function resetInterval() {
                clearInterval(interval);
                interval = setInterval(() => {
                    currentIndex = (currentIndex + 1) % images.length;
                    updateImage();
                }, 5000);
            }
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            function ajustarAlturaLaterales() {
                if (window.innerWidth < 640) {
                    var carrusel = document.querySelector('.relative.h-\\[200px\\].w-full');
                    var laterales = document.querySelector('.lateral-full-mobile');
                    if (carrusel && laterales) {
                        laterales.style.height = carrusel.offsetHeight + "px";
                        var hijos = laterales.querySelectorAll('div');
                        hijos.forEach(function (hijo) {
                            hijo.style.height = "100%";
                        });
                    }
                } else {
                    var laterales = document.querySelector('.lateral-full-mobile');
                    if (laterales) {
                        laterales.style.height = "";
                        var hijos = laterales.querySelectorAll('div');
                        hijos.forEach(function (hijo) {
                            hijo.style.height = "";
                        });
                    }
                }
            }

            ajustarAlturaLaterales();
            window.addEventListener('resize', ajustarAlturaLaterales);
        });
    </script>

    <!-- Sección de Categorías Modernizada -->
    <section class="py-12 px-4 sm:px-6 lg:px-10 bg-gradient-to-b from-white to-gray-50" id="categories-container">
        <div class="mx-auto max-w-7xl">
            <!-- Encabezado de sección -->
            <div class="mb-10 flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#23916A] shadow-lg">
                        <i class="fas fa-th-large text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-2xl font-bold text-gray-800 sm:text-3xl">Explora por Categoría</h2>
                        <p class="text-sm text-gray-500">Encuentra lo que necesitas para tu negocio</p>
                    </div>
                </div>
                <a href="@Url.Action("Listar", "Categorias")"
                    class="group flex items-center gap-2 rounded-full bg-[#23916A] px-5 py-2.5 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-[#1d7a59] hover:shadow-lg hover:scale-105">
                    Ver todas
                    <i class="fas fa-arrow-right text-xs transition-transform duration-300 group-hover:translate-x-1"></i>
                </a>
            </div>

            <!-- Grid de categorías -->
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 sm:gap-6">
                @foreach (var categoria in Model)
                {
                    <form method="post" action="@Url.Action("Consultar", "Negocios")" class="group">
                        <input type="hidden" name="idCategoria" value="@categoria.Id" />
                        <button type="submit" class="flex w-full flex-col items-center">
                            <!-- Contenedor de imagen con efectos -->
                            <div class="relative mb-3 aspect-square w-full overflow-hidden rounded-2xl bg-white shadow-md transition-all duration-300 group-hover:shadow-2xl group-hover:-translate-y-2">
                                <!-- Borde animado -->
                                <div class="absolute inset-0 rounded-2xl border-2 border-transparent transition-all duration-300 group-hover:border-[#23916A]"></div>
                                <!-- Overlay en hover -->
                                <div class="absolute inset-0 bg-gradient-to-t from-[#23916A]/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100 rounded-2xl"></div>
                                <!-- Imagen -->
                                <div class="flex h-full w-full items-center justify-center p-3">
                                    <img src="@(categoria.Imagen?.Base64 ?? "/images/default.webp")" alt="@categoria.Nombre"
                                        class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-110">
                                </div>
                                <!-- Badge de hover -->
                                <div class="absolute bottom-2 left-1/2 -translate-x-1/2 transform opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:bottom-3">
                                    <span class="inline-flex items-center gap-1 rounded-full bg-[#23916A] px-3 py-1 text-xs font-semibold text-white shadow-lg">
                                        <i class="fas fa-eye text-[10px]"></i> Ver
                                    </span>
                                </div>
                            </div>
                            <!-- Nombre de categoría -->
                            <p class="text-center text-sm font-semibold text-gray-700 transition-all duration-300 group-hover:text-[#23916A] group-hover:font-bold sm:text-base">
                                @categoria.Nombre
                            </p>
                        </button>
                    </form>
                }
            </div>
        </div>
    </section>

    <!-- Sección de Ofertas Flash Modernizada -->
    <section class="bg-gradient-to-br from-[#F66623]/5 to-orange-50 py-12 px-4 sm:px-6 lg:px-10" id="ofertas-container">
        <div class="mx-auto max-w-7xl">
            @{
                var ofertas = (ViewBag.OfertasFlash as IEnumerable<dynamic>)?.Where(o => o.Estado == 1).Take(6);
            }

            <!-- Encabezado -->
            <div class="mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#F66623] shadow-lg">
                        <i class="fas fa-bolt text-xl text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-gray-800 sm:text-2xl">Ofertas Flash</h2>
                        <p class="text-sm text-gray-500">Por tiempo limitado</p>
                    </div>
                </div>
                @if (ofertas != null && ofertas.Any())
                {
                    <a href="@Url.Action("ConsultarTodo", "OfertasFlash")"
                        class="group flex items-center gap-1 rounded-full bg-[#F66623]/10 px-4 py-2 text-sm font-semibold text-[#F66623] transition-all duration-200 hover:bg-[#F66623] hover:text-white">
                        Ver todas
                        <i class="fas fa-arrow-right text-xs transition-transform duration-200 group-hover:translate-x-1"></i>
                    </a>
                }
            </div>

            @if (ofertas != null && ofertas.Any())
            {
                <div id="offers-container" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var oferta in ofertas)
                    {
                        <a href="@Url.Action("ConsultarProductos", "Negocios", new { idLocal = oferta.IdLocal })"
                            class="group block" title="Ver Local">
                            <div class="relative flex flex-col overflow-hidden rounded-2xl bg-white shadow-lg transition-all duration-300 group-hover:shadow-2xl group-hover:-translate-y-1">
                                <!-- Imagen del producto -->
                                <div class="relative aspect-[4/3] overflow-hidden bg-gray-100">
                                    <img src="@oferta.ImagenProductoOfertaFlash" alt="Imagen del Producto"
                                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110">

                                    <!-- Badge de oferta -->
                                    <div class="absolute top-3 right-3 rounded-full bg-[#F66623] px-3 py-1 text-xs font-bold text-white shadow-lg">
                                        <i class="fas fa-fire mr-1"></i> OFERTA
                                    </div>
                                </div>

                                <!-- Logo del local -->
                                <div class="absolute top-3 left-3 h-16 w-16 overflow-hidden rounded-xl border-2 border-white bg-white shadow-lg">
                                    @if (!string.IsNullOrWhiteSpace(oferta?.ImagenLocal?.Base64))
                                    {
                                        <img src="@oferta.ImagenLocal.Base64" alt="Local" class="h-full w-full object-cover">
                                    }
                                </div>

                                <!-- Información de la oferta -->
                                <div class="p-5">
                                    <h3 class="text-lg font-bold text-gray-800 line-clamp-1">
                                        @oferta.Titulo
                                    </h3>
                                    <p class="mt-1 text-sm text-[#F66623] font-semibold">@oferta.ProductoOfertaFlash</p>
                                    <p class="mt-2 text-sm text-gray-600 line-clamp-2">@oferta.Descripcion</p>

                                    <div class="mt-3 flex items-center gap-2 text-sm text-gray-500">
                                        <i class="fas fa-map-marker-alt text-[#23916A]"></i>
                                        <span>@oferta.NombreLocal</span>
                                    </div>

                                    <!-- Temporizador -->
                                    <div class="mt-4 flex items-center justify-between rounded-xl bg-red-50 px-4 py-2">
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-clock text-red-500"></i>
                                            <span class="text-sm font-semibold text-red-600">Expira en</span>
                                        </div>
                                        <span class="countdown-timer font-bold text-red-600"
                                            data-expiration="@oferta.TiempoOferta?.ToString("yyyy-MM-ddTHH:mm:ss")"></span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="mt-6 flex justify-center" id="galeriaOfertas">
                </div>
            }
        </div>
    </section>
    <script>
        function cargarBannersOfertas() {
            fetch("/Banners/ListarBannersOfertas")
                .then(response => response.json())
                .then(banners => {
                    const galeria = document.getElementById("galeriaOfertas");
                    galeria.innerHTML = "";

                    banners.forEach(banner => {
                        galeria.innerHTML += `
                                <img src="${banner.base64}" alt="${banner.nombre}" class="h-auto w-full max-w-5xl rounded-lg shadow-md">
                        `;
                    });
                })
                .catch(error => console.error("Error cargando banners:", error));
        }
        cargarBannersOfertas();
    </script>
    <script>
        function actualizarContadores() {
            document.querySelectorAll(".countdown-timer").forEach(timer => {
                const expirationTime = new Date(timer.dataset.expiration).getTime();
                const now = new Date().getTime();
                const timeLeft = expirationTime - now;

                if (timeLeft > 0) {
                    const hours = Math.floor(timeLeft / (1000 * 60 * 60));
                    const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
                    const seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);
                    timer.innerText = `${hours}h ${minutes}m ${seconds}s`;
                } else {
                    timer.innerText = "Expirado";
                }
            });
        }
        setInterval(actualizarContadores, 1000);
        actualizarContadores();
    </script>

    <!-- Sección de Mejores Proveedores Modernizada -->
    <section class="py-12 px-4 sm:px-6 lg:px-10" style="background-color: #F4F1E9">
        <div class="mx-auto max-w-7xl">
            <!-- Encabezado -->
            <div class="mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-[#23916A] shadow-lg">
                        <i class="fas fa-store text-xl text-white"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-gray-800 sm:text-2xl">Mejores Proveedores</h2>
                        <p class="text-sm text-gray-500">Verificados y confiables</p>
                    </div>
                </div>
                <a href="@Url.Action("Listar", "Categorias")"
                    class="group flex items-center gap-1 rounded-full bg-[#23916A]/10 px-4 py-2 text-sm font-semibold text-[#23916A] transition-all duration-200 hover:bg-[#23916A] hover:text-white">
                    Ver todos
                    <i class="fas fa-arrow-right text-xs transition-transform duration-200 group-hover:translate-x-1"></i>
                </a>
            </div>

            <div id="providers-grid">
                <div id="providers-highlighted" class="mb-8"></div>
                <div id="providers-list" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"></div>
            </div>
        </div>
    </section>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const providers = JSON.parse('@Html.Raw(ViewBag.LocalesAleatoriosJson)');
            const highlightedContainer = document.getElementById("providers-highlighted");
            const providersListContainer = document.getElementById("providers-list");

            const DEFAULT_IMAGE = "/images/Logo2.jpg";
            const DEFAULT_TEXT = "Acá podría estar tu local";

            const createProviderCard = (provider, index) => {
                const isPlaceholder = provider.Nombre === DEFAULT_TEXT;
                const buttonText = isPlaceholder ? "Registrarme" : "Ver Ahora";
                const buttonColor = index % 2 === 0 ? "bg-[#23916A] hover:bg-[#1d7a59]" : "bg-[#F66623] hover:bg-[#e55a1a]";
                const badgeColor = index % 2 === 0 ? "bg-[#23916A]/10 text-[#23916A]" : "bg-[#F66623]/10 text-[#F66623]";

                const card = document.createElement("div");
                card.className = "group bg-white rounded-2xl shadow-lg p-5 lg:p-6 flex flex-row items-center gap-5 transition-all duration-300 hover:shadow-xl hover:-translate-y-1";

                card.innerHTML = `
                    <div class="relative flex-shrink-0">
                        <img src="${provider.imagen?.Base64 || DEFAULT_IMAGE}" alt="${provider.Nombre}"
                            class="h-20 w-20 rounded-2xl object-contain border-2 border-gray-100 lg:w-24 lg:h-24 transition-transform duration-300 group-hover:scale-105">
                        ${!isPlaceholder ? '<div class="absolute -bottom-1 -right-1 flex h-6 w-6 items-center justify-center rounded-full bg-[#23916A] text-white shadow-md"><i class="fas fa-check text-xs"></i></div>' : ''}
                    </div>
                    <div class="flex flex-col justify-center flex-1 min-w-0">
                        <h3 class="text-base font-bold text-gray-800 lg:text-lg truncate">${provider.Nombre || DEFAULT_TEXT}</h3>
                        <span class="mt-1 inline-flex w-fit items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-semibold ${badgeColor}">
                            ${isPlaceholder ? '<i class="fas fa-rocket"></i> ¡Únete!' : '<i class="fas fa-shield-check"></i> Verificado'}
                        </span>
                        <button
                            class="proveedor-btn ${buttonColor} mt-3 rounded-full px-5 py-2.5 text-sm font-semibold text-white shadow-md transition-all duration-200 hover:shadow-lg flex items-center gap-2 w-fit"
                            data-id="${provider.Id || ''}"
                            data-placeholder="${isPlaceholder}">
                            ${buttonText}
                            <i class="fas fa-arrow-right text-xs"></i>
                        </button>
                    </div>
                `;
                return card;
            };

            const createHighlightedSection = () => {
                const highlighted = document.createElement("div");
                highlighted.className = "rounded-2xl flex flex-col lg:flex-row overflow-hidden bg-gradient-to-br from-[#23916A] to-[#1d7a59] shadow-xl";

                highlighted.innerHTML = `
                    <div class="flex h-[200px] w-full items-center justify-center sm:h-[260px] lg:h-auto lg:w-1/2 relative overflow-hidden">
                        <div class="absolute inset-0 bg-gradient-to-r from-transparent to-[#23916A]/30"></div>
                        <img src="/images/mujer.png" alt="Imagen de mujer" class="max-h-[280px] w-auto object-contain relative z-10 drop-shadow-2xl">
                    </div>
                    <div class="flex w-full flex-col justify-center px-8 py-8 lg:w-1/2 lg:py-12">
                        <span class="inline-flex w-fit items-center gap-2 rounded-full bg-white/20 px-4 py-1.5 text-sm font-medium text-white mb-4">
                            <i class="fas fa-star"></i> Únete a los mejores
                        </span>
                        <h3 class="text-xl font-bold text-white lg:text-2xl">Encuentra mejores proveedores</h3>
                        <p class="mt-2 text-3xl leading-tight font-extrabold text-white lg:text-5xl">ABASTECE TU<br>NEGOCIO YA</p>
                        <a href="/Categorias/Listar" class="mt-6 inline-block w-fit">
                            <button class="group flex items-center gap-2 rounded-full bg-[#F66623] px-6 py-3 text-base font-semibold text-white shadow-lg transition-all duration-200 hover:bg-[#e55a1a] hover:shadow-xl hover:scale-105">
                                Explorar proveedores
                                <i class="fas fa-arrow-right transition-transform duration-200 group-hover:translate-x-1"></i>
                            </button>
                        </a>
                    </div>
                `;
                return highlighted;
            };

            // Insertar contenido dinámico
            highlightedContainer.appendChild(createHighlightedSection());

            for (let i = 0; i < 6; i++) {
                const provider = providers[i] || { Nombre: DEFAULT_TEXT, imagen: { Base64: DEFAULT_IMAGE } };
                providersListContainer.appendChild(createProviderCard(provider, i));
            }

            // Delegar eventos en el contenedor
            document.getElementById("providers-grid").addEventListener("click", (e) => {
                if (e.target.classList.contains("proveedor-btn") || e.target.closest(".proveedor-btn")) {
                    const button = e.target.classList.contains("proveedor-btn") ? e.target : e.target.closest(".proveedor-btn");
                    const isPlaceholder = button.getAttribute("data-placeholder") === "true";
                    const id = button.getAttribute("data-id");

                    if (isPlaceholder) {
                        window.location.href = "/Login/Login";
                    } else {
                        window.location.href = `/Negocios/ConsultarProductos?idLocal=${id}`;
                    }
                }
            });
        });
    </script>


    <!-- Carrusel de Negocios Modernizado -->
    <section class="relative bg-gradient-to-br from-[#23916A] to-[#1d7a59] px-4 py-14 sm:px-6 lg:px-10">
        <!-- Decoración de fondo -->
        <div class="absolute inset-0 overflow-hidden">
            <div class="absolute -top-24 -right-24 h-64 w-64 rounded-full bg-white/5"></div>
            <div class="absolute -bottom-32 -left-32 h-96 w-96 rounded-full bg-white/5"></div>
        </div>

        <div class="relative mx-auto max-w-7xl">
            <!-- Título de sección -->
            <div class="mb-10 text-center">
                <h2 class="text-2xl font-bold text-white sm:text-3xl">Explora Nuestros Negocios</h2>
                <p class="mt-2 text-white/80">Descubre los mejores proveedores verificados</p>
            </div>

            <div id="carousel" class="relative" data-carousel="slide">
                <!-- Contenedor del Carrusel -->
                <div id="carousel-wrapper" class="overflow-hidden rounded-2xl px-4 sm:px-8">
                    <div id="carousel-container" class="flex gap-5 transition-transform duration-700 ease-in-out">
                        @if (ViewBag.Negocios != null && ViewBag.Negocios.Count > 0)
                        {
                            var negociosList = (List<BusinessLogic.Models.Negocio>)ViewBag.Negocios;
                            var negociosDuplicados = negociosList.Concat(negociosList).ToList();

                            @foreach (var negocio in negociosDuplicados)
                            {
                                <a href="@Url.Action("ConsultarProductos", "Negocios", new { idLocal = negocio.Id })"
                                    class="card group w-64 flex-none overflow-hidden rounded-2xl bg-white shadow-xl transition-all duration-300 hover:shadow-2xl hover:-translate-y-2 sm:w-72">
                                    <div class="flex flex-col items-center justify-center p-6">
                                        <div class="relative">
                                            <img src="@(negocio.imagen?.Base64 ?? "/images/default.webp")" alt="@negocio.Nombre"
                                                class="h-28 w-28 rounded-2xl border-4 border-gray-100 object-contain shadow-lg transition-transform duration-300 group-hover:scale-105 sm:h-32 sm:w-32" />
                                            <div class="absolute -bottom-2 -right-2 flex h-8 w-8 items-center justify-center rounded-full bg-[#23916A] text-white shadow-lg">
                                                <i class="fas fa-check text-sm"></i>
                                            </div>
                                        </div>
                                        <h3 class="mt-5 text-center text-base font-bold text-gray-800 group-hover:text-[#23916A] transition-colors duration-200">@negocio.Nombre</h3>
                                        <p class="mt-1 flex items-center gap-1 text-center text-sm text-gray-500">
                                            <i class="fas fa-map-marker-alt text-[#F66623] text-xs"></i>
                                            @negocio.Localizacion
                                        </p>
                                        <span class="mt-3 inline-flex items-center gap-1 rounded-full bg-[#23916A]/10 px-3 py-1 text-xs font-semibold text-[#23916A]">
                                            <i class="fas fa-eye"></i> Ver productos
                                        </span>
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="w-full rounded-2xl bg-white/10 p-8 text-center">
                                <i class="fas fa-store-slash text-4xl text-white/50 mb-3"></i>
                                <p class="text-lg text-white/80">No hay negocios registrados aún.</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Botones de navegación -->
                <button type="button"
                    class="absolute top-1/2 -left-3 z-10 -translate-y-1/2 rounded-full bg-white p-3 shadow-xl transition-all duration-200 hover:bg-gray-50 hover:scale-110 hover:shadow-2xl sm:-left-5"
                    data-carousel-prev>
                    <svg class="h-5 w-5 text-gray-700" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>

                <button type="button"
                    class="absolute top-1/2 -right-3 z-10 -translate-y-1/2 rounded-full bg-white p-3 shadow-xl transition-all duration-200 hover:bg-gray-50 hover:scale-110 hover:shadow-2xl sm:-right-5"
                    data-carousel-next>
                    <svg class="h-5 w-5 text-gray-700" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>
        </div>
    </section>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const carouselContainer = document.getElementById('carousel-container');
            const prevButton = document.querySelector("[data-carousel-prev]");
            const nextButton = document.querySelector("[data-carousel-next]");
            const cards = carouselContainer.querySelectorAll(".card");

            if (cards.length === 0) return;

            let currentIndex = cards.length / 2;
            const cardWidth = cards[0].getBoundingClientRect().width + 20;
            const totalCards = cards.length;
            const visibleCards = 3;

            carouselContainer.style.transform = `translateX(${-currentIndex * cardWidth}px)`;

            function updateCarousel() {
                carouselContainer.style.transition = "transform 0.7s ease-in-out";
                const offset = -currentIndex * cardWidth;
                carouselContainer.style.transform = `translateX(${offset}px)`;
            }

            function checkLoop() {
                if (currentIndex === 0) {
                    setTimeout(() => {
                        carouselContainer.style.transition = "none";
                        currentIndex = totalCards / 2;
                        carouselContainer.style.transform = `translateX(${-currentIndex * cardWidth}px)`;
                    }, 700);
                } else if (currentIndex === totalCards - visibleCards) {
                    setTimeout(() => {
                        carouselContainer.style.transition = "none";
                        currentIndex = totalCards / 2 - visibleCards;
                        carouselContainer.style.transform = `translateX(${-currentIndex * cardWidth}px)`;
                    }, 700);
                }
            }

            function nextSlide() {
                currentIndex++;
                updateCarousel();
                checkLoop();
            }

            function prevSlide() {
                currentIndex--;
                updateCarousel();
                checkLoop();
            }

            function autoSlide() {
                nextSlide();
            }

            let interval = setInterval(autoSlide, 4000);

            nextButton.addEventListener("click", () => {
                clearInterval(interval);
                nextSlide();
                interval = setInterval(autoSlide, 4000);
            });

            prevButton.addEventListener("click", () => {
                clearInterval(interval);
                prevSlide();
                interval = setInterval(autoSlide, 4000);
            });
        });
    </script>

    @{
        var imagenPorDefecto = "/images/default.webp";
    }

    <section class="discounts-section p-6 lg:p-10" id="categorias-container">
        <div class="mb-6 text-center lg:text-start">
            <h2 class="text-3xl font-bold text-[#F66623] lg:text-5xl">DESCUENTOS</h2>
            <h2 class="text-5xl font-bold text-[#23916A] lg:text-8xl">IMPERDIBLES</h2>
        </div>

        @foreach (var categoria in Model)
        {
            var categoriaNombre = categoria.Nombre;
            var bannersCat = ViewBag.BannersPorCategoria[categoriaNombre] as IEnumerable<dynamic> ?? new List<object>();

            var horizontal = bannersCat.Where(b => (string)b.Formato == "16:9").Select(b => (string)b.Url ?? imagenPorDefecto).ToList();
            var cuadrado = bannersCat.Where(b => (string)b.Formato == "1:1").Select(b => (string)b.Url ?? imagenPorDefecto).ToList();

            // Asegurar siempre 2 horizontales y 4 cuadrados
            while (horizontal.Count < 2)
                horizontal.Add(imagenPorDefecto);

            while (cuadrado.Count < 4)
                cuadrado.Add(imagenPorDefecto);


            <div class="mb-10 rounded-xl bg-white p-5 shadow-md">
                <div class="mb-4 flex flex-col items-center justify-between lg:flex-row">
                    <h2 class="pl-0 text-center text-lg font-bold text-gray-800 lg:text-left lg:pl-10">
                        @categoriaNombre
                    </h2>
                    <form method="post" action="@Url.Action("Consultar", "Negocios")" class="inline">
                        <input type="hidden" name="idCategoria" value="@categoria.Id" />
                        <input type="hidden" name="membre" value="" />
                        <button type="submit"
                            class="mt-2 flex items-center text-sm font-medium text-gray-600 hover:text-gray-800">
                            Ver más
                            <svg xmlns="http://www.w3.org/2000/svg" class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </button>
                    </form>
                </div>

                <!-- Rejilla de imágenes -->
                <div class="grid grid-cols-1 gap-4 lg:grid-cols-5">

                    <img src="@horizontal[0]"
                        class="col-span-3 hidden h-60 w-full rounded-tl-3xl object-cover lg:block">
                    <img src="@cuadrado[3]"
                        class="col-span-1 hidden h-60 w-full rounded-tl-3xl rounded-br-3xl object-cover lg:block">
                    <img src="@cuadrado[2]"
                        class="col-span-1 hidden h-60 w-full rounded-tl-3xl rounded-br-3xl object-cover lg:block">
                    <img src="@cuadrado[0]" class="col-span-1 hidden h-60 w-full object-cover lg:block">
                    <img src="@cuadrado[1]" class="col-span-1 hidden h-60 w-full object-cover lg:block">
                    <img src="@horizontal[1]" class="col-span-3 hidden h-60 w-full object-cover lg:block">

                    <div class="flex flex-col gap-2 lg:hidden">
                        <div class="aspect-[16/9] w-full overflow-hidden rounded-tl-3xl">
                            <img src="@horizontal[0]" class="h-full w-full object-cover" alt="..." />
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <div class="aspect-square overflow-hidden rounded-tl-3xl">
                                <img src="@cuadrado[0]" class="h-full w-full object-cover" alt="..." />
                            </div>
                            <div class="aspect-square overflow-hidden rounded-br-3xl">
                                <img src="@cuadrado[1]" class="h-full w-full object-cover" alt="..." />
                            </div>
                        </div>

                        <div class="aspect-[16/9] w-full overflow-hidden rounded-br-3xl">
                            <img src="@horizontal[1]" class="h-full w-full object-cover" alt="..." />
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <div class="aspect-square overflow-hidden rounded-tl-3xl">
                                <img src="@cuadrado[2]" class="h-full w-full object-cover" alt="..." />
                            </div>
                            <div class="aspect-square overflow-hidden rounded-br-3xl">
                                <img src="@cuadrado[3]" class="h-full w-full object-cover" alt="..." />
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        }
    </section>
</body>

</html>