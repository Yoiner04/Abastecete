@inject IHttpContextAccessor HttpContextAccessor
@using BusinessLogic.Utilidades
@{
    ViewData["Title"] = "Editar Banners";
    string permisos = HttpContextAccessor.HttpContext.Session.GetString("permisos");
}
@model List<BusinessLogic.Models.Categoria>

<h2 class="text-5xl font-bold mb-8 mt-6 text-center">Editar Banners</h2>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative">
    <div class="absolute left-1/2 top-0 bottom-0 w-1 bg-gray-300 hidden md:block"></div>

    @if (permisos != null && RolPermisos.TienePermiso("Administrar Banners", permisos))
    {
        <div class="flex flex-col items-center text-center px-6">
            <img src="/images/bannerssuperior.jpg" alt="Banners del Carrusel" class="w-full max-w-md rounded-lg shadow-lg mb-4">
            <p class="text-gray-700 text-lg">Banners del carrusel superior que se muestran en la página principal.</p>
            @Html.Partial("BannerModal")
            <a onclick="abrirBannerModal()" class="mt-4 bg-green-600 text-white px-6 py-3 rounded-lg text-lg font-medium hover:bg-green-700">
                Editar Banners Del Carrusel Superior
            </a>
        </div>
    }

    @if (permisos != null && RolPermisos.TienePermiso("Administrar Banners", permisos))
    {
        <div class="flex flex-col items-center text-center px-6">
            <img src="/images/bannerscategorias.jpg" alt="Banners de Categoría" class="w-full max-w-md rounded-lg shadow-lg mb-4">
            <p class="text-gray-700 text-lg">Banners asociados a categorías específicas dentro del sitio.</p>
            @Html.Partial("CategoryBannerModal")
            <a onclick="abrirCategoryBannerModal()" class="mt-4 bg-green-600 text-white px-6 py-3 rounded-lg text-lg font-medium hover:bg-green-700">
                Editar Banners de Las Categorías
            </a>
        </div>
    }

    @if (permisos != null && RolPermisos.TienePermiso("Administrar Banners", permisos))
    {
        <div class="flex flex-col items-center text-center px-6">
            <img src="/images/bannerproveedores.png" alt="Banner de Proveedores" class="w-full max-w-md rounded-lg shadow-lg mb-4">
            <p class="text-gray-700 text-lg">Banner principal de la sección de proveedores.</p>
            <a onclick="abrirBannerProveedoresModal()" class="mt-4 bg-green-600 text-white px-6 py-3 rounded-lg text-lg font-medium hover:bg-green-700">
                Editar Banner de Proveedores
            </a>
        </div>
    }
</div>

@Html.Partial("BannerModal")
@Html.Partial("CategoryBannerModal")
@Html.Partial("BannerProveedoresModal")