@inject IHttpContextAccessor HttpContextAccessor
@using BusinessLogic.Utilidades
@model List<BusinessLogic.Models.Categoria>
@{
    ViewData["Title"] = "Gestión de Banners";
    string permisos = HttpContextAccessor.HttpContext.Session.GetString("permisosSistema") ?? "";
    var puedeAdministrar = RolPermisos.TienePermiso("ADMIN_BANNERS", permisos);
}

<!-- Header a ancho completo -->
<div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div class="flex items-center gap-4">
                <a href="@Url.Action("Principal", "Home")"
                   class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors">
                    <i class="fas fa-arrow-left text-gray-600"></i>
                </a>
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Gestión de Banners</h1>
                    <p class="text-sm text-gray-500 mt-1">Administra los banners publicitarios del sistema</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Contenido con contenedor -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

<!-- Stats Cards -->
<div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center">
            <i class="fas fa-home text-emerald-600"></i>
        </div>
        <div>
            <p class="text-lg font-bold text-gray-900">Inicio</p>
            <p class="text-xs text-gray-500">Carrusel</p>
        </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center">
            <i class="fas fa-tags text-blue-600"></i>
        </div>
        <div>
            <p class="text-lg font-bold text-gray-900">@Model.Count</p>
            <p class="text-xs text-gray-500">Categorías</p>
        </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-purple-100 flex items-center justify-center">
            <i class="fas fa-store text-purple-600"></i>
        </div>
        <div>
            <p class="text-lg font-bold text-gray-900">Prov.</p>
            <p class="text-xs text-gray-500">Banner</p>
        </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-orange-100 flex items-center justify-center">
            <i class="fas fa-bolt text-orange-600"></i>
        </div>
        <div>
            <p class="text-lg font-bold text-gray-900">Ofertas</p>
            <p class="text-xs text-gray-500">Flash</p>
        </div>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-indigo-100 flex items-center justify-center">
            <i class="fas fa-sign-in-alt text-indigo-600"></i>
        </div>
        <div>
            <p class="text-lg font-bold text-gray-900">Sesión</p>
            <p class="text-xs text-gray-500">Login</p>
        </div>
    </div>
</div>

@if (puedeAdministrar)
{
    <!-- Grid de Tarjetas de Banners -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Banners de Inicio -->
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
            <div class="h-40 bg-gradient-to-br from-emerald-500 to-emerald-600 flex items-center justify-center relative overflow-hidden">
                <img src="/images/bannerssuperior.jpg" alt="Banners del Carrusel"
                     class="w-full h-full object-cover opacity-80"
                     onerror="this.style.display='none'">
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                <div class="absolute bottom-3 left-4 right-4">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-white/20 text-white backdrop-blur-sm">
                        <i class="fas fa-image mr-1"></i> Ratio 16:9 y 1:1
                    </span>
                </div>
            </div>
            <div class="p-5">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center">
                        <i class="fas fa-home text-emerald-600"></i>
                    </div>
                    <h3 class="font-semibold text-gray-900">Banners de Inicio</h3>
                </div>
                <p class="text-sm text-gray-600 mb-4">
                    Carrusel superior (16:9) y banners laterales (1:1) en la página principal.
                </p>
                <button onclick="abrirBannerModal()"
                        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-emerald-600 text-white rounded-lg hover:bg-emerald-700 transition-colors font-medium">
                    <i class="fas fa-edit"></i>
                    Editar Banners
                </button>
            </div>
        </div>

        <!-- Banners por Categoría -->
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
            <div class="h-40 bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center relative overflow-hidden">
                <img src="/images/bannerscategorias.jpg" alt="Banners de Categoría"
                     class="w-full h-full object-cover opacity-80"
                     onerror="this.style.display='none'">
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                <div class="absolute bottom-3 left-4 right-4">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-white/20 text-white backdrop-blur-sm">
                        <i class="fas fa-th mr-1"></i> 2 Horiz. + 4 Cuadrados
                    </span>
                </div>
            </div>
            <div class="p-5">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center">
                        <i class="fas fa-tags text-blue-600"></i>
                    </div>
                    <h3 class="font-semibold text-gray-900">Banners por Categoría</h3>
                </div>
                <p class="text-sm text-gray-600 mb-4">
                    Banners específicos por categoría: 2 horizontales y 4 cuadrados.
                </p>
                <button onclick="abrirCategoryBannerModal()"
                        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium">
                    <i class="fas fa-edit"></i>
                    Editar Banners
                </button>
            </div>
        </div>

        <!-- Banner de Proveedores -->
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
            <div class="h-40 bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center relative overflow-hidden">
                <img src="/images/bannerproveedores.png" alt="Banner de Proveedores"
                     class="w-full h-full object-cover opacity-80"
                     onerror="this.style.display='none'">
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                <div class="absolute bottom-3 left-4 right-4">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-white/20 text-white backdrop-blur-sm">
                        <i class="fas fa-store mr-1"></i> Sección Proveedores
                    </span>
                </div>
            </div>
            <div class="p-5">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-lg bg-purple-100 flex items-center justify-center">
                        <i class="fas fa-store text-purple-600"></i>
                    </div>
                    <h3 class="font-semibold text-gray-900">Banner de Proveedores</h3>
                </div>
                <p class="text-sm text-gray-600 mb-4">
                    Imagen principal que aparece en la sección de proveedores.
                </p>
                <button onclick="abrirBannerProveedoresModal()"
                        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors font-medium">
                    <i class="fas fa-edit"></i>
                    Editar Banner
                </button>
            </div>
        </div>

        <!-- Banner de Ofertas Flash -->
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
            <div class="h-40 bg-gradient-to-br from-orange-500 to-orange-600 flex items-center justify-center relative overflow-hidden">
                <div class="text-center text-white">
                    <i class="fas fa-bolt text-5xl mb-2 animate-pulse"></i>
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                <div class="absolute bottom-3 left-4 right-4">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-white/20 text-white backdrop-blur-sm">
                        <i class="fas fa-bolt mr-1"></i> Ofertas Especiales
                    </span>
                </div>
            </div>
            <div class="p-5">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-lg bg-orange-100 flex items-center justify-center">
                        <i class="fas fa-bolt text-orange-600"></i>
                    </div>
                    <h3 class="font-semibold text-gray-900">Banner de Ofertas Flash</h3>
                </div>
                <p class="text-sm text-gray-600 mb-4">
                    Imagen de la sección principal para mostrar ofertas flash.
                </p>
                <button onclick="abrirBannerOfertasModal()"
                        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition-colors font-medium">
                    <i class="fas fa-edit"></i>
                    Editar Banner
                </button>
            </div>
        </div>

        <!-- Banner de Inicio Sesión -->
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
            <div class="h-40 bg-gradient-to-br from-indigo-500 to-indigo-600 flex items-center justify-center relative overflow-hidden">
                <div class="text-center text-white">
                    <i class="fas fa-sign-in-alt text-5xl mb-2"></i>
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                <div class="absolute bottom-3 left-4 right-4">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-white/20 text-white backdrop-blur-sm">
                        <i class="fas fa-user mr-1"></i> Pantalla Login
                    </span>
                </div>
            </div>
            <div class="p-5">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-lg bg-indigo-100 flex items-center justify-center">
                        <i class="fas fa-sign-in-alt text-indigo-600"></i>
                    </div>
                    <h3 class="font-semibold text-gray-900">Banner de Inicio Sesión</h3>
                </div>
                <p class="text-sm text-gray-600 mb-4">
                    Imagen que aparece en la pantalla de inicio de sesión.
                </p>
                <button onclick="abrirBannerSesionModal()"
                        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors font-medium">
                    <i class="fas fa-edit"></i>
                    Editar Banner
                </button>
            </div>
        </div>

        <!-- Banner del Buscador -->
        <div class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow">
            <div class="h-40 bg-gradient-to-br from-teal-500 to-teal-600 flex items-center justify-center relative overflow-hidden">
                <div class="text-center text-white">
                    <i class="fas fa-search text-5xl mb-2"></i>
                </div>
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                <div class="absolute bottom-3 left-4 right-4">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-white/20 text-white backdrop-blur-sm">
                        <i class="fas fa-search mr-1"></i> Página de Búsqueda
                    </span>
                </div>
            </div>
            <div class="p-5">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-lg bg-teal-100 flex items-center justify-center">
                        <i class="fas fa-search text-teal-600"></i>
                    </div>
                    <h3 class="font-semibold text-gray-900">Banner del Buscador</h3>
                </div>
                <p class="text-sm text-gray-600 mb-4">
                    Imagen promocional que aparece debajo del buscador de productos.
                </p>
                <button onclick="abrirBannerBuscadorModal()"
                        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-teal-600 text-white rounded-lg hover:bg-teal-700 transition-colors font-medium">
                    <i class="fas fa-edit"></i>
                    Editar Banner
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="bg-white rounded-xl border border-gray-200 p-12 text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 flex items-center justify-center">
            <i class="fas fa-lock text-2xl text-gray-400"></i>
        </div>
        <h3 class="text-lg font-medium text-gray-900 mb-2">Acceso Restringido</h3>
        <p class="text-gray-500">No tienes permisos para administrar banners</p>
    </div>
}

</div> <!-- Cierre del contenedor principal -->

<!-- Inclusión de modales -->
@Html.Partial("BannerModal")
@Html.Partial("CategoryBannerModal")
@Html.Partial("BannerProveedoresModal")
@Html.Partial("BannerOfertasModal")
@Html.Partial("BannerSesionModal")
@Html.Partial("BannerBuscadorModal")
