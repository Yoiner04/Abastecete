@model List<BusinessLogic.Models.Categoria>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>

<body>
    <!-- DESCUENTOS -->
    <section id="discounts-section" class="discounts-section p-6 lg:p-10">
        <div class="mb-6 flex flex-wrap gap-2 lg:gap-4">
            <h2 class="text-3xl lg:text-5xl font-bold text-[#F66623]">DESCUENTOS</h2>
            <h2 class="text-3xl lg:text-5xl font-bold text-[#23916A]">IMPERDIBLES</h2>
        </div>

        <!-- Contenedor de Categorías -->
        <div id="categories-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var categoria in Model.Where(c => c.Estado == 1))
            {
                var rutaBase = $"/images/{categoria.Nombre.Replace(" ", "_")}/";
                var imagenPorDefecto = "/images/default.webp";

                <div class="rounded-xl p-6 shadow-md transition-transform transform hover:scale-105 @(categoria.Id % 2 == 0 ? "bg-white" : "bg-green-100")">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-lg font-bold text-gray-800">@categoria.Nombre</h3>
                    </div>

                    <!-- Imágenes representativas -->
                    <div class="grid grid-cols-2 gap-2">
                        <img src="@($"{rutaBase}banner3.webp")" onerror="this.src='@imagenPorDefecto'" class="h-32 w-full object-cover rounded-lg">
                        <img src="@($"{rutaBase}banner4.webp")" onerror="this.src='@imagenPorDefecto'" class="h-32 w-full object-cover rounded-lg">
                        <img src="@($"{rutaBase}banner5.webp")" onerror="this.src='@imagenPorDefecto'" class="h-32 w-full object-cover rounded-lg">
                        <img src="@($"{rutaBase}banner6.webp")" onerror="this.src='@imagenPorDefecto'" class="h-32 w-full object-cover rounded-lg">
                    </div>
                </div>
            }
        </div>
    </section>
</body>
