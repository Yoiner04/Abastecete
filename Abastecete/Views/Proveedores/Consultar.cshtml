<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abastecete</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <style>
        #mapa {
            width: 100%;
            height: 600px;
            min-height: 600px;
            flex-shrink: 0;
        }

        #filtro-popup {
            display: none;
            max-width: 400px;
            width: 100%;
        }

        .mapa-con-filtros {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
        }

            .mapa-con-filtros > #mapa {
                flex: 1 1 60%;
                margin-top: 50px;
                max-width: 700px;
                height: 300px;
            }


            .mapa-con-filtros > #filtro-popup {
                flex: 1 1 35%;
                max-width: 400px;
            }

        .flex-half {
            width: 50%;
        }

        .grid-cols-2 {
            grid-template-columns: repeat(2, 1fr);
        }

        #providers-container .bg-white {
            flex: 0 0 300px;
            max-width: 300px;
            height: auto;
        }

            #providers-container .bg-white .bg-gray-200 {
                width: 100%;
                height: 180px;
            }

        @@media (max-width: 768px) {
            #main-container {
                flex-direction: column;
            }

            #mapa-filtros,
            #proveedores-container {
                width: 100%;
            }

            .mapa-con-filtros {
                flex-direction: column;
            }

                .mapa-con-filtros > #mapa {
                    width: 100%;
                }

            #providers-container {
                margin-left: 25px;
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 1rem;
            }
        }

        @@media (max-width: 480px) {
            #providers-container {
                grid-template-columns: 1fr;
            }

            #filtro-popup {
                width: 100%;
            }

            #mapa {
                height: 200px;
            }

            .bg-white {
                max-width: 100%;
            }
        }
    </style>
</head>

<body>
    <section class="w-full bg-gray-200 h-80 flex items-center justify-center mb-8 rounded-lg" style="margin-top: 10px;">
        <h1 class="text-3xl font-bold text-gray-800">Promociones especiales</h1>
    </section>

    <div id="main-container" class="min-h-screen bg-[#F4F1E9] flex">
        <!-- Mapa y Filtros -->
        <div id="mapa-filtros" class="w-1/3 p-4 mt-3">
            <!-- Botón de filtros -->
            <div class="mb-4">
                <button id="filtro-btn"
                        class="flex items-center bg-green-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-green-700 shadow-md">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" y1="21" x2="20" y2="21"></line>
                        <line x1="4" y1="10" x2="20" y2="10"></line>
                        <circle cx="14" cy="21" r="2"></circle>
                        <circle cx="8" cy="10" r="2"></circle>
                        <line x1="4" y1="3" x2="20" y2="3"></line>
                        <circle cx="16" cy="3" r="2"></circle>
                    </svg>
                    Filtros
                </button>

                <!-- Opciones de filtros desplegables -->
                <div id="filtro-popup" class="mt-2 bg-white rounded-lg shadow-lg p-4">
                    <h2 class="text-xl font-bold text-green-600 mb-4">Filtros</h2>
                    <div class="mb-6">
                        <h3 class="text-lg font-semibold text-orange-600 mb-2">Categorías</h3>
                        <hr class="border-gray-300 mb-4">
                        <ul class="space-y-2">
                            <li>
                                <a href="#" class="text-sm text-gray-700 hover:text-green-600">Todos los productos</a>
                            </li>
                            <li>
                                <a href="#" class="text-sm text-gray-700 hover:text-green-600">Frutas y Verduras</a>
                            </li>
                            <li><a href="#" class="text-sm text-gray-700 hover:text-green-600">Proteínas</a></li>
                            <li><a href="#" class="text-sm text-gray-700 hover:text-green-600">Lácteos y Huevos</a></li>
                            <li>
                                <a href="#" class="text-sm text-gray-700 hover:text-green-600">
                                    Panadería y
                                    Repostería
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Mapa -->
            <div id="mapa"
                 class="h-[calc(100vh-2rem)] bg-gray-200 rounded-lg shadow-md flex items-center justify-center sticky top-4">
                Cargando mapa...
            </div>
        </div>

        <!-- Galería de proveedores -->
        <main id="proveedores-container" class="w-2/3 p-6 overflow-y-auto text-center items-center">
            <div class="flex items-center justify-between mb-6">
                <!-- Encabezado -->
                <h2 class="text-2xl font-bold text-green-600">Todos los proveedores</h2>
            </div>

            <!-- Contenedor dinámico de tarjetas de proveedores -->
            <div class="grid grid-cols-3 gap-6 text-center items-center" id="providers-container"></div>

            <!-- Paginación -->
            <div class="mt-6 flex justify-center space-x-2">
                <button class="w-8 h-8 bg-gray-300 rounded-full text-gray-600 font-bold hover:bg-gray-400">&lt;</button>
                <button class="w-8 h-8 bg-green-600 text-white rounded-full font-bold">1</button>
                <button class="w-8 h-8 bg-gray-300 rounded-full text-gray-600 font-bold hover:bg-gray-400">2</button>
                <button class="w-8 h-8 bg-gray-300 rounded-full text-gray-600 font-bold hover:bg-gray-400">3</button>
                <button class="w-8 h-8 bg-gray-300 rounded-full text-gray-600 font-bold hover:bg-gray-400">&gt;</button>
            </div>
        </main>
    </div>

    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script>
        // Mostrar u ocultar los filtros al dar clic
        const filtroBtn = document.getElementById('filtro-btn');
        const filtroPopup = document.getElementById('filtro-popup');
        const mapaFiltros = document.getElementById('mapa-filtros');
        const proveedoresContainer = document.getElementById('proveedores-container');
        const providersContainer = document.getElementById("providers-container");

        filtroBtn.addEventListener('click', () => {
            const isHidden = filtroPopup.style.display === 'none' || filtroPopup.style.display === '';

            filtroPopup.style.display = isHidden ? 'block' : 'none';

            if (isHidden) {
                // Cambiar a diseño con mapa y filtros en una fila
                mapaFiltros.classList.add('mapa-con-filtros');
                mapaFiltros.classList.replace('w-1/3', 'flex-half');
                proveedoresContainer.classList.replace('w-2/3', 'flex-half');
                providersContainer.classList.replace('grid-cols-3', 'grid-cols-2');
            } else {
                // Volver a diseño 1/3 y 2/3
                mapaFiltros.classList.remove('mapa-con-filtros');
                mapaFiltros.classList.replace('flex-half', 'w-1/3');
                proveedoresContainer.classList.replace('flex-half', 'w-2/3');
                providersContainer.classList.replace('grid-cols-2', 'grid-cols-3');
            }
        });
    </script>
    <script>
        // Inicializar el mapa
        var mapa = L.map('mapa').setView([0, 0], 13);

        // Cargar los tiles de OpenStreetMap
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '© OpenStreetMap'
        }).addTo(mapa);

        // Función para cargar locales dentro de los límites actuales del mapa
        function cargarLocales() {
            const bounds = mapa.getBounds();
            const sw = bounds.getSouthWest();
            const ne = bounds.getNorthEast();

            // Llamar a la API para obtener los locales
            fetch(`http://localhost/obtener_locales.php?sw_lat=${sw.lat}&sw_lng=${sw.lng}&ne_lat=${ne.lat}&ne_lng=${ne.lng}`)
                .then(response => response.json())
                .then(data => {
                    data.forEach(local => {
                        L.marker([local.Latitud, local.Longitud])
                            .addTo(mapa)
                            .bindPopup(`<strong>${local.Direccion_local}</strong>`);
                    });
                })
                .catch(error => {
                    console.error("Error al cargar los locales:", error);
                });
        }

        mapa.on('moveend', cargarLocales);

        // Verificar si el navegador soporta geolocalización
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                function (position) {
                    var lat = position.coords.latitude;
                    var lng = position.coords.longitude;

                    mapa.setView([lat, lng], 15);

                    L.marker([lat, lng]).addTo(mapa)
                        .bindPopup("Estás aquí")
                        .openPopup();

                    cargarLocales();
                },
                function (error) {
                    console.error("Error obteniendo la ubicación: ", error.message);
                    alert("No se pudo obtener tu ubicación.");
                }
            );
        } else {
            alert("Tu navegador no soporta la geolocalización.");
        }
    </script>
    <script>
        // Datos de proveedores
        const providers = Array.from({ length: 10 }, (_, i) => ({
            name: `Proveedor ${i + 1}`,
            rating: "5.0",
            category: "Frutas y Verduras",
            image: src = "/images/a.jpg"
        }));


        // Renderizar dinámicamente las tarjetas de proveedores
        providers.forEach((provider) => {
            const card = document.createElement("div");
            card.className = "bg-white border border-gray-200 rounded-lg shadow-md p-4 flex flex-col items-center";

            card.innerHTML = `
                <div class="relative w-full">
                    <div class="bg-gray-200 h-52 rounded-lg" style="background-image: url(${provider.image}); background-size: cover; background-position: center;"></div>
                    <div class="absolute top-2 left-2 bg-white rounded-full flex items-center px-2 py-1 text-sm font-medium shadow">
                        <span class="text-yellow-500 mr-1"><i class="fas fa-star"></i></span>
                        <span>${provider.rating}</span>
                    </div>
                    <button class="absolute top-2 right-2 bg-white p-2 rounded-full shadow text-gray-600 hover:text-green-600">
                        <i class="far fa-heart"></i>
                    </button>
                </div>
                <div class="mt-4 text-center">
                    <p class="text-lg font-bold text-gray-800">${provider.name}</p>
                    <a href="@Url.Action("Consultar", "Productos")" class="mt-2 bg-green-600 text-white px-4 py-2 rounded-full text-sm font-medium hover:bg-green-700">
                        Ver
                    </a>
                </div>
            `;
            providersContainer.appendChild(card);
        });
    </script>
</body>

</html>
