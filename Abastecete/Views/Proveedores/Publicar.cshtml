<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Abastecete</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Abastecete.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/css/Images/Logo A naranja.png" />
    <link rel="stylesheet" href="styles.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>

<body class="bg-gray-100 py-10">
    <br />
    <div class="max-w-6xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Membresía Básica -->
            <div class="bg-white p-6 rounded-2xl shadow-md text-center">
                <h3 class="text-xl font-semibold">Básica</h3>
                <p class="text-gray-500 mt-2">$9.99/mes</p>
                <ul class="mt-4 text-gray-600">
                    <li>✔ Acceso limitado</li>
                    <li>✔ Soporte básico</li>
                    <li>✔ 5GB de almacenamiento</li>
                </ul>
                <button class="mt-4 bg-[#F6580F] text-white py-2 px-4 rounded-lg hover:bg-[#15803D]">Seleccionar</button>
            </div>

            <!-- Membresía Estándar -->
            <div class="bg-white p-6 rounded-2xl shadow-md text-center">
                <h3 class="text-xl font-semibold">Estándar</h3>
                <p class="text-gray-500 mt-2">$19.99/mes</p>
                <ul class="mt-4 text-gray-600">
                    <li>✔ Acceso completo</li>
                    <li>✔ Soporte prioritario</li>
                    <li>✔ 50GB de almacenamiento</li>
                </ul>
                <button class="mt-4 bg-[#F6580F] text-white py-2 px-4 rounded-lg hover:bg-[#15803D]">Seleccionar</button>
            </div>

            <!-- Membresía Premium -->
            <div class="bg-white p-6 rounded-2xl shadow-md text-center">
                <h3 class="text-xl font-semibold">Premium</h3>
                <p class="text-gray-500 mt-2">$29.99/mes</p>
                <ul class="mt-4 text-gray-600">
                    <li>✔ Todo incluido</li>
                    <li>✔ Soporte VIP</li>
                    <li>✔ Almacenamiento ilimitado</li>
                </ul>
                <button class="mt-4 bg-[#F6580F] text-white py-2 px-4 rounded-lg hover:bg-[#15803D]">Seleccionar</button>
            </div>

            <!-- Membresía Pro -->
            <div class="bg-white p-6 rounded-2xl shadow-md text-center">
                <h3 class="text-xl font-semibold">Pro</h3>
                <p class="text-gray-500 mt-2">$39.99/mes</p>
                <ul class="mt-4 text-gray-600">
                    <li>✔ Funcionalidades avanzadas</li>
                    <li>✔ Soporte dedicado</li>
                    <li>✔ Integraciones exclusivas</li>
                </ul>
                <button class="mt-4 bg-[#F6580F] text-white py-2 px-4 rounded-lg hover:bg-[#15803D]">Seleccionar</button>
            </div>

            <!-- Membresía Empresarial -->
            <div class="bg-white p-6 rounded-2xl shadow-md text-center">
                <h3 class="text-xl font-semibold">Empresarial</h3>
                <p class="text-gray-500 mt-2">$49.99/mes</p>
                <ul class="mt-4 text-gray-600">
                    <li>✔ Para grandes empresas</li>
                    <li>✔ Soporte 24/7</li>
                    <li>✔ Seguridad avanzada</li>
                </ul>
                <button class="mt-4 bg-[#F6580F] text-white py-2 px-4 rounded-lg hover:bg-[#15803D]">Seleccionar</button>
            </div>

            <!-- Membresía Ultimate -->
            <div class="bg-white p-6 rounded-2xl shadow-md text-center">
                <h3 class="text-xl font-semibold">Ultimate</h3>
                <p class="text-gray-500 mt-2">$99.99/mes</p>
                <ul class="mt-4 text-gray-600">
                    <li>✔ Beneficios exclusivos</li>
                    <li>✔ Soporte ultra rápido</li>
                    <li>✔ Personalización total</li>
                </ul>
                <button class="mt-4 bg-[#F6580F] text-white py-2 px-4 rounded-lg hover:bg-[#15803D]">Seleccionar</button>
            </div>
        </div>
    </div>
</body>
</html>



